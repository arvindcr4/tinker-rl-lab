       \\\"$ref\\\": \\\"#/$defs/Evidence\\\"\\n          }\\n        }\\n      }\\n    },\\n    \\\"DecontaminationProbe\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\n        \\\"status\\\",\\n        \\\"train_test_overlap_probe\\\",\\n        \\\"parser_adversarial_probe\\\",\\n        \\\"evidence\\\"\\n      ],\\n      \\\"properties\\\": {\\n        \\\"status\\\": {\\n          \\\"$ref\\\": \\\"#/$defs/Status\\\"\\n        },\\n        \\\"train_test_overlap_probe\\\": {\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"additionalProperties\\\": false,\\n          \\\"required\\\": [\\n            \\\"method\\\",\\n            \\\"passed\\\",\\n            \\\"max_overlap\\\"\\n          ],\\n          \\\"properties\\\": {\\n            \\\"method\\\": {\\n              \\\"type\\\": [\\\"string\\\", \\\"null\\\"]\\n            },\\n            \\\"passed\\\": {\\n              \\\"type\\\": [\\\"boolean\\\", \\\"null\\\"]\\n            },\\n            \\\"max_overlap\\\": {\\n              \\\"type\\\": [\\\"number\\\", \\\"null\\\"]\\n            },\\n            \\\"artifact_uri\\\": {\\n              \\\"type\\\": [\\\"string\\\", \\\"null\\\"],\\n              \\\"format\\\": \\\"uri\\\"\\n            }\\n          }\\n        },\\n        \\\"parser_adversarial_probe\\\": {\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"additionalProperties\\\": false,\\n          \\\"required\\\": [\\n            \\\"method\\\",\\n            \\\"passed\\\",\\n            \\\"failure_modes\\\"\\n          ],\\n          \\\"properties\\\": {\\n            \\\"method\\\": {\\n              \\\"type\\\": [\\\"string\\\", \\\"null\\\"]\\n            },\\n            \\\"passed\\\": {\\n              \\\"type\\\": [\\\"boolean\\\", \\\"null\\\"]\\n            },\\n            \\\"failure_modes\\\": {\\n              \\\"type\\\": \\\"array\\\",\\n              \\\"items\\\": {\\