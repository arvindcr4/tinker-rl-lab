"}\\n      }\\n    },\\n    \\\"delta_hook\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": False,\\n      \\\"required\\\": [\\\"component\\\", \\\"operation\\\", \\\"description\\\", \\\"registry_paths_touched\\\"],\\n      \\\"properties\\\": {\\n        \\\"component\\\": {\\\"enum\\\": [\\\"loss\\\", \\\"reference_kl\\\", \\\"sampler\\\", \\\"grouping\\\", \\\"reward\\\", \\\"optimizer\\\", \\\"data\\\", \\\"evaluation\\\", \\\"multi_agent\\\", \\\"other\\\"]},\\n        \\\"operation\\\": {\\\"enum\\\": [\\\"add\\\", \\\"remove\\\", \\\"replace\\\", \\\"schedule\\\", \\\"tune\\\", \\\"wrap\\\", \\\"unknown\\\"]},\\n        \\\"description\\\": {\\\"type\\\": \\\"string\\\"},\\n        \\\"registry_paths_touched\\\": {\\\"type\\\": \\\"array\\\", \\\"items\\\": {\\\"type\\\": \\\"string\\\"}}\\n      }\\n    },\\n    \\\"metric\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": False,\\n      \\\"required\\\": [\\\"name\\\", \\\"value\\\", \\\"unit\\\", \\\"aggregation\\\"],\\n      \\\"properties\\\": {\\n        \\\"name\\\": {\\\"type\\\": \\\"string\\\"},\\n        \\\"value\\\": {\\\"type\\\": [\\\"number\\\", \\\"null\\\"]},\\n        \\\"unit\\\": {\\\"type\\\": \\\"string\\\"},\\n        \\\"aggregation\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n        \\\"step\\\": {\\\"type\\\": [\\\"integer\\\", \\\"null\\\"]},\\n        \\\"ci95\\\": {\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"additionalProperties\\\": False,\\n          \\\"properties\\\": {\\n            \\\"low\\\": {\\\"type\\\": [\\\"number\\\", \\\"null\\\"]},\\n            \\\"high\\\": {\\\"type\\\": [\\\"number\\\", \\\"null\\\"]},\\n            \\\"method\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]}\\n          }\\n        },\\n        \\\"n\\\": {\\\"type\\\": [\\\"integer\\\", \\\"null\\\"], \\\"minimum\\\": 1}\\n      }\\n    },\\n    \\\"hash\\\": {\\n      \\\"type\\\": \\\"object\\\"