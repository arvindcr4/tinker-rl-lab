[95.525369, "o", "#!/usr/bin/make -f\r\n\r\nexport DEB_BUILD_MAINT_OPTIONS = hardening=+all\r\n\r\n%:\r\n\tdh $@\r\n\r\noverride_dh_auto_build:\r\n\tdh_auto_build --sourcedir src\r\n\r\noverride_dh_auto_clean:\r\n\tdh_auto_clean --sourcedir src\r\n\trm -f src/pmars\r\n"]
