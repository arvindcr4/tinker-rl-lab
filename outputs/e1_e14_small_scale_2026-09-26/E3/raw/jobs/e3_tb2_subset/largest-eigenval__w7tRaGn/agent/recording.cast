[396.025594, "o", "\u001b[01m\u001b[Keigen_c.c:\u001b[m\u001b[K In function ‘\u001b[01m\u001b[Kpy_find_dominant_eigenvalue_and_eigenvector\u001b[m\u001b[K’:\r\n"]
[396.025985, "o", "\u001b[01m\u001b[Keigen_c.c:54:37:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[Kpassing argument 3 of ‘\u001b[01m\u001b[Kscipy_dgeev_64_\u001b[m\u001b[K’ from incompatible pointer type [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wincompatible-pointer-types\u0007-Wincompatible-pointer-types\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   54 |     scipy_dgeev_64_(&jobvl, &jobvr, \u001b[01;35m\u001b[K&n\u001b[m\u001b[K, Awork, &lda, wr, wi, NULL, &ldvl, vr, &ldvr, work, &lwork, &info);\r\n      |                                     \u001b[01;35m\u001b[K^~\u001b[m\u001b[K\r\n      |                                     \u001b[01;35m\u001b[K|\u001b[m\u001b[K\r\n      |                                     \u001b[01;35m\u001b[Knpy_intp * {aka long int *}\u001b[m\u001b[K\r\n\u001b[01m\u001b[Keigen_c.c:8:60:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[Kexpected ‘\u001b[01m\u001b[Kint *\u001b[m\u001b[K’ but argument is of type ‘\u001b[01m\u001b[Knpy_intp *\u001b[m\u001b[K’ {aka ‘\u001b[01m\u001b[Klong int *\u001b[m\u001b[K’}\r\n    8 | extern void scipy_dgeev_64_(char *jobvl, char *jobvr, \u001b[01;36m\u001b[Kint *n\u001b[m\u001b[K, double *a, int *lda,\r\n      |                                                       \u001b[01;36m\u001b[K~~~~~^\u001b[m\u001b[K\r"]
[396.026, "o", "\n"]
