[259.536738, "o", "    return median\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.536968, "o", "A = np.random.normal(size=(10, 10)).astype(np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== 10x10 ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.537311, "o", "ref_t = benchmark(\"ref\", ref_solution, A, N=1000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.537534, "o", "scipy_t = benchmark(\"scipy\", scipy_solution, A, N=1000)\r\n\u001b[?2004l\r"]
