[105.921282, "i", "cat > /app/bench2.py << 'PYEOF'\nimport time\nimport numpy as np\nimport scipy.linalg\n\ndef ref_solution(A):\n    eigenvalues, eigenvectors = np.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_solution(A):\n    eigenvalues, eigenvectors = scipy.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_eigvals_only(A):\n    eigenvalues = scipy.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    # Need eigenvector too\n    eigenvectors = scipy.linalg.eig(A, left=False, right=True)\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_eig_right_only(A):\n    eigenvalues, eigenvectors = scipy.linalg.eig(A, left=False, right=True)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_eigvals_then_vec(A):\n    eigenvalues = scipy.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    # Compute eigenvector for specific eigenvalue"]
[105.921359, "i", "\n    eigenvectors = scipy.linalg.eig(A, left=False, right=True)\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef numpy_eigvals_then_vec(A):\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    eigenvectors = np.linalg.eig(A, left=False, right=True)\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef benchmark(name, func, A, N=1000):\n    times = []\n    for _ in range(N):\n        t0 = time.perf_counter()\n        func(A)\n        t1 = time.perf_counter()\n        times.append(t1 - t0)\n    median = np.median(times)\n    print(f\"  {name}: median={median*1e6:.3f} us\")\n    return median\n\nA = np.random.normal(size=(10, 10)).astype(np.float64)\nprint(\"=== 10x10 ===\")\nref_t = benchmark(\"ref\", ref_solution, A, N=1000)\nscipy_t = benchmark(\"scipy\", scipy_solution, A, N=1000)\nscipy_ro_t = benchmark(\"scipy_ro\", scipy_eig_right_only, A, N=1000)\nnumpy_ev_t = benchmark(\"numpy_ev\", numpy_eigvals_then_vec, A, N=1000)\nprint(f\"  Speedup: scipy={ref_t/scipy_t:.2f}x, scipy_ro={ref_t/scipy_ro_t:.2f"]
[105.921371, "i", "}x, numpy_ev={ref_t/numpy_ev_t:.2f}x\")\nPYEOF\npython3 /app/bench2.py\n"]
