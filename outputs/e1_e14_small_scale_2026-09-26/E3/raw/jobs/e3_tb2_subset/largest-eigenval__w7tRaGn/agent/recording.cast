[190.868638, "i", "cat > /app/bench5.py << 'PYEOF'\nimport time\nimport numpy as np\nimport scipy.linalg\nimport ctypes\nfrom ctypes import c_int, c_double, c_char_p, POINTER, byref\n\n# Load LAPACK\nliblapack = ctypes.CDLL('libopenblas.so.0')\n\n# dgeev signature: dgeev_(jobvl, jobvr, n, a, lda, wr, wi, vl, ldvl, vr, ldvr, work, lwork, info)\n# For complex: zgeev_\n\ndef ref_solution(A):\n    eigenvalues, eigenvectors = np.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_solution(A):\n    eigenvalues, eigenvectors = scipy.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_eigvals(A):\n    eigenvalues = scipy.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx]\n\ndef scipy_eigvals_right(A):\n    eigenvalues = scipy.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    eigenvectors = scipy.linalg.eig(A, left=False, right=True)\n    return eigenvalues[idx], eigenvectors[:, idx"]
[190.86871, "i", "]\n\ndef benchmark(name, func, A, N=1000):\n    times = []\n    for _ in range(N):\n        t0 = time.perf_counter()\n        func(A)\n        t1 = time.perf_counter()\n        times.append(t1 - t0)\n    median = np.median(times)\n    print(f\"  {name}: median={median*1e6:.3f} us\")\n    return median\n\nfor size in [2, 4, 6, 8, 10]:\n    A = np.random.normal(size=(size, size)).astype(np.float64)\n    print(f\"\\n=== {size}x{size} ===\")\n    ref_t = benchmark(\"ref\", ref_solution, A, N=1000)\n    scipy_t = benchmark(\"scipy\", scipy_solution, A, N=1000)\n    scipy_ev_t = benchmark(\"scipy_ev\", scipy_eigvals, A, N=1000)\n    scipy_er_t = benchmark(\"scipy_er\", scipy_eigvals_right, A, N=1000)\n    print(f\"  Speedup: scipy={ref_t/scipy_t:.2f}x, ev={ref_t/scipy_ev_t:.2f}x, er={ref_t/scipy_er_t:.2f}x\")\nPYEOF\npython3 /app/bench5.py\n"]
