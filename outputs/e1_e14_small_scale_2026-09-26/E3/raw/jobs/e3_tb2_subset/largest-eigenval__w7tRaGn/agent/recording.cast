[259.514868, "i", "cat > /app/bench_numba.py << 'PYEOF'\nimport time\nimport numpy as np\nimport scipy.linalg\nfrom numba import njit, prange\n\ndef ref_solution(A):\n    eigenvalues, eigenvectors = np.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_solution(A):\n    eigenvalues, eigenvectors = scipy.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\n@njit(cache=True)\ndef qr_iteration(A, max_iter=100):\n    n = A.shape[0]\n    # Copy A\n    H = np.empty((n, n))\n    for i in range(n):\n        for j in range(n):\n            H[i, j] = A[i, j]\n    \n    # QR iteration with shifts (Francis QR algorithm simplified)\n    for iteration in range(max_iter):\n        # Wilkinson shift\n        a11 = H[0, 0]\n        a12 = H[0, 1]\n        a21 = H[1, 0]\n        a22 = H[1, 1]\n        \n        trace = a11 + a22\n        det = a11 * a22 - a12 * a21\n        disc = trace * trace - 4.0 * det\n        \n        if disc >= 0:\n            sqrt_dis"]
[259.51495, "i", "c = np.sqrt(disc)\n            shift1 = (trace + sqrt_disc) / 2.0\n            shift2 = (trace - sqrt_disc) / 2.0\n            # Choose shift closer to a22\n            if abs(shift1 - a22) < abs(shift2 - a22):\n                shift = shift1\n            else:\n                shift = shift2\n        else:\n            shift = a22\n        \n        # Shift\n        for i in range(n):\n            H[i, i] -= shift\n        \n        # QR decomposition using Givens rotations\n        for j in range(n):\n            for i in range(n):\n                if i != j:\n                    H[i, j] = A[i, j]\n        \n        for j in range(n - 1):\n            a = H[j, j]\n            b = H[j + 1, j]\n            r = np.sqrt(a * a + b * b)\n            if r == 0.0:\n                c = 1.0\n                s = 0.0\n            else:\n                c = a / r\n                s = b / r\n            \n            for k in range(n):\n                t1 = H[j, k]\n                t2 = H[j + 1, k]\n                H[j, k] = c * t1 + s * t2\n              "]
[259.515013, "i", "  H[j + 1, k] = -s * t1 + c * t2\n            \n            for k in range(n):\n                t1 = H[k, j]\n                t2 = H[k, j + 1]\n                H[k, j] = c * t1 + s * t2\n                H[k, j + 1] = -s * t1 + c * t2\n        \n        # Unshift\n        for i in range(n):\n            H[i, i] += shift\n        \n        # Check convergence\n        if iteration > 0:\n            off_diag = 0.0\n            for i in range(n):\n                for j in range(i):\n                    off_diag += abs(H[i, j])\n            if off_diag < 1e-14:\n                break\n    \n    # Extract eigenvalues from diagonal\n    eigenvalues = np.empty(n, dtype=np.complex128)\n    i = 0\n    while i < n:\n        if i < n - 1 and abs(H[i + 1, i]) > 1e-14:\n            # Complex conjugate pair\n            a = H[i, i]\n            b = H[i, i + 1]\n            c = H[i + 1, i]\n            d = H[i + 1, i + 1]\n            trace = a + d\n            det = a * d - b * c\n            disc = trace * trace - 4.0 * det\n            if disc >= 0:\n     "]
[259.515086, "i", "           sqrt_disc = np.sqrt(disc)\n                eigenvalues[i] = complex((trace + sqrt_disc) / 2.0, 0.0)\n                eigenvalues[i + 1] = complex((trace - sqrt_disc) / 2.0, 0.0)\n            else:\n                sqrt_disc = np.sqrt(-disc)\n                eigenvalues[i] = complex(trace / 2.0, sqrt_disc / 2.0)\n                eigenvalues[i + 1] = complex(trace / 2.0, -sqrt_disc / 2.0)\n            i += 2\n        else:\n            eigenvalues[i] = complex(H[i, i], 0.0)\n            i += 1\n    \n    return eigenvalues\n\ndef numba_solution(A):\n    eigenvalues = qr_iteration(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    # Compute eigenvector\n    A_shifted = A - eigenvalues[idx] * np.eye(A.shape[0])\n    U, S, Vt = np.linalg.svd(A_shifted)\n    eigenvector = Vt[-1]\n    return eigenvalues[idx], eigenvector\n\ndef benchmark(name, func, A, N=1000):\n    times = []\n    for _ in range(N):\n        t0 = time.perf_counter()\n        func(A)\n        t1 = time.perf_counter()\n        times.append(t1 - t0)\n    median = np.medi"]
[259.515103, "i", "an(times)\n    print(f\"  {name}: median={median*1e6:.3f} us\")\n    return median\n\nA = np.random.normal(size=(10, 10)).astype(np.float64)\nprint(\"=== 10x10 ===\")\nref_t = benchmark(\"ref\", ref_solution, A, N=1000)\nscipy_t = benchmark(\"scipy\", scipy_solution, A, N=1000)\nnumba_t = benchmark(\"numba\", numba_solution, A, N=1000)\nprint(f\"  Speedup: scipy={ref_t/scipy_t:.2f}x, numba={ref_t/numba_t:.2f}x\")\nPYEOF\npython3 /app/bench_numba.py\n"]
