[395.942196, "o", "> "]
[395.942388, "o", "    /* Don't free eigvec - it's owned by vec_arr */\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.942401, "o", "> "]
[395.942662, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.942675, "o", "    PyObject* result = Py_BuildValue(\"(OO)\", ev_arr, vec_arr);\r\n\u001b[?2004l\r"]
[395.942947, "o", "\u001b[?2004h>     Py_DECREF(ev_arr);\r\n\u001b[?2004l\r\u001b[?2004h>     Py_DECREF(vec_arr);\r\n\u001b[?2004l\r\u001b[?2004h> "]
