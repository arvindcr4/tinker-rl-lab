[395.939961, "o", "\u001b[?2004h>         eigvec[2*i]   = vr[i + idx * (int)n];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.940224, "o", "        eigvec[2*i+1] = (wi[idx] == 0.0) ? 0.0 : vr[i + idx * (int)n];\r\n\u001b[?2004l\r"]
[395.940371, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
