[259.537796, "o", "\u001b[?2004h"]
[259.538061, "o", "> "]
[259.538278, "o", "print(f\"  Speedup: scipy={ref_t/scipy_t:.2f}x, numba={ref_t/numba_t:.2f}x\")\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
