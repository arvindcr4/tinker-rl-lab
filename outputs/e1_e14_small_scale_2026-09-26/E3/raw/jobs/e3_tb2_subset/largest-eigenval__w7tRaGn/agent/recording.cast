[84.913305, "i", "cat > /app/bench.py << 'EOF'\nimport time\nimport numpy as np\nimport scipy.linalg\n\ndef ref_solution(A):\n    eigenvalues, eigenvectors = np.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_solution(A):\n    eigenvalues, eigenvectors = scipy.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef power_iteration(A, max_iter=1000, tol=1e-12):\n    n = A.shape[0]\n    np.random.seed(42)\n    v = np.random.randn(n)\n    v = v / np.linalg.norm(v)\n    eigenvalue = 0.0\n    for _ in range(max_iter):\n        w = A @ v\n        eigenvalue_new = np.dot(v, w)\n        v_new = w / np.linalg.norm(w)\n        if np.abs(np.abs(eigenvalue_new) - np.abs(eigenvalue)) < tol:\n            v = v_new\n            eigenvalue = eigenvalue_new\n            break\n        v = v_new\n        eigenvalue = eigenvalue_new\n    return eigenvalue, v\n\ndef power_iteration_fast(A, max_iter=1000, tol=1e-12):\n    n = A.shape[0]\n    v = np.rando"]
[84.914377, "i", "m.RandomState(42).randn(n)\n    v = v / np.linalg.norm(v)\n    eigenvalue = 0.0\n    for _ in range(max_iter):\n        w = A @ v\n        eigenvalue_new = np.dot(v, w)\n        v_new = w / np.linalg.norm(w)\n        if np.abs(np.abs(eigenvalue_new) - np.abs(eigenvalue)) < tol:\n            v = v_new\n            eigenvalue = eigenvalue_new\n            break\n        v = v_new\n        eigenvalue = eigenvalue_new\n    return eigenvalue, v\n\ndef test_correctness(name, func, A):\n    ev, vec = func(A)\n    residual = np.linalg.norm(A @ vec - ev * vec)\n    print(f\"  {name}: residual={residual:.2e}, eigenvalue={ev}\")\n    return residual < 1e-6\n\ndef benchmark(name, func, A, N=1000):\n    times = []\n    for _ in range(N):\n        t0 = time.perf_counter()\n        func(A)\n        t1 = time.perf_counter()\n        times.append(t1 - t0)\n    median = np.median(times)\n    print(f\"  {name}: median={median*1e6:.3f} us\")\n    return median\n\nsizes = [2, 4, 6, 8, 10]\nfor size in sizes:\n    A = np.random.normal(size=(size, size)).astype(np.floa"]
[84.916338, "i", "t64)\n    print(f\"\\n=== {size}x{size} ===\")\n    \n    # Correctness check\n    ref_ev, ref_vec = ref_solution(A)\n    print(f\"  Reference: eigenvalue={ref_ev}\")\n    \n    test_correctness(\"scipy\", scipy_solution, A)\n    test_correctness(\"power_iter\", power_iteration, A)\n    \n    # Benchmark\n    ref_t = benchmark(\"ref\", ref_solution, A, N=1000)\n    scipy_t = benchmark(\"scipy\", scipy_solution, A, N=1000)\n    power_t = benchmark(\"power_iter\", power_iteration, A, N=1000)\n    \n    print(f\"  Speedup: scipy={ref_t/scipy_t:.2f}x, power={ref_t/power_t:.2f}x\")\nEOF\npython3 /app/bench.py\n"]
