[395.936948, "o", "    int idx = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     double max_mag = 0.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937185, "o", "    for (int i = 0; i < (int)n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937199, "o", "        double mag;\r\n\u001b[?2004l\r"]
[395.937402, "o", "\u001b[?2004h>         if (wi[i] == 0.0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937629, "o", "            mag = (wr[i] < 0) ? -wr[i] : wr[i];\r\n\u001b[?2004l\r\u001b[?2004h>         } else {"]
[395.937644, "o", "\r\n\u001b[?2004l\r"]
[395.937652, "o", "\u001b[?2004h"]
[395.937902, "o", ">             mag = sqrt(wr[i]*wr[i] + wi[i]*wi[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938098, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         if (mag > max_mag) {"]
[395.938119, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.938414, "o", ">             max_mag = mag;\r\n\u001b[?2004l\r\u001b[?2004h>             idx = i;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[395.938428, "o", "\u001b[?2004h"]
[395.938624, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938842, "o", "    /* Build complex eigenvalue */\r\n\u001b[?2004l\r\u001b[?2004h>     double ev_real = wr[idx];\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.938857, "o", "> "]
[395.939066, "o", "    double ev_imag = wi[idx];\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.939264, "o", "    /* Build eigenvector column - store as complex128 */\r\n\u001b[?2004l\r"]
[395.939483, "o", "\u001b[?2004h> "]
[395.939702, "o", "    double* eigvec = (double*)malloc(2 * (size_t)n * sizeof(double));\r\n\u001b[?2004l\r\u001b[?2004h> "]
