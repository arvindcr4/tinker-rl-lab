[174.925343, "i", "cat > /app/bench4.py << 'PYEOF'\nimport time\nimport numpy as np\nimport scipy.linalg\n\ndef ref_solution(A):\n    eigenvalues, eigenvectors = np.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    return eigenvalues[idx], eigenvectors[:, idx]\n\ndef scipy_eigvals_vec(A):\n    eigenvalues = scipy.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    # Compute eigenvector for dominant eigenvalue\n    A_shifted = A - eigenvalues[idx] * np.eye(A.shape[0])\n    # Use SVD to find null space\n    U, S, Vt = np.linalg.svd(A_shifted)\n    eigenvector = Vt[-1]\n    return eigenvalues[idx], eigenvector\n\ndef scipy_eigvals_vec2(A):\n    eigenvalues = scipy.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    # Compute eigenvector for dominant eigenvalue\n    A_shifted = A - eigenvalues[idx] * np.eye(A.shape[0])\n    # Replace last column with ones and solve\n    A_mod = A_shifted.copy()\n    A_mod[:, -1] = 1.0\n    b = np.zeros(A.shape[0])\n    b[-1] = 1.0\n    eigenvector = np.linalg.solve(A_mod, b)\n    return eigen"]
[174.943641, "i", "values[idx], eigenvector\n\ndef benchmark(name, func, A, N=1000):\n    times = []\n    for _ in range(N):\n        t0 = time.perf_counter()\n        func(A)\n        t1 = time.perf_counter()\n        times.append(t1 - t0)\n    median = np.median(times)\n    print(f\"  {name}: median={median*1e6:.3f} us\")\n    return median\n\nA = np.random.normal(size=(10, 10)).astype(np.float64)\nprint(\"=== 10x10 ===\")\nref_t = benchmark(\"ref\", ref_solution, A, N=1000)\nscipy_t = benchmark(\"scipy\", scipy_solution, A, N=1000)\nscipy_ev_t = benchmark(\"scipy_ev\", scipy_eigvals_vec, A, N=1000)\nscipy_ev2_t = benchmark(\"scipy_ev2\", scipy_eigvals_vec2, A, N=1000)\nprint(f\"  Speedup: scipy={ref_t/scipy_t:.2f}x, scipy_ev={ref_t/scipy_ev_t:.2f}x, scipy_ev2={ref_t/scipy_ev2_t:.2f}x\")\nPYEOF\npython3 /app/bench4.py\n"]
