[237.436163, "i", "cat > /app/eigen_c.c << 'CEOF'\n#include <Python.h>\n#include <numpy/arrayobject.h>\n#include <stdlib.h>\n#include <string.h>\n\n/* LAPACK dgeev: real eigenvalues */\nextern void dgeev_(char *jobvl, char *jobvr, int *n, double *a, int *lda,\n                   double *wr, double *wi, double *vl, int *ldvl,\n                   double *vr, int *ldvr, double *work, int *lwork,\n                   int *info);\n\n/* LAPACK zgeev: complex eigenvalues */\nextern void zgeev_(char *jobvl, char *jobvr, int *n, double *a, int *lda,\n                   double *w, double *vl, int *ldvl,\n                   double *vr, int *ldvr, double *work, int *lwork,\n                   double *rwork, int *info);\n\nstatic PyObject* py_find_dominant_eigenvalue_and_eigenvector(PyObject* self, PyObject* args) {\n    PyObject* py_A;\n    if (!PyArg_ParseTuple(args, \"O\", &py_A)) return NULL;\n    \n    PyArrayObject* A_arr = (PyArrayObject*)py_A;\n    if (PyArray_NDIM(A_arr) != 2) {\n        PyErr_SetString(PyExc_ValueError, \"A must be 2D\");\n        return NULL;"]
[237.436266, "i", "\n    }\n    \n    npy_intp n = PyArray_DIM(A_arr, 0);\n    if (PyArray_DIM(A_arr, 1) != n) {\n        PyErr_SetString(PyExc_ValueError, \"A must be square\");\n        return NULL;\n    }\n    \n    if (PyArray_TYPE(A_arr) != NPY_FLOAT64) {\n        PyErr_SetString(PyExc_ValueError, \"A must be float64\");\n        return NULL;\n    }\n    \n    double* A = (double*)PyArray_DATA(A_arr);\n    \n    /* Allocate workspace */\n    int lwork = 4 * n;\n    double* work = (double*)malloc(lwork * sizeof(double));\n    double* wr = (double*)malloc(n * sizeof(double));\n    double* wi = (double*)malloc(n * sizeof(double));\n    double* vr = (double*)malloc(n * n * sizeof(double));\n    int info;\n    \n    /* Copy A into a working buffer (dgeev may modify it) */\n    double* Awork = (double*)malloc(n * n * sizeof(double));\n    memcpy(Awork, A, n * n * sizeof(double));\n    \n    char jobvl = 'N';\n    char jobvr = 'V';\n    int lda = n;\n    int ldvl = n;\n    int ldvr = n;\n    \n    dgeev_(&jobvl, &jobvr, &n, Awork, &lda, wr, wi, NULL, &ldvl, vr, &ldvr"]
[237.436346, "i", ", work, &lwork, &info);\n    \n    /* Find dominant eigenvalue (largest magnitude) */\n    int idx = 0;\n    double max_mag = 0.0;\n    for (int i = 0; i < n; i++) {\n        double mag;\n        if (wi[i] == 0.0) {\n            mag = (wr[i] < 0) ? -wr[i] : wr[i];\n        } else {\n            mag = sqrt(wr[i]*wr[i] + wi[i]*wi[i]);\n        }\n        if (mag > max_mag) {\n            max_mag = mag;\n            idx = i;\n        }\n    }\n    \n    /* Build complex eigenvalue */\n    double ev_real = wr[idx];\n    double ev_imag = wi[idx];\n    \n    /* Build eigenvector column */\n    double* eigvec = (double*)malloc(2 * n * sizeof(double));\n    for (int i = 0; i < n; i++) {\n        eigvec[2*i]   = vr[i + idx * n];\n        eigvec[2*i+1] = (wi[idx] == 0.0) ? 0.0 : vr[i + idx * n];\n    }\n    \n    /* Create numpy arrays for output */\n    npy_intp ev_shape = 1;\n    PyObject* ev_arr = PyArray_SimpleNewFromData(1, &ev_shape, NPY_COMPLEX128, &ev_real);\n    npy_intp vec_shape = n;\n    PyObject* vec_arr = PyArray_SimpleNewFromData(1, &ve"]
[237.436421, "i", "c_shape, NPY_COMPLEX128, eigvec);\n    \n    /* Free memory */\n    free(Awork);\n    free(work);\n    free(wr);\n    free(wi);\n    free(vr);\n    /* Don't free eigvec - it's owned by vec_arr */\n    \n    PyObject* result = Py_BuildValue(\"(OO)\", ev_arr, vec_arr);\n    Py_DECREF(ev_arr);\n    Py_DECREF(vec_arr);\n    return result;\n}\n\nstatic PyMethodDef EigenMethods[] = {\n    {\"find_dominant_eigenvalue_and_eigenvector\", py_find_dominant_eigenvalue_and_eigenvector, METH_VARARGS, \"Find dominant eigenvalue and eigenvector\"},\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef eigenmodule = {\n    PyModuleDef_HEAD_INIT, \"eigen_c\", NULL, -1, EigenMethods\n};\n\nPyMODINIT_FUNC PyInit_eigen_c(void) {\n    import_array();\n    return PyModule_Create(&eigenmodule);\n}\nCEOF\n"]
[237.458627, "o", "cat > /app/eigen_c.c << 'CEOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include <Python.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <numpy/arrayobject.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /* LAPACK dgeev: real eigenvalues */\r\n\u001b[?2004l\r\u001b[?2004h> extern void dgeev_(char *jobvl, char *jobvr, int *n, double *a, int *lda,\r\n\u001b[?2004l\r\u001b[?2004h>                    double *wr, double *wi, double *vl, int *ldvl,\r\n\u001b[?2004l\r\u001b[?2004h>                    double *vr, int *ldvr, double *work, int *lwork,\r\n\u001b[?2004l\r\u001b[?2004h>                    int *info);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /* LAPACK zgeev: complex eigenvalues */\r\n\u001b[?2004l\r\u001b[?2004h> extern void zgeev_(char *jobvl, char *jobvr, int *n, double *a, int *lda,\r\n\u001b[?2004l\r\u001b[?2004h>                    double *w, double *vl, int *ldvl,\r\n\u001b[?2004l\r\u001b[?2004h>                    double *vr, int *ldvr, double *work, int *lwork,\r\n\u001b[?2004l\r\u001b[?2004h>                    double *rwork, int *info);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b"]
