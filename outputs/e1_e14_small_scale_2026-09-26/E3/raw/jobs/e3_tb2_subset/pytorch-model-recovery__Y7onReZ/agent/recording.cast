[55.438035, "o", "\r\n\u001b[?2004l\r"]
[55.438289, "o", "\u001b[?2004h> src_sequences = dataset['src_sequences']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.438502, "o", "tgt_sequences = dataset['tgt_sequences']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.438715, "o", "print(f\"src_sequences shape: {src_sequences.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.438948, "o", "print(f\"tgt_sequences shape: {tgt_sequences.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.43909, "o", "# ---- Create model and load weights ----\r\n\u001b[?2004l\r"]
[55.439104, "o", "\u001b[?2004h> model = RecoveredModel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.439283, "o", "model.load_state_dict(weights)\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r"]
[55.439295, "o", "\u001b[?2004h"]
[55.4393, "o", "> "]
[55.439306, "o", "\r\n\u001b[?2004l\r"]
[55.439573, "o", "\u001b[?2004h> # ---- Compute original MSE ----\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.439756, "o", "    outputs = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r"]
[55.439792, "o", "\u001b[?2004h> "]
[55.4401, "o", "    original_mse = F.mse_loss(outputs, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.440323, "o", "    print(f\"Original MSE: {original_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.44047, "o", "# ---- Tune output_layer to reduce MSE ----\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.440686, "o", "# Freeze all layers except output_layer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.440849, "o", "for name, param in model.named_parameters():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.441066, "o", "    if not name.startswith('output_layer'):\r\n\u001b[?2004l\r\u001b[?2004h>         param.requires_grad = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.441131, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.441323, "o", "> "]
[55.441548, "o", "        param.requires_grad = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.441778, "o", "# Use SGD to optimize output_layer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.44193, "o", "optimizer = torch.optim.SGD(model.parameters(), lr=0.01, momentum=0.9)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.442148, "o", "for epoch in range(500):\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.442163, "o", "> "]
[55.442424, "o", "    outputs = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.442643, "o", "    loss = F.mse_loss(outputs, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.442803, "o", "    optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.442948, "o", "    if epoch % 50 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.443162, "o", "        print(f\"Epoch {epoch}, Loss: {loss.item():.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.44331, "o", "# ---- Compute final MSE ----\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.443324, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[55.443509, "o", "\u001b[?2004h> "]
[55.443522, "o", "    outputs = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r"]
[55.443785, "o", "\u001b[?2004h>     final_mse = F.mse_loss(outputs, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.444007, "o", "    print(f\"Final MSE: {final_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.444227, "o", "    print(f\"MSE reduced: {final_mse < original_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.444444, "o", "# ---- Save as TorchScript ----\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.444663, "o", "traced = torch.jit.script(model)\r\n\u001b[?2004l\r\u001b[?2004h> traced.save('/app/model.pt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.444823, "o", "print(\"Model saved to /app/model.pt\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.444837, "o", "> "]
[55.445022, "o", "# ---- Verify ----\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.445236, "o", "loaded = torch.jit.load('/app/model.pt')\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.445423, "o", "    loaded_outputs = loaded(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r"]
[55.445439, "o", "\u001b[?2004h"]
[55.44571, "o", ">     loaded_mse = F.mse_loss(loaded_outputs, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.445865, "o", "    print(f\"Loaded model MSE: {loaded_mse}\")\r\n\u001b[?2004l\r"]
[55.445879, "o", "\u001b[?2004h"]
[55.445887, "o", "> "]
[55.445893, "o", "\r\n\u001b[?2004l\r"]
[55.446237, "o", "\u001b[?2004h> # Check state dict keys match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.446382, "o", "print(\"\\nState dict keys match:\", set(weights.keys()) == set(loaded.state_dict().keys()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.446597, "o", "PYEOF\r\n\u001b[?2004l\r"]
[55.44837, "o", "\u001b[?2004h"]
[55.448386, "o", "root@modal:/app# "]
