[18.761347, "o", "dataset = torch.load('/app/dataset.pt', map_location='cpu')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.761567, "o", "src_sequences = dataset['src_sequences']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.761797, "o", "tgt_sequences = dataset['tgt_sequences']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.762026, "o", "print(f\"src_sequences shape: {src_sequences.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.762302, "o", "print(f\"tgt_sequences shape: {tgt_sequences.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ---- Create model and load weights ----\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.76246, "o", "model = RecoveredModel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.762618, "o", "model.load_state_dict(weights)\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.762633, "o", "\r\n\u001b[?2004l\r"]
[18.762907, "o", "\u001b[?2004h> # ---- Compute original MSE ----\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.763108, "o", "    outputs = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r"]
[18.763175, "o", "\u001b[?2004h> "]
[18.763414, "o", "    original_mse = F.mse_loss(outputs, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.76363, "o", "    print(f\"Original MSE: {original_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.763793, "o", "# ---- Tune output_layer to reduce MSE ----\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.764012, "o", "# Freeze all layers except output_layer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.76423, "o", "for name, param in model.named_parameters():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.764245, "o", "    if not name.startswith('output_layer'):\r\n\u001b[?2004l\r"]
[18.764503, "o", "\u001b[?2004h>         param.requires_grad = False\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.764721, "o", "        param.requires_grad = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.764955, "o", "# Use SGD to optimize output_layer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.76517, "o", "optimizer = torch.optim.SGD(model.parameters(), lr=0.01, momentum=0.9)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.765186, "o", "for epoch in range(500):\r\n\u001b[?2004l\r"]
[18.765375, "o", "\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.765595, "o", "    outputs = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.765777, "o", "    loss = F.mse_loss(outputs, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.765979, "o", "    loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.step()\r\n\u001b[?2004l\r"]
