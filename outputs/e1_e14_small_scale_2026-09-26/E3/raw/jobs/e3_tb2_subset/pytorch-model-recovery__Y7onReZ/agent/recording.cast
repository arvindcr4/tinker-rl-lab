[55.427939, "i", "cat > /app/solve.py << 'PYEOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n# ---- Model Definition ----\nclass PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000):\n        super().__init__()\n        pe = torch.zeros(1, max_len, d_model)\n        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-torch.log(torch.tensor(10000.0)) / d_model))\n        pe[0, :, 0::2] = torch.sin(position * div_term)\n        pe[0, :, 1::2] = torch.cos(position * div_term)\n        self.register_buffer('pe', pe)\n\n    def forward(self, x):\n        return x + self.pe[:, :x.size(1), :]\n\nclass RecoveredModel(nn.Module):\n    def __init__(self, input_dim=64, d_model=128, nhead=1, dim_feedforward=256,\n                 num_encoder_layers=3, num_decoder_layers=1, max_len=5000):\n        super().__init__()\n        self.embedding = nn.Linear(input_dim, d_model)\n        self.pos_encoder = PositionalEncoding(d_model,"]
[55.427997, "i", " max_len)\n        \n        encoder_layer = nn.TransformerEncoderLayer(\n            d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,\n            batch_first=True\n        )\n        self.transformer_encoder = nn.TransformerEncoder(encoder_layer, num_layers=num_encoder_layers)\n        \n        decoder_layer = nn.TransformerDecoderLayer(\n            d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,\n            batch_first=True\n        )\n        self.transformer_decoder = nn.TransformerDecoder(decoder_layer, num_layers=num_decoder_layers)\n        \n        self.output_layer = nn.Linear(d_model, input_dim)\n        \n        self.d_model = d_model\n        self.nhead = nhead\n\n    def forward(self, src, tgt):\n        src = self.embedding(src)\n        src = self.pos_encoder(src)\n        \n        tgt = self.embedding(tgt)\n        tgt = self.pos_encoder(tgt)\n        \n        memory = self.transformer_encoder(src)\n        output = self.transformer_decoder(tgt, memory)\n        output = self.output_l"]
[55.428021, "i", "ayer(output)\n        return output\n\n# ---- Load weights and dataset ----\nweights = torch.load('/app/weights.pt', map_location='cpu')\ndataset = torch.load('/app/dataset.pt', map_location='cpu')\n\nsrc_sequences = dataset['src_sequences']\ntgt_sequences = dataset['tgt_sequences']\n\nprint(f\"src_sequences shape: {src_sequences.shape}\")\nprint(f\"tgt_sequences shape: {tgt_sequences.shape}\")\n\n# ---- Create model and load weights ----\nmodel = RecoveredModel()\nmodel.load_state_dict(weights)\nmodel.eval()\n\n# ---- Compute original MSE ----\nwith torch.no_grad():\n    outputs = model(src_sequences, tgt_sequences)\n    original_mse = F.mse_loss(outputs, tgt_sequences).item()\n    print(f\"Original MSE: {original_mse}\")\n\n# ---- Tune output_layer to reduce MSE ----\n# Freeze all layers except output_layer\nfor name, param in model.named_parameters():\n    if not name.startswith('output_layer'):\n        param.requires_grad = False\n    else:\n        param.requires_grad = True\n\n# Use SGD to optimize output_layer\noptimizer = torch.optim.SGD("]
[55.428048, "i", "model.parameters(), lr=0.01, momentum=0.9)\n\nfor epoch in range(500):\n    optimizer.zero_grad()\n    outputs = model(src_sequences, tgt_sequences)\n    loss = F.mse_loss(outputs, tgt_sequences)\n    loss.backward()\n    optimizer.step()\n    if epoch % 50 == 0:\n        print(f\"Epoch {epoch}, Loss: {loss.item():.6f}\")\n\n# ---- Compute final MSE ----\nwith torch.no_grad():\n    outputs = model(src_sequences, tgt_sequences)\n    final_mse = F.mse_loss(outputs, tgt_sequences).item()\n    print(f\"Final MSE: {final_mse}\")\n    print(f\"MSE reduced: {final_mse < original_mse}\")\n\n# ---- Save as TorchScript ----\nmodel.eval()\ntraced = torch.jit.script(model)\ntraced.save('/app/model.pt')\nprint(\"Model saved to /app/model.pt\")\n\n# ---- Verify ----\nloaded = torch.jit.load('/app/model.pt')\nwith torch.no_grad():\n    loaded_outputs = loaded(src_sequences, tgt_sequences)\n    loaded_mse = F.mse_loss(loaded_outputs, tgt_sequences).item()\n    print(f\"Loaded model MSE: {loaded_mse}\")\n\n# Check state dict keys match\nprint(\"\\nState dict keys match"]
