[18.767203, "o", "    final_mse = F.mse_loss(outputs, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.767426, "o", "    print(f\"Final MSE: {final_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.767699, "o", "    print(f\"MSE reduced: {final_mse < original_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
