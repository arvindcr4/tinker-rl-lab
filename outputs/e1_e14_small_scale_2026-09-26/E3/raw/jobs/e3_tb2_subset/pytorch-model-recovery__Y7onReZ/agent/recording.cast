[18.766486, "o", "        print(f\"Epoch {epoch}, Loss: {loss.item():.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ---- Compute final MSE ----\r\n\u001b[?2004l\r"]
