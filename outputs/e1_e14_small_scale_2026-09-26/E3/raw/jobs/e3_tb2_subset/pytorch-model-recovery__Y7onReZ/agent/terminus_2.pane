[?2004l[?2004h> 
[?2004l[?2004h> # Use SGD to optimize output_layer
[?2004l[?2004h> optimizer = torch.optim.SGD(model.parameters(), lr=0.01, momentum=0.9)
[?2004l[?2004h> 
[?2004l[?2004h> for epoch in range(500):
[?2004l[?2004h>     optimizer.zero_grad()
