[68.858179, "o", "\u001b[?2004hroot@modal:/app# "]
[73.337494, "i", "diff /tmp/original_output.txt /tmp/optimized_output.txt\n"]
[73.338178, "o", "diff /tmp/original_output.txt /tmp/optimized_output.txt\r\n\u001b[?2004l\r"]
