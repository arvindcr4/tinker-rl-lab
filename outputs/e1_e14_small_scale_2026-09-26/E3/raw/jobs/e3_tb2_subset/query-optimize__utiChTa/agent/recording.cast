[33.743595, "i", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_synsets_domainid ON synsets(domainid);\"\n"]
[33.745537, "o", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_synsets_domainid ON synsets(domainid);\"\r\n\u001b[?2004l\r"]
