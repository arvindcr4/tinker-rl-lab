[67.349365, "o", "  FROM words w\r\n\u001b[?2004l\r\u001b[?2004h>   JOIN senses s ON w.wordid = s.wordid\r\n\u001b[?2004l\r\u001b[?2004h>   JOIN synsets syn ON s.synsetid = syn.synsetid\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY w.wordid, w.word\r\n\u001b[?2004l\r\u001b[?2004h>   HAVING total_synsets >= 2\r\n\u001b[?2004l\r\u001b[?2004h>     AND distinct_domains >= 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
