[32.738776, "i", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_senses_wordid_synsetid ON senses(wordid, synsetid);\"\n"]
[32.740865, "o", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_senses_wordid_synsetid ON senses(wordid, synsetid);\"\r\n\u001b[?2004l\r"]
