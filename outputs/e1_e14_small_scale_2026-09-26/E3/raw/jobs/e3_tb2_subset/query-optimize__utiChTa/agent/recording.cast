[31.753547, "i", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_senses_synsetid ON senses(synsetid);\"\n"]
[31.756427, "o", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_senses_synsetid ON senses(synsetid);\"\r\n\u001b[?2004l\r"]
[31.826952, "o", "\u001b[?2004h"]
