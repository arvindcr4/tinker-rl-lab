[34.805729, "i", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_synsets_posid ON synsets(posid);\"\n"]
[34.807493, "o", "sqlite3 /app/oewn.sqlite \"CREATE INDEX IF NOT EXISTS idx_synsets_posid ON synsets(posid);\"\r\n\u001b[?2004l\r"]
