[331.436111, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nimport json\n\ntokenizer = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\n\n# Filter science domain\nscience_domains = ['physics', 'chemistry', 'biology']\nscience_entries = [e for e in ds_meta['train'] if e['domain'] in science_domains]\n\n# Try different tokenization approaches\n# Approach 1: deepseek_reasoning + deepseek_solution only\n# Approach 2: problem + deepseek_reasoning + deepseek_solution\n# Approach 3: deepseek_reasoning + deepseek_solution with special tokens\n\n# Let's check what the default config conversations look like for science entries\n# First, let's see if we can match entries between configs\nds_default = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'default')\n\n# Check if any default entry's user message matches a science problem\nscience_problems = set(e['problem'] for e in science_entries)\nprint(f\"Science problems: {len(s"]
[331.436388, "i", "cience_problems)}\")\n\n# Check default config for science-like content\nfor i, entry in enumerate(ds_default['train'][:5]):\n    user_msg = entry['conversations'][0]['value']\n    # Check if this user message starts with a science problem\n    is_science = any(user_msg.startswith(p[:50]) for p in science_problems)\n    print(f\"Default[{i}] user starts with: {user_msg[:100]}\")\n    print(f\"  Is science: {is_science}\")\nEOF\n"]
