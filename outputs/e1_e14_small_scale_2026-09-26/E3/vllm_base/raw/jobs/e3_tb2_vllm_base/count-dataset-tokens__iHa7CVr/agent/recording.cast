[211.262866, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nimport json\n\n# Load the metadata config\nds = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\n\n# Filter for science domain (physics, chemistry, biology)\nscience_domains = ['physics', 'chemistry', 'biology']\nscience_indices = [i for i, d in enumerate(ds['train']['domain']) if d in science_domains]\nprint(f\"Science domain entries: {len(science_indices)}\")\nprint(f\"Domains: {[ds['train']['domain'][i] for i in science_indices]}\")\n\n# Show first science example\nfor idx in science_indices[:2]:\n    print(f\"\\n--- Science Example {idx} ---\")\n    print(f\"Domain: {ds['train'][idx]['domain']}\")\n    print(f\"Problem: {ds['train'][idx]['problem'][:200]}\")\n    print(f\"Deepseek reasoning: {ds['train'][idx]['deepseek_reasoning'][:200]}\")\n    print(f\"Deepseek solution: {ds['train'][idx]['deepseek_solution'][:200]}\")\nEOF\n"]
