[609.201121, "i", "python3 << 'PYEOF'\nfrom datasets import load_dataset\nimport os\n\n# Check if there's a README in the dataset\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\nprint(\"Dataset info:\")\nprint(ds_meta)\nprint(\"\\nDataset card info:\")\ntry:\n    from huggingface_hub import HfApi\n    api = HfApi()\n    info = api.dataset_info('ryanmarten/OpenThoughts-1k-sample')\n    print(\"Has README:\", hasattr(info, 'card_data') and info.card_data is not None)\n    if hasattr(info, 'card_data') and info.card_data:\n        print(\"Card data:\", info.card_data)\nexcept Exception as e:\n    print(f\"Error: {e}\")\nPYEOF\n"]
