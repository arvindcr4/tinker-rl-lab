[640.899535, "i", "python3 << 'PYEOF'\nfrom datasets import load_dataset_builder\nimport os\n\n# Try to get README through dataset builder\ndb = load_dataset_builder('ryanmarten/OpenThoughts-1k-sample', 'metadata')\nprint(\"Builder info:\", db)\nprint(\"Builder config:\", db.config)\n\n# Check if there's a README in the builder\nif hasattr(db, 'info') and db.info:\n    print(\"\\nInfo:\", db.info)\n    if hasattr(db.info, 'citation'):\n        print(\"Citation:\", db.info.citation)\n    if hasattr(db.info, 'description'):\n        print(\"Description:\", db.info.description)\n\n# Try to find README in cache\nimport huggingface_hub\nfrom huggingface_hub import HfApi\napi = HfApi()\ntry:\n    files = api.list_repo_files('ryanmarten/OpenThoughts-1k-sample', repo_type='dataset')\n    print(\"\\nRepo files:\", files)\nexcept Exception as e:\n    print(f\"Error listing files: {e}\")\nPYEOF\n"]
