[587.62328, "i", "python3 << 'PYEOF'\nfrom datasets import load_dataset\nfrom collections import Counter\n\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\nprint(\"Columns:\", ds_meta['train'].column_names)\nprint(\"Num examples:\", len(ds_meta['train']))\nprint(\"First entry keys:\", list(ds_meta['train'][0].keys()))\n\ndomains = ds_meta['train']['domain']\nprint(\"\\nDomain distribution:\")\nprint(Counter(domains))\n\nscience_domains = ['physics', 'chemistry', 'biology']\nscience_entries = [e for e in ds_meta['train'] if e['domain'] in science_domains]\nprint(f\"\\nScience entries: {len(science_entries)}\")\nprint(f\"Science domains: {Counter(e['domain'] for e in science_entries)}\")\nPYEOF\n"]
