[421.526923, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nimport json\n\ntokenizer = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\n\n# Filter science domain\nscience_domains = ['physics', 'chemistry', 'biology']\nscience_entries = [e for e in ds_meta['train'] if e['domain'] in science_domains]\n\n# Let's look at the full content of a science entry to understand the structure\nfor entry in science_entries[:2]:\n    print(f\"\\n=== Domain: {entry['domain']} ===\")\n    print(f\"Problem: {entry['problem']}\")\n    print(f\"\\nDeepseek reasoning (first 500 chars):\")\n    print(entry['deepseek_reasoning'][:500])\n    print(f\"\\nDeepseek solution (first 500 chars):\")\n    print(entry['deepseek_solution'][:500])\n    print(f\"\\nGround truth solution (first 200 chars):\")\n    print(entry['ground_truth_solution'][:200])\nEOF\n"]
