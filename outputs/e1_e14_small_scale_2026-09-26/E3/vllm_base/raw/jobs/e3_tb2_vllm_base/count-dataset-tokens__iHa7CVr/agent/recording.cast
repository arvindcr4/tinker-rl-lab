[357.700639, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\n\n# Filter science domain\nscience_domains = ['physics', 'chemistry', 'biology']\nscience_entries = [e for e in ds_meta['train'] if e['domain'] in science_domains]\nprint(f\"Science entries: {len(science_entries)}\")\n\n# Approach 1: deepseek_reasoning + deepseek_solution (no special tokens)\ntotal_tokens = 0\nfor entry in science_entries:\n    r_tokens = tokenizer.encode(entry['deepseek_reasoning'], add_special_tokens=False)\n    s_tokens = tokenizer.encode(entry['deepseek_solution'], add_special_tokens=False)\n    total_tokens += len(r_tokens) + len(s_tokens)\nprint(f\"Approach 1 (reasoning + solution, no special tokens): {total_tokens}\")\n\n# Approach 2: deepseek_reasoning + deepseek_solution (with special tokens)\ntotal_tokens2 = 0\nfor entry in science_entries:\n    r_tokens = tokenizer.encode"]
[357.700859, "i", "(entry['deepseek_reasoning'], add_special_tokens=True)\n    s_tokens = tokenizer.encode(entry['deepseek_solution'], add_special_tokens=True)\n    total_tokens2 += len(r_tokens) + len(s_tokens)\nprint(f\"Approach 2 (reasoning + solution, with special tokens): {total_tokens2}\")\n\n# Approach 3: problem + deepseek_reasoning + deepseek_solution\ntotal_tokens3 = 0\nfor entry in science_entries:\n    p_tokens = tokenizer.encode(entry['problem'], add_special_tokens=False)\n    r_tokens = tokenizer.encode(entry['deepseek_reasoning'], add_special_tokens=False)\n    s_tokens = tokenizer.encode(entry['deepseek_solution'], add_special_tokens=False)\n    total_tokens3 += len(p_tokens) + len(r_tokens) + len(s_tokens)\nprint(f\"Approach 3 (problem + reasoning + solution, no special tokens): {total_tokens3}\")\n\n# Approach 4: just deepseek_reasoning\ntotal_tokens4 = 0\nfor entry in science_entries:\n    r_tokens = tokenizer.encode(entry['deepseek_reasoning'], add_special_tokens=False)\n    total_tokens4 += len(r_tokens)\nprint(f\"Approach 4 (just"]
[357.701049, "i", " reasoning, no special tokens): {total_tokens4}\")\n\n# Approach 5: just deepseek_solution\ntotal_tokens5 = 0\nfor entry in science_entries:\n    s_tokens = tokenizer.encode(entry['deepseek_solution'], add_special_tokens=False)\n    total_tokens5 += len(s_tokens)\nprint(f\"Approach 5 (just solution, no special tokens): {total_tokens5}\")\nEOF\n"]
