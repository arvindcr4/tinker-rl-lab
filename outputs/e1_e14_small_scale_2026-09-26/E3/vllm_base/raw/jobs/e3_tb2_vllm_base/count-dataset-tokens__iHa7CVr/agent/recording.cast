[493.786359, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nimport json\n\ntokenizer = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\n\n# Filter science domain\nscience_domains = ['physics', 'chemistry', 'biology']\nscience_entries = [e for e in ds_meta['train'] if e['domain'] in science_domains]\n\n# Let's look at the full deepseek_reasoning and deepseek_solution for all science entries\n# and also check if there's a specific format\n\n# Check if deepseek_reasoning contains <|begin_of_thought|> markers\nfor entry in science_entries[:3]:\n    print(f\"\\n=== {entry['domain']} ===\")\n    print(f\"Reasoning starts with: {entry['deepseek_reasoning'][:100]}\")\n    print(f\"Has thought markers: {'<|begin_of_thought|>' in entry['deepseek_reasoning']}\")\n    print(f\"Has solution markers: {'<|begin_of_solution|>' in entry['deepseek_solution']}\")\n    print(f\"Reasoning ends with: {entry['deepseek_reasoning'][-50:]}\")\n    pri"]
[493.786603, "i", "nt(f\"Solution starts with: {entry['deepseek_solution'][:100]}\")\nEOF\n"]
