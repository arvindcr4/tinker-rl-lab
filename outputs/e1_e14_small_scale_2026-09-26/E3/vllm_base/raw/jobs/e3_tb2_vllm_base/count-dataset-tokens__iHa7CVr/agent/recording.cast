[186.095257, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nimport json\n\n# Load the metadata config\nds = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\nprint(\"Columns:\", ds['train'].column_names)\nprint(\"Num examples:\", len(ds['train']))\n\n# Check first example\nprint(\"\\nFirst example:\")\nfor k, v in ds['train'][0].items():\n    if isinstance(v, str) and len(v) < 500:\n        print(f\"  {k}: {v}\")\n    elif isinstance(v, str):\n        print(f\"  {k}: {v[:200]}...\")\n    else:\n        print(f\"  {k}: {v}\")\n\n# Check domains\nprint(\"\\nDomains:\")\ndomains = ds['train']['domain']\nfrom collections import Counter\nprint(Counter(domains))\nEOF\n"]
