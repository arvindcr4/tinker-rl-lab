[382.714866, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nimport json\n\ntokenizer = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\nds_default = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'default')\n\n# Try to match entries between configs by checking if the user message in default\n# contains the problem from metadata\nscience_entries = [e for e in ds_meta['train'] if e['domain'] in ['physics', 'chemistry', 'biology']]\n\n# For each science entry, find matching entry in default config\nmatched = 0\nfor se in science_entries:\n    problem = se['problem']\n    for de in ds_default['train']:\n        user_msg = de['conversations'][0]['value']\n        if problem in user_msg:\n            matched += 1\n            # Check the assistant response\n            assistant_msg = de['conversations'][1]['value']\n            # Check if it contains deepseek reasoning markers\n            has_thought = '<|begin_of_tho"]
[382.715164, "i", "ught|>' in assistant_msg\n            has_solution = '<|begin_of_solution|>' in assistant_msg\n            print(f\"Matched! has_thought={has_thought}, has_solution={has_solution}\")\n            print(f\"  Problem: {problem[:80]}\")\n            print(f\"  User msg: {user_msg[:80]}\")\n            print(f\"  Assistant: {assistant_msg[:80]}\")\n            break\n    if matched >= 3:\n        break\n\nprint(f\"\\nTotal matched: {matched}\")\nEOF\n"]
[382.715338, "o", "python3 << 'EOF'\r\n"]
