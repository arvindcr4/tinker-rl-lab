[259.929868, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nimport json\n\n# Load both configs\nds_default = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'default')\nds_meta = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata')\n\n# Check if they have the same ordering by comparing first few\nprint(\"Default first conversation:\")\nprint(json.dumps(ds_default['train'][0]['conversations'], indent=2)[:500])\n\nprint(\"\\nMetadata first entry:\")\nprint(f\"Problem: {ds_meta['train'][0]['problem'][:200]}\")\nprint(f\"Deepseek reasoning: {ds_meta['train'][0]['deepseek_reasoning'][:200]}\")\nprint(f\"Deepseek solution: {ds_meta['train'][0]['deepseek_solution'][:200]}\")\n\n# Check if the user message in default matches the problem in metadata\nprint(\"\\nDefault user message:\")\nprint(ds_default['train'][0]['conversations'][0]['value'][:200])\nEOF\n"]
