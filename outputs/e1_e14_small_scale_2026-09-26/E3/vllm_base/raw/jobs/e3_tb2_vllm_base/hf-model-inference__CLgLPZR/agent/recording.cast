[204.262907, "o", "    data = request.get_json()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.263051, "o", "    if data is None or 'text' not in data:\r\n\u001b[?2004l\r"]
[204.263285, "o", "\u001b[?2004h> "]
[204.263501, "o", "        return jsonify({\"error\": \"Missing 'text' field in request body\"}), 400\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.263729, "o", "    text = data['text']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.263952, "o", "    if not isinstance(text, str) or len(text.strip()) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.264113, "o", "        return jsonify({\"error\": \"Text must be a non-empty string\"}), 400\r\n\u001b[?2004l\r"]
[204.264128, "o", "\u001b[?2004h"]
[204.264173, "o", "> \r\n\u001b[?2004l\r"]
[204.264185, "o", "\u001b[?2004h"]
[204.264538, "o", ">     inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.264553, "o", "\r\n\u001b[?2004l\r"]
[204.264562, "o", "\u001b[?2004h"]
[204.264896, "o", ">     with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>         outputs = model(**inputs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.265169, "o", "        probabilities = torch.softmax(outputs.logits, dim=-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.265427, "o", "        scores = probabilities.squeeze().tolist()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[204.265442, "o", "> "]
[204.265712, "o", "    # SST-2: label 0 = negative, label 1 = positive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.265862, "o", "    negative_score = scores[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.266087, "o", "    positive_score = scores[1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.266373, "o", "    sentiment = 'positive' if positive_score > negative_score else 'negative'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[204.266389, "o", "> "]
[204.266654, "o", "    return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         'sentiment': sentiment,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.266875, "o", "        'confidence': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.267166, "o", "            'positive': positive_score,\r\n\u001b[?2004l\r\u001b[?2004h>             'negative': negative_score"]
[204.267215, "o", "\r\n\u001b[?2004l\r"]
[204.267494, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[204.267514, "o", "> "]
[204.267787, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     app.run(host='0.0.0.0', port=5000)\r\n\u001b[?2004l\r"]
