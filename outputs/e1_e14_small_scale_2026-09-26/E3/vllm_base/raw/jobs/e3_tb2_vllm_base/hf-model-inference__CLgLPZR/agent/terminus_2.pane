[?2004l[?2004h> model.eval()
[?2004l[?2004h> 
[?2004l[?2004h> @app.route('/sentiment', methods=['POST'])
[?2004l[?2004h> def sentiment():
[?2004l[?2004h>     if not request.is_json:
[?2004l[?2004h>         return jsonify({"error": "Request must be JSON"}), 400
[?2004l[?2004h> 
[?2004l[?2004h>     data = request.get_json()
[?2004l[?2004h>     if data is None or 'text' not in data:
[?2004l[?2004h>         return jsonify({"error": "Missing 'text' field in request body"}), 400
[?2004l[?2004h> 
[?2004l[?2004h>     text = data['text']
[?2004l[?2004h>     if not isinstance(text, str) or len(text.strip()) == 0:
[?2004l[?2004h>         return jsonify({"error": "Text must be a non-empty string"}), 400
[?2004l[?2004h> 
[?2004l[?2004h>     inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
[?2004l[?2004h> 
[?2004l[?2004h>     with torch.no_grad():
[?2004l[?2004h>         outputs = model(**inputs)
[?2004l[?2004h>         probabilities = torch.softmax(outputs.logits, dim=-1)
[?2004l[?2004h>         scores = probabilities.squeeze().tolist()
[?2004l[?2004h> 
[?2004l[?2004h>     # SST-2: label 0 = negative, label 1 = positive
[?2004l[?2004h>     negative_score = scores[0]
[?2004l[?2004h>     positive_score = scores[1]
[?2004l[?2004h> 
[?2004l[?2004h>     sentiment = 'positive' if positive_score > negative_score else 'negative'
[?2004l[?2004h> 
[?2004l[?2004h>     return jsonify({
[?2004l[?2004h>         'sentiment': sentiment,
[?2004l[?2004h>         'confidence': {
