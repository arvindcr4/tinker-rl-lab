[116.444124, "o", "\u001b[?2004h"]
[116.444278, "o", "> "]
[116.445258, "o", "    Uses power iteration for speed on small matrices.\r\n\u001b[?2004l\r"]
[116.445494, "o", "\u001b[?2004h"]
[116.445613, "o", "> "]
[116.445913, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[116.446115, "o", "\u001b[?2004h"]
[116.446268, "o", "> "]
[116.446829, "o", "    n = A.shape[0]\r\n\u001b[?2004l\r"]
[116.447008, "o", "\u001b[?2004h"]
[116.447153, "o", "> "]
[116.447323, "o", "    \r\n\u001b[?2004l\r"]
[116.447563, "o", "\u001b[?2004h"]
[116.447702, "o", "> "]
[116.448708, "o", "    # Power iteration to find dominant eigenvalue and eigenvector\r\n\u001b[?2004l\r"]
[116.44893, "o", "\u001b[?2004h"]
[116.449067, "o", "> "]
[116.449636, "o", "    # Start with a random vector\r\n\u001b[?2004l\r"]
[116.449821, "o", "\u001b[?2004h"]
[116.449972, "o", "> "]
[116.450396, "o", "    np.random.seed(42)\r\n"]
[116.450451, "o", "\u001b[?2004l\r"]
[116.450721, "o", "\u001b[?2004h"]
[116.450845, "o", "> "]
[116.451309, "o", "    b = np.random.randn(n)\r\n\u001b[?2004l\r"]
[116.451514, "o", "\u001b[?2004h"]
[116.451658, "o", "> "]
[116.452207, "o", "    b = b / np.linalg.norm(b)\r\n\u001b[?2004l\r"]
[116.452442, "o", "\u001b[?2004h"]
[116.452519, "o", "> "]
[116.452729, "o", "    \r\n\u001b[?2004l\r"]
[116.452952, "o", "\u001b[?2004h"]
[116.453112, "o", "> "]
[116.454555, "o", "    # Power iteration - typically converges in 50-100 iterations for well-separated eigenvalues\r\n\u001b[?2004l\r"]
[116.454777, "o", "\u001b[?2004h"]
[116.454912, "o", "> "]
[116.456145, "o", "    # For small matrices, we can afford more iterations to ensure convergence\r\n\u001b[?2004l\r"]
[116.456322, "o", "\u001b[?2004h"]
[116.456515, "o", "> "]
[116.456971, "o", "    eigenvalue = 0.0\r\n\u001b[?2004l\r"]
[116.45712, "o", "\u001b[?2004h"]
[116.457301, "o", "> "]
[116.45783, "o", "    for _ in range(200):\r\n\u001b[?2004l\r"]
[116.458036, "o", "\u001b[?2004h"]
[116.458193, "o", "> "]
[116.458749, "o", "        # Matrix-vector multiply\r\n\u001b[?2004l\r"]
[116.458913, "o", "\u001b[?2004h"]
[116.459027, "o", "> "]
[116.459493, "o", "        b_new = A @ b\r\n\u001b[?2004l\r"]
[116.459593, "o", "\u001b[?2004h"]
[116.459776, "o", "> "]
[116.460579, "o", "        eigenvalue_new = np.dot(b, b_new)\r\n"]
[116.46064, "o", "\u001b[?2004l\r"]
[116.460859, "o", "\u001b[?2004h"]
[116.460938, "o", "> "]
[116.461702, "o", "        norm = np.linalg.norm(b_new)\r\n\u001b[?2004l\r"]
[116.461911, "o", "\u001b[?2004h"]
[116.462035, "o", "> "]
[116.462527, "o", "        if norm == 0:\r\n\u001b[?2004l\r"]
[116.462737, "o", "\u001b[?2004h"]
[116.462905, "o", "> "]
[116.463247, "o", "            break\r\n\u001b[?2004l\r"]
[116.463485, "o", "\u001b[?2004h"]
[116.463591, "o", "> "]
[116.464052, "o", "        b = b_new / norm\r\n\u001b[?2004l\r"]
[116.464241, "o", "\u001b[?2004h> "]
[116.465046, "o", "        if abs(eigenvalue_new - eigenvalue) < 1e-14:\r\n\u001b[?2004l\r"]
[116.465259, "o", "\u001b[?2004h"]
[116.465409, "o", "> "]
[116.465806, "o", "            break\r\n\u001b[?2004l\r"]
[116.466001, "o", "\u001b[?2004h"]
[116.466151, "o", "> "]
[116.466811, "o", "        eigenvalue = eigenvalue_new\r\n\u001b[?2004l\r"]
[116.467037, "o", "\u001b[?2004h"]
[116.467182, "o", "> "]
[116.467342, "o", "    \r\n\u001b[?2004l\r"]
[116.467493, "o", "\u001b[?2004h"]
[116.467608, "o", "> "]
[116.468207, "o", "    # Use Rayleigh quotient for more accurate eigenvalue\r\n"]
[116.468282, "o", "\u001b[?2004l\r"]
[116.468512, "o", "\u001b[?2004h"]
[116.46865, "o", "> "]
[116.468975, "o", "    Ab = A @ b\r\n"]
[116.46904, "o", "\u001b[?2004l\r"]
[116.469236, "o", "\u001b[?2004h"]
[116.469467, "o", "> "]
[116.470103, "o", "    eigenvalue = np.dot(b, Ab) / np.dot(b, b)\r\n\u001b[?2004l\r"]
[116.470283, "o", "\u001b[?2004h"]
[116.470513, "o", "> "]
[116.47066, "o", "    \r\n\u001b[?2004l\r"]
[116.470867, "o", "\u001b[?2004h"]
[116.471058, "o", "> "]
[116.47151, "o", "    return eigenvalue, b\r\n\u001b[?2004l\r"]
[116.471729, "o", "\u001b[?2004h"]
[116.471893, "o", "> "]
[116.472073, "o", "PYEOF\r\n\u001b[?2004l\r"]
[116.479271, "o", "\u001b[?2004h"]
[116.479556, "o", "root@modal:/app# "]
[117.254552, "i", "python3 -c \"\nimport numpy as np\nfrom eigen import find_dominant_eigenvalue_and_eigenvector\n\n# Test correctness\nfor size in [2, 4, 6, 8, 10]:\n    A = np.random.normal(size=(size, size)).astype(np.float64)\n    eigenval, eigenvec = find_dominant_eigenvalue_and_eigenvector(A)\n    residual = np.linalg.norm(A @ eigenvec - eigenval * eigenvec)\n    print(f'{size}x{size}: residual={residual:.2e}, eigenval={eigenval}')\n\"\n"]
