[132.299286, "i", "python3 -c \"\nimport numpy as np\nimport time\n\n# Test: eigvals + inverse iteration\nA = np.random.normal(size=(10,10)).astype(np.float64)\nN = 1000\n\n# eigvals approach\nt0 = time.perf_counter()\nfor _ in range(N):\n    ev = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(ev))\n    lam = ev[idx]\n    # inverse iteration\n    b = np.random.randn(10)\n    b = b / np.linalg.norm(b)\n    for _ in range(50):\n        b = np.linalg.solve(A - lam * np.eye(10), b)\n        b = b / np.linalg.norm(b)\n    residual = np.linalg.norm(A @ b - lam * b)\nt1 = time.perf_counter()\nprint(f'eigvals + inv_iter: {(t1-t0)/N*1e6:.2f} us, residual={residual:.2e}')\n\n# Full eig\nt0 = time.perf_counter()\nfor _ in range(N):\n    ev, evec = np.linalg.eig(A)\n    idx = np.argmax(np.abs(ev))\nt1 = time.perf_counter()\nprint(f'full eig: {(t1-t0)/N*1e6:.2f} us')\n\"\n"]
