[99.492244, "i", "python3 -c \"\nimport numpy as np\nimport time\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Test eigvals vs eig\nN = 1000\nt0 = time.perf_counter()\nfor _ in range(N):\n    ev = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(ev))\nt1 = time.perf_counter()\nprint(f'eigvals only: {(t1-t0)/N*1e6:.2f} us')\n\nt0 = time.perf_counter()\nfor _ in range(N):\n    ev, evec = np.linalg.eig(A)\n    idx = np.argmax(np.abs(ev))\nt1 = time.perf_counter()\nprint(f'eig full: {(t1-t0)/N*1e6:.2f} us')\n\"\n"]
