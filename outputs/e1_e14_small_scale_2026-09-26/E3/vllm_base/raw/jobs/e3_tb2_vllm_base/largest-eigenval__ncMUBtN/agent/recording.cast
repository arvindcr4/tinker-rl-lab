[321.434851, "i", "python3 -c \"\nimport numpy as np\nfrom eigen_cython import find_dominant_eigenvalue_and_eigenvector_cython\n\n# Test correctness\nfor size in [2, 4, 6, 8, 10]:\n    A = np.random.normal(size=(size, size)).astype(np.float64)\n    eigenval, eigenvec = find_dominant_eigenvalue_and_eigenvector_cython(A, size)\n    residual = np.linalg.norm(A @ eigenvec - eigenval * eigenvec)\n    print(f'{size}x{size}: residual={residual:.2e}, eigenval={eigenval}')\n\"\n"]
