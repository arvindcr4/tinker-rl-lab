[520.131919, "i", "cat > /app/eigen_lapack.c << 'EOF'\n#include <Python.h>\n#include <numpy/arrayobject.h>\n#include <stdlib.h>\n#include <math.h>\n\n/* LAPACKE interface - C-style */\nextern int scipy_LAPACKE_dgeev64_(int matrix_layout, char jobvl, char jobvr,\n                                   int n, double *a, int lda,\n                                   double *wreal, double *wimag,\n                                   double *vl, int ldvl,\n                                   double *vr, int ldvr);\n\nstatic PyObject* py_find_dominant(PyObject* self, PyObject* args) {\n    PyObject* py_A;\n    if (!PyArg_ParseTuple(args, \"O\", &py_A)) return NULL;\n    \n    PyArrayObject* arr_A = (PyArrayObject*)py_A;\n    if (PyArray_NDIM(arr_A) != 2) {\n        PyErr_SetString(PyExc_ValueError, \"A must be 2D\");\n        return NULL;\n    }\n    \n    int n = (int)PyArray_DIM(arr_A, 0);\n    if (n != (int)PyArray_DIM(arr_A, 1)) {\n        PyErr_SetString(PyExc_ValueError, \"A must be square\");\n        return NULL;\n    }\n    \n    double* A = (double*)PyArray_DATA(ar"]
[520.132212, "i", "r_A);\n    \n    /* Copy A to a working buffer (dgeev may modify it) */\n    double* a_work = (double*)malloc(n * n * sizeof(double));\n    memcpy(a_work, A, n * n * sizeof(double));\n    \n    /* Allocate workspace */\n    double* wreal = (double*)malloc(n * sizeof(double));\n    double* wimag = (double*)malloc(n * sizeof(double));\n    double* vr = (double*)malloc(n * n * sizeof(double));\n    \n    int lda = n;\n    int ldvl = n;\n    int ldvr = n;\n    \n    /* LAPACKE: 101 = row-major, 102 = column-major */\n    int info = scipy_LAPACKE_dgeev64_(101, 'N', 'V', n, a_work, lda,\n                                       wreal, wimag, NULL, ldvl,\n                                       vr, ldvr);\n    \n    /* Find dominant eigenvalue (largest magnitude) */\n    int idx = 0;\n    double max_mag = 0.0;\n    for (int i = 0; i < n; i++) {\n        double mag = sqrt(wreal[i]*wreal[i] + wimag[i]*wimag[i]);\n        if (mag > max_mag) {\n            max_mag = mag;\n            idx = i;\n        }\n    }\n    \n    /* Build eigenvalue (complex if "]
[520.132492, "i", "wimag[idx] != 0) */\n    double ev_real = wreal[idx];\n    double ev_imag = wimag[idx];\n    \n    /* Build eigenvector - LAPACKE returns row-major, need column-major */\n    double* evec = vr + idx * n;  /* row idx in row-major = column idx in column-major */\n    \n    /* Create numpy arrays for return */\n    PyArrayObject* py_evec;\n    PyObject* py_eigenval;\n    npy_intp dims[1] = {n};\n    \n    if (ev_imag == 0.0) {\n        /* Real eigenvalue */\n        py_eigenval = PyFloat_FromDouble(ev_real);\n        py_evec = (PyArrayObject*)PyArray_SimpleNewFromData(1, dims, NPY_FLOAT64, evec);\n    } else {\n        /* Complex eigenvalue */\n        double* evec_complex = (double*)malloc(2 * n * sizeof(double));\n        for (int i = 0; i < n; i++) {\n            evec_complex[2*i]   = evec[i];\n            evec_complex[2*i+1] = 0.0;\n        }\n        py_eigenval = PyComplex_FromDoubles(ev_real, ev_imag);\n        py_evec = (PyArrayObject*)PyArray_SimpleNewFromData(1, dims, NPY_COMPLEX128, evec_complex);\n    }\n    \n    free(a_work)"]
[520.132587, "i", ";\n    free(wreal);\n    free(wimag);\n    free(vr);\n    \n    return Py_BuildValue(\"NO\", py_eigenval, py_evec);\n}\n\nstatic PyMethodDef methods[] = {\n    {\"find_dominant\", py_find_dominant, METH_VARARGS, \"Find dominant eigenvalue and eigenvector\"},\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef moduledef = {\n    PyModuleDef_HEAD_INIT, \"eigen_lapack\", NULL, -1, methods\n};\n\nPyMODINIT_FUNC PyInit_eigen_lapack(void) {\n    import_array();\n    return PyModule_Create(&moduledef);\n}\nEOF\n"]
