[178.095963, "i", "cat > /app/eigen_cython.pyx << 'EOF'\nimport numpy as np\ncimport numpy as np\nfrom libc.math cimport sqrt, fabs, abs as cabs\n\ndef find_dominant_eigenvalue_and_eigenvector_cython(double[:, :] A, int n):\n    \"\"\"\n    Power iteration to find dominant eigenvalue and eigenvector.\n    Uses real arithmetic - works well for real dominant eigenvalues.\n    \"\"\"\n    cdef double[:] b = np.zeros(n, dtype=np.float64)\n    cdef double[:] b_new = np.zeros(n, dtype=np.float64)\n    cdef double[:] Ab = np.zeros(n, dtype=np.float64)\n    cdef double norm, eigenvalue, eigenvalue_new\n    cdef int i, j, iteration\n    \n    # Initialize with random-ish vector\n    b[0] = 1.0\n    for i in range(1, n):\n        b[i] = (i * 7 + 3) % 100 / 100.0 - 0.5\n    \n    # Normalize\n    norm = 0.0\n    for i in range(n):\n        norm += b[i] * b[i]\n    norm = sqrt(norm)\n    for i in range(n):\n        b[i] /= norm\n    \n    eigenvalue = 0.0\n    \n    for iteration in range(300):\n        # Matrix-vector multiply: b_new = A @ b\n        for i in range(n):\n       "]
[178.096232, "i", "     b_new[i] = 0.0\n            for j in range(n):\n                b_new[i] += A[i, j] * b[j]\n        \n        # Rayleigh quotient\n        eigenvalue_new = 0.0\n        for i in range(n):\n            eigenvalue_new += b[i] * b_new[i]\n        \n        # Normalize\n        norm = 0.0\n        for i in range(n):\n            norm += b_new[i] * b_new[i]\n        norm = sqrt(norm)\n        \n        if norm < 1e-300:\n            break\n        \n        for i in range(n):\n            b[i] = b_new[i] / norm\n        \n        if fabs(eigenvalue_new - eigenvalue) < 1e-14:\n            eigenvalue = eigenvalue_new\n            break\n        eigenvalue = eigenvalue_new\n    \n    # Final Rayleigh quotient\n    for i in range(n):\n        Ab[i] = 0.0\n        for j in range(n):\n            Ab[i] += A[i, j] * b[j]\n    eigenvalue = 0.0\n    for i in range(n):\n        eigenvalue += b[i] * Ab[i]\n    \n    return eigenvalue, np.array(b, dtype=np.float64)\nEOF\n"]
