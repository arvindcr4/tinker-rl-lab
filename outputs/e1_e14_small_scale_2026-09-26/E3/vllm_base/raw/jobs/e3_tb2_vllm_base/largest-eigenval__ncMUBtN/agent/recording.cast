[116.433181, "i", "cat > /app/eigen.py << 'PYEOF'\nimport numpy as np\n\n\ndef find_dominant_eigenvalue_and_eigenvector(A: np.ndarray):\n    \"\"\"\n    Find the dominant eigenvalue and eigenvector of a general real square matrix.\n    Uses power iteration for speed on small matrices.\n    \"\"\"\n    n = A.shape[0]\n    \n    # Power iteration to find dominant eigenvalue and eigenvector\n    # Start with a random vector\n    np.random.seed(42)\n    b = np.random.randn(n)\n    b = b / np.linalg.norm(b)\n    \n    # Power iteration - typically converges in 50-100 iterations for well-separated eigenvalues\n    # For small matrices, we can afford more iterations to ensure convergence\n    eigenvalue = 0.0\n    for _ in range(200):\n        # Matrix-vector multiply\n        b_new = A @ b\n        eigenvalue_new = np.dot(b, b_new)\n        norm = np.linalg.norm(b_new)\n        if norm == 0:\n            break\n        b = b_new / norm\n        if abs(eigenvalue_new - eigenvalue) < 1e-14:\n            break\n        eigenvalue = eigenvalue_new\n    \n    # Use Rayleigh q"]
[116.436576, "i", "uotient for more accurate eigenvalue\n    Ab = A @ b\n    eigenvalue = np.dot(b, Ab) / np.dot(b, b)\n    \n    return eigenvalue, b\nPYEOF\n"]
