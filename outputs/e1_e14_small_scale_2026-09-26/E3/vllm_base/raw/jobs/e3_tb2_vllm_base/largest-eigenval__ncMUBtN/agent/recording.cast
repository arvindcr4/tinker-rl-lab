[344.860616, "i", "cat > /app/eigen_lapack.c << 'EOF'\n#include <Python.h>\n#include <numpy/arrayobject.h>\n#include <stdlib.h>\n#include <math.h>\n\n/* LAPACK function signatures */\nextern void dgeev_(char *jobvl, char *jobvr, int *n, double *a, int *lda,\n                   double *wr, double *wi, double *vl, int *ldvl,\n                   double *vr, int *ldvr, double *work, int *lwork,\n                   int *info);\n\nstatic PyObject* py_find_dominant(PyObject* self, PyObject* args) {\n    PyObject* py_A;\n    if (!PyArg_ParseTuple(args, \"O\", &py_A)) return NULL;\n    \n    PyArrayObject* arr_A = (PyArrayObject*)py_A;\n    if (PyArray_NDIM(arr_A) != 2) {\n        PyErr_SetString(PyExc_ValueError, \"A must be 2D\");\n        return NULL;\n    }\n    \n    int n = PyArray_DIM(arr_A, 0);\n    if (n != PyArray_DIM(arr_A, 1)) {\n        PyErr_SetString(PyExc_ValueError, \"A must be square\");\n        return NULL;\n    }\n    \n    double* A = (double*)PyArray_DATA(arr_A);\n    \n    /* Copy A to a working buffer (dgeev may modify it) */\n    double* a_work = "]
[344.860837, "i", "(double*)malloc(n * n * sizeof(double));\n    memcpy(a_work, A, n * n * sizeof(double));\n    \n    /* Allocate workspace */\n    int lwork = n * 4;\n    double* work = (double*)malloc(lwork * sizeof(double));\n    double* wr = (double*)malloc(n * sizeof(double));\n    double* wi = (double*)malloc(n * sizeof(double));\n    double* vr = (double*)malloc(n * n * sizeof(double));\n    \n    char jobvl = 'N';\n    char jobvr = 'V';\n    int lda = n;\n    int ldvl = n;\n    int ldvr = n;\n    int info = 0;\n    \n    dgeev_(&jobvl, &jobvr, &n, a_work, &lda, wr, wi, NULL, &ldvl, vr, &ldvr, work, &lwork, &info);\n    \n    /* Find dominant eigenvalue (largest magnitude) */\n    int idx = 0;\n    double max_mag = 0.0;\n    for (int i = 0; i < n; i++) {\n        double mag = sqrt(wr[i]*wr[i] + wi[i]*wi[i]);\n        if (mag > max_mag) {\n            max_mag = mag;\n            idx = i;\n        }\n    }\n    \n    /* Build eigenvalue (complex if wi[idx] != 0) */\n    double ev_real = wr[idx];\n    double ev_imag = wi[idx];\n    \n    /* Build eigenvect"]
[344.861162, "i", "or */\n    double* evec = vr + idx * n;\n    \n    /* Create numpy arrays for return */\n    PyArrayObject* py_evec;\n    PyObject* py_eigenval;\n    \n    if (ev_imag == 0.0) {\n        /* Real eigenvalue */\n        py_eigenval = PyFloat_FromDouble(ev_real);\n        py_evec = (PyArrayObject*)PyArray_SimpleNewFromData(1, &n, NPY_FLOAT64, evec);\n    } else {\n        /* Complex eigenvalue - return complex arrays */\n        double* evec_complex = (double*)malloc(2 * n * sizeof(double));\n        for (int i = 0; i < n; i++) {\n            evec_complex[2*i]   = evec[i];\n            evec_complex[2*i+1] = 0.0;\n        }\n        py_eigenval = PyComplex_FromDoubles(ev_real, ev_imag);\n        py_evec = (PyArrayObject*)PyArray_SimpleNewFromData(1, &n, NPY_COMPLEX128, evec_complex);\n    }\n    \n    free(a_work);\n    free(work);\n    free(wr);\n    free(wi);\n    free(vr);\n    \n    return Py_BuildValue(\"NO\", py_eigenval, py_evec);\n}\n\nstatic PyMethodDef methods[] = {\n    {\"find_dominant\", py_find_dominant, METH_VARARGS, \"Find dominant e"]
[344.861565, "i", "igenvalue and eigenvector\"},\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef moduledef = {\n    PyModuleDef_HEAD_INIT, \"eigen_lapack\", NULL, -1, methods\n};\n\nPyMODINIT_FUNC PyInit_eigen_lapack(void) {\n    import_array();\n    return PyModule_Create(&moduledef);\n}\nEOF\n"]
