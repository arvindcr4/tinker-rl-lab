[?2004l#include <Python.h>
#include <numpy/arrayobject.h>
#include <stdlib.h>
#include <math.h>

/* LAPACKE interface - C-style */
extern int scipy_LAPACKE_dgeev64_(int matrix_layout, char jobvl, char jobvr,
                                   int n, double *a, int lda,
                                   double *wreal, double *wimag,
                                   double *vl, int ldvl,
                                   double *vr, int ldvr);

static PyObject* py_find_dominant(PyObject* self, PyObject* args) {
    PyObject* py_A;
    if (!PyArg_ParseTuple(args, "O", &py_A)) return NULL;
    
    PyArrayObject* arr_A = (PyArrayObject*)py_A;
    if (PyArray_NDIM(arr_A) != 2) {
        PyErr_SetString(PyExc_ValueError, "A must be 2D");
        return NULL;
    }
    
    int n = (int)PyArray_DIM(arr_A, 0);
    if (n != (int)PyArray_DIM(arr_A, 1)) {
        PyErr_SetString(PyExc_ValueError, "A must be square");
        return NULL;
    }
    
    double* A = (double*)PyArray_DATA(arr_A);
    
    /* Copy A to a working buffer (dgeev may modify it) */
    double* a_work = (double*)malloc(n * n * sizeof(double));
    memcpy(a_work, A, n * n * sizeof(double));
    
    /* Allocate workspace */
    double* wreal = (double*)malloc(n * sizeof(double));
    double* wimag = (double*)malloc(n * sizeof(double));
    double* vr = (double*)malloc(n * n * sizeof(double));
    
    int lda = n;
    int ldvl = n;
    int ldvr = n;
    
    /* LAPACKE: 101 = row-major, 102 = column-major */
    int info = scipy_LAPACKE_dgeev64_(101, 'N', 'V', n, a_work, lda,
                                       wreal, wimag, NULL, ldvl,
                                       vr, ldvr);
    
    /* Find dominant eigenvalue (largest magnitude) */
    int idx = 0;
    double max_mag = 0.0;
    for (int i = 0; i < n; i++) {
        double mag = sqrt(wreal[i]*wreal[i] + wimag[i]*wimag[i]);
        if (mag > max_mag) {
            max_mag = mag;
            idx = i;
        }
    }
    
    /* Build eigenvalue (complex if wimag[idx] != 0) */
    double ev_real = wreal[idx];
    double ev_imag = wimag[idx];
    
    /* Build eigenvector - LAPACKE returns row-major, need column-major */
    double* evec = vr + idx * n;  /* row idx in row-major = column idx in column-major */
    
    /* Create numpy arrays for return */
    PyArrayObject* py_evec;
    PyObject* py_eigenval;
    npy_intp dims[1] = {n};
    
    if (ev_imag == 0.0) {
        /* Real eigenvalue */
        py_eigenval = PyFloat_FromDouble(ev_real);
        py_evec = (PyArrayObject*)PyArray_SimpleNewFromData(1, dims, NPY_FLOAT64, evec);
    } else {
        /* Complex eigenvalue */
        double* evec_complex = (double*)malloc(2 * n * sizeof(double));
        for (int i = 0; i < n; i++) {
            evec_complex[2*i]   = evec[i];
            evec_complex[2*i+1] = 0.0;
        }
        py_eigenval = PyComplex_FromDoubles(ev_real, ev_imag);
        py_evec = (PyArrayObject*)PyArray_SimpleNewFromData(1, dims, NPY_COMPLEX128, evec_complex);
    }
    
    free(a_work);
    free(wreal);
    free(wimag);
    free(vr);
    
    return Py_BuildValue("NO", py_eigenval, py_evec);
}

static PyMethodDef methods[] = {
    {"find_dominant", py_find_dominant, METH_VARARGS, "Find dominant eigenvalue and eigenvector"},
    {NULL, NULL, 0, NULL}
};

static struct PyModuleDef moduledef = {
    PyModuleDef_HEAD_INIT, "eigen_lapack", NULL, -1, methods
};

PyMODINIT_FUNC PyInit_eigen_lapack(void) {
    import_array();
    return PyModule_Create(&moduledef);
}
