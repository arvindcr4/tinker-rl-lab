[45.905675, "o", "print(f\"tgt_sequences shape: {tgt_sequences.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.905691, "o", "# Create model and load weights\r\n\u001b[?2004l\r"]
[45.905891, "o", "\u001b[?2004h> model = RecoveredModel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.906038, "o", "model.load_state_dict(weights)\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.906052, "o", "\r\n\u001b[?2004l\r"]
[45.906338, "o", "\u001b[?2004h> # Compute initial MSE\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.906593, "o", "    output = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r"]
[45.906852, "o", "\u001b[?2004h>     initial_mse = F.mse_loss(output, tgt_sequences).item()\r\n\u001b[?2004l\r"]
[45.906869, "o", "\u001b[?2004h"]
[45.906878, "o", "> "]
[45.90718, "o", "print(f\"Initial MSE: {initial_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.907397, "o", "# Freeze all layers except output_layer\r\n\u001b[?2004l\r\u001b[?2004h> for name, param in model.named_parameters():\r\n\u001b[?2004l\r"]
[45.907412, "o", "\u001b[?2004h"]
[45.907688, "o", ">     if not name.startswith('output_layer'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.907835, "o", "        param.requires_grad = False\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.907977, "o", "        param.requires_grad = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.907991, "o", "\r\n\u001b[?2004l\r"]
[45.908243, "o", "\u001b[?2004h> # Tune output_layer weights\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.908501, "o", "optimizer = torch.optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=0.01)\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.908521, "o", "> \r\n\u001b[?2004l\r"]
[45.908528, "o", "\u001b[?2004h"]
[45.908834, "o", "> for epoch in range(500):\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.909053, "o", "    output = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.90927, "o", "    loss = F.mse_loss(output, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.909491, "o", "    optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h>     if epoch % 50 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.909742, "o", "        print(f\"Epoch {epoch}, Loss: {loss.item()}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[45.909757, "o", "> "]
[45.910014, "o", "# Compute final MSE\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.910166, "o", "    output = model(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.910426, "o", "    final_mse = F.mse_loss(output, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.910581, "o", "print(f\"Final MSE: {final_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.910723, "o", "print(f\"MSE reduced: {final_mse < initial_mse}\")\r\n\u001b[?2004l\r"]
[45.910736, "o", "\u001b[?2004h"]
[45.910986, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Save as TorchScript\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.911133, "o", "traced = torch.jit.script(model)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.911344, "o", "traced.save('/app/model.pt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.911359, "o", "print(\"Model saved to /app/model.pt\")\r\n\u001b[?2004l\r"]
[45.911627, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify\r\n\u001b[?2004l\r\u001b[?2004h> loaded = torch.jit.load('/app/model.pt')\r\n\u001b[?2004l\r"]
[45.911642, "o", "\u001b[?2004h"]
[45.911649, "o", "> "]
[45.911957, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     loaded_output = loaded(src_sequences, tgt_sequences)\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.911971, "o", "> "]
[45.912258, "o", "    loaded_mse = F.mse_loss(loaded_output, tgt_sequences).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.91248, "o", "print(f\"Loaded model MSE: {loaded_mse}\")\r\n\u001b[?2004l\r\u001b[?2004h> PYTHON_SCRIPT\r\n\u001b[?2004l\r"]
[45.914517, "o", "\u001b[?2004h"]
[45.914538, "o", "root@modal:/app# "]
[46.87059, "i", "python3 /app/solve.py\n"]
[46.879967, "o", "python3 /app/solve.py\r\n\u001b[?2004l\r"]
