[10.798641, "i", "python3 -c \"\nimport torch\nimport pprint\n\n# Load weights\nweights = torch.load('/app/weights.pt', map_location='cpu', weights_only=False)\nprint('=== State dict keys ===')\nfor k, v in weights.items():\n    print(f'{k}: shape={v.shape}, dtype={v.dtype}')\n\nprint()\nprint('=== Dataset ===')\ndataset = torch.load('/app/dataset.pt', map_location='cpu', weights_only=False)\nprint(f'Type: {type(dataset)}')\nif isinstance(dataset, dict):\n    for k, v in dataset.items():\n        print(f'{k}: shape={v.shape}, dtype={v.dtype}')\n        if isinstance(v, torch.Tensor):\n            print(f'  values: {v}')\nelif isinstance(dataset, (list, tuple)):\n    for i, item in enumerate(dataset):\n        print(f'[{i}]: shape={item.shape}, dtype={item.dtype}')\n        if isinstance(item, torch.Tensor):\n            print(f'  values: {item}')\n\"\n"]
