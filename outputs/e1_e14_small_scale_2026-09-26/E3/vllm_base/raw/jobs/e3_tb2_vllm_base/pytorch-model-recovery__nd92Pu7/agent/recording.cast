[45.894258, "i", "cat > /app/solve.py << 'PYTHON_SCRIPT'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.nn import TransformerEncoder, TransformerEncoderLayer, TransformerDecoder, TransformerDecoderLayer\n\nclass PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000):\n        super().__init__()\n        self.pe = nn.Parameter(torch.zeros(1, max_len, d_model), requires_grad=False)\n        pe = torch.zeros(1, max_len, d_model)\n        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-torch.log(torch.tensor(10000.0)) / d_model))\n        pe[0, :, 0::2] = torch.sin(position * div_term)\n        pe[0, :, 1::2] = torch.cos(position * div_term)\n        self.pe.data = pe.data\n\n    def forward(self, x):\n        return x + self.pe[:, :x.size(1), :]\n\nclass RecoveredModel(nn.Module):\n    def __init__(self, d_model=128, nhead=4, dim_feedforward=256, num_encoder_layers=3, num_decoder_layers=1):\n        super("]
[45.894314, "i", ").__init__()\n        self.embedding = nn.Linear(64, d_model)\n        self.pos_encoder = PositionalEncoding(d_model)\n        \n        encoder_layer = TransformerEncoderLayer(\n            d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,\n            batch_first=True\n        )\n        self.transformer_encoder = TransformerEncoder(encoder_layer, num_encoder_layers)\n        \n        decoder_layer = TransformerDecoderLayer(\n            d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,\n            batch_first=True\n        )\n        self.transformer_decoder = TransformerDecoder(decoder_layer, num_decoder_layers)\n        \n        self.output_layer = nn.Linear(d_model, 64)\n\n    def forward(self, src, tgt):\n        src = self.embedding(src)\n        src = self.pos_encoder(src)\n        memory = self.transformer_encoder(src)\n        tgt = self.embedding(tgt)\n        tgt = self.pos_encoder(tgt)\n        output = self.transformer_decoder(tgt, memory)\n        output = self.output_layer(output)\n       "]
[45.894338, "i", " return output\n\n# Load data\nweights = torch.load('/app/weights.pt', map_location='cpu', weights_only=False)\ndataset = torch.load('/app/dataset.pt', map_location='cpu', weights_only=False)\n\nsrc_sequences = dataset['src_sequences']\ntgt_sequences = dataset['tgt_sequences']\n\nprint(f\"src_sequences shape: {src_sequences.shape}\")\nprint(f\"tgt_sequences shape: {tgt_sequences.shape}\")\n\n# Create model and load weights\nmodel = RecoveredModel()\nmodel.load_state_dict(weights)\nmodel.eval()\n\n# Compute initial MSE\nwith torch.no_grad():\n    output = model(src_sequences, tgt_sequences)\n    initial_mse = F.mse_loss(output, tgt_sequences).item()\nprint(f\"Initial MSE: {initial_mse}\")\n\n# Freeze all layers except output_layer\nfor name, param in model.named_parameters():\n    if not name.startswith('output_layer'):\n        param.requires_grad = False\n    else:\n        param.requires_grad = True\n\n# Tune output_layer weights\noptimizer = torch.optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=0.01)\n\nfor epoch in range(5"]
[45.894363, "i", "00):\n    optimizer.zero_grad()\n    output = model(src_sequences, tgt_sequences)\n    loss = F.mse_loss(output, tgt_sequences)\n    loss.backward()\n    optimizer.step()\n    if epoch % 50 == 0:\n        print(f\"Epoch {epoch}, Loss: {loss.item()}\")\n\n# Compute final MSE\nwith torch.no_grad():\n    output = model(src_sequences, tgt_sequences)\n    final_mse = F.mse_loss(output, tgt_sequences).item()\nprint(f\"Final MSE: {final_mse}\")\nprint(f\"MSE reduced: {final_mse < initial_mse}\")\n\n# Save as TorchScript\nmodel.eval()\ntraced = torch.jit.script(model)\ntraced.save('/app/model.pt')\nprint(\"Model saved to /app/model.pt\")\n\n# Verify\nloaded = torch.jit.load('/app/model.pt')\nwith torch.no_grad():\n    loaded_output = loaded(src_sequences, tgt_sequences)\n    loaded_mse = F.mse_loss(loaded_output, tgt_sequences).item()\nprint(f\"Loaded model MSE: {loaded_mse}\")\nPYTHON_SCRIPT\n"]
