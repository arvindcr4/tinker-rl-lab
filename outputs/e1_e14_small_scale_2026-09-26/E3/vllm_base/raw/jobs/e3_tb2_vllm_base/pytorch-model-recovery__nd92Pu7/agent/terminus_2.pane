[?2004l[?2004h> 
[?2004l[?2004h> class PositionalEncoding(nn.Module):
[?2004l[?2004h>     def __init__(self, d_model, max_len=5000):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.pe = nn.Parameter(torch.zeros(1, max_len, d_model), requires_grad=False)
[?2004l[?2004h>         pe = torch.zeros(1, max_len, d_model)
[?2004l[?2004h>         position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)
[?2004l[?2004h>         div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-torch.log(torch.tensor(10000.0)) / d_model))
[?2004l[?2004h>         pe[0, :, 0::2] = torch.sin(position * div_term)
[?2004l[?2004h>         pe[0, :, 1::2] = torch.cos(position * div_term)
[?2004l[?2004h>         self.pe.data = pe.data
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         return x + self.pe[:, :x.size(1), :]
[?2004l[?2004h> 
[?2004l[?2004h> class RecoveredModel(nn.Module):
[?2004l[?2004h>     def __init__(self, d_model=128, nhead=4, dim_feedforward=256, num_encoder_layers=3, num_decoder_layers=1):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.embedding = nn.Linear(64, d_model)
[?2004l[?2004h>         self.pos_encoder = PositionalEncoding(d_model)
[?2004l[?2004h>         
[?2004l[?2004h>         encoder_layer = TransformerEncoderLayer(
[?2004l[?2004h>             d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,
[?2004l[?2004h>             batch_first=True
[?2004l[?2004h>         )
[?2004l[?2004h>         self.transformer_encoder = TransformerEncoder(encoder_layer, num_encoder_layers)
[?2004l[?2004h>         
[?2004l[?2004h>         decoder_layer = TransformerDecoderLayer(
[?2004l[?2004h>             d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,
[?2004l[?2004h>             batch_first=True
[?2004l[?2004h>         )
[?2004l[?2004h>         self.transformer_decoder = TransformerDecoder(decoder_layer, num_decoder_layers)
[?2004l[?2004h>         
[?2004l[?2004h>         self.output_layer = nn.Linear(d_model, 64)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, src, tgt):
[?2004l[?2004h>         src = self.embedding(src)
[?2004l[?2004h>         src = self.pos_encoder(src)
[?2004l[?2004h>         memory = self.transformer_encoder(src)
[?2004l[?2004h>         tgt = self.embedding(tgt)
[?2004l[?2004h>         tgt = self.pos_encoder(tgt)
[?2004l[?2004h>         output = self.transformer_decoder(tgt, memory)
[?2004l[?2004h>         output = self.output_layer(output)
[?2004l[?2004h>         return output
