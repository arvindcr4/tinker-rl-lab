                    writhe_2 += contributions[i1, i3] * contributions[i2, i4]
                    writhe_3 += contributions[i1, i4] * contributions[i2, i3]
    print()

    return (writhe_1 / (2*np.pi)**2,
            writhe_2 / (2*np.pi)**2,
            writhe_3 / (2*np.pi)**2)


