[206.627821, "i", "python3 -c \"\nimport os\n\ndef read_line_sequential(filepath):\n    records = []\n    if not os.path.exists(filepath):\n        return records\n    with open(filepath, 'r') as f:\n        content = f.read()\n    if not content:\n        return records\n    lines = content.split('\\\\n')\n    if lines and lines[-1] == '':\n        lines = lines[:-1]\n    for line in lines:\n        records.append(line)\n    return records\n\naccount_records = read_line_sequential('data/ACCOUNTS.DAT')\nprint('Account records:', len(account_records))\nfor rec in account_records:\n    print('  rec:', repr(rec), 'len:', len(rec))\n    rec_padded = rec.ljust(34)\n    print('    id:', repr(rec_padded[0:4]), 'name:', repr(rec_padded[4:24]), 'bal:', repr(rec_padded[24:34]))\n\nbook_records = read_line_sequential('data/BOOKS.DAT')\nprint('Book records:', len(book_records))\nfor rec in book_records:\n    print('  rec:', repr(rec), 'len:', len(rec))\n    rec_padded = rec.ljust(28)\n    print('    id:', repr(rec_padded[0:4]), 'title:', repr(rec_padded[4:24]), 'owner:', "]
[206.627867, "i", "repr(rec_padded[24:28]))\n\"\n"]
