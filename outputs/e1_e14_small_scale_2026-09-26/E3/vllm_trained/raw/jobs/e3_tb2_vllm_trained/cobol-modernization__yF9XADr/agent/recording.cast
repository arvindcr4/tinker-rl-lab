[306.155101, "i", "python3 -c \"\nimport os\n\ndef read_fixed_records(filepath, record_size):\n    records = []\n    if not os.path.exists(filepath):\n        return records\n    with open(filepath, 'rb') as f:\n        content = f.read()\n    if not content:\n        return records\n    if content.endswith(b'\\\\n'):\n        content = content[:-1]\n    num_records = len(content) // record_size\n    for i in range(num_records):\n        record = content[i * record_size:(i + 1) * record_size]\n        records.append(record)\n    return records\n\naccount_records = read_fixed_records('data/ACCOUNTS.DAT', 34)\nprint('Before update:')\nfor rec in account_records:\n    print('  ', rec)\n\nbuyer_id = b'U001'\nseller_id = b'U002'\nws_amount = 200\n\nnew_account_records = []\nfor rec in account_records:\n    acc_id = rec[0:4]\n    acc_name = rec[4:24]\n    acc_balance = int(rec[24:34].decode('ascii'))\n    print(f'  Processing {acc_id.decode()}: balance={acc_balance}')\n    if acc_id == buyer_id:\n        acc_balance -= ws_amount\n        print(f'    Buyer: subtracted, new"]
[306.156397, "i", " balance={acc_balance}')\n    if acc_id == seller_id:\n        acc_balance += ws_amount\n        print(f'    Seller: added, new balance={acc_balance}')\n    new_rec = acc_id + acc_name + str(acc_balance).zfill(10).encode('ascii')\n    new_account_records.append(new_rec)\n\nprint('After update:')\nfor rec in new_account_records:\n    print('  ', rec)\n\n# Write\nwith open('data/ACCOUNTS.DAT', 'wb') as f:\n    for record in new_account_records:\n        f.write(record)\n\nprint('Written to file')\n\n# Verify\nwith open('data/ACCOUNTS.DAT', 'rb') as f:\n    content = f.read()\nprint('File content:', repr(content))\n\"\n"]
