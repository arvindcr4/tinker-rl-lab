[294.191124, "i", "python3 -c \"\nimport os\n\ndef read_fixed_records(filepath, record_size):\n    records = []\n    if not os.path.exists(filepath):\n        return records\n    with open(filepath, 'rb') as f:\n        content = f.read()\n    if not content:\n        return records\n    if content.endswith(b'\\\\n'):\n        content = content[:-1]\n    num_records = len(content) // record_size\n    for i in range(num_records):\n        record = content[i * record_size:(i + 1) * record_size]\n        records.append(record)\n    return records\n\ninput_records = read_fixed_records('src/INPUT.DAT', 22)\nprint('Input records:', len(input_records))\nfor r in input_records:\n    print('  ', repr(r))\n    print('  buyer:', repr(r[0:4]))\n    print('  seller:', repr(r[4:8]))\n    print('  book:', repr(r[8:12]))\n    print('  amount:', repr(r[12:22]))\n\naccount_records = read_fixed_records('data/ACCOUNTS.DAT', 34)\nprint('Account records:', len(account_records))\nfor r in account_records:\n    print('  ', repr(r))\n\nbook_records = read_fixed_records('data/BOOKS.DAT', "]
[294.191183, "i", "28)\nprint('Book records:', len(book_records))\nfor r in book_records:\n    print('  ', repr(r))\n\"\n"]
[294.191911, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.192186, "o", "def read_fixed_records(filepath, record_size):\r\n\u001b[?2004l\r\u001b[?2004h>     records = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.192201, "o", "    if not os.path.exists(filepath):\r\n\u001b[?2004l\r"]
[294.192496, "o", "\u001b[?2004h>         return records\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filepath, 'rb') as f:\r\n\u001b[?2004l\r"]
[294.192512, "o", "\u001b[?2004h"]
[294.19254, "o", "> "]
[294.192855, "o", "        content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h>     if not content:\r\n\u001b[?2004l\r\u001b[?2004h>         return records\r\n\u001b[?2004l\r"]
[294.192868, "o", "\u001b[?2004h"]
