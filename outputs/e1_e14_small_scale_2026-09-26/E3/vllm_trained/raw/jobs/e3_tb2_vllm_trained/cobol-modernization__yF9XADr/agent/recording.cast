[416.107579, "o", "    with open(filepath, 'wb') as f:\r\n"]
[416.107588, "o", "\u001b[?2004l\r"]
[416.107908, "o", "\u001b[?2004h>         for rec in records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.108134, "o", "            f.write(rec['id'].encode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(rec['name'].encode('ascii'))"]
