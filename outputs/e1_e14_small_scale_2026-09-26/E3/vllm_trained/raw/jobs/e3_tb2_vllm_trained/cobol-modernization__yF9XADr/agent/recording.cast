[416.109822, "o", "        if len(rec) == BOOK_REC_SIZE:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.110045, "o", "            book_id = rec[0:4].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.110284, "o", "            book_title = rec[4:24].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.110519, "o", "            book_owner = rec[24:28].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h>             records.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.110766, "o", "                'id': book_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.110923, "o", "                'title': book_title,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.111076, "o", "                'owner': book_owner\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.111093, "o", "> "]
[416.111302, "o", "    return records\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
