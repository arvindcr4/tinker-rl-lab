[263.171266, "o", "        return records\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.17142, "o", "    # Strip trailing newline if present (from previous writes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.171569, "o", "    if content.endswith(b'\\n'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.171718, "o", "        content = content[:-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.171973, "o", "    num_records = len(content) // record_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.17219, "o", "    for i in range(num_records):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.172441, "o", "        record = content[i * record_size:(i + 1) * record_size]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.172675, "o", "        records.append(record)\r\n\u001b[?2004l\r\u001b[?2004h>     return records\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.172689, "o", "> \r\n\u001b[?2004l\r"]
[263.172964, "o", "\u001b[?2004h> def write_fixed_records(filepath, records):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.173288, "o", "    \"\"\"Write records as fixed-length records without newline separators.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.173518, "o", "    with open(filepath, 'wb') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.173743, "o", "        for record in records:\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(record)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.17376, "o", "\u001b[?2004h"]
[263.174037, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     # Read input file (22 bytes per record)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.174053, "o", "> "]
[263.17435, "o", "    input_records = read_fixed_records('src/INPUT.DAT', 22)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.17439, "o", "> "]
[263.174835, "o", "    if not input_records:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"Error: Input file is empty\")\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.175075, "o", "    input_record = input_records[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.175314, "o", "    buyer_id = input_record[0:4].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.175467, "o", "    seller_id = input_record[4:8].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.175689, "o", "    book_id = input_record[8:12].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.17596, "o", "    amount_str = input_record[12:22].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.176279, "o", "    # Parse amount - COBOL PIC 9(10) with spaces treated as zeros\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.176584, "o", "    amount_clean = amount_str.replace(' ', '0')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.176812, "o", "    amount = int(amount_clean)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.17709, "o", "    ws_amount = amount  # integer part (PIC 9(10)V99, but input is PIC 9(10))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[263.177105, "o", "\u001b[?2004h"]
[263.177386, "o", ">     # Validate users and book\r\n\u001b[?2004l\r\u001b[?2004h>     buyer_found = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.177402, "o", "> "]
[263.177672, "o", "    seller_found = False\r\n\u001b[?2004l\r\u001b[?2004h>     book_found = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.177897, "o", "    valid_owner = False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.178049, "o", "    # Read accounts (34 bytes per record)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.178295, "o", "    account_records = read_fixed_records('data/ACCOUNTS.DAT', 34)\r\n\u001b[?2004l\r"]
[263.178517, "o", "\u001b[?2004h>     for rec in account_records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.178742, "o", "        acc_id = rec[0:4].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.178894, "o", "        if acc_id == buyer_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.179044, "o", "            buyer_found = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.179206, "o", "        if acc_id == seller_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.179427, "o", "            seller_found = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.179651, "o", "    # Read books (28 bytes per record)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.179873, "o", "    book_records = read_fixed_records('data/BOOKS.DAT', 28)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.180097, "o", "    for rec in book_records:\r\n\u001b[?2004l\r\u001b[?2004h>         b_id = rec[0:4].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.180112, "o", "> "]
[263.180331, "o", "        if b_id == book_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.18055, "o", "            book_found = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.180565, "o", "            owner = rec[24:28].decode('ascii')\r\n\u001b[?2004l\r"]
[263.180773, "o", "\u001b[?2004h>             if owner == seller_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.180925, "o", "                valid_owner = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.181144, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     print(\" \")  # DISPLAY \" \" from COBOL\r\n\u001b[?2004l\r"]
[263.181169, "o", "\u001b[?2004h"]
[263.181178, "o", "> "]
[263.181452, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.181643, "o", "    if buyer_found and seller_found and book_found and valid_owner:\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.1819, "o", ">         # Process transaction\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.182102, "o", "        # Update accounts\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.182117, "o", "> "]
[263.182418, "o", "        new_account_records = []\r\n\u001b[?2004l\r\u001b[?2004h>         for rec in account_records:\r\n\u001b[?2004l\r"]
[263.182645, "o", "\u001b[?2004h>             acc_id = rec[0:4]\r\n\u001b[?2004l\r"]
[263.182659, "o", "\u001b[?2004h"]
[263.182934, "o", ">             acc_name = rec[4:24]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.183156, "o", "            acc_balance = int(rec[24:34].decode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.183321, "o", "            if acc_id == buyer_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.183547, "o", "                acc_balance -= ws_amount\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.183771, "o", "            if acc_id == seller_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.183997, "o", "                acc_balance += ws_amount\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.1843, "o", "            new_rec = acc_id + acc_name + str(acc_balance).zfill(10).encode('ascii')\r\n\u001b[?2004l\r"]
[263.18432, "o", "\u001b[?2004h"]
[263.184329, "o", "> "]
[263.184681, "o", "            new_account_records.append(new_rec)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.184955, "o", "        write_fixed_records('data/ACCOUNTS.DAT', new_account_records)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.18497, "o", "        \r\n\u001b[?2004l\r"]
[263.185247, "o", "\u001b[?2004h>         # Update books\r\n\u001b[?2004l\r\u001b[?2004h>         new_book_records = []\r\n\u001b[?2004l\r"]
[263.185262, "o", "\u001b[?2004h"]
[263.185462, "o", ">         for rec in book_records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.185682, "o", "            b_id = rec[0:4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.185697, "o", "            b_title = rec[4:24]\r\n\u001b[?2004l\r"]
[263.185965, "o", "\u001b[?2004h>             b_owner = rec[24:28]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.18598, "o", "> "]
[263.186293, "o", "            if b_id == book_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.186559, "o", "                b_owner = buyer_id.encode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.186574, "o", "> "]
[263.18677, "o", "            new_rec = b_id + b_title + b_owner\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.186785, "o", "> "]
[263.187048, "o", "            new_book_records.append(new_rec)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.187369, "o", "        write_fixed_records('data/BOOKS.DAT', new_book_records)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.187384, "o", "        \r\n"]
[263.187393, "o", "\u001b[?2004l\r"]
[263.18771, "o", "\u001b[?2004h>         # Append transaction (22 bytes per record)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.187863, "o", "        trans_book = book_id.encode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.18817, "o", "        trans_amount = str(ws_amount).zfill(10).encode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.1884, "o", "        trans_seller = seller_id.encode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.188639, "o", "        trans_buyer = buyer_id.encode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.188654, "o", "        \r\n\u001b[?2004l\r"]
[263.188929, "o", "\u001b[?2004h> "]
[263.189077, "o", "        transaction_record = trans_book + trans_amount + trans_seller + trans_buyer\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[263.189091, "o", "\u001b[?2004h"]
[263.1891, "o", "> "]
[263.189456, "o", "        with open('data/TRANSACTIONS.DAT', 'ab') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.189709, "o", "            f.write(transaction_record)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.189929, "o", "        print(\"Transaction completed successfully\")\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.190132, "o", "        print(\"Transaction failed due to validation errors\")\r\n\u001b[?2004l\r"]
[263.190363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.190585, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[263.192893, "o", "\u001b[?2004h"]
[263.192912, "o", "root@modal:/app# "]
