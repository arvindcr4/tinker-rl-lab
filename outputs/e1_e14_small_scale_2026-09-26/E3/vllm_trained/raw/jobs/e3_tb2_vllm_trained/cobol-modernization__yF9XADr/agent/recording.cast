[416.111541, "o", "\u001b[?2004h"]
[416.111814, "o", ">         for rec in records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.112046, "o", "            f.write(rec['id'].encode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.112282, "o", "            f.write(rec['title'].encode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.112506, "o", "            f.write(rec['owner'].encode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def read_transactions(filepath):\r\n"]
[416.112522, "o", "\u001b[?2004l\r"]
[416.11253, "o", "\u001b[?2004h"]
[416.112776, "o", ">     records = []\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filepath, 'rb') as f:\r\n\u001b[?2004l\r"]
[416.112791, "o", "\u001b[?2004h"]
[416.113056, "o", ">         data = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.113292, "o", "    for i in range(0, len(data), TRANS_REC_SIZE):\r\n\u001b[?2004l\r\u001b[?2004h>         rec = data[i:i+TRANS_REC_SIZE]\r\n\u001b[?2004l\r"]
[416.113306, "o", "\u001b[?2004h"]
[416.113315, "o", "> "]
[416.113594, "o", "        if len(rec) == TRANS_REC_SIZE:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.113862, "o", "            trans_book = rec[0:4].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.11401, "o", "            trans_amount = int(rec[4:14].decode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.114206, "o", "            trans_seller = rec[14:18].decode('ascii')\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.11422, "o", "> "]
[416.114413, "o", "            trans_buyer = rec[18:22].decode('ascii')\r\n\u001b[?2004l\r"]
[416.114427, "o", "\u001b[?2004h"]
[416.114434, "o", "> "]
[416.11474, "o", "            records.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 'book': trans_book,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.114897, "o", "                'amount': trans_amount,\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.114909, "o", "> "]
[416.115095, "o", "                'seller': trans_seller,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.115249, "o", "                'buyer': trans_buyer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.115487, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>     return records\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.115918, "o", "def append_transaction(filepath, book_id, amount, seller_id, buyer_id):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.116166, "o", "    with open(filepath, 'ab') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.116351, "o", "        f.write(book_id.encode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.116557, "o", "        f.write(str(amount).zfill(10).encode('ascii'))\r\n\u001b[?2004l\r"]
[416.116714, "o", "\u001b[?2004h> "]
[416.116934, "o", "        f.write(seller_id.encode('ascii'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.116951, "o", "        f.write(buyer_id.encode('ascii'))\r\n\u001b[?2004l\r"]
[416.117244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.117474, "o", "    # Change to /app directory (COBOL program runs from /app/)\r\n\u001b[?2004l\r\u001b[?2004h>     os.chdir('/app')\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.117488, "o", "> \r\n\u001b[?2004l\r"]
[416.117689, "o", "\u001b[?2004h>     # Read input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.117958, "o", "    buyer_id, seller_id, book_id, ws_amount = read_input('src/INPUT.DAT')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[416.117974, "o", "> "]
[416.11825, "o", "    # Validate users and book\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.118476, "o", "    accounts = read_accounts('data/ACCOUNTS.DAT')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.1187, "o", "    books = read_books('data/BOOKS.DAT')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     buyer_found = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.118928, "o", "    seller_found = False\r\n\u001b[?2004l\r\u001b[?2004h>     book_found = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.118943, "o", "> "]
[416.119186, "o", "    valid_owner = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for acc in accounts:\r\n"]
[416.119201, "o", "\u001b[?2004l\r"]
[416.119209, "o", "\u001b[?2004h"]
[416.119535, "o", ">         if acc['id'] == buyer_id:\r\n\u001b[?2004l\r\u001b[?2004h>             buyer_found = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.119764, "o", "        if acc['id'] == seller_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.119989, "o", "            seller_found = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for book in books:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.120005, "o", "> "]
[416.120289, "o", "        if book['id'] == book_id:\r\n\u001b[?2004l\r\u001b[?2004h>             book_found = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.120305, "o", "> "]
[416.120502, "o", "            if book['owner'] == seller_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.120723, "o", "                valid_owner = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.120948, "o", "    # Process transaction if all validations pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.121186, "o", "    if buyer_found and seller_found and book_found and valid_owner:\r\n\u001b[?2004l\r"]
[416.121444, "o", "\u001b[?2004h>         # Update account balances\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.121662, "o", "        for acc in accounts:\r\n\u001b[?2004l\r\u001b[?2004h>             if acc['id'] == buyer_id:\r\n\u001b[?2004l\r"]
[416.121675, "o", "\u001b[?2004h"]
[416.121683, "o", "> "]
[416.12192, "o", "                acc['balance'] -= ws_amount\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.122135, "o", "            if acc['id'] == seller_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.122362, "o", "                acc['balance'] += ws_amount\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.122581, "o", "        write_accounts('data/ACCOUNTS.DAT', accounts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Update book ownership"]
[416.122595, "o", "\r\n\u001b[?2004l\r"]
[416.122603, "o", "\u001b[?2004h"]
[416.122916, "o", ">         for book in books:\r\n\u001b[?2004l\r\u001b[?2004h>             if book['id'] == book_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.123062, "o", "                book['owner'] = buyer_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.123075, "o", "> "]
[416.123344, "o", "        write_books('data/BOOKS.DAT', books)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.123563, "o", "        # Append transaction record\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.123801, "o", "        append_transaction('data/TRANSACTIONS.DAT', book_id, ws_amount, seller_id, buyer_id)\r\n\u001b[?2004l\r"]
[416.123945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.124086, "o", "        print(\"Transaction completed successfully\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.124099, "o", "> "]
[416.124306, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.124446, "o", "        print(\"Transaction failed due to validation errors\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.124662, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF"]
