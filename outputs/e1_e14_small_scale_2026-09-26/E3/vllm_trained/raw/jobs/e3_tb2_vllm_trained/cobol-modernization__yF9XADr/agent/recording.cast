[416.098352, "i", "cat > /app/program.py << 'PYEOF'\nimport os\nimport sys\n\n# Record sizes\nACCOUNT_REC_SIZE = 34  # ID(4) + Name(20) + Balance(10)\nBOOK_REC_SIZE = 28     # ID(4) + Title(20) + Owner(4)\nTRANS_REC_SIZE = 22    # Book(4) + Amount(10) + Seller(4) + Buyer(4)\nINPUT_REC_SIZE = 22    # Buyer(4) + Seller(4) + Book(4) + Amount(10)\n\ndef read_input(filepath):\n    with open(filepath, 'rb') as f:\n        data = f.read()\n    if len(data) < INPUT_REC_SIZE:\n        print(\"Error: Input file is empty\")\n        sys.exit(1)\n    buyer_id = data[0:4].decode('ascii')\n    seller_id = data[4:8].decode('ascii')\n    book_id = data[8:12].decode('ascii')\n    amount_str = data[12:22].decode('ascii')\n    amount = int(amount_str)  # PIC 9(10)\n    # In COBOL: WS-AMOUNT is PIC 9(10)V99\n    # MOVE INPUT-AMOUNT TO WS-AMOUNT: the integer value is placed in the integer part\n    # So WS-AMOUNT = amount (as integer, the V99 part is 00)\n    # When used in ADD/SUBTRACT with PIC 9(10), only integer part matters\n    ws_amount = amount  # effectively the inte"]
[416.098435, "i", "ger part\n    return buyer_id, seller_id, book_id, ws_amount\n\ndef read_accounts(filepath):\n    records = []\n    with open(filepath, 'rb') as f:\n        data = f.read()\n    for i in range(0, len(data), ACCOUNT_REC_SIZE):\n        rec = data[i:i+ACCOUNT_REC_SIZE]\n        if len(rec) == ACCOUNT_REC_SIZE:\n            acc_id = rec[0:4].decode('ascii')\n            acc_name = rec[4:24].decode('ascii')\n            acc_balance = int(rec[24:34].decode('ascii'))\n            records.append({\n                'id': acc_id,\n                'name': acc_name,\n                'balance': acc_balance\n            })\n    return records\n\ndef write_accounts(filepath, records):\n    with open(filepath, 'wb') as f:\n        for rec in records:\n            f.write(rec['id'].encode('ascii'))\n            f.write(rec['name'].encode('ascii'))\n            f.write(str(rec['balance']).zfill(10).encode('ascii'))\n\ndef read_books(filepath):\n    records = []\n    with open(filepath, 'rb') as f:\n        data = f.read()\n    for i in range(0, len(data), "]
[416.098484, "i", "BOOK_REC_SIZE):\n        rec = data[i:i+BOOK_REC_SIZE]\n        if len(rec) == BOOK_REC_SIZE:\n            book_id = rec[0:4].decode('ascii')\n            book_title = rec[4:24].decode('ascii')\n            book_owner = rec[24:28].decode('ascii')\n            records.append({\n                'id': book_id,\n                'title': book_title,\n                'owner': book_owner\n            })\n    return records\n\ndef write_books(filepath, records):\n    with open(filepath, 'wb') as f:\n        for rec in records:\n            f.write(rec['id'].encode('ascii'))\n            f.write(rec['title'].encode('ascii'))\n            f.write(rec['owner'].encode('ascii'))\n\ndef read_transactions(filepath):\n    records = []\n    with open(filepath, 'rb') as f:\n        data = f.read()\n    for i in range(0, len(data), TRANS_REC_SIZE):\n        rec = data[i:i+TRANS_REC_SIZE]\n        if len(rec) == TRANS_REC_SIZE:\n            trans_book = rec[0:4].decode('ascii')\n            trans_amount = int(rec[4:14].decode('ascii'))\n            trans_se"]
[416.09853, "i", "ller = rec[14:18].decode('ascii')\n            trans_buyer = rec[18:22].decode('ascii')\n            records.append({\n                'book': trans_book,\n                'amount': trans_amount,\n                'seller': trans_seller,\n                'buyer': trans_buyer\n            })\n    return records\n\ndef append_transaction(filepath, book_id, amount, seller_id, buyer_id):\n    with open(filepath, 'ab') as f:\n        f.write(book_id.encode('ascii'))\n        f.write(str(amount).zfill(10).encode('ascii'))\n        f.write(seller_id.encode('ascii'))\n        f.write(buyer_id.encode('ascii'))\n\ndef main():\n    # Change to /app directory (COBOL program runs from /app/)\n    os.chdir('/app')\n\n    # Read input\n    buyer_id, seller_id, book_id, ws_amount = read_input('src/INPUT.DAT')\n\n    # Validate users and book\n    accounts = read_accounts('data/ACCOUNTS.DAT')\n    books = read_books('data/BOOKS.DAT')\n\n    buyer_found = False\n    seller_found = False\n    book_found = False\n    valid_owner = False\n\n    for acc in account"]
[416.098542, "i", "s:\n        if acc['id'] == buyer_id:\n            buyer_found = True\n        if acc['id'] == seller_id:\n            seller_found = True\n\n    for book in books:\n        if book['id'] == book_id:\n            book_found = True\n            if book['owner'] == seller_id:\n                valid_owner = True\n\n    # Process transaction if all validations pass\n    if buyer_found and seller_found and book_found and valid_owner:\n        # Update account balances\n        for acc in accounts:\n            if acc['id'] == buyer_id:\n                acc['balance'] -= ws_amount\n            if acc['id'] == seller_id:\n                acc['balance'] += ws_amount\n        write_accounts('data/ACCOUNTS.DAT', accounts)\n\n        # Update book ownership\n        for book in books:\n            if book['id'] == book_id:\n                book['owner'] = buyer_id\n        write_books('data/BOOKS.DAT', books)\n\n        # Append transaction record\n        append_transaction('data/TRANSACTIONS.DAT', book_id, ws_amount, seller_id, buyer_id)\n\n       "]
[416.098549, "i", " print(\"Transaction completed successfully\")\n    else:\n        print(\"Transaction failed due to validation errors\")\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
