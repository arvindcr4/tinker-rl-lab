[130.521895, "i", "cat > /app/program.py << 'PYEOF'\nimport os\nimport shutil\n\ndef read_line_sequential(filepath):\n    \"\"\"Read a line-sequential file (newline-terminated records).\"\"\"\n    records = []\n    if not os.path.exists(filepath):\n        return records\n    with open(filepath, 'r') as f:\n        content = f.read()\n    if not content:\n        return records\n    # Split by newline, but handle files without trailing newline\n    lines = content.split('\\n')\n    # Remove trailing empty string if file ends with newline\n    if lines and lines[-1] == '':\n        lines = lines[:-1]\n    for line in lines:\n        records.append(line)\n    return records\n\ndef write_line_sequential(filepath, records):\n    \"\"\"Write records as line-sequential (newline-terminated).\"\"\"\n    with open(filepath, 'w') as f:\n        for record in records:\n            f.write(record + '\\n')\n\ndef main():\n    # Read input file\n    input_records = read_line_sequential('src/INPUT.DAT')\n    if not input_records:\n        print(\"Error: Input file is empty\")\n        retur"]
[130.521973, "i", "n\n    \n    input_record = input_records[0]\n    # Pad to expected length (22 bytes) with spaces\n    input_record = input_record.ljust(22)\n    \n    buyer_id = input_record[0:4]\n    seller_id = input_record[4:8]\n    book_id = input_record[8:12]\n    amount_str = input_record[12:22]\n    \n    # Parse amount - COBOL PIC 9(10) with spaces treated as zeros\n    amount_clean = amount_str.replace(' ', '0')\n    amount = int(amount_clean)\n    \n    # WS-AMOUNT is PIC 9(10)V99, but INPUT-AMOUNT PIC 9(10) moved to it\n    # The integer part is the amount, decimal part is 00\n    # When used in arithmetic with PIC 9(10) fields, only integer part matters\n    ws_amount = amount  # integer part\n    \n    # Validate users and book\n    buyer_found = False\n    seller_found = False\n    book_found = False\n    valid_owner = False\n    \n    # Read accounts\n    account_records = read_line_sequential('data/ACCOUNTS.DAT')\n    for rec in account_records:\n        rec = rec.ljust(34)\n        acc_id = rec[0:4]\n        if acc_id == buyer_id:\n      "]
[130.522022, "i", "      buyer_found = True\n        if acc_id == seller_id:\n            seller_found = True\n    \n    # Read books\n    book_records = read_line_sequential('data/BOOKS.DAT')\n    for rec in book_records:\n        rec = rec.ljust(28)\n        b_id = rec[0:4]\n        if b_id == book_id:\n            book_found = True\n            owner = rec[24:28]\n            if owner == seller_id:\n                valid_owner = True\n    \n    print(\" \")  # DISPLAY \" \" from COBOL\n    \n    if buyer_found and seller_found and book_found and valid_owner:\n        # Process transaction\n        \n        # Update accounts\n        new_account_records = []\n        for rec in account_records:\n            rec = rec.ljust(34)\n            acc_id = rec[0:4]\n            acc_name = rec[4:24]\n            acc_balance_str = rec[24:34]\n            acc_balance = int(acc_balance_str)\n            \n            if acc_id == buyer_id:\n                acc_balance -= ws_amount\n            if acc_id == seller_id:\n                acc_balance += ws_amount\n            \n"]
[130.522067, "i", "            new_rec = acc_id + acc_name + str(acc_balance).zfill(10)\n            new_account_records.append(new_rec)\n        \n        write_line_sequential('data/ACCOUNTS.DAT', new_account_records)\n        \n        # Update books\n        new_book_records = []\n        for rec in book_records:\n            rec = rec.ljust(28)\n            b_id = rec[0:4]\n            b_title = rec[4:24]\n            b_owner = rec[24:28]\n            \n            if b_id == book_id:\n                b_owner = buyer_id\n            \n            new_rec = b_id + b_title + b_owner\n            new_book_records.append(new_rec)\n        \n        write_line_sequential('data/BOOKS.DAT', new_book_records)\n        \n        # Append transaction\n        trans_book = book_id\n        trans_amount = str(ws_amount).zfill(10)\n        trans_seller = seller_id\n        trans_buyer = buyer_id\n        \n        transaction_record = trans_book + trans_amount + trans_seller + trans_buyer\n        \n        with open('data/TRANSACTIONS.DAT', 'a') as f:\n           "]
[130.522075, "i", " f.write(transaction_record + '\\n')\n        \n        print(\"Transaction completed successfully\")\n    else:\n        print(\"Transaction failed due to validation errors\")\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
