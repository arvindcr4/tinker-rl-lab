[232.443058, "i", "cat > /app/program.py << 'PYEOF'\nimport os\n\ndef read_fixed_records(filepath, record_size):\n    \"\"\"Read a file as fixed-length records.\"\"\"\n    records = []\n    if not os.path.exists(filepath):\n        return records\n    with open(filepath, 'rb') as f:\n        content = f.read()\n    if not content:\n        return records\n    # Handle line-sequential: strip trailing newline if present\n    if content.endswith(b'\\n'):\n        content = content[:-1]\n    # Also handle files that might have \\r\\n\n    if content.endswith(b'\\r\\n'):\n        content = content[:-2]\n    num_records = len(content) // record_size\n    for i in range(num_records):\n        record = content[i * record_size:(i + 1) * record_size]\n        records.append(record)\n    return records\n\ndef write_fixed_records(filepath, records):\n    \"\"\"Write records as fixed-length records with newline separators.\"\"\"\n    with open(filepath, 'wb') as f:\n        for record in records:\n            f.write(record)\n            f.write(b'\\n')\n\ndef main():\n    # Read input fil"]
[232.443135, "i", "e (22 bytes per record)\n    input_records = read_fixed_records('src/INPUT.DAT', 22)\n    if not input_records:\n        print(\"Error: Input file is empty\")\n        return\n    \n    input_record = input_records[0]\n    buyer_id = input_record[0:4].decode('ascii')\n    seller_id = input_record[4:8].decode('ascii')\n    book_id = input_record[8:12].decode('ascii')\n    amount_str = input_record[12:22].decode('ascii')\n    \n    # Parse amount - COBOL PIC 9(10) with spaces treated as zeros\n    amount_clean = amount_str.replace(' ', '0')\n    amount = int(amount_clean)\n    ws_amount = amount  # integer part (PIC 9(10)V99, but input is PIC 9(10))\n    \n    # Validate users and book\n    buyer_found = False\n    seller_found = False\n    book_found = False\n    valid_owner = False\n    \n    # Read accounts (34 bytes per record)\n    account_records = read_fixed_records('data/ACCOUNTS.DAT', 34)\n    for rec in account_records:\n        acc_id = rec[0:4].decode('ascii')\n        if acc_id == buyer_id:\n            buyer_found = True\n     "]
[232.443191, "i", "   if acc_id == seller_id:\n            seller_found = True\n    \n    # Read books (28 bytes per record)\n    book_records = read_fixed_records('data/BOOKS.DAT', 28)\n    for rec in book_records:\n        b_id = rec[0:4].decode('ascii')\n        if b_id == book_id:\n            book_found = True\n            owner = rec[24:28].decode('ascii')\n            if owner == seller_id:\n                valid_owner = True\n    \n    print(\" \")  # DISPLAY \" \" from COBOL\n    \n    if buyer_found and seller_found and book_found and valid_owner:\n        # Process transaction\n        \n        # Update accounts\n        new_account_records = []\n        for rec in account_records:\n            acc_id = rec[0:4]\n            acc_name = rec[4:24]\n            acc_balance = int(rec[24:34].decode('ascii'))\n            \n            if acc_id == buyer_id:\n                acc_balance -= ws_amount\n            if acc_id == seller_id:\n                acc_balance += ws_amount\n            \n            new_rec = acc_id + acc_name + str(acc_balance).zfill"]
[232.443278, "i", "(10).encode('ascii')\n            new_account_records.append(new_rec)\n        \n        write_fixed_records('data/ACCOUNTS.DAT', new_account_records)\n        \n        # Update books\n        new_book_records = []\n        for rec in book_records:\n            b_id = rec[0:4]\n            b_title = rec[4:24]\n            b_owner = rec[24:28]\n            \n            if b_id == book_id:\n                b_owner = buyer_id.encode('ascii')\n            \n            new_rec = b_id + b_title + b_owner\n            new_book_records.append(new_rec)\n        \n        write_fixed_records('data/BOOKS.DAT', new_book_records)\n        \n        # Append transaction (22 bytes per record)\n        trans_book = book_id.encode('ascii')\n        trans_amount = str(ws_amount).zfill(10).encode('ascii')\n        trans_seller = seller_id.encode('ascii')\n        trans_buyer = buyer_id.encode('ascii')\n        \n        transaction_record = trans_book + trans_amount + trans_seller + trans_buyer\n        \n        with open('data/TRANSACTIONS.DAT', 'ab'"]
[232.443295, "i", ") as f:\n            f.write(transaction_record)\n            f.write(b'\\n')\n        \n        print(\"Transaction completed successfully\")\n    else:\n        print(\"Transaction failed due to validation errors\")\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
[232.443866, "o", "cat > /app/program.py << 'PYEOF'\r\n"]
