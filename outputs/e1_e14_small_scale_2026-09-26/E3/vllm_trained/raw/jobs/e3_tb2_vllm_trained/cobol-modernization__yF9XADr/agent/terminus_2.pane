[?2004l[?2004h> def read_line_sequential(filepath):
[?2004l[?2004h>     """Read a line-sequential file (newline-terminated records)."""
[?2004l[?2004h>     records = []
[?2004l[?2004h>     if not os.path.exists(filepath):
[?2004l[?2004h>         return records
[?2004l[?2004h>     with open(filepath, 'r') as f:
[?2004l[?2004h>         content = f.read()
[?2004l[?2004h>     if not content:
[?2004l[?2004h>         return records
[?2004l[?2004h>     # Split by newline, but handle files without trailing newline
[?2004l[?2004h>     lines = content.split('\n')
[?2004l[?2004h>     # Remove trailing empty string if file ends with newline
[?2004l[?2004h>     if lines and lines[-1] == '':
[?2004l[?2004h>         lines = lines[:-1]
[?2004l[?2004h>     for line in lines:
[?2004l[?2004h>         records.append(line)
[?2004l[?2004h>     return records
[?2004l[?2004h> 
[?2004l[?2004h> def write_line_sequential(filepath, records):
[?2004l[?2004h>     """Write records as line-sequential (newline-terminated)."""
[?2004l[?2004h>     with open(filepath, 'w') as f:
[?2004l[?2004h>         for record in records:
[?2004l[?2004h>             f.write(record + '\n')
