[?2004l[?2004h> def main():
[?2004l[?2004h>     # Change to /app directory (COBOL program runs from /app/)
[?2004l[?2004h>     os.chdir('/app')
[?2004l[?2004h> 
[?2004l[?2004h>     # Read input
[?2004l[?2004h>     buyer_id, seller_id, book_id, ws_amount = read_input('src/INPUT.DAT')
[?2004l[?2004h> 
[?2004l[?2004h>     # Validate users and book
[?2004l[?2004h>     accounts = read_accounts('data/ACCOUNTS.DAT')
[?2004l[?2004h>     books = read_books('data/BOOKS.DAT')
[?2004l[?2004h> 
[?2004l[?2004h>     buyer_found = False
[?2004l[?2004h>     seller_found = False
[?2004l[?2004h>     book_found = False
[?2004l[?2004h>     valid_owner = False
[?2004l[?2004h> 
[?2004l[?2004h>     for acc in accounts:
[?2004l[?2004h>         if acc['id'] == buyer_id:
[?2004l[?2004h>             buyer_found = True
[?2004l[?2004h>         if acc['id'] == seller_id:
[?2004l[?2004h>             seller_found = True
[?2004l[?2004h> 
[?2004l[?2004h>     for book in books:
[?2004l[?2004h>         if book['id'] == book_id:
[?2004l[?2004h>             book_found = True
[?2004l[?2004h>             if book['owner'] == seller_id:
[?2004l[?2004h>                 valid_owner = True
[?2004l[?2004h> 
[?2004l[?2004h>     # Process transaction if all validations pass
[?2004l[?2004h>     if buyer_found and seller_found and book_found and valid_owner:
[?2004l[?2004h>         # Update account balances
[?2004l[?2004h>         for acc in accounts:
[?2004l[?2004h>             if acc['id'] == buyer_id:
[?2004l[?2004h>                 acc['balance'] -= ws_amount
[?2004l[?2004h>             if acc['id'] == seller_id:
[?2004l[?2004h>                 acc['balance'] += ws_amount
[?2004l[?2004h>         write_accounts('data/ACCOUNTS.DAT', accounts)
[?2004l[?2004h> 
[?2004l[?2004h>         # Update book ownership
[?2004l[?2004h>         for book in books:
[?2004l[?2004h>             if book['id'] == book_id:
[?2004l[?2004h>                 book['owner'] = buyer_id
[?2004l[?2004h>         write_books('data/BOOKS.DAT', books)
[?2004l[?2004h> 
[?2004l[?2004h>         # Append transaction record
[?2004l[?2004h>         append_transaction('data/TRANSACTIONS.DAT', book_id, ws_amount, seller_id, buyer_id)
[?2004l[?2004h> 
[?2004l[?2004h>         print("Transaction completed successfully")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print("Transaction failed due to validation errors")
[?2004l[?2004h> 
