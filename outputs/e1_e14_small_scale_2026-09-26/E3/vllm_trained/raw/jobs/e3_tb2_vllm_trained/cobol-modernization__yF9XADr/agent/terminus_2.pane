[?2004hroot@modal:/app# cat > /app/program.py << 'PYEOF'
[?2004l[?2004h> import os
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> # Record sizes
[?2004l[?2004h> ACCOUNT_REC_SIZE = 34  # ID(4) + Name(20) + Balance(10)
[?2004l[?2004h> BOOK_REC_SIZE = 28     # ID(4) + Title(20) + Owner(4)
[?2004l[?2004h> TRANS_REC_SIZE = 22    # Book(4) + Amount(10) + Seller(4) + Buyer(4)
[?2004l[?2004h> INPUT_REC_SIZE = 22    # Buyer(4) + Seller(4) + Book(4) + Amount(10)
[?2004l[?2004h> 
[?2004l[?2004h> def read_input(filepath):
[?2004l[?2004h>     with open(filepath, 'rb') as f:
[?2004l[?2004h>         data = f.read()
[?2004l[?2004h>     if len(data) < INPUT_REC_SIZE:
[?2004l[?2004h>         print("Error: Input file is empty")
[?2004l[?2004h>         sys.exit(1)
[?2004l[?2004h>     buyer_id = data[0:4].decode('ascii')
[?2004l[?2004h>     seller_id = data[4:8].decode('ascii')
[?2004l[?2004h>     book_id = data[8:12].decode('ascii')
[?2004l[?2004h>     amount_str = data[12:22].decode('ascii')
[?2004l[?2004h>     amount = int(amount_str)  # PIC 9(10)
[?2004l[?2004h>     # In COBOL: WS-AMOUNT is PIC 9(10)V99
[?2004l[?2004h>     # MOVE INPUT-AMOUNT TO WS-AMOUNT: the integer value is placed in the integer part
[?2004l[?2004h>     # So WS-AMOUNT = amount (as integer, the V99 part is 00)
[?2004l[?2004h>     # When used in ADD/SUBTRACT with PIC 9(10), only integer part matters
[?2004l[?2004h>     ws_amount = amount  # effectively the integer part
[?2004l[?2004h>     return buyer_id, seller_id, book_id, ws_amount
[?2004l[?2004h> 
[?2004l[?2004h> def read_accounts(filepath):
[?2004l[?2004h>     records = []
[?2004l[?2004h>     with open(filepath, 'rb') as f:
[?2004l[?2004h>         data = f.read()
[?2004l[?2004h>     for i in range(0, len(data), ACCOUNT_REC_SIZE):
[?2004l[?2004h>         rec = data[i:i+ACCOUNT_REC_SIZE]
[?2004l[?2004h>         if len(rec) == ACCOUNT_REC_SIZE:
[?2004l[?2004h>             acc_id = rec[0:4].decode('ascii')
[?2004l[?2004h>             acc_name = rec[4:24].decode('ascii')
[?2004l[?2004h>             acc_balance = int(rec[24:34].decode('ascii'))
[?2004l[?2004h>             records.append({
[?2004l[?2004h>                 'id': acc_id,
[?2004l[?2004h>                 'name': acc_name,
[?2004l[?2004h>                 'balance': acc_balance
[?2004l[?2004h>             })
[?2004l[?2004h>     return records
