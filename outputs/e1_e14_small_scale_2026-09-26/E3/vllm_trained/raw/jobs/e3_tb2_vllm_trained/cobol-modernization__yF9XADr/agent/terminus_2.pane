[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> def read_fixed_records(filepath, record_size):
[?2004l[?2004h>     """Read a file as fixed-length records."""
[?2004l[?2004h>     records = []
[?2004l[?2004h>     if not os.path.exists(filepath):
[?2004l[?2004h>         return records
[?2004l[?2004h>     with open(filepath, 'rb') as f:
[?2004l[?2004h>         content = f.read()
[?2004l[?2004h>     if not content:
[?2004l[?2004h>         return records
[?2004l[?2004h>     # Handle line-sequential: strip trailing newline if present
[?2004l[?2004h>     if content.endswith(b'\n'):
[?2004l[?2004h>         content = content[:-1]
[?2004l[?2004h>     # Also handle files that might have \r\n
[?2004l[?2004h>     if content.endswith(b'\r\n'):
[?2004l[?2004h>         content = content[:-2]
[?2004l[?2004h>     num_records = len(content) // record_size
[?2004l[?2004h>     for i in range(num_records):
[?2004l[?2004h>         record = content[i * record_size:(i + 1) * record_size]
[?2004l[?2004h>         records.append(record)
[?2004l[?2004h>     return records
[?2004l[?2004h> 
[?2004l[?2004h> def write_fixed_records(filepath, records):
[?2004l[?2004h>     """Write records as fixed-length records with newline separators."""
[?2004l[?2004h>     with open(filepath, 'wb') as f:
[?2004l[?2004h>         for record in records:
[?2004l[?2004h>             f.write(record)
[?2004l[?2004h>             f.write(b'\n')
[?2004l[?2004h> 
