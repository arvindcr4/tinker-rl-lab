[315.063994, "i", "python3 << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nimport json\n\n# Load metadata and filter for science domain\nmetadata = load_dataset('ryanmarten/OpenThoughts-1k-sample', 'metadata', split='train')\n\n# Filter for science domain (physics, chemistry, biology)\nscience_mask = [d in ['physics', 'chemistry', 'biology'] for d in metadata['domain']]\nscience_data = metadata.filter(lambda x: x['domain'] in ['physics', 'chemistry', 'biology'])\nprint(f\"Science examples: {len(science_data)}\")\n\n# Load tokenizer\ntokenizer = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\n\n# Count tokens in deepseek_reasoning and deepseek_solution\ntotal_tokens = 0\nfor i in range(len(science_data)):\n    reasoning = science_data[i]['deepseek_reasoning']\n    solution = science_data[i]['deepseek_solution']\n    \n    reasoning_tokens = len(tokenizer.encode(reasoning, add_special_tokens=False))\n    solution_tokens = len(tokenizer.encode(solution, add_special_tokens=False))\n    \n    print(f\"Example {"]
[315.064041, "i", "i} (domain={science_data[i]['domain']}): reasoning={reasoning_tokens}, solution={solution_tokens}, total={reasoning_tokens + solution_tokens}\")\n    total_tokens += reasoning_tokens + solution_tokens\n\nprint(f\"\\nTotal deepseek tokens in science domain: {total_tokens}\")\nEOF\n"]
