[302.690553, "i", "python3 -c \"\nimport numpy as np\nimport time\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Test with overwrite_a\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues, eigenvectors = np.linalg.eig(A, overwrite_a=True)\n    idx = np.argmax(np.abs(eigenvalues))\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eig(overwrite_a=True) median: {np.median(dts):.6f}')\n\n# Test eigvals only\ndts2 = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    t1 = time.perf_counter()\n    dts2.append(t1-t0)\nprint(f'eigvals median: {np.median(dts2):.6f}')\n\n# Test eigvals + eigenvector via complex lstsq\ndts3 = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues)"]
[302.690853, "i", ")\n    lam = eigenvalues[idx]\n    B = A - lam * np.eye(10)\n    # Use SVD to find null space\n    U, S, Vh = np.linalg.svd(B)\n    evec = Vh[-1]\n    t1 = time.perf_counter()\n    dts3.append(t1-t0)\nprint(f'eigvals+SVD median: {np.median(dts3):.6f}')\n\"\n"]
