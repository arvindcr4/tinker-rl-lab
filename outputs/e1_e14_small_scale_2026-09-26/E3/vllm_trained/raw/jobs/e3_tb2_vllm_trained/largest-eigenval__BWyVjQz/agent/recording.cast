[272.037213, "o", "\u001b[?2004h"]
[272.037296, "o", "> "]
[272.038002, "o", "        double norm = sqrt(v_k1 * v_k1 + sigma);\r\n\u001b[?2004l\r"]
[272.038156, "o", "\u001b[?2004h"]
