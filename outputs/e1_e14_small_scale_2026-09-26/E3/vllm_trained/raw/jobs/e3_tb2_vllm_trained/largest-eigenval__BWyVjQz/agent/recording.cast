[413.477283, "i", "python3 -c \"\nimport numpy as np\nimport time\n\n# Test: eigvals + eigenvector via solving\nA = np.random.normal(size=(10,10)).astype(np.float64)\neigenvalues = np.linalg.eigvals(A)\nidx = np.argmax(np.abs(eigenvalues))\nlambda_d = eigenvalues[idx]\n\n# Compute eigenvector by finding null space of (A - lambda*I)\n# Use SVD\nB = A - lambda_d * np.eye(10)\nu, s, vh = np.linalg.svd(B)\nevec = vh[-1]\nprint(f'Eigenvalue: {lambda_d}')\nprint(f'Verification: {np.allclose(A @ evec, lambda_d * evec)}')\n\n# Time it\ndts = []\nfor i in range(200):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lambda_d = eigenvalues[idx]\n    B = A - lambda_d * np.eye(10)\n    u, s, vh = np.linalg.svd(B)\n    evec = vh[-1]\n    t0 = time.perf_counter()\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals + SVD median: {np.median(dts):.6f}s')\n\"\n"]
