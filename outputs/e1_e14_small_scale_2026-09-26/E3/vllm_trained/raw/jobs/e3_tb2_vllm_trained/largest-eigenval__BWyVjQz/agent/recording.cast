[201.079377, "i", "python3 -c \"\nimport numpy as np\nimport time\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Approach: eigvals + SVD for eigenvector\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lam = eigenvalues[idx]\n    # Compute eigenvector via SVD of (A - lam*I)\n    B = A - lam * np.eye(10)\n    U, S, Vt = np.linalg.svd(B)\n    evec = Vt[-1]  # last row of Vt corresponds to smallest singular value\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals+SVD median: {np.median(dts):.6f}')\n\n# Verify correctness\nA = np.random.normal(size=(10,10)).astype(np.float64)\neigenvalues = np.linalg.eigvals(A)\nidx = np.argmax(np.abs(eigenvalues))\nlam = eigenvalues[idx]\nB = A - lam * np.eye(10)\nU, S, Vt = np.linalg.svd(B)\nevec = Vt[-1]\nprint(f'Residual: {np.linalg.norm(A @ evec - lam * evec):.2e}')\n\"\n"]
