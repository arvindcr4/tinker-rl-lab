[489.813723, "i", "cat > /app/eigen.c << 'EOF'\n#include <math.h>\n#include <stdlib.h>\n#include <string.h>\n#include <float.h>\n#define NMAX 10\n#define TOL 1e-14\n\nstatic void hessenberg(const double *A, int n, double *H, double *Q) {\n    memcpy(H, A, n*n*sizeof(double));\n    memset(Q, 0, n*n*sizeof(double));\n    for(int i=0;i<n;i++) Q[i*n+i]=1.0;\n    for(int k=0;k<n-2;k++) {\n        double s=0.0;\n        for(int i=k+1;i<n;i++) s+=H[i*n+k]*H[i*n+k];\n        if(s<1e-30) continue;\n        double a=sqrt(s);\n        if(H[(k+1)*n+k]>0) a=-a;\n        double v0=H[(k+1)*n+k]-a;\n        double nv=sqrt(v0*v0+s-H[(k+1)*n+k]*H[(k+1)*n+k]);\n        if(nv<1e-30) continue;\n        double v[10]; v[0]=v0/nv;\n        for(int i=1;i<n-k-1;i++) v[i]=H[(k+1+i)*n+k]/nv;\n        for(int j=k;j<n;j++) {\n            double d=0.0;\n            for(int i=k+1;i<n;i++) d+=v[i-k-1]*H[i*n+j];\n            for(int i=k+1;i<n;i++) H[i*n+j]-=2.0*v[i-k-1]*d;\n        }\n        for(int i=0;i<n;i++) {\n            double d=0.0;\n            for(int j=k+1;j<n;j++) d+=H[i*n+j]*v"]
[489.814158, "i", "[j-k-1];\n            for(int j=k+1;j<n;j++) H[i*n+j]-=2.0*d*v[j-k-1];\n        }\n        for(int j=k+1;j<n;j++) {\n            double d=0.0;\n            for(int i=k+1;i<n;i++) d+=Q[i*n+j]*v[i-k-1];\n            for(int i=k+1;i<n;i++) Q[i*n+j]-=2.0*d*v[i-k-1];\n        }\n    }\n}\n\nstatic void qr_step(double *H, int n, int m, double *Q) {\n    double x=H[0], y=H[n+1], z=0.0;\n    for(int k=0;k<m-1;k++) {\n        double r=sqrt(x*x+y*y);\n        if(r<1e-30) { x=H[(k+2)*n+k]; y=H[(k+2)*n+k+1]; z=H[(k+2)*n+k+2]; continue; }\n        double cs=x/r, sn=y/r;\n        for(int j=k;j<n;j++) {\n            double t1=cs*H[k*n+j]+sn*H[(k+1)*n+j];\n            double t2=-sn*H[k*n+j]+cs*H[(k+1)*n+j];\n            H[k*n+j]=t1; H[(k+1)*n+j]=t2;\n        }\n        for(int i=0;i<m;i++) {\n            double t1=cs*H[i*n+k]+sn*H[i*n+k+1];\n            double t2=-sn*H[i*n+k]+cs*H[i*n+k+1];\n            H[i*n+k]=t1; H[i*n+k+1]=t2;\n        }\n        for(int i=0;i<n;i++) {\n            double t1=cs*Q[i*n+k]+sn*Q[i*n+k+1];\n            double t2=-sn*Q[i*"]
[489.814363, "i", "n+k]+cs*Q[i*n+k+1];\n            Q[i*n+k]=t1; Q[i*n+k+1]=t2;\n        }\n        if(k<m-2) { x=H[(k+2)*n+k]; y=H[(k+2)*n+k+1]; z=H[(k+2)*n+k+2]; }\n    }\n}\n\nstatic void wilkinson_shift(const double *H, int m, double *sr, double *si) {\n    double a=H[(m-2)*n+m-2], b=H[(m-2)*n+m-1];\n    double c=H[(m-1)*n+m-2], d=H[(m-1)*n+m-1];\n    double tr=a+d, det=a*d-b*c;\n    double disc=tr*tr-4.0*det;\n    if(disc>=0) {\n        double sd=sqrt(disc), s1=(tr+sd)/2.0, s2=(tr-sd)/2.0;\n        double r1=fabs(a-s1)+fabs(b), r2=fabs(a-s2)+fabs(b);\n        *sr=(r1<r2)?s1:s2; *si=0.0;\n    } else {\n        *sr=d; *si=0.0;\n    }\n}\n\nint find_dominant_eigenvalue_and_eigenvector_c(const double *A, int n, double *eval_re, double *eval_im, double *evec_re, double *evec_im) {\n    double H[100], Q[100];\n    hessenberg(A, n, H, Q);\n\n    // QR iteration\n    for(int iter=0;iter<1000;iter++) {\n        int m=n;\n        while(m>0) {\n            int i;\n            for(i=m-1;i>0;i--) {\n                if(fabs(H[i*n+i-1])<TOL*(fabs(H[(i-1)*n+i-1])+fabs("]
[489.815197, "i", "H[i*n+i]))) break;\n            }\n            if(i==m) {\n                eval_re[m-1]=H[(m-1)*n+m-1]; eval_im[m-1]=0.0; m--; continue;\n            }\n            int j=i-1;\n            if(fabs(H[j*n+j-1])<TOL*(fabs(H[(j-1)*n+j-1])+fabs(H[j*n+j]))) {\n                eval_re[m-1]=H[(m-1)*n+m-1]; eval_im[m-1]=0.0;\n                eval_re[m-2]=H[(m-2)*n+m-2]; eval_im[m-2]=0.0;\n                m-=2; continue;\n            }\n            double sr, si;\n            wilkinson_shift(H, m, &sr, &si);\n            // Apply shift\n            for(int k=0;k<m;k++) H[k*n+k]-=sr;\n            qr_step(H, n, m, Q);\n            for(int k=0;k<m;k++) H[k*n+k]+=sr;\n        }\n    }\n\n    // Find dominant eigenvalue\n    double max_mag=0.0, max_re=0.0, max_im=0.0;\n    for(int i=0;i<n;i++) {\n        double mag=sqrt(eval_re[i]*eval_re[i]+eval_im[i]*eval_im[i]);\n        if(mag>max_mag) { max_mag=mag; max_re=eval_re[i]; max_im=eval_im[i]; }\n    }\n    *eval_re=max_re; *eval_im=max_im;\n\n    // Inverse iteration for eigenvector\n    // For complex "]
[489.815484, "i", "eigenvalue, solve (A - lambda*I)*v = v iteratively\n    // Using 2n x 2n real system\n    double M[400], L[400];\n    int piv[20];\n    double x[20], y[20];\n    for(int iter=0;iter<200;iter++) {\n        // Build 2n x 2n system\n        for(int i=0;i<n;i++) {\n            for(int j=0;j<n;j++) {\n                M[i*2*n+j]=A[i*n+j]; M[i*2*n+j+n]=0.0;\n                M[(i+n)*2*n+j]=0.0; M[(i+n)*2*n+j+n]=A[i*n+j];\n            }\n            M[i*2*n+i]-=max_re; M[(i+n)*2*n+i+n]-=max_re;\n            M[i*2*n+i+n]=-max_im; M[(i+n)*2*n+i]=max_im;\n        }\n        memcpy(L,M,4*n*n*sizeof(double));\n        for(int i=0;i<2*n;i++) piv[i]=i;\n        int sing=0;\n        for(int k=0;k<2*n;k++) {\n            int mr=k; double mv=fabs(L[k*2*n+k]);\n            for(int i=k+1;i<2*n;i++) {\n                double v=fabs(L[i*2*n+k]);\n                if(v>mv){mv=v;mr=i;}\n            }\n            if(mr!=k) {\n                for(int j=0;j<2*n;j++) { double t=L[k*2*n+j];L[k*2*n+j]=L[mr*2*n+j];L[mr*2*n+j]=t; }\n                int t=piv[k];piv[k"]
[489.815581, "i", "]=piv[mr];piv[mr]=t;\n            }\n            if(fabs(L[k*2*n+k])<1e-30){sing=1;break;}\n            for(int i=k+1;i<2*n;i++) {\n                double f=L[i*2*n+k]/L[k*2*n+k];\n                for(int j=k+1;j<2*n;j++) L[i*2*n+j]-=f*L[k*2*n+j];\n                L[i*2*n+k]=f;\n            }\n        }\n        if(sing) {\n            for(int i=0;i<n;i++){evec_re[i]=(double)(i+1);evec_im[i]=0.0;}\n            continue;\n        }\n        // Forward sub\n        for(int i=0;i<2*n;i++) y[i]=0.0;\n        for(int i=0;i<2*n;i++) {\n            int pi=piv[i];\n            y[i]=(pi<n)?evec_re[pi]:evec_re[pi-n];\n            for(int j=0;j<i;j++) y[i]-=L[i*2*n+j]*y[j];\n        }\n        // Back sub\n        for(int i=2*n-1;i>=0;i--) {\n            x[i]=y[i];\n            for(int j=i+1;j<2*n;j++) x[i]-=L[i*2*n+j]*x[j];\n            x[i]/=L[i*2*n+i];\n        }\n        // Normalize\n        double nm=0.0;\n        for(int i=0;i<n;i++) nm+=x[i]*x[i]+x[i+n]*x[i+n];\n        nm=sqrt(nm);\n        if(nm<1e-30) { for(int i=0;i<n;i++){evec_re[i]=(do"]
[489.81574, "i", "uble)(i+1);evec_im[i]=0.0;} continue; }\n        for(int i=0;i<n;i++) { evec_re[i]=x[i]/nm; evec_im[i]=x[i+n]/nm; }\n    }\n    return 0;\n}\nEOF\n"]
