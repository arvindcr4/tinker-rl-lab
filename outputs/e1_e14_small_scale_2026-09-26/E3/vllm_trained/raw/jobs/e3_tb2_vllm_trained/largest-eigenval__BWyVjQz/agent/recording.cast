[272.063209, "o", "\u001b[?2004h"]
[272.063295, "o", "> "]
[272.064122, "o", "            double a = H[0], b = H[1], c = H[n], d = H[n+1];\r\n\u001b[?2004l\r"]
[272.064234, "o", "\u001b[?2004h"]
[272.064327, "o", "> "]
[272.064726, "o", "            double trace = a + d;\r\n\u001b[?2004l\r"]
[272.064862, "o", "\u001b[?2004h"]
[272.064981, "o", "> "]
[272.065568, "o", "            double det = a * d - b * c;\r\n\u001b[?2004l\r"]
[272.065723, "o", "\u001b[?2004h"]
[272.065846, "o", "> "]
[272.066402, "o", "            double disc = trace * trace - 4.0 * det;\r\n\u001b[?2004l\r"]
[272.066499, "o", "\u001b[?2004h"]
[272.06657, "o", "> "]
[272.0668, "o", "            \r\n\u001b[?2004l\r"]
[272.066913, "o", "\u001b[?2004h"]
[272.06701, "o", "> "]
[272.067435, "o", "            if (disc >= 0) {\r\n\u001b[?2004l\r"]
[272.067559, "o", "\u001b[?2004h"]
[272.067677, "o", "> "]
[272.068322, "o", "                double sqrt_disc = sqrt(disc);\r\n\u001b[?2004l\r"]
[272.068471, "o", "\u001b[?2004h"]
[272.068572, "o", "> "]
[272.069412, "o", "                eigenvalues[0] = (trace + sqrt_disc) / 2.0;\r\n\u001b[?2004l\r"]
[272.069552, "o", "\u001b[?2004h"]
[272.069706, "o", "> "]
[272.070343, "o", "                eigenvalues[1] = (trace - sqrt_disc) / 2.0;\r\n\u001b[?2004l\r"]
[272.070455, "o", "\u001b[?2004h"]
[272.07058, "o", "> "]
[272.070914, "o", "            } else {\r\n\u001b[?2004l\r"]
[272.071039, "o", "\u001b[?2004h"]
[272.071147, "o", "> "]
[272.07212, "o", "                // Complex eigenvalues - store real and imaginary parts\r\n\u001b[?2004l\r"]
[272.07225, "o", "\u001b[?2004h"]
[272.07234, "o", "> "]
[272.072823, "o", "                eigenvalues[0] = trace / 2.0;\r\n\u001b[?2004l\r"]
[272.07294, "o", "\u001b[?2004h"]
[272.073027, "o", "> "]
[272.073766, "o", "                eigenvalues[1] = sqrt(-disc) / 2.0;\r\n\u001b[?2004l\r"]
[272.073907, "o", "\u001b[?2004h"]
[272.074031, "o", "> "]
[272.07428, "o", "            }\r\n\u001b[?2004l\r"]
[272.074442, "o", "\u001b[?2004h"]
[272.074567, "o", "> "]
[272.074898, "o", "            return 0;\r\n\u001b[?2004l\r"]
[272.074996, "o", "\u001b[?2004h"]
[272.075075, "o", "> "]
[272.075224, "o", "        }\r\n\u001b[?2004l\r"]
[272.075319, "o", "\u001b[?2004h"]
[272.075402, "o", "> "]
[272.075559, "o", "        \r\n\u001b[?2004l\r"]
[272.075689, "o", "\u001b[?2004h"]
[272.075775, "o", "> "]
[272.076219, "o", "        // Check for deflation\r\n\u001b[?2004l\r"]
[272.076345, "o", "\u001b[?2004h"]
[272.076444, "o", "> "]
[272.07721, "o", "        double off_diag = fabs(H[(nn-1) * n + nn - 2]);\r\n\u001b[?2004l\r"]
[272.077332, "o", "\u001b[?2004h"]
[272.077412, "o", "> "]
[272.077809, "o", "        double scale = 0.0;\r\n\u001b[?2004l\r"]
[272.077911, "o", "\u001b[?2004h"]
[272.077981, "o", "> "]
[272.078501, "o", "        for (int i = 0; i < nn; i++) {\r\n\u001b[?2004l\r"]
[272.078605, "o", "\u001b[?2004h"]
[272.078685, "o", "> "]
[272.07896, "o", "            for (int j = 0; j < nn; j++) {\r\n\u001b[?2004l\r"]
[272.079047, "o", "\u001b[?2004h"]
[272.079165, "o", "> "]
[272.079915, "o", "                scale = fmax(scale, fabs(H[i * n + j]));\r\n\u001b[?2004l\r"]
[272.080045, "o", "\u001b[?2004h"]
[272.080122, "o", "> "]
[272.080311, "o", "            }\r\n\u001b[?2004l\r"]
[272.080405, "o", "\u001b[?2004h"]
[272.080462, "o", "> "]
[272.080647, "o", "        }\r\n\u001b[?2004l\r"]
[272.080768, "o", "\u001b[?2004h"]
[272.080858, "o", "> "]
[272.081274, "o", "        if (scale < 1e-30) scale = 1.0;\r\n\u001b[?2004l\r"]
[272.081374, "o", "\u001b[?2004h"]
[272.081463, "o", "> "]
[272.081548, "o", "        \r\n\u001b[?2004l\r"]
[272.081604, "o", "\u001b[?2004h"]
[272.081719, "o", "> "]
[272.082117, "o", "        if (off_diag / scale < TOL) {\r\n\u001b[?2004l\r"]
[272.082237, "o", "\u001b[?2004h"]
[272.082301, "o", "> "]
[272.083072, "o", "            eigenvalues[nn - 1] = H[(nn-1) * n + nn - 1];\r\n\u001b[?2004l\r"]
[272.083188, "o", "\u001b[?2004h"]
[272.083275, "o", "> "]
[272.083552, "o", "            nn--;\r\n\u001b[?2004l\r"]
[272.083674, "o", "\u001b[?2004h"]
[272.083777, "o", "> "]
[272.084082, "o", "            continue;\r\n\u001b[?2004l\r"]
[272.08418, "o", "\u001b[?2004h"]
[272.084289, "o", "> "]
[272.084429, "o", "        }\r\n\u001b[?2004l\r"]
[272.084529, "o", "\u001b[?2004h"]
[272.084607, "o", "> "]
[272.084754, "o", "        \r\n\u001b[?2004l\r"]
[272.084873, "o", "\u001b[?2004h"]
[272.084952, "o", "> "]
[272.085321, "o", "        // Wilkinson shift\r\n\u001b[?2004l\r"]
[272.085433, "o", "\u001b[?2004h"]
[272.085527, "o", "> "]
[272.08582, "o", "        double a = H[(nn-2) * n + nn - 2];\r\n\u001b[?2004l\r"]
[272.085899, "o", "\u001b[?2004h"]
[272.085994, "o", "> "]
[272.086554, "o", "        double b = H[(nn-2) * n + nn - 1];\r\n\u001b[?2004l\r"]
[272.086684, "o", "\u001b[?2004h"]
[272.086766, "o", "> "]
[272.087337, "o", "        double c = H[(nn-1) * n + nn - 2];\r\n\u001b[?2004l\r"]
[272.087446, "o", "\u001b[?2004h"]
[272.087546, "o", "> "]
[272.087989, "o", "        double d = H[(nn-1) * n + nn - 1];\r\n\u001b[?2004l\r"]
[272.088072, "o", "\u001b[?2004h"]
[272.08815, "o", "> "]
[272.088459, "o", "        double trace = a + d;\r\n\u001b[?2004l\r"]
[272.088576, "o", "\u001b[?2004h"]
[272.088704, "o", "> "]
[272.089083, "o", "        double det = a * d - b * c;\r\n\u001b[?2004l\r"]
[272.089185, "o", "\u001b[?2004h"]
[272.089263, "o", "> "]
[272.089549, "o", "        double disc = trace * trace - 4.0 * det;\r\n\u001b[?2004l\r"]
[272.089609, "o", "\u001b[?2004h"]
[272.08972, "o", "> "]
[272.089871, "o", "        \r\n\u001b[?2004l\r"]
[272.090005, "o", "\u001b[?2004h"]
[272.090094, "o", "> "]
[272.090398, "o", "        double shift;\r\n\u001b[?2004l\r"]
[272.090508, "o", "\u001b[?2004h"]
[272.090573, "o", "> "]
[272.090938, "o", "        if (disc >= 0) {\r\n\u001b[?2004l\r"]
[272.091044, "o", "\u001b[?2004h"]
[272.09112, "o", "> "]
[272.091557, "o", "            double sqrt_disc = sqrt(disc);\r\n\u001b[?2004l\r"]
[272.09166, "o", "\u001b[?2004h"]
[272.091731, "o", "> "]
[272.092412, "o", "            double e1 = (trace + sqrt_disc) / 2.0;\r\n\u001b[?2004l\r"]
[272.092501, "o", "\u001b[?2004h"]
[272.092582, "o", "> "]
[272.093263, "o", "            double e2 = (trace - sqrt_disc) / 2.0;\r\n\u001b[?2004l\r"]
[272.093363, "o", "\u001b[?2004h"]
[272.093429, "o", "> "]
[272.094062, "o", "            shift = (fabs(e1 - d) > fabs(e2 - d)) ? e1 : e2;\r\n\u001b[?2004l\r"]
[272.094154, "o", "\u001b[?2004h"]
[272.09422, "o", "> "]
[272.094418, "o", "        } else {\r\n\u001b[?2004l\r"]
[272.094517, "o", "\u001b[?2004h"]
[272.094604, "o", "> "]
[272.094869, "o", "            shift = d;\r\n\u001b[?2004l\r"]
[272.094968, "o", "\u001b[?2004h"]
[272.095049, "o", "> "]
[272.095203, "o", "        }\r\n\u001b[?2004l\r"]
[272.095323, "o", "\u001b[?2004h"]
[272.095413, "o", "> "]
[272.095552, "o", "        \r\n\u001b[?2004l\r"]
[272.095658, "o", "\u001b[?2004h"]
[272.095746, "o", "> "]
[272.096103, "o", "        // Shifted QR step\r\n\u001b[?2004l\r"]
[272.09621, "o", "\u001b[?2004h"]
[272.096296, "o", "> "]
[272.096816, "o", "        for (int i = 0; i < nn; i++) {\r\n\u001b[?2004l\r"]
[272.096922, "o", "\u001b[?2004h"]
[272.097015, "o", "> "]
[272.097502, "o", "            H[i * n + i] -= shift;\r\n\u001b[?2004l\r"]
[272.097637, "o", "\u001b[?2004h"]
[272.097681, "o", "> "]
[272.097816, "o", "        }\r\n\u001b[?2004l\r"]
[272.097857, "o", "\u001b[?2004h"]
[272.097972, "o", "> "]
[272.098111, "o", "        \r\n\u001b[?2004l\r"]
[272.098221, "o", "\u001b[?2004h"]
[272.098306, "o", "> "]
[272.098818, "o", "        // QR decomposition using Givens rotations\r\n\u001b[?2004l\r"]
[272.098927, "o", "\u001b[?2004h"]
[272.09901, "o", "> "]
[272.099563, "o", "        for (int j = 0; j < nn - 1; j++) {\r\n\u001b[?2004l\r"]
[272.099675, "o", "\u001b[?2004h"]
[272.099757, "o", "> "]
[272.100121, "o", "            double x = H[j * n + j];\r\n\u001b[?2004l\r"]
[272.100212, "o", "\u001b[?2004h"]
[272.100278, "o", "> "]
[272.100835, "o", "            double y = H[(j+1) * n + j];\r\n\u001b[?2004l\r"]
[272.100947, "o", "\u001b[?2004h"]
[272.101041, "o", "> "]
[272.101496, "o", "            double r = sqrt(x * x + y * y);\r\n\u001b[?2004l\r"]
[272.101623, "o", "\u001b[?2004h"]
[272.101716, "o", "> "]
[272.102101, "o", "            if (r < 1e-30) continue;\r\n\u001b[?2004l\r"]
[272.102196, "o", "\u001b[?2004h"]
[272.102252, "o", "> "]
[272.102691, "o", "            double cs = x / r;\r\n\u001b[?2004l\r"]
[272.102789, "o", "\u001b[?2004h"]
[272.102865, "o", "> "]
[272.103313, "o", "            double sn = y / r;\r\n\u001b[?2004l\r"]
[272.103444, "o", "\u001b[?2004h"]
[272.10354, "o", "> "]
[272.103726, "o", "            \r\n\u001b[?2004l\r"]
[272.103826, "o", "\u001b[?2004h"]
[272.103887, "o", "> "]
[272.104624, "o", "            // Apply Givens rotation to rows j and j+1\r\n\u001b[?2004l\r"]
[272.104736, "o", "\u001b[?2004h"]
[272.104842, "o", "> "]
[272.105441, "o", "            for (int k = j; k < nn; k++) {\r\n\u001b[?2004l\r"]
[272.105558, "o", "\u001b[?2004h"]
[272.10564, "o", "> "]
[272.106211, "o", "                double t1 = H[j * n + k];\r\n\u001b[?2004l\r"]
[272.106316, "o", "\u001b[?2004h"]
[272.106398, "o", "> "]
[272.107018, "o", "                double t2 = H[(j+1) * n + k];\r\n\u001b[?2004l\r"]
[272.107131, "o", "\u001b[?2004h"]
[272.107197, "o", "> "]
[272.107873, "o", "                H[j * n + k] = cs * t1 + sn * t2;\r\n\u001b[?2004l\r"]
[272.107985, "o", "\u001b[?2004h"]
[272.108049, "o", "> "]
[272.108857, "o", "                H[(j+1) * n + k] = -sn * t1 + cs * t2;\r\n\u001b[?2004l\r"]
[272.109003, "o", "\u001b[?2004h> "]
[272.109165, "o", "            }\r\n\u001b[?2004l\r"]
[272.109252, "o", "\u001b[?2004h"]
[272.109328, "o", "> "]
[272.109484, "o", "        }\r\n\u001b[?2004l\r"]
[272.109613, "o", "\u001b[?2004h"]
[272.109696, "o", "> "]
[272.10983, "o", "        \r\n\u001b[?2004l\r"]
[272.109925, "o", "\u001b[?2004h"]
[272.110026, "o", "> "]
[272.110759, "o", "        // Multiply R * Q (apply rotations from right)\r\n\u001b[?2004l\r"]
[272.110873, "o", "\u001b[?2004h"]
[272.110949, "o", "> "]
[272.111512, "o", "        for (int j = 0; j < nn - 1; j++) {\r\n\u001b[?2004l\r"]
[272.111623, "o", "\u001b[?2004h"]
[272.111707, "o", "> "]
[272.112192, "o", "            double x = H[j * n + j];\r\n\u001b[?2004l\r"]
[272.112296, "o", "\u001b[?2004h"]
[272.11237, "o", "> "]
[272.112923, "o", "            double y = H[(j+1) * n + j];\r\n\u001b[?2004l\r"]
[272.113026, "o", "\u001b[?2004h"]
[272.113111, "o", "> "]
[272.113683, "o", "            double r = sqrt(x * x + y * y);\r\n\u001b[?2004l\r"]
[272.113785, "o", "\u001b[?2004h"]
[272.113863, "o", "> "]
[272.114233, "o", "            if (r < 1e-30) continue;\r\n\u001b[?2004l\r"]
[272.114326, "o", "\u001b[?2004h"]
[272.114402, "o", "> "]
[272.114821, "o", "            double cs = x / r;\r\n\u001b[?2004l\r"]
[272.114947, "o", "\u001b[?2004h"]
[272.115032, "o", "> "]
[272.115255, "o", "            double sn = y / r;\r\n\u001b[?2004l\r"]
[272.115326, "o", "\u001b[?2004h"]
[272.115415, "o", "> "]
[272.115562, "o", "            \r\n\u001b[?2004l\r"]
[272.115675, "o", "\u001b[?2004h"]
[272.115763, "o", "> "]
[272.116328, "o", "            for (int i = 0; i < nn; i++) {\r\n\u001b[?2004l\r"]
[272.116429, "o", "\u001b[?2004h"]
[272.116515, "o", "> "]
[272.11708, "o", "                double t1 = H[i * n + j];\r\n\u001b[?2004l\r"]
[272.117181, "o", "\u001b[?2004h"]
[272.117254, "o", "> "]
[272.117862, "o", "                double t2 = H[i * n + (j+1)];\r\n\u001b[?2004l\r"]
[272.117961, "o", "\u001b[?2004h"]
[272.118039, "o", "> "]
[272.11869, "o", "                H[i * n + j] = cs * t1 + sn * t2;\r\n\u001b[?2004l\r"]
[272.11879, "o", "\u001b[?2004h"]
[272.118874, "o", "> "]
[272.119613, "o", "                H[i * n + (j+1)] = -sn * t1 + cs * t2;\r\n\u001b[?2004l\r"]
[272.11972, "o", "\u001b[?2004h"]
[272.119809, "o", "> "]
[272.120001, "o", "            }\r\n\u001b[?2004l\r"]
[272.120108, "o", "\u001b[?2004h"]
[272.120179, "o", "> "]
[272.120325, "o", "        }\r\n\u001b[?2004l\r"]
[272.120424, "o", "\u001b[?2004h"]
[272.120502, "o", "> "]
[272.120636, "o", "        \r\n\u001b[?2004l\r"]
[272.120745, "o", "\u001b[?2004h"]
[272.120824, "o", "> "]
[272.121169, "o", "        // Restore shift\r\n\u001b[?2004l\r"]
[272.121265, "o", "\u001b[?2004h"]
[272.121342, "o", "> "]
[272.121886, "o", "        for (int i = 0; i < nn; i++) {\r\n\u001b[?2004l\r"]
[272.121996, "o", "\u001b[?2004h"]
[272.122067, "o", "> "]
[272.122542, "o", "            H[i * n + i] += shift;\r\n\u001b[?2004l\r"]
[272.122653, "o", "\u001b[?2004h"]
[272.122747, "o", "> "]
[272.122908, "o", "        }\r\n\u001b[?2004l\r"]
[272.123029, "o", "\u001b[?2004h"]
[272.123126, "o", "> "]
[272.123291, "o", "        \r\n\u001b[?2004l\r"]
[272.123415, "o", "\u001b[?2004h"]
[272.12349, "o", "> "]
[272.123646, "o", "        iter++;\r\n\u001b[?2004l\r"]
[272.123718, "o", "\u001b[?2004h"]
[272.12377, "o", "> "]
[272.124254, "o", "        if (iter > MAX_ITER) break;\r\n\u001b[?2004l\r"]
[272.124387, "o", "\u001b[?2004h"]
[272.124466, "o", "> "]
[272.124563, "o", "    }\r\n\u001b[?2004l\r"]
[272.124674, "o", "\u001b[?2004h"]
[272.124753, "o", "> "]
[272.124848, "o", "    \r\n\u001b[?2004l\r"]
[272.124934, "o", "\u001b[?2004h"]
[272.125011, "o", "> "]
[272.125167, "o", "    return 0;\r\n\u001b[?2004l\r"]
[272.125254, "o", "\u001b[?2004h"]
[272.12532, "o", "> "]
[272.125373, "o", "}\r\n\u001b[?2004l\r"]
[272.125468, "o", "\u001b[?2004h"]
[272.125539, "o", "> \r\n"]
[272.125651, "o", "\u001b[?2004l\r"]
[272.125738, "o", "\u001b[?2004h"]
[272.125834, "o", "> "]
[272.126768, "o", "// Compute eigenvector for a given eigenvalue using inverse iteration\r\n\u001b[?2004l\r"]
[272.126874, "o", "\u001b[?2004h"]
[272.126959, "o", "> "]
[272.128451, "o", "void compute_eigenvector(const double *A, int n, double lambda_r, double lambda_i, double *evec_r, double *evec_i) {\r\n\u001b[?2004l\r"]
[272.128557, "o", "\u001b[?2004h"]
[272.128645, "o", "> "]
[272.129351, "o", "    // Build (A - lambda*I) and solve for null space\r\n\u001b[?2004l\r"]
[272.129462, "o", "\u001b[?2004h"]
[272.129549, "o", "> "]
[272.130359, "o", "    // Use power iteration with shift: (A - sigma*I)^{-1} v\r\n\u001b[?2004l\r"]
[272.130477, "o", "\u001b[?2004h"]
[272.130571, "o", "> "]
[272.131014, "o", "    // Start with random vector\r\n\u001b[?2004l\r"]
[272.13114, "o", "\u001b[?2004h"]
[272.13122, "o", "> "]
[272.131686, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.131822, "o", "\u001b[?2004h"]
[272.131908, "o", "> "]
[272.132335, "o", "        evec_r[i] = 1.0 / sqrt((double)n);\r\n\u001b[?2004l\r"]
[272.13242, "o", "\u001b[?2004h"]
[272.132502, "o", "> "]
[272.132763, "o", "        evec_i[i] = 0.0;\r\n\u001b[?2004l\r"]
[272.132846, "o", "\u001b[?2004h"]
[272.132919, "o", "> "]
[272.132994, "o", "    }\r\n\u001b[?2004l\r"]
[272.133071, "o", "\u001b[?2004h"]
[272.133136, "o", "> "]
[272.133203, "o", "    \r\n\u001b[?2004l\r"]
[272.133308, "o", "\u001b[?2004h"]
[272.133356, "o", "> "]
[272.133965, "o", "    // Simple inverse iteration with shift\r\n\u001b[?2004l\r"]
[272.134108, "o", "\u001b[?2004h"]
[272.134189, "o", "> "]
[272.135058, "o", "    // For simplicity, use a few steps of shifted power iteration\r\n\u001b[?2004l\r"]
[272.135156, "o", "\u001b[?2004h"]
[272.135237, "o", "> "]
[272.135709, "o", "    double sigma = lambda_r;  // real shift\r\n\u001b[?2004l\r"]
[272.135794, "o", "\u001b[?2004h"]
[272.135857, "o", "> "]
[272.135927, "o", "    \r\n\u001b[?2004l\r"]
[272.136007, "o", "\u001b[?2004h"]
[272.136073, "o", "> "]
[272.136511, "o", "    for (int iter = 0; iter < 100; iter++) {\r\n\u001b[?2004l\r"]
[272.136607, "o", "\u001b[?2004h"]
[272.136672, "o", "> "]
[272.137032, "o", "        // w = (A - sigma*I)^{-1} v\r\n\u001b[?2004l\r"]
[272.137125, "o", "\u001b[?2004h"]
[272.137172, "o", "> "]
[272.137616, "o", "        // Build A - sigma*I\r\n"]
[272.137679, "o", "\u001b[?2004l\r"]
[272.137778, "o", "\u001b[?2004h"]
[272.137859, "o", "> "]
[272.138346, "o", "        double B[100]; // max 10x10\r\n\u001b[?2004l\r"]
[272.138464, "o", "\u001b[?2004h"]
[272.13857, "o", "> "]
[272.138824, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.138923, "o", "\u001b[?2004h"]
[272.138991, "o", "> "]
[272.139409, "o", "            for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[272.139503, "o", "\u001b[?2004h"]
[272.139572, "o", "> "]
[272.140043, "o", "                B[i * n + j] = A[i * n + j];\r\n\u001b[?2004l\r"]
[272.140118, "o", "\u001b[?2004h"]
[272.140214, "o", "> "]
[272.140898, "o", "                if (i == j) B[i * n + j] -= sigma;\r\n\u001b[?2004l\r"]
[272.141026, "o", "\u001b[?2004h"]
[272.141103, "o", "> "]
[272.141306, "o", "            }\r\n\u001b[?2004l\r"]
[272.141399, "o", "\u001b[?2004h"]
[272.141476, "o", "> "]
[272.141629, "o", "        }\r\n\u001b[?2004l\r"]
[272.141735, "o", "\u001b[?2004h"]
[272.141812, "o", "> "]
[272.141944, "o", "        \r\n\u001b[?2004l\r"]
[272.142039, "o", "\u001b[?2004h"]
[272.142113, "o", "> "]
[272.142773, "o", "        // Solve B * w = v using LU decomposition\r\n\u001b[?2004l\r"]
[272.142873, "o", "\u001b[?2004h"]
[272.142951, "o", "> "]
[272.143767, "o", "        // Simple Gaussian elimination with partial pivoting\r\n\u001b[?2004l\r"]
[272.143878, "o", "\u001b[?2004h"]
[272.143958, "o", "> "]
[272.144747, "o", "        double L[100], U[100], P[100]; // LU and permutation\r\n\u001b[?2004l\r"]
[272.14485, "o", "\u001b[?2004h"]
[272.144925, "o", "> "]
[272.145521, "o", "        memcpy(U, B, n * n * sizeof(double));\r\n\u001b[?2004l\r"]
[272.145632, "o", "\u001b[?2004h"]
[272.145711, "o", "> "]
[272.146305, "o", "        for (int i = 0; i < n; i++) P[i] = i;\r\n\u001b[?2004l\r"]
[272.146409, "o", "\u001b[?2004h"]
[272.146486, "o", "> "]
[272.14663, "o", "        \r\n\u001b[?2004l\r"]
[272.146728, "o", "\u001b[?2004h"]
[272.146814, "o", "> "]
[272.147359, "o", "        for (int k = 0; k < n - 1; k++) {\r\n\u001b[?2004l\r"]
[272.147458, "o", "\u001b[?2004h"]
[272.147524, "o", "> "]
[272.14796, "o", "            // Partial pivoting\r\n\u001b[?2004l\r"]
[272.148073, "o", "\u001b[?2004h"]
[272.148157, "o", "> "]
[272.148534, "o", "            int max_row = k;\r\n\u001b[?2004l\r"]
[272.14865, "o", "\u001b[?2004h"]
[272.148755, "o", "> "]
[272.149418, "o", "            double max_val = fabs(U[k * n + k]);\r\n\u001b[?2004l\r"]
[272.149527, "o", "\u001b[?2004h"]
[272.149609, "o", "> "]
[272.150211, "o", "            for (int i = k + 1; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.15033, "o", "\u001b[?2004h"]
[272.150425, "o", "> "]
[272.151116, "o", "                if (fabs(U[i * n + k]) > max_val) {\r\n\u001b[?2004l\r"]
[272.151225, "o", "\u001b[?2004h"]
[272.151306, "o", "> "]
[272.151968, "o", "                    max_val = fabs(U[i * n + k]);\r\n\u001b[?2004l\r"]
[272.15207, "o", "\u001b[?2004h"]
[272.152147, "o", "> "]
[272.152585, "o", "                    max_row = i;\r\n\u001b[?2004l\r"]
[272.152699, "o", "\u001b[?2004h"]
[272.152812, "o", "> "]
[272.152968, "o", "                }\r\n\u001b[?2004l\r"]
[272.153053, "o", "\u001b[?2004h"]
[272.153131, "o", "> "]
[272.153305, "o", "            }\r\n\u001b[?2004l\r"]
[272.153429, "o", "\u001b[?2004h"]
[272.153514, "o", "> "]
[272.153966, "o", "            if (max_row != k) {\r\n\u001b[?2004l\r"]
[272.154076, "o", "\u001b[?2004h"]
[272.154163, "o", "> "]
[272.15476, "o", "                for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[272.154858, "o", "\u001b[?2004h"]
[272.1549, "o", "> "]
[272.155237, "o", "                    double tmp = U[k * n + j];\r\n\u001b[?2004l\r"]
[272.15533, "o", "\u001b[?2004h"]
[272.155381, "o", "> "]
[272.155976, "o", "                    U[k * n + j] = U[max_row * n + j];\r\n\u001b[?2004l\r"]
[272.156084, "o", "\u001b[?2004h"]
[272.156184, "o", "> "]
[272.156665, "o", "                    U[max_row * n + j] = tmp;\r\n\u001b[?2004l\r"]
[272.156765, "o", "\u001b[?2004h"]
[272.156877, "o", "> "]
[272.157042, "o", "                }\r\n\u001b[?2004l\r"]
[272.157158, "o", "\u001b[?2004h"]
[272.157239, "o", "> "]
[272.157902, "o", "                int tmp = P[k]; P[k] = P[max_row]; P[max_row] = tmp;\r\n\u001b[?2004l\r"]
[272.157984, "o", "\u001b[?2004h"]
[272.158039, "o", "> "]
[272.15825, "o", "            }\r\n\u001b[?2004l\r"]
[272.158363, "o", "\u001b[?2004h"]
[272.158453, "o", "> "]
[272.158639, "o", "            \r\n\u001b[?2004l\r"]
[272.158775, "o", "\u001b[?2004h"]
[272.15885, "o", "> "]
[272.159557, "o", "            if (fabs(U[k * n + k]) < 1e-30) continue;\r\n\u001b[?2004l\r"]
[272.159663, "o", "\u001b[?2004h"]
[272.159757, "o", "> "]
[272.159989, "o", "            \r\n\u001b[?2004l\r"]
[272.160103, "o", "\u001b[?2004h"]
[272.160188, "o", "> "]
[272.160829, "o", "            for (int i = k + 1; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.160934, "o", "\u001b[?2004h"]
[272.161009, "o", "> "]
[272.161816, "o", "                double factor = U[i * n + k] / U[k * n + k];\r\n\u001b[?2004l\r"]
[272.161911, "o", "\u001b[?2004h"]
[272.161975, "o", "> "]
[272.162572, "o", "                for (int j = k; j < n; j++) {\r\n\u001b[?2004l\r"]
[272.162673, "o", "\u001b[?2004h"]
[272.162751, "o", "> "]
[272.163506, "o", "                    U[i * n + j] -= factor * U[k * n + j];\r\n\u001b[?2004l\r"]
[272.163606, "o", "\u001b[?2004h"]
[272.163679, "o", "> "]
[272.163916, "o", "                }\r\n\u001b[?2004l\r"]
[272.164004, "o", "\u001b[?2004h"]
[272.164078, "o", "> "]
[272.164274, "o", "            }\r\n\u001b[?2004l\r"]
[272.164374, "o", "\u001b[?2004h"]
[272.164444, "o", "> "]
[272.164595, "o", "        }\r\n\u001b[?2004l\r"]
[272.164683, "o", "\u001b[?2004h"]
[272.164747, "o", "> "]
[272.164878, "o", "        \r\n\u001b[?2004l\r"]
[272.164973, "o", "\u001b[?2004h"]
[272.165045, "o", "> "]
[272.165462, "o", "        // Forward substitution\r\n\u001b[?2004l\r"]
[272.165553, "o", "\u001b[?2004h"]
[272.165631, "o", "> "]
[272.165904, "o", "        double w[n];\r\n\u001b[?2004l\r"]
[272.165993, "o", "\u001b[?2004h"]
[272.166063, "o", "> "]
[272.166559, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.16665, "o", "\u001b[?2004h"]
[272.166721, "o", "> "]
[272.167347, "o", "            w[i] = evec_r[P[i]]; // permuted RHS\r\n\u001b[?2004l\r"]
[272.167438, "o", "\u001b[?2004h"]
[272.16751, "o", "> "]
[272.168064, "o", "            for (int j = 0; j < i; j++) {\r\n\u001b[?2004l\r"]
[272.168154, "o", "\u001b[?2004h"]
[272.168223, "o", "> "]
[272.169281, "o", "                w[i] -= U[j * n + i] * w[j]; // Note: U is upper, need to use L\r\n\u001b[?2004l\r"]
[272.169372, "o", "\u001b[?2004h"]
[272.169446, "o", "> "]
[272.16964, "o", "            }\r\n\u001b[?2004l\r"]
[272.169738, "o", "\u001b[?2004h"]
[272.169837, "o", "> "]
[272.170504, "o", "            // Actually let me redo this properly\r\n\u001b[?2004l\r"]
[272.170616, "o", "\u001b[?2004h"]
[272.170713, "o", "> "]
[272.170866, "o", "        }\r\n\u001b[?2004l\r"]
[272.170956, "o", "\u001b[?2004h"]
[272.171032, "o", "> "]
[272.171168, "o", "        \r\n\u001b[?2004l\r"]
[272.171258, "o", "\u001b[?2004h"]
[272.171328, "o", "> "]
[272.17198, "o", "        // Simpler approach: just do one step of shifted power iteration\r\n\u001b[?2004l\r"]
[272.172053, "o", "\u001b[?2004h"]
[272.172098, "o", "> "]
[272.172303, "o", "        // w = A * v, then normalize\r\n\u001b[?2004l\r"]
[272.172355, "o", "\u001b[?2004h"]
[272.172432, "o", "> "]
[272.172709, "o", "        double w2[n];\r\n\u001b[?2004l\r"]
[272.172803, "o", "\u001b[?2004h"]
[272.172872, "o", "> "]
[272.17329, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.173389, "o", "\u001b[?2004h"]
[272.173426, "o", "> "]
[272.173802, "o", "            w2[i] = 0.0;\r\n\u001b[?2004l\r"]
[272.173917, "o", "\u001b[?2004h"]
[272.173994, "o", "> "]
[272.174576, "o", "            for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[272.174745, "o", "\u001b[?2004h"]
[272.174816, "o", "> "]
[272.175317, "o", "                w2[i] += A[i * n + j] * evec_r[j];\r\n\u001b[?2004l\r"]
[272.175415, "o", "\u001b[?2004h"]
[272.175489, "o", "> "]
[272.175651, "o", "            }\r\n\u001b[?2004l\r"]
[272.175734, "o", "\u001b[?2004h"]
[272.175789, "o", "> "]
[272.175873, "o", "        }\r\n\u001b[?2004l\r"]
[272.175977, "o", "\u001b[?2004h"]
[272.176043, "o", "> "]
[272.17613, "o", "        \r\n\u001b[?2004l\r"]
[272.176178, "o", "\u001b[?2004h"]
[272.176217, "o", "> "]
[272.176638, "o", "        double norm = 0.0;\r\n\u001b[?2004l\r"]
[272.176833, "o", "\u001b[?2004h"]
[272.176867, "o", "> "]
[272.177389, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.177489, "o", "\u001b[?2004h"]
[272.177573, "o", "> "]
[272.178059, "o", "            norm += w2[i] * w2[i];\r\n\u001b[?2004l\r"]
[272.178185, "o", "\u001b[?2004h"]
[272.178291, "o", "> "]
[272.17845, "o", "        }\r\n\u001b[?2004l\r"]
[272.178554, "o", "\u001b[?2004h"]
[272.178651, "o", "> "]
[272.179016, "o", "        norm = sqrt(norm);\r\n\u001b[?2004l\r"]
[272.179107, "o", "\u001b[?2004h"]
[272.179171, "o", "> "]
[272.179317, "o", "        \r\n\u001b[?2004l\r"]
[272.179421, "o", "\u001b[?2004h"]
[272.179519, "o", "> "]
[272.179897, "o", "        if (norm < 1e-30) {\r\n\u001b[?2004l\r"]
[272.179994, "o", "\u001b[?2004h"]
[272.180096, "o", "> "]
[272.180857, "o", "            for (int i = 0; i < n; i++) evec_r[i] = 1.0;\r\n\u001b[?2004l\r"]
[272.180961, "o", "\u001b[?2004h"]
[272.18104, "o", "> "]
[272.181341, "o", "            continue;\r\n"]
[272.181377, "o", "\u001b[?2004l\r"]
[272.181499, "o", "\u001b[?2004h"]
[272.181572, "o", "> "]
[272.181694, "o", "        }\r\n\u001b[?2004l\r"]
[272.181768, "o", "\u001b[?2004h"]
[272.181819, "o", "> "]
[272.181948, "o", "        \r\n\u001b[?2004l\r"]
[272.182035, "o", "\u001b[?2004h"]
[272.182066, "o", "> "]
[272.182296, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.182387, "o", "\u001b[?2004h"]
[272.182472, "o", "> "]
[272.182703, "o", "            evec_r[i] = w2[i] / norm;\r\n\u001b[?2004l\r"]
[272.182751, "o", "\u001b[?2004h"]
[272.182797, "o", "> "]
[272.182947, "o", "        }\r\n\u001b[?2004l\r"]
[272.183011, "o", "\u001b[?2004h"]
[272.183048, "o", "> "]
[272.183117, "o", "    }\r\n\u001b[?2004l\r"]
[272.183161, "o", "\u001b[?2004h"]
[272.183202, "o", "> "]
[272.183235, "o", "}"]
[272.183256, "o", "\r\n\u001b[?2004l\r"]
[272.183357, "o", "\u001b[?2004h"]
[272.183429, "o", "> "]
[272.18345, "o", "\r\n\u001b[?2004l\r"]
[272.183535, "o", "\u001b[?2004h"]
[272.183625, "o", "> "]
[272.184401, "o", "// Main function: find dominant eigenvalue and eigenvector\r\n\u001b[?2004l\r"]
[272.18455, "o", "\u001b[?2004h"]
[272.184651, "o", "> "]
[272.185837, "o", "// Returns: eigenvalue real part, eigenvalue imag part, eigenvector real, eigenvector imag\r\n\u001b[?2004l\r"]
[272.185934, "o", "\u001b[?2004h"]
[272.186009, "o", "> "]
[272.18661, "o", "void find_dominant(const double *A, int n, \r\n\u001b[?2004l\r"]
[272.186703, "o", "\u001b[?2004h"]
[272.186796, "o", "> "]
[272.187293, "o", "                   double *eval_r, double *eval_i,\r\n\u001b[?2004l\r"]
[272.187377, "o", "\u001b[?2004h"]
[272.187437, "o", "> "]
[272.188146, "o", "                   double *evec_r, double *evec_i) {\r\n\u001b[?2004l\r"]
[272.188254, "o", "\u001b[?2004h"]
[272.188335, "o", "> "]
[272.188605, "o", "    // Make a copy\r\n"]
[272.188639, "o", "\u001b[?2004l\r"]
[272.188779, "o", "\u001b[?2004h"]
[272.188896, "o", "> "]
[272.189106, "o", "    double H[100];\r\n\u001b[?2004l\r"]
[272.189215, "o", "\u001b[?2004h"]
[272.189286, "o", "> "]
[272.18982, "o", "    memcpy(H, A, n * n * sizeof(double));\r\n\u001b[?2004l\r"]
[272.189939, "o", "\u001b[?2004h"]
[272.190028, "o", "> "]
[272.190118, "o", "    \r\n\u001b[?2004l\r"]
[272.190218, "o", "\u001b[?2004h"]
[272.190301, "o", "> "]
[272.190645, "o", "    // Reduce to Hessenberg form\r\n\u001b[?2004l\r"]
[272.190718, "o", "\u001b[?2004h"]
[272.190832, "o", "> "]
[272.19114, "o", "    hessenberg_reduce(H, n);\r\n\u001b[?2004l\r"]
[272.191222, "o", "\u001b[?2004h"]
[272.191293, "o", "> "]
[272.19135, "o", "    \r\n\u001b[?2004l\r"]
[272.191429, "o", "\u001b[?2004h"]
[272.191494, "o", "> "]
[272.191711, "o", "    // QR iteration to find eigenvalues\r\n\u001b[?2004l\r"]
[272.191761, "o", "\u001b[?2004h"]
[272.191878, "o", "> "]
[272.192564, "o", "    double evals[20]; // max 10 eigenvalues, stored as pairs for complex\r\n\u001b[?2004l\r"]
[272.192676, "o", "\u001b[?2004h"]
[272.192734, "o", "> "]
[272.193181, "o", "    qr_eigenvalues(H, n, evals);\r\n\u001b[?2004l\r"]
[272.193302, "o", "\u001b[?2004h"]
[272.19337, "o", "> "]
[272.193457, "o", "    \r\n\u001b[?2004l\r"]
[272.193553, "o", "\u001b[?2004h"]
[272.193636, "o", "> "]
[272.193928, "o", "    // Find dominant eigenvalue (largest magnitude)\r\n\u001b[?2004l\r"]
[272.194004, "o", "\u001b[?2004h"]
[272.194065, "o", "> "]
[272.194191, "o", "    double max_mag = -1.0;\r\n\u001b[?2004l\r"]
[272.194247, "o", "\u001b[?2004h"]
[272.194282, "o", "> "]
[272.194535, "o", "    int idx = 0;\r\n\u001b[?2004l\r"]
[272.194625, "o", "\u001b[?2004h"]
[272.194666, "o", "> "]
[272.195123, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.19521, "o", "\u001b[?2004h"]
[272.195274, "o", "> "]
[272.195378, "o", "        double mag;\r\n\u001b[?2004l\r"]
[272.195442, "o", "\u001b[?2004h"]
[272.195497, "o", "> "]
[272.196283, "o", "        if (evals[i] < 0 && i + 1 < n && evals[i+1] != 0) {\r\n\u001b[?2004l\r"]
[272.196384, "o", "\u001b[?2004h"]
[272.196454, "o", "> "]
[272.196765, "o", "            // Complex eigenvalue stored as (real, imag)\r\n\u001b[?2004l\r"]
[272.196852, "o", "\u001b[?2004h"]
[272.196928, "o", "> "]
[272.197324, "o", "            mag = sqrt(evals[i] * evals[i] + evals[i+1] * evals[i+1]);\r\n\u001b[?2004l\r"]
[272.197387, "o", "\u001b[?2004h"]
[272.197474, "o", "> "]
[272.197878, "o", "            if (mag > max_mag) {\r\n\u001b[?2004l\r"]
[272.19798, "o", "\u001b[?2004h"]
[272.198076, "o", "> "]
[272.198475, "o", "                max_mag = mag;\r\n\u001b[?2004l\r"]
[272.198602, "o", "\u001b[?2004h"]
[272.198685, "o", "> "]
[272.198969, "o", "                idx = i;\r\n\u001b[?2004l\r"]
[272.199069, "o", "\u001b[?2004h"]
[272.199134, "o", "> "]
[272.19927, "o", "            }\r\n\u001b[?2004l\r"]
[272.199337, "o", "\u001b[?2004h"]
[272.199419, "o", "> "]
[272.19966, "o", "        } else {\r\n\u001b[?2004l\r"]
[272.199752, "o", "\u001b[?2004h"]
[272.199835, "o", "> "]
[272.200271, "o", "            mag = fabs(evals[i]);\r\n\u001b[?2004l\r"]
