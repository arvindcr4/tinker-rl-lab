[359.633827, "o", "\u001b[?2004h"]
[359.633879, "o", "> "]
[359.634112, "o", "// Find dominant eigenvalue and eigenvector\r\n\u001b[?2004l\r"]
[359.634157, "o", "\u001b[?2004h"]
[359.634248, "o", "> "]
[359.634471, "o", "// A: input matrix (n x n, row-major)\r\n\u001b[?2004l\r"]
[359.634532, "o", "\u001b[?2004h"]
[359.634571, "o", "> "]
[359.634798, "o", "// eval: output eigenvalue (real part)\r\n\u001b[?2004l\r"]
[359.634849, "o", "\u001b[?2004h"]
[359.634935, "o", "> "]
[359.635394, "o", "// evec: output eigenvector (n elements, real)\r\n\u001b[?2004l\r"]
[359.635492, "o", "\u001b[?2004h"]
[359.635573, "o", "> "]
