[125.292646, "o", "        }\r\n\u001b[?2004l\r"]
[125.292764, "o", "\u001b[?2004h"]
[125.292872, "o", "> "]
[125.293011, "o", "        \r\n\u001b[?2004l\r"]
[125.293108, "o", "\u001b[?2004h"]
[125.293198, "o", "> "]
[125.293606, "o", "        // v_new = w / ||w||\r\n\u001b[?2004l\r"]
[125.293721, "o", "\u001b[?2004h"]
[125.293802, "o", "> "]
[125.294329, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.294459, "o", "\u001b[?2004h"]
[125.294551, "o", "> "]
[125.295046, "o", "            v_new[i] = w[i] / norm;\r\n\u001b[?2004l\r"]
[125.295147, "o", "\u001b[?2004h"]
[125.295221, "o", "> "]
[125.295372, "o", "        }\r\n\u001b[?2004l\r"]
[125.295469, "o", "\u001b[?2004h"]
[125.295543, "o", "> "]
[125.295691, "o", "        \r\n\u001b[?2004l\r"]
[125.295786, "o", "\u001b[?2004h"]
[125.295871, "o", "> "]
[125.296265, "o", "        // Check convergence\r\n\u001b[?2004l\r"]
[125.296364, "o", "\u001b[?2004h"]
[125.296436, "o", "> "]
[125.296808, "o", "        double diff = 0.0;\r\n\u001b[?2004l\r"]
[125.296913, "o", "\u001b[?2004h"]
[125.296998, "o", "> "]
[125.297491, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.297598, "o", "\u001b[?2004h"]
[125.29766, "o", "> "]
[125.298069, "o", "            double d = v_new[i] - v[i];\r\n\u001b[?2004l\r"]
[125.298168, "o", "\u001b[?2004h"]
[125.29823, "o", "> "]
[125.298594, "o", "            diff += d * d;\r\n\u001b[?2004l\r"]
[125.298685, "o", "\u001b[?2004h"]
[125.29876, "o", "> "]
[125.298915, "o", "        }\r\n\u001b[?2004l\r"]
[125.299036, "o", "\u001b[?2004h"]
[125.299138, "o", "> "]
[125.299521, "o", "        diff = sqrt(diff);\r\n\u001b[?2004l\r"]
[125.299634, "o", "\u001b[?2004h"]
[125.299726, "o", "> "]
[125.299865, "o", "        \r\n\u001b[?2004l\r"]
[125.299978, "o", "\u001b[?2004h"]
[125.300075, "o", "> "]
