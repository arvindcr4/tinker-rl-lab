[359.635787, "o", "\u001b[?2004h"]
[359.635829, "o", "> "]
[359.636828, "o", "int find_dominant_real(const double *A, int n, double *eval, double *evec) {\r\n\u001b[?2004l\r"]
[359.636928, "o", "\u001b[?2004h"]
[359.636994, "o", "> "]
[359.63792, "o", "    // Use power iteration to find dominant eigenvalue and eigenvector\r\n\u001b[?2004l\r"]
[359.638034, "o", "\u001b[?2004h"]
[359.638103, "o", "> "]
[359.638439, "o", "    double v[10], w[10];\r\n\u001b[?2004l\r"]
[359.638525, "o", "\u001b[?2004h"]
[359.638608, "o", "> "]
[359.638687, "o", "    \r\n"]
[359.638711, "o", "\u001b[?2004l\r"]
[359.638779, "o", "\u001b[?2004h"]
[359.63882, "o", "> "]
[359.638939, "o", "    // Initialize\r\n\u001b[?2004l\r"]
[359.638997, "o", "\u001b[?2004h"]
[359.639069, "o", "> "]
[359.639385, "o", "    for (int i = 0; i < n; i++) v[i] = 1.0 / sqrt((double)n);\r\n\u001b[?2004l\r"]
[359.639441, "o", "\u001b[?2004h"]
[359.639477, "o", "> "]
[359.639563, "o", "    \r\n\u001b[?2004l\r"]
[359.639689, "o", "\u001b[?2004h"]
[359.639788, "o", "> "]
[359.64046, "o", "    for (int iter = 0; iter < MAX_ITER; iter++) {\r\n\u001b[?2004l\r"]
[359.640574, "o", "\u001b[?2004h"]
[359.64065, "o", "> "]
[359.640943, "o", "        // w = A * v\r\n\u001b[?2004l\r"]
[359.64106, "o", "\u001b[?2004h"]
[359.641174, "o", "> "]
[359.641709, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.641834, "o", "\u001b[?2004h"]
[359.641916, "o", "> "]
[359.642262, "o", "            w[i] = 0.0;\r\n\u001b[?2004l\r"]
[359.642365, "o", "\u001b[?2004h"]
[359.642441, "o", "> "]
[359.642993, "o", "            for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[359.643098, "o", "\u001b[?2004h"]
[359.643185, "o", "> "]
[359.643789, "o", "                w[i] += A[i * n + j] * v[j];\r\n\u001b[?2004l\r"]
[359.643931, "o", "\u001b[?2004h"]
[359.644083, "o", "> "]
[359.6442, "o", "            }\r\n\u001b[?2004l\r"]
[359.644314, "o", "\u001b[?2004h"]
[359.644413, "o", "> "]
[359.644566, "o", "        }\r\n\u001b[?2004l\r"]
[359.644692, "o", "\u001b[?2004h"]
[359.644775, "o", "> "]
[359.644884, "o", "        \r\n\u001b[?2004l\r"]
[359.644963, "o", "\u001b[?2004h"]
[359.645041, "o", "> "]
[359.645395, "o", "        // Compute norm\r\n\u001b[?2004l\r"]
[359.645494, "o", "\u001b[?2004h"]
[359.645576, "o", "> "]
[359.645975, "o", "        double norm = 0.0;\r\n\u001b[?2004l\r"]
[359.646097, "o", "\u001b[?2004h"]
[359.646193, "o", "> "]
[359.646957, "o", "        for (int i = 0; i < n; i++) norm += w[i] * w[i];\r\n\u001b[?2004l\r"]
[359.647075, "o", "\u001b[?2004h"]
[359.647159, "o", "> "]
[359.647528, "o", "        norm = sqrt(norm);\r\n\u001b[?2004l\r"]
[359.647638, "o", "\u001b[?2004h"]
[359.647709, "o", "> "]
[359.64781, "o", "        \r\n\u001b[?2004l\r"]
[359.647941, "o", "\u001b[?2004h"]
[359.64804, "o", "> "]
[359.648438, "o", "        if (norm < 1e-30) {\r\n\u001b[?2004l\r"]
[359.648555, "o", "\u001b[?2004h"]
[359.648637, "o", "> "]
[359.648992, "o", "            for (int i = 0; i < n; i++) v[i] = (double)(i + 1);\r\n\u001b[?2004l\r"]
[359.649065, "o", "\u001b[?2004h"]
[359.649138, "o", "> "]
[359.649259, "o", "            continue;\r\n\u001b[?2004l\r"]
[359.649337, "o", "\u001b[?2004h"]
[359.64942, "o", "> "]
[359.649521, "o", "        }\r\n\u001b[?2004l\r"]
[359.649597, "o", "\u001b[?2004h"]
[359.649669, "o", "> "]
[359.649769, "o", "        \r\n\u001b[?2004l\r"]
[359.649866, "o", "\u001b[?2004h"]
[359.649944, "o", "> "]
[359.650275, "o", "        // v = w / norm\r\n\u001b[?2004l\r"]
[359.650393, "o", "\u001b[?2004h"]
[359.650476, "o", "> "]
[359.651229, "o", "        for (int i = 0; i < n; i++) v[i] = w[i] / norm;\r\n\u001b[?2004l\r"]
[359.651349, "o", "\u001b[?2004h"]
[359.651445, "o", "> "]
[359.651582, "o", "        \r\n\u001b[?2004l\r"]
[359.651692, "o", "\u001b[?2004h"]
[359.651766, "o", "> "]
[359.652056, "o", "        // Check convergence\r\n\u001b[?2004l\r"]
[359.652139, "o", "\u001b[?2004h"]
[359.65221, "o", "> "]
[359.652498, "o", "        double diff = 0.0;\r\n\u001b[?2004l\r"]
[359.652582, "o", "\u001b[?2004h"]
[359.652658, "o", "> "]
[359.65317, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.653289, "o", "\u001b[?2004h"]
[359.653384, "o", "> "]
[359.65381, "o", "            double d = v[i] - w[i] / norm;\r\n\u001b[?2004l\r"]
[359.653887, "o", "\u001b[?2004h"]
[359.653971, "o", "> "]
[359.654165, "o", "            diff += d * d;\r\n\u001b[?2004l\r"]
[359.654258, "o", "\u001b[?2004h"]
[359.654345, "o", "> "]
[359.654465, "o", "        }\r\n\u001b[?2004l\r"]
[359.654597, "o", "\u001b[?2004h"]
[359.65469, "o", "> "]
[359.655127, "o", "        if (diff < TOL) break;\r\n\u001b[?2004l\r"]
[359.65523, "o", "\u001b[?2004h"]
[359.655303, "o", "> "]
[359.655384, "o", "    }\r\n\u001b[?2004l\r"]
[359.655476, "o", "\u001b[?2004h"]
[359.655553, "o", "> "]
[359.655632, "o", "    \r\n\u001b[?2004l\r"]
[359.655738, "o", "\u001b[?2004h"]
[359.655807, "o", "> "]
[359.656158, "o", "    // Rayleigh quotient\r\n\u001b[?2004l\r"]
[359.656272, "o", "\u001b[?2004h"]
[359.656366, "o", "> "]
[359.656648, "o", "    double Av[10];\r\n\u001b[?2004l\r"]
[359.656748, "o", "\u001b[?2004h"]
[359.656825, "o", "> "]
[359.65728, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.657407, "o", "\u001b[?2004h"]
[359.657509, "o", "> "]
[359.657754, "o", "        Av[i] = 0.0;\r\n\u001b[?2004l\r"]
[359.657834, "o", "\u001b[?2004h"]
[359.657893, "o", "> "]
[359.65826, "o", "        for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[359.658338, "o", "\u001b[?2004h"]
[359.658418, "o", "> "]
[359.658848, "o", "            Av[i] += A[i * n + j] * v[j];\r\n\u001b[?2004l\r"]
[359.658928, "o", "\u001b[?2004h"]
[359.658983, "o", "> "]
[359.659103, "o", "        }\r\n\u001b[?2004l\r"]
[359.659187, "o", "\u001b[?2004h"]
[359.65925, "o", "> "]
[359.659323, "o", "    }\r\n\u001b[?2004l\r"]
[359.6594, "o", "\u001b[?2004h"]
[359.659459, "o", "> "]
[359.659642, "o", "    *eval = 0.0;\r\n\u001b[?2004l\r"]
[359.65972, "o", "\u001b[?2004h"]
[359.659781, "o", "> "]
[359.660301, "o", "    for (int i = 0; i < n; i++) *eval += v[i] * Av[i];\r\n\u001b[?2004l\r"]
[359.660379, "o", "\u001b[?2004h"]
[359.660435, "o", "> "]
[359.660501, "o", "    \r\n\u001b[?2004l\r"]
[359.660578, "o", "\u001b[?2004h"]
[359.660646, "o", "> "]
[359.661109, "o", "    for (int i = 0; i < n; i++) evec[i] = v[i];\r\n\u001b[?2004l\r"]
[359.661188, "o", "\u001b[?2004h"]
[359.661246, "o", "> "]
[359.661327, "o", "    \r\n\u001b[?2004l\r"]
[359.6614, "o", "\u001b[?2004h"]
[359.661466, "o", "> "]
[359.661596, "o", "    return 0;\r\n\u001b[?2004l\r"]
[359.661691, "o", "\u001b[?2004h"]
[359.661758, "o", "> "]
[359.661813, "o", "}\r\n"]
[359.661916, "o", "\u001b[?2004l\r"]
[359.662004, "o", "\u001b[?2004h"]
