[489.837919, "o", "static void qr_step(double *H, int n, int m, double *Q) {\r\n\u001b[?2004l\r"]
[489.838027, "o", "\u001b[?2004h"]
[489.838115, "o", "> "]
[489.838485, "o", "    double x=H[0], y=H[n+1], z=0.0;\r\n\u001b[?2004l\r"]
[489.838606, "o", "\u001b[?2004h"]
[489.838683, "o", "> "]
[489.839009, "o", "    for(int k=0;k<m-1;k++) {\r\n\u001b[?2004l\r"]
[489.839116, "o", "\u001b[?2004h"]
[489.839185, "o", "> "]
[489.839522, "o", "        double r=sqrt(x*x+y*y);\r\n\u001b[?2004l\r"]
[489.839638, "o", "\u001b[?2004h"]
[489.839725, "o", "> "]
[489.840563, "o", "        if(r<1e-30) { x=H[(k+2)*n+k]; y=H[(k+2)*n+k+1]; z=H[(k+2)*n+k+2]; continue; }\r\n\u001b[?2004l\r"]
[489.840652, "o", "\u001b[?2004h"]
[489.840725, "o", "> "]
[489.841046, "o", "        double cs=x/r, sn=y/r;\r\n\u001b[?2004l\r"]
[489.841149, "o", "\u001b[?2004h"]
[489.841235, "o", "> "]
[489.841562, "o", "        for(int j=k;j<n;j++) {\r\n\u001b[?2004l\r"]
[489.841649, "o", "\u001b[?2004h"]
[489.841715, "o", "> "]
[489.842236, "o", "            double t1=cs*H[k*n+j]+sn*H[(k+1)*n+j];\r\n\u001b[?2004l\r"]
[489.842335, "o", "\u001b[?2004h"]
[489.842415, "o", "> "]
[489.842932, "o", "            double t2=-sn*H[k*n+j]+cs*H[(k+1)*n+j];\r\n\u001b[?2004l\r"]
[489.843019, "o", "\u001b[?2004h"]
[489.843088, "o", "> "]
[489.843497, "o", "            H[k*n+j]=t1; H[(k+1)*n+j]=t2;\r\n\u001b[?2004l\r"]
[489.843578, "o", "\u001b[?2004h"]
[489.843643, "o", "> "]
[489.843755, "o", "        }\r\n\u001b[?2004l\r"]
[489.843859, "o", "\u001b[?2004h"]
[489.843955, "o", "> "]
[489.844299, "o", "        for(int i=0;i<m;i++) {\r\n\u001b[?2004l\r"]
[489.844382, "o", "\u001b[?2004h"]
[489.844476, "o", "> "]
[489.844972, "o", "            double t1=cs*H[i*n+k]+sn*H[i*n+k+1];\r\n\u001b[?2004l\r"]
[489.845083, "o", "\u001b[?2004h"]
[489.84517, "o", "> "]
[489.845658, "o", "            double t2=-sn*H[i*n+k]+cs*H[i*n+k+1];\r\n\u001b[?2004l\r"]
[489.845745, "o", "\u001b[?2004h"]
[489.845841, "o", "> "]
[489.846248, "o", "            H[i*n+k]=t1; H[i*n+k+1]=t2;\r\n\u001b[?2004l\r"]
[489.84634, "o", "\u001b[?2004h"]
[489.846423, "o", "> "]
[489.846569, "o", "        }\r\n\u001b[?2004l\r"]
[489.846663, "o", "\u001b[?2004h"]
[489.846735, "o", "> "]
[489.847055, "o", "        for(int i=0;i<n;i++) {\r\n\u001b[?2004l\r"]
[489.847151, "o", "\u001b[?2004h"]
[489.847227, "o", "> "]
[489.847735, "o", "            double t1=cs*Q[i*n+k]+sn*Q[i*n+k+1];\r\n\u001b[?2004l\r"]
[489.847842, "o", "\u001b[?2004h"]
[489.847927, "o", "> "]
[489.848426, "o", "            double t2=-sn*Q[i*n+k]+cs*Q[i*n+k+1];\r\n\u001b[?2004l\r"]
[489.848509, "o", "\u001b[?2004h"]
[489.848574, "o", "> "]
[489.848997, "o", "            Q[i*n+k]=t1; Q[i*n+k+1]=t2;\r\n\u001b[?2004l\r"]
[489.84909, "o", "\u001b[?2004h"]
[489.849158, "o", "> "]
[489.849284, "o", "        }\r\n\u001b[?2004l\r"]
[489.849362, "o", "\u001b[?2004h"]
[489.849429, "o", "> "]
[489.850145, "o", "        if(k<m-2) { x=H[(k+2)*n+k]; y=H[(k+2)*n+k+1]; z=H[(k+2)*n+k+2]; }\r\n\u001b[?2004l\r"]
[489.850228, "o", "\u001b[?2004h"]
[489.850294, "o", "> "]
[489.850369, "o", "    }\r\n\u001b[?2004l\r"]
[489.850441, "o", "\u001b[?2004h"]
[489.850507, "o", "> "]
[489.85055, "o", "}\r\n\u001b[?2004l\r"]
[489.850652, "o", "\u001b[?2004h"]
[489.850708, "o", "> "]
[489.850725, "o", "\r\n\u001b[?2004l\r"]
[489.850829, "o", "\u001b[?2004h"]
[489.850892, "o", "> "]
[489.851644, "o", "static void wilkinson_shift(const double *H, int m, double *sr, double *si) {\r\n\u001b[?2004l\r"]
[489.851752, "o", "\u001b[?2004h"]
[489.851827, "o", "> "]
[489.852308, "o", "    double a=H[(m-2)*n+m-2], b=H[(m-2)*n+m-1];\r\n\u001b[?2004l\r"]
[489.852395, "o", "\u001b[?2004h"]
[489.852458, "o", "> "]
[489.85291, "o", "    double c=H[(m-1)*n+m-2], d=H[(m-1)*n+m-1];\r\n\u001b[?2004l\r"]
[489.852994, "o", "\u001b[?2004h"]
[489.853073, "o", "> "]
[489.853414, "o", "    double tr=a+d, det=a*d-b*c;\r\n\u001b[?2004l\r"]
[489.853516, "o", "\u001b[?2004h"]
[489.853593, "o", "> "]
[489.853939, "o", "    double disc=tr*tr-4.0*det;\r\n\u001b[?2004l\r"]
[489.854029, "o", "\u001b[?2004h"]
[489.854099, "o", "> "]
[489.854319, "o", "    if(disc>=0) {\r\n\u001b[?2004l\r"]
[489.854404, "o", "\u001b[?2004h"]
[489.854502, "o", "> "]
[489.855137, "o", "        double sd=sqrt(disc), s1=(tr+sd)/2.0, s2=(tr-sd)/2.0;\r\n\u001b[?2004l\r"]
[489.855237, "o", "\u001b[?2004h"]
[489.855333, "o", "> "]
[489.855983, "o", "        double r1=fabs(a-s1)+fabs(b), r2=fabs(a-s2)+fabs(b);\r\n\u001b[?2004l\r"]
[489.856107, "o", "\u001b[?2004h"]
[489.856197, "o", "> "]
[489.856616, "o", "        *sr=(r1<r2)?s1:s2; *si=0.0;\r\n\u001b[?2004l\r"]
[489.856704, "o", "\u001b[?2004h"]
[489.856768, "o", "> "]
[489.856911, "o", "    } else {\r\n\u001b[?2004l\r"]
[489.856994, "o", "\u001b[?2004h"]
[489.857062, "o", "> "]
[489.857311, "o", "        *sr=d; *si=0.0;\r\n\u001b[?2004l\r"]
[489.857392, "o", "\u001b[?2004h"]
[489.857462, "o", "> "]
[489.857553, "o", "    }\r\n\u001b[?2004l\r"]
[489.857665, "o", "\u001b[?2004h"]
[489.85774, "o", "> "]
[489.857811, "o", "}\r\n\u001b[?2004l\r"]
[489.857922, "o", "\u001b[?2004h"]
[489.857991, "o", "> "]
[489.858007, "o", "\r\n\u001b[?2004l\r"]
[489.858117, "o", "\u001b[?2004h"]
[489.858188, "o", "> "]
[489.859505, "o", "int find_dominant_eigenvalue_and_eigenvector_c(const double *A, int n, double *eval_re, double *eval_im, double *evec_re, double *evec_im) {\r\n\u001b[?2004l\r"]
[489.859605, "o", "\u001b[?2004h"]
[489.859729, "o", "> "]
[489.860031, "o", "    double H[100], Q[100];\r\n\u001b[?2004l\r"]
[489.860142, "o", "\u001b[?2004h"]
[489.860235, "o", "> "]
[489.860549, "o", "    hessenberg(A, n, H, Q);\r\n"]
[489.860576, "o", "\u001b[?2004l\r"]
[489.860699, "o", "\u001b[?2004h"]
[489.860767, "o", "> "]
[489.860817, "o", "\r\n\u001b[?2004l\r"]
[489.860988, "o", "\u001b[?2004h"]
[489.861093, "o", "> "]
[489.861328, "o", "    // QR iteration\r\n\u001b[?2004l\r"]
[489.86143, "o", "\u001b[?2004h"]
[489.861505, "o", "> "]
[489.8619, "o", "    for(int iter=0;iter<1000;iter++) {\r\n\u001b[?2004l\r"]
[489.862024, "o", "\u001b[?2004h"]
[489.862093, "o", "> "]
[489.862283, "o", "        int m=n;\r\n\u001b[?2004l\r"]
[489.862359, "o", "\u001b[?2004h"]
[489.862424, "o", "> "]
[489.862646, "o", "        while(m>0) {\r\n\u001b[?2004l\r"]
[489.862763, "o", "\u001b[?2004h"]
[489.862854, "o", "> "]
[489.863063, "o", "            int i;\r\n\u001b[?2004l\r"]
[489.86317, "o", "\u001b[?2004h"]
[489.863262, "o", "> "]
[489.863641, "o", "            for(i=m-1;i>0;i--) {\r\n\u001b[?2004l\r"]
[489.863738, "o", "\u001b[?2004h"]
[489.863818, "o", "> "]
[489.864615, "o", "                if(fabs(H[i*n+i-1])<TOL*(fabs(H[(i-1)*n+i-1])+fabs(H[i*n+i]))) break;\r\n\u001b[?2004l\r"]
[489.864703, "o", "\u001b[?2004h"]
[489.864799, "o", "> "]
[489.864977, "o", "            }\r\n\u001b[?2004l\r"]
[489.865069, "o", "\u001b[?2004h"]
[489.865159, "o", "> "]
[489.865407, "o", "            if(i==m) {\r\n\u001b[?2004l\r"]
[489.865525, "o", "\u001b[?2004h"]
[489.865627, "o", "> "]
[489.866362, "o", "                eval_re[m-1]=H[(m-1)*n+m-1]; eval_im[m-1]=0.0; m--; continue;\r\n\u001b[?2004l\r"]
[489.866471, "o", "\u001b[?2004h"]
[489.866552, "o", "> "]
[489.866735, "o", "            }\r\n\u001b[?2004l\r"]
[489.866838, "o", "\u001b[?2004h"]
[489.866906, "o", "> "]
[489.867144, "o", "            int j=i-1;\r\n\u001b[?2004l\r"]
[489.86723, "o", "\u001b[?2004h"]
[489.867303, "o", "> "]
[489.868053, "o", "            if(fabs(H[j*n+j-1])<TOL*(fabs(H[(j-1)*n+j-1])+fabs(H[j*n+j]))) {\r\n\u001b[?2004l\r"]
[489.868156, "o", "\u001b[?2004h"]
[489.868243, "o", "> "]
[489.868858, "o", "                eval_re[m-1]=H[(m-1)*n+m-1]; eval_im[m-1]=0.0;\r\n\u001b[?2004l\r"]
[489.868964, "o", "\u001b[?2004h"]
[489.869052, "o", "> "]
[489.86966, "o", "                eval_re[m-2]=H[(m-2)*n+m-2]; eval_im[m-2]=0.0;\r\n\u001b[?2004l\r"]
[489.869757, "o", "\u001b[?2004h"]
[489.869832, "o", "> "]
[489.870176, "o", "                m-=2; continue;\r\n\u001b[?2004l\r"]
[489.870264, "o", "\u001b[?2004h"]
[489.870338, "o", "> "]
[489.8705, "o", "            }\r\n\u001b[?2004l\r"]
[489.870621, "o", "\u001b[?2004h"]
[489.870708, "o", "> "]
[489.871005, "o", "            double sr, si;\r\n\u001b[?2004l\r"]
[489.871092, "o", "\u001b[?2004h"]
[489.871169, "o", "> "]
[489.87165, "o", "            wilkinson_shift(H, m, &sr, &si);\r\n"]
[489.871682, "o", "\u001b[?2004l\r"]
[489.871786, "o", "\u001b[?2004h"]
[489.871873, "o", "> "]
[489.872155, "o", "            // Apply shift\r\n"]
[489.872174, "o", "\u001b[?2004l\r"]
[489.872273, "o", "\u001b[?2004h"]
[489.872358, "o", "> "]
[489.872839, "o", "            for(int k=0;k<m;k++) H[k*n+k]-=sr;\r\n\u001b[?2004l\r"]
[489.87293, "o", "\u001b[?2004h"]
[489.873002, "o", "> "]
[489.87337, "o", "            qr_step(H, n, m, Q);\r\n\u001b[?2004l\r"]
[489.873484, "o", "\u001b[?2004h"]
[489.873572, "o", "> "]
[489.87404, "o", "            for(int k=0;k<m;k++) H[k*n+k]+=sr;\r\n\u001b[?2004l\r"]
[489.87416, "o", "\u001b[?2004h"]
[489.874248, "o", "> "]
[489.8744, "o", "        }\r\n\u001b[?2004l\r"]
[489.874507, "o", "\u001b[?2004h"]
[489.874582, "o", "> "]
[489.874698, "o", "    }\r\n\u001b[?2004l\r"]
[489.874786, "o", "\u001b[?2004h"]
[489.874879, "o", "> "]
[489.87492, "o", "\r\n\u001b[?2004l\r"]
[489.875046, "o", "\u001b[?2004h"]
[489.875122, "o", "> "]
[489.875449, "o", "    // Find dominant eigenvalue\r\n\u001b[?2004l\r"]
[489.875532, "o", "\u001b[?2004h"]
[489.87561, "o", "> "]
[489.876086, "o", "    double max_mag=0.0, max_re=0.0, max_im=0.0;\r\n\u001b[?2004l\r"]
[489.876164, "o", "\u001b[?2004h"]
[489.876232, "o", "> "]
[489.876533, "o", "    for(int i=0;i<n;i++) {\r\n"]
[489.876555, "o", "\u001b[?2004l\r"]
[489.876694, "o", "\u001b[?2004h"]
[489.876775, "o", "> "]
[489.87747, "o", "        double mag=sqrt(eval_re[i]*eval_re[i]+eval_im[i]*eval_im[i]);\r\n\u001b[?2004l\r"]
[489.877576, "o", "\u001b[?2004h"]
[489.877657, "o", "> "]
[489.878413, "o", "        if(mag>max_mag) { max_mag=mag; max_re=eval_re[i]; max_im=eval_im[i]; }\r\n\u001b[?2004l\r"]
[489.878507, "o", "\u001b[?2004h"]
[489.878596, "o", "> "]
[489.878696, "o", "    }\r\n\u001b[?2004l\r"]
[489.878818, "o", "\u001b[?2004h"]
[489.878891, "o", "> "]
[489.879275, "o", "    *eval_re=max_re; *eval_im=max_im;\r\n\u001b[?2004l\r"]
[489.879369, "o", "\u001b[?2004h"]
[489.879448, "o", "> \r\n"]
[489.87948, "o", "\u001b[?2004l\r"]
[489.879606, "o", "\u001b[?2004h"]
[489.879686, "o", "> "]
[489.880091, "o", "    // Inverse iteration for eigenvector\r\n\u001b[?2004l\r"]
[489.880202, "o", "\u001b[?2004h"]
[489.880278, "o", "> "]
[489.88097, "o", "    // For complex eigenvalue, solve (A - lambda*I)*v = v iteratively\r\n\u001b[?2004l\r"]
[489.88108, "o", "\u001b[?2004h"]
[489.881156, "o", "> "]
[489.881506, "o", "    // Using 2n x 2n real system\r\n\u001b[?2004l\r"]
[489.881596, "o", "\u001b[?2004h"]
[489.881685, "o", "> "]
[489.881991, "o", "    double M[400], L[400];\r\n\u001b[?2004l\r"]
[489.882087, "o", "\u001b[?2004h"]
[489.882147, "o", "> "]
[489.882363, "o", "    int piv[20];\r\n\u001b[?2004l\r"]
[489.882469, "o", "\u001b[?2004h"]
[489.882562, "o", "> "]
[489.882849, "o", "    double x[20], y[20];\r\n\u001b[?2004l\r"]
[489.882952, "o", "\u001b[?2004h"]
[489.883029, "o", "> "]
[489.88343, "o", "    for(int iter=0;iter<200;iter++) {\r\n\u001b[?2004l\r"]
[489.883546, "o", "\u001b[?2004h"]
[489.883626, "o", "> "]
[489.883976, "o", "        // Build 2n x 2n system\r\n\u001b[?2004l\r"]
[489.884079, "o", "\u001b[?2004h"]
[489.884162, "o", "> "]
[489.884472, "o", "        for(int i=0;i<n;i++) {\r\n\u001b[?2004l\r"]
[489.884561, "o", "\u001b[?2004h"]
[489.884656, "o", "> "]
[489.885015, "o", "            for(int j=0;j<n;j++) {\r\n\u001b[?2004l\r"]
[489.885128, "o", "\u001b[?2004h"]
[489.885197, "o", "> "]
[489.885747, "o", "                M[i*2*n+j]=A[i*n+j]; M[i*2*n+j+n]=0.0;\r\n\u001b[?2004l\r"]
[489.885844, "o", "\u001b[?2004h"]
[489.885916, "o", "> "]
[489.886564, "o", "                M[(i+n)*2*n+j]=0.0; M[(i+n)*2*n+j+n]=A[i*n+j];\r\n\u001b[?2004l\r"]
[489.886679, "o", "\u001b[?2004h"]
[489.886781, "o", "> "]
[489.88696, "o", "            }\r\n\u001b[?2004l\r"]
[489.887051, "o", "\u001b[?2004h"]
[489.887137, "o", "> "]
[489.887739, "o", "            M[i*2*n+i]-=max_re; M[(i+n)*2*n+i+n]-=max_re;\r\n\u001b[?2004l\r"]
