[398.890301, "i", "python3 -c \"\nimport numpy as np\nimport time\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Benchmark eigvals (eigenvalues only)\ndts = []\nfor i in range(200):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    ev = np.linalg.eigvals(A)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals median: {np.median(dts):.6f}s')\n\n# Benchmark eig (eigenvalues + eigenvectors)\ndts = []\nfor i in range(200):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    ev, evc = np.linalg.eig(A)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eig median: {np.median(dts):.6f}s')\n\n# Test with complex eigenvalue matrix\nA2 = np.array([[0, -1], [1, 0]], dtype=np.float64)  # rotation, eigenvalues +/-i\nev, evc = np.linalg.eig(A2)\nprint(f'Rotation matrix eigenvalues: {ev}')\nprint(f'Rotation matrix eigenvectors: {evc}')\n\"\n"]
