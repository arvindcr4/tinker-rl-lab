[272.048515, "o", "            }\r\n\u001b[?2004l\r"]
[272.04863, "o", "\u001b[?2004h"]
[272.048713, "o", "> "]
[272.048834, "o", "        }\r\n\u001b[?2004l\r"]
[272.048903, "o", "\u001b[?2004h"]
[272.04899, "o", "> "]
