[426.584427, "i", "python3 -c \"\nimport numpy as np\nimport time\n\n# More accurate timing\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Approach: eigvals + inverse iteration\ndef solve_eigen(A):\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lam = eigenvalues[idx]\n    \n    # Inverse iteration\n    v = np.random.randn(A.shape[0]) + 1j * np.random.randn(A.shape[0])\n    v = v / np.linalg.norm(v)\n    \n    for _ in range(100):\n        w = np.linalg.solve(A - lam * np.eye(A.shape[0]), v)\n        v = w / np.linalg.norm(w)\n    \n    return lam, v\n\n# Test correctness\nA = np.random.normal(size=(10,10)).astype(np.float64)\nlambda_d, evec = solve_eigen(A)\nprint(f'Correct: {np.allclose(A @ evec, lambda_d * evec)}')\n\n# Timing\nN = 500\ndts = []\nfor i in range(N):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    solve_eigen(A)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals + inv_iter median: {np.median(dts):.6f}s')\nprint(f'eigvals + inv_iter m"]
[426.584743, "i", "ean: {np.mean(dts):.6f}s')\n\"\n"]
