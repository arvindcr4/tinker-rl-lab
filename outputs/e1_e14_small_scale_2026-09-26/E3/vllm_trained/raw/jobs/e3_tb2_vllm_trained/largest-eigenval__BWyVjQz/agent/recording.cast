[175.870902, "i", "python3 -c \"\nimport numpy as np\nimport ctypes\nimport time\n\n# Load the C library\nlib = ctypes.CDLL('/app/eigen.so')\n\n# Define function signatures\nlib.power_iteration.argtypes = [ctypes.POINTER(ctypes.c_double), ctypes.c_int, ctypes.POINTER(ctypes.c_double), ctypes.POINTER(ctypes.c_double)]\nlib.power_iteration.restype = ctypes.c_int\n\n# Test with a simple matrix\nA = np.array([[2.0, 1.0], [0.0, 3.0]], dtype=np.float64)\neval_ = ctypes.c_double(0.0)\nevec = (ctypes.c_double * 2)()\nlib.power_iteration(A.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), 2, ctypes.byref(eval_), evec)\nprint(f'Eigenvalue: {eval_.value}, Eigenvector: [{evec[0]}, {evec[1]}]')\nprint(f'Expected: 3.0, [0.447, 0.894]')\n\"\n"]
