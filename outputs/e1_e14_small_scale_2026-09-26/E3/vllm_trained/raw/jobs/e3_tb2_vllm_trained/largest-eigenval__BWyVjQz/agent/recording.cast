[489.832377, "o", "            for(int j=k+1;j<n;j++) d+=H[i*n+j]*v[j-k-1];\r\n\u001b[?2004l\r"]
[489.832469, "o", "\u001b[?2004h"]
[489.832541, "o", "> "]
[489.833153, "o", "            for(int j=k+1;j<n;j++) H[i*n+j]-=2.0*d*v[j-k-1];\r\n\u001b[?2004l\r"]
[489.833268, "o", "\u001b[?2004h"]
[489.833346, "o", "> "]
[489.833499, "o", "        }\r\n"]
[489.833526, "o", "\u001b[?2004l\r"]
[489.833642, "o", "\u001b[?2004h"]
[489.83374, "o", "> "]
[489.834083, "o", "        for(int j=k+1;j<n;j++) {\r\n\u001b[?2004l\r"]
[489.834176, "o", "\u001b[?2004h"]
[489.834232, "o", "> "]
[489.834554, "o", "            double d=0.0;\r\n"]
[489.834585, "o", "\u001b[?2004l\r"]
[489.834701, "o", "\u001b[?2004h"]
[489.834784, "o", "> "]
[489.835351, "o", "            for(int i=k+1;i<n;i++) d+=Q[i*n+j]*v[i-k-1];\r\n\u001b[?2004l\r"]
[489.835431, "o", "\u001b[?2004h"]
[489.835505, "o", "> "]
[489.836108, "o", "            for(int i=k+1;i<n;i++) Q[i*n+j]-=2.0*d*v[i-k-1];\r\n\u001b[?2004l\r"]
[489.836211, "o", "\u001b[?2004h"]
[489.836291, "o", "> "]
[489.836422, "o", "        }\r\n\u001b[?2004l\r"]
