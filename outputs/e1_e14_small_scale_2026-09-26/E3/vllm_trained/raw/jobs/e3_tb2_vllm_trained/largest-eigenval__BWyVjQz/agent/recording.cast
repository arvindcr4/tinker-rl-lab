[125.314346, "o", "\u001b[?2004h"]
[125.314453, "o", "> \r\n"]
[125.314559, "o", "\u001b[?2004l\r"]
[125.314639, "o", "\u001b[?2004h"]
[125.31475, "o", "> "]
[125.315239, "o", "// For 2x2 matrices, use analytical solution\r\n\u001b[?2004l\r"]
[125.315368, "o", "\u001b[?2004h"]
[125.31548, "o", "> "]
[125.31622, "o", "int eigen_2x2(const double *A, double *eigenvalue, double *eigenvector) {\r\n\u001b[?2004l\r"]
[125.316334, "o", "\u001b[?2004h"]
[125.316423, "o", "> "]
[125.316936, "o", "    double a = A[0], b = A[1], c = A[2], d = A[3];\r\n\u001b[?2004l\r"]
[125.317042, "o", "\u001b[?2004h"]
[125.317128, "o", "> "]
[125.317504, "o", "    double trace = a + d;\r\n\u001b[?2004l\r"]
[125.317657, "o", "\u001b[?2004h"]
[125.317755, "o", "> "]
[125.318207, "o", "    double det = a * d - b * c;\r\n\u001b[?2004l\r"]
[125.31832, "o", "\u001b[?2004h"]
[125.318398, "o", "> "]
[125.318877, "o", "    double disc = trace * trace - 4.0 * det;\r\n\u001b[?2004l\r"]
[125.318999, "o", "\u001b[?2004h"]
[125.319085, "o", "> "]
[125.319193, "o", "    \r\n\u001b[?2004l\r"]
[125.319335, "o", "\u001b[?2004h"]
[125.319494, "o", "> "]
[125.319651, "o", "    if (disc >= 0) {\r\n\u001b[?2004l\r"]
[125.319746, "o", "\u001b[?2004h"]
[125.319817, "o", "> "]
[125.3202, "o", "        // Real eigenvalues\r\n\u001b[?2004l\r"]
[125.320305, "o", "\u001b[?2004h"]
[125.320392, "o", "> "]
[125.320908, "o", "        double sqrt_disc = sqrt(disc);\r\n\u001b[?2004l\r"]
[125.321008, "o", "\u001b[?2004h"]
[125.321079, "o", "> "]
[125.321559, "o", "        double e1 = (trace + sqrt_disc) / 2.0;\r\n\u001b[?2004l\r"]
[125.321643, "o", "\u001b[?2004h"]
[125.321725, "o", "> "]
[125.322207, "o", "        double e2 = (trace - sqrt_disc) / 2.0;\r\n\u001b[?2004l\r"]
[125.322306, "o", "\u001b[?2004h"]
[125.322369, "o", "> "]
[125.322473, "o", "        \r\n\u001b[?2004l\r"]
[125.322568, "o", "\u001b[?2004h"]
[125.322656, "o", "> "]
[125.323144, "o", "        if (fabs(e1) >= fabs(e2)) {\r\n\u001b[?2004l\r"]
[125.323246, "o", "\u001b[?2004h"]
[125.323319, "o", "> "]
[125.323721, "o", "            *eigenvalue = e1;\r\n\u001b[?2004l\r"]
[125.323812, "o", "\u001b[?2004h"]
[125.323886, "o", "> "]
[125.324472, "o", "            // eigenvector for e1: (b, e1-a) or (e1-d, c)\r\n\u001b[?2004l\r"]
[125.324557, "o", "\u001b[?2004h"]
[125.324629, "o", "> "]
[125.325089, "o", "            if (fabs(b) > 1e-15) {\r\n\u001b[?2004l\r"]
[125.325194, "o", "\u001b[?2004h"]
[125.325285, "o", "> "]
[125.325969, "o", "                double norm = sqrt(b * b + (e1 - a) * (e1 - a));\r\n\u001b[?2004l\r"]
[125.326063, "o", "\u001b[?2004h"]
[125.326128, "o", "> "]
[125.326583, "o", "                eigenvector[0] = b / norm;\r\n\u001b[?2004l\r"]
[125.326692, "o", "\u001b[?2004h"]
[125.326771, "o", "> "]
[125.327427, "o", "                eigenvector[1] = (e1 - a) / norm;\r\n\u001b[?2004l\r"]
[125.327527, "o", "\u001b[?2004h"]
[125.32761, "o", "> "]
[125.327907, "o", "            } else {\r\n\u001b[?2004l\r"]
[125.328027, "o", "\u001b[?2004h"]
[125.328111, "o", "> "]
[125.329054, "o", "                eigenvector[0] = (e1 - d) / sqrt((e1-d)*(e1-d) + c*c);\r\n\u001b[?2004l\r"]
[125.329237, "o", "\u001b[?2004h"]
[125.329336, "o", "> "]
[125.330204, "o", "                eigenvector[1] = c / sqrt((e1-d)*(e1-d) + c*c);\r\n\u001b[?2004l\r"]
[125.330326, "o", "\u001b[?2004h"]
[125.330408, "o", "> "]
[125.330616, "o", "            }\r\n\u001b[?2004l\r"]
[125.330729, "o", "\u001b[?2004h"]
[125.330812, "o", "> "]
[125.331081, "o", "        } else {\r\n\u001b[?2004l\r"]
[125.331177, "o", "\u001b[?2004h"]
[125.331256, "o", "> "]
[125.331659, "o", "            *eigenvalue = e2;\r\n\u001b[?2004l\r"]
[125.331776, "o", "\u001b[?2004h"]
[125.331834, "o", "> "]
[125.332215, "o", "            if (fabs(b) > 1e-15) {\r\n\u001b[?2004l\r"]
[125.332306, "o", "\u001b[?2004h"]
[125.332372, "o", "> "]
[125.333012, "o", "                double norm = sqrt(b * b + (e2 - a) * (e2 - a));\r\n\u001b[?2004l\r"]
[125.33311, "o", "\u001b[?2004h"]
[125.333202, "o", "> "]
[125.333655, "o", "                eigenvector[0] = b / norm;\r\n\u001b[?2004l\r"]
[125.333763, "o", "\u001b[?2004h"]
[125.333827, "o", "> "]
[125.334307, "o", "                eigenvector[1] = (e2 - a) / norm;\r\n\u001b[?2004l\r"]
[125.334421, "o", "\u001b[?2004h"]
[125.334497, "o", "> "]
[125.334745, "o", "            } else {\r\n\u001b[?2004l\r"]
[125.334842, "o", "\u001b[?2004h"]
[125.334906, "o", "> "]
[125.33557, "o", "                eigenvector[0] = (e2 - d) / sqrt((e2-d)*(e2-d) + c*c);\r\n\u001b[?2004l\r"]
[125.335714, "o", "\u001b[?2004h"]
[125.335812, "o", "> "]
[125.336656, "o", "                eigenvector[1] = c / sqrt((e2-d)*(e2-d) + c*c);\r\n\u001b[?2004l\r"]
[125.336762, "o", "\u001b[?2004h"]
[125.336849, "o", "> "]
[125.337041, "o", "            }\r\n\u001b[?2004l\r"]
[125.337131, "o", "\u001b[?2004h"]
[125.337201, "o", "> "]
[125.337339, "o", "        }\r\n\u001b[?2004l\r"]
[125.33743, "o", "\u001b[?2004h"]
[125.337505, "o", "> "]
[125.337725, "o", "    } else {\r\n"]
[125.337761, "o", "\u001b[?2004l\r"]
[125.337897, "o", "\u001b[?2004h"]
[125.337984, "o", "> "]
[125.338506, "o", "        // Complex eigenvalues - use power iteration\r\n\u001b[?2004l\r"]
[125.338629, "o", "\u001b[?2004h"]
[125.338709, "o", "> "]
[125.339526, "o", "        return power_iteration(A, 2, eigenvalue, eigenvector);\r\n\u001b[?2004l\r"]
