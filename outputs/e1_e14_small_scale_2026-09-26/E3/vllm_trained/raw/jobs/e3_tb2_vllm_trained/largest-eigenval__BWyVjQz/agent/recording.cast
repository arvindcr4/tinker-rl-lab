[333.691955, "i", "python3 -c \"\nimport numpy as np\nimport time\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Test with pre-allocated arrays\nevals = np.empty(10, dtype=np.complex128)\nevecs = np.empty((10,10), dtype=np.complex128)\n\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    np.linalg.eig(A, overwrite_a=True, a=evals, b=evecs)\n    idx = np.argmax(np.abs(evals))\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eig pre-allocated median: {np.median(dts):.6f}')\n\"\n"]
