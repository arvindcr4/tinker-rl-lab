[125.313305, "o", "\u001b[?2004h"]
[125.313372, "o", "> "]
[125.313466, "o", "    \r\n\u001b[?2004l\r"]
[125.313575, "o", "\u001b[?2004h"]
[125.313669, "o", "> "]
