[272.058161, "o", "int qr_eigenvalues(double *H, int n, double *eigenvalues) {\r\n\u001b[?2004l\r"]
[272.05831, "o", "\u001b[?2004h"]
[272.058411, "o", "> "]
[272.058712, "o", "    int nn = n;\r\n\u001b[?2004l\r"]
[272.058867, "o", "\u001b[?2004h"]
[272.058965, "o", "> "]
[272.059186, "o", "    int iter = 0;\r\n\u001b[?2004l\r"]
[272.059277, "o", "\u001b[?2004h"]
[272.059389, "o", "> "]
[272.059456, "o", "    \r\n\u001b[?2004l\r"]
[272.059541, "o", "\u001b[?2004h"]
[272.059644, "o", "> "]
[272.059786, "o", "    while (nn > 0) {\r\n\u001b[?2004l\r"]
[272.059876, "o", "\u001b[?2004h"]
[272.059952, "o", "> "]
[272.060283, "o", "        if (nn == 1) {\r\n\u001b[?2004l\r"]
[272.060416, "o", "\u001b[?2004h"]
[272.060524, "o", "> "]
[272.061028, "o", "            eigenvalues[0] = H[0];\r\n\u001b[?2004l\r"]
[272.061132, "o", "\u001b[?2004h"]
[272.061231, "o", "> "]
[272.06145, "o", "            return 0;\r\n\u001b[?2004l\r"]
[272.061568, "o", "\u001b[?2004h"]
[272.061683, "o", "> "]
[272.061774, "o", "        }\r\n\u001b[?2004l\r"]
[272.061839, "o", "\u001b[?2004h"]
[272.061911, "o", "> "]
[272.062102, "o", "        \r\n\u001b[?2004l\r"]
[272.062226, "o", "\u001b[?2004h"]
[272.062358, "o", "> "]
[272.062543, "o", "        if (nn == 2) {\r\n\u001b[?2004l\r"]
[272.062614, "o", "\u001b[?2004h"]
[272.062718, "o", "> "]
