[272.032258, "o", "        }\r\n\u001b[?2004l\r"]
[272.032353, "o", "\u001b[?2004h"]
[272.032419, "o", "> "]
[272.032677, "o", "        if (sigma < 1e-30) continue;\r\n\u001b[?2004l\r"]
[272.032737, "o", "\u001b[?2004h"]
[272.032845, "o", "> "]
[272.033165, "o", "        sigma = sqrt(sigma);\r\n\u001b[?2004l\r"]
[272.033283, "o", "\u001b[?2004h"]
[272.033405, "o", "> "]
[272.033639, "o", "        \r\n\u001b[?2004l\r"]
[272.033758, "o", "\u001b[?2004h"]
[272.033908, "o", "> "]
[272.034473, "o", "        double alpha = A[(k+1) * n + k];\r\n\u001b[?2004l\r"]
[272.034595, "o", "\u001b[?2004h"]
[272.034681, "o", "> "]
[272.035345, "o", "        double sign = (alpha >= 0) ? 1.0 : -1.0;\r\n\u001b[?2004l\r"]
[272.035464, "o", "\u001b[?2004h"]
[272.035556, "o", "> "]
[272.036169, "o", "        double v_k1 = alpha + sign * sigma;\r\n\u001b[?2004l\r"]
[272.036288, "o", "\u001b[?2004h"]
[272.036386, "o", "> "]
