[125.261846, "i", "cat > /app/eigen.c << 'EOF'\n#include <math.h>\n#include <stdlib.h>\n#include <string.h>\n\n// Power iteration to find dominant eigenvalue and eigenvector\n// Returns 0 on success, -1 on failure\nint power_iteration(const double *A, int n, double *eigenvalue, double *eigenvector) {\n    // Initialize with a random-ish vector\n    double *v = (double *)malloc(n * sizeof(double));\n    double *v_new = (double *)malloc(n * sizeof(double));\n    double *w = (double *)malloc(n * sizeof(double));\n    \n    // Use a deterministic starting vector\n    for (int i = 0; i < n; i++) {\n        v[i] = 1.0 / sqrt((double)n);\n    }\n    \n    double max_iter = 1000;\n    double tol = 1e-14;\n    \n    for (int iter = 0; iter < max_iter; iter++) {\n        // w = A * v\n        for (int i = 0; i < n; i++) {\n            w[i] = 0.0;\n            for (int j = 0; j < n; j++) {\n                w[i] += A[i * n + j] * v[j];\n            }\n        }\n        \n        // Compute norm of w\n        double norm = 0.0;\n        for (int i = 0; i < n; i++) {\n    "]
[125.26287, "i", "        norm += w[i] * w[i];\n        }\n        norm = sqrt(norm);\n        \n        if (norm < 1e-30) {\n            // Zero vector - try different starting vector\n            for (int i = 0; i < n; i++) {\n                v[i] = (double)(i + 1);\n            }\n            continue;\n        }\n        \n        // v_new = w / ||w||\n        for (int i = 0; i < n; i++) {\n            v_new[i] = w[i] / norm;\n        }\n        \n        // Check convergence\n        double diff = 0.0;\n        for (int i = 0; i < n; i++) {\n            double d = v_new[i] - v[i];\n            diff += d * d;\n        }\n        diff = sqrt(diff);\n        \n        // Copy v_new to v\n        memcpy(v, v_new, n * sizeof(double));\n        \n        if (diff < tol) break;\n    }\n    \n    // Compute eigenvalue via Rayleigh quotient: lambda = v^T A v\n    // First compute Av\n    for (int i = 0; i < n; i++) {\n        w[i] = 0.0;\n        for (int j = 0; j < n; j++) {\n            w[i] += A[i * n + j] * v[j];\n        }\n    }\n    \n    double lambda = 0.0;\n   "]
[125.263106, "i", " for (int i = 0; i < n; i++) {\n        lambda += v[i] * w[i];\n    }\n    \n    *eigenvalue = lambda;\n    for (int i = 0; i < n; i++) {\n        eigenvector[i] = v[i];\n    }\n    \n    free(v);\n    free(v_new);\n    free(w);\n    \n    return 0;\n}\n\n// For 2x2 matrices, use analytical solution\nint eigen_2x2(const double *A, double *eigenvalue, double *eigenvector) {\n    double a = A[0], b = A[1], c = A[2], d = A[3];\n    double trace = a + d;\n    double det = a * d - b * c;\n    double disc = trace * trace - 4.0 * det;\n    \n    if (disc >= 0) {\n        // Real eigenvalues\n        double sqrt_disc = sqrt(disc);\n        double e1 = (trace + sqrt_disc) / 2.0;\n        double e2 = (trace - sqrt_disc) / 2.0;\n        \n        if (fabs(e1) >= fabs(e2)) {\n            *eigenvalue = e1;\n            // eigenvector for e1: (b, e1-a) or (e1-d, c)\n            if (fabs(b) > 1e-15) {\n                double norm = sqrt(b * b + (e1 - a) * (e1 - a));\n                eigenvector[0] = b / norm;\n                eigenvector[1] = (e1 - a) / norm"]
[125.26327, "i", ";\n            } else {\n                eigenvector[0] = (e1 - d) / sqrt((e1-d)*(e1-d) + c*c);\n                eigenvector[1] = c / sqrt((e1-d)*(e1-d) + c*c);\n            }\n        } else {\n            *eigenvalue = e2;\n            if (fabs(b) > 1e-15) {\n                double norm = sqrt(b * b + (e2 - a) * (e2 - a));\n                eigenvector[0] = b / norm;\n                eigenvector[1] = (e2 - a) / norm;\n            } else {\n                eigenvector[0] = (e2 - d) / sqrt((e2-d)*(e2-d) + c*c);\n                eigenvector[1] = c / sqrt((e2-d)*(e2-d) + c*c);\n            }\n        }\n    } else {\n        // Complex eigenvalues - use power iteration\n        return power_iteration(A, 2, eigenvalue, eigenvector);\n    }\n    return 0;\n}\nEOF\n"]
[125.263433, "o", "cat > /app/eigen.c << 'EOF'\r\n"]
