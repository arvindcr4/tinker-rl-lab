[319.429889, "i", "python3 -c \"\nimport numpy as np\nimport time\n\n# Test: eigvals + complex power iteration\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lam = eigenvalues[idx]\n    # Complex power iteration\n    v = np.ones(10, dtype=np.complex128) / np.sqrt(10)\n    for _ in range(30):\n        v = A @ v\n        v = v / np.linalg.norm(v)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals+complex_power median: {np.median(dts):.6f}')\n\n# Verify\nA = np.random.normal(size=(10,10)).astype(np.float64)\neigenvalues = np.linalg.eigvals(A)\nidx = np.argmax(np.abs(eigenvalues))\nlam = eigenvalues[idx]\nv = np.ones(10, dtype=np.complex128) / np.sqrt(10)\nfor _ in range(30):\n    v = A @ v\n    v = v / np.linalg.norm(v)\nprint(f'Residual: {np.linalg.norm(A @ v - lam * v):.2e}')\nprint(f'lam type: {type(lam)}, iscomplex: {np.iscomplex(lam)}')\n\"\n"]
