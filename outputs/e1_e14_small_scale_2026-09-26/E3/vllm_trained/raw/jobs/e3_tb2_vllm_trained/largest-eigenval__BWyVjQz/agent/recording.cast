[272.04035, "o", "\u001b[?2004h"]
[272.040418, "o", "> "]
[272.040923, "o", "        for (int i = k + 2; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.041047, "o", "\u001b[?2004h"]
[272.041141, "o", "> "]
