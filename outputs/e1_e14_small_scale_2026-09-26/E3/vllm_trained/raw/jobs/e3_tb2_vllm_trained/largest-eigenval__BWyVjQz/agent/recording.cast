[125.280659, "o", "\u001b[?2004h"]
[125.280744, "o", "> "]
[125.28103, "o", "        // Compute norm of w\r\n\u001b[?2004l\r"]
[125.281157, "o", "\u001b[?2004h"]
[125.281246, "o", "> "]
[125.281627, "o", "        double norm = 0.0;\r\n\u001b[?2004l\r"]
[125.281752, "o", "\u001b[?2004h"]
[125.281853, "o", "> "]
[125.282381, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.282492, "o", "\u001b[?2004h"]
[125.282563, "o", "> "]
[125.283005, "o", "            norm += w[i] * w[i];\r\n\u001b[?2004l\r"]
[125.283105, "o", "\u001b[?2004h"]
[125.283199, "o", "> "]
[125.283321, "o", "        }\r\n"]
[125.283415, "o", "\u001b[?2004l\r"]
[125.283494, "o", "\u001b[?2004h"]
[125.283579, "o", "> "]
[125.283887, "o", "        norm = sqrt(norm);\r\n\u001b[?2004l\r"]
[125.283997, "o", "\u001b[?2004h"]
[125.284106, "o", "> "]
[125.284257, "o", "        \r\n\u001b[?2004l\r"]
[125.284383, "o", "\u001b[?2004h"]
[125.284487, "o", "> "]
[125.2848, "o", "        if (norm < 1e-30) {\r\n\u001b[?2004l\r"]
[125.284912, "o", "\u001b[?2004h"]
[125.284991, "o", "> "]
[125.285773, "o", "            // Zero vector - try different starting vector\r\n\u001b[?2004l\r"]
[125.285893, "o", "\u001b[?2004h"]
[125.286002, "o", "> "]
[125.28645, "o", "            for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.286554, "o", "\u001b[?2004h"]
[125.28666, "o", "> "]
[125.287199, "o", "                v[i] = (double)(i + 1);\r\n\u001b[?2004l\r"]
[125.287324, "o", "\u001b[?2004h"]
[125.287434, "o", "> "]
[125.287686, "o", "            }"]
[125.290979, "o", "\r\n\u001b[?2004l\r"]
