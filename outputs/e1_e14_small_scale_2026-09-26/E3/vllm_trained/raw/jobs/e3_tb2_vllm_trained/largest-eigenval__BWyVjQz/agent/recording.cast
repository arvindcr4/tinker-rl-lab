[231.139974, "i", "python3 -c \"\nimport numpy as np\nimport time\n\n# Test: eigvals + power iteration in pure Python/numpy\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lam = eigenvalues[idx]\n    # Power iteration to find eigenvector\n    v = np.ones(10) / np.sqrt(10)\n    for _ in range(50):\n        v = A @ v\n        v = v / np.linalg.norm(v)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals+power_iter median: {np.median(dts):.6f}')\n\n# Verify\nA = np.random.normal(size=(10,10)).astype(np.float64)\neigenvalues = np.linalg.eigvals(A)\nidx = np.argmax(np.abs(eigenvalues))\nlam = eigenvalues[idx]\nv = np.ones(10) / np.sqrt(10)\nfor _ in range(50):\n    v = A @ v\n    v = v / np.linalg.norm(v)\nprint(f'Residual: {np.linalg.norm(A @ v - lam * v):.2e}')\nprint(f'Eigenvalue type: {type(lam)}, {np.iscomplex(lam)}')\n\"\n"]
