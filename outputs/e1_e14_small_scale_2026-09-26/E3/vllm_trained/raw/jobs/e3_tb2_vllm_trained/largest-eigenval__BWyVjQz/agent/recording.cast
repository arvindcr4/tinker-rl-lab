[286.913089, "i", "python3 -c \"\nimport numpy as np\nimport time\n\n# Test: eigvals + eigenvector via lstsq\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Approach: eigvals + lstsq for eigenvector\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lam = eigenvalues[idx]\n    # Compute eigenvector: solve (A - lam*I)x = 0\n    # Use least squares with constraint ||x||=1\n    B = A - lam * np.eye(10)\n    # Add a constraint row to make it well-posed\n    B_aug = np.vstack([B, np.ones(10)])\n    x, _, _, _ = np.linalg.lstsq(B_aug, np.zeros(11), rcond=None)\n    x = x / np.linalg.norm(x)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals+lstsq median: {np.median(dts):.6f}')\n\n# Verify\nA = np.random.normal(size=(10,10)).astype(np.float64)\neigenvalues = np.linalg.eigvals(A)\nidx = np.argmax(np.abs(eigenvalues))\nlam = eigenvalues[idx]\nB = A - lam * np.eye(10)\nB_aug = np.vstac"]
[286.913378, "i", "k([B, np.ones(10)])\nx, _, _, _ = np.linalg.lstsq(B_aug, np.zeros(11), rcond=None)\nx = x / np.linalg.norm(x)\nprint(f'Residual: {np.linalg.norm(A @ x - lam * x):.2e}')\n\"\n"]
