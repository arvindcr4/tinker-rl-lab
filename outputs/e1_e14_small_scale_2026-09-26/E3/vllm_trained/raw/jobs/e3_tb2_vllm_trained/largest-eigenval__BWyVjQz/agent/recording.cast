[216.551108, "i", "python3 -c \"\nimport numpy as np\nimport time\nfrom scipy.linalg import lu_factor, lu_solve\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Approach: eigvals + inverse iteration\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues = np.linalg.eigvals(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    lam = eigenvalues[idx]\n    # Inverse iteration: solve (A - lam*I)x = b, normalize\n    B = A - lam * np.eye(10)\n    lu, piv = lu_factor(B)\n    b = np.ones(10)\n    x = lu_solve((lu, piv), b)\n    x = x / np.linalg.norm(x)\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'eigvals+inverse_iter median: {np.median(dts):.6f}')\n\n# Verify\nA = np.random.normal(size=(10,10)).astype(np.float64)\neigenvalues = np.linalg.eigvals(A)\nidx = np.argmax(np.abs(eigenvalues))\nlam = eigenvalues[idx]\nB = A - lam * np.eye(10)\nlu, piv = lu_factor(B)\nb = np.ones(10)\nx = lu_solve((lu, piv), b)\nx = x / np.linalg.norm(x)\nprint(f'Residual: {np.linalg.nor"]
[216.551292, "i", "m(A @ x - lam * x):.2e}')\n\"\n"]
