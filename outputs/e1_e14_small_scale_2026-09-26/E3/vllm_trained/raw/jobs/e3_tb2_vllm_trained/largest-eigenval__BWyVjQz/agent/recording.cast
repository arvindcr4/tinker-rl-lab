[98.272297, "i", "python3 -c \"\nimport numpy as np\nimport time\nfrom scipy.sparse.linalg import eigs\n\nA = np.random.normal(size=(10,10)).astype(np.float64)\n\n# Test scipy eigs\ndts = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    w, v = eigs(A, k=1, which='LM')\n    t1 = time.perf_counter()\n    dts.append(t1-t0)\nprint(f'scipy eigs median: {np.median(dts):.6f}')\n\n# Test numpy eig\ndts2 = []\nfor i in range(100):\n    A = np.random.normal(size=(10,10)).astype(np.float64)\n    t0 = time.perf_counter()\n    eigenvalues, eigenvectors = np.linalg.eig(A)\n    idx = np.argmax(np.abs(eigenvalues))\n    t1 = time.perf_counter()\n    dts2.append(t1-t0)\nprint(f'numpy eig median: {np.median(dts2):.6f}')\n\"\n"]
