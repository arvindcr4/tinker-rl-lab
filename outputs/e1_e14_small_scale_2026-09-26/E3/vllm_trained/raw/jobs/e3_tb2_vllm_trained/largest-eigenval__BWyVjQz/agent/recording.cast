[272.045305, "o", "> "]
[272.045913, "o", "                dot += v[i] * A[i * n + j];\r\n\u001b[?2004l\r"]
[272.04604, "o", "\u001b[?2004h"]
[272.046137, "o", "> "]
[272.046344, "o", "            }\r\n\u001b[?2004l\r"]
[272.046424, "o", "\u001b[?2004h"]
