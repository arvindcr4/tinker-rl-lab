[272.053543, "o", "\u001b[?2004h"]
[272.053657, "o", "> "]
[272.054325, "o", "                A[i * n + j] -= 2.0 * dot * v[j];\r\n\u001b[?2004l\r"]
[272.054442, "o", "\u001b[?2004h"]
[272.054571, "o", "> "]
[272.054832, "o", "            }\r\n\u001b[?2004l\r"]
