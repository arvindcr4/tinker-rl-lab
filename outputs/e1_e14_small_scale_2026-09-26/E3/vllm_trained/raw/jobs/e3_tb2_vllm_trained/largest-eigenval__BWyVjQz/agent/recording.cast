[125.301529, "o", "        \r\n\u001b[?2004l\r"]
[125.301635, "o", "\u001b[?2004h"]
[125.301716, "o", "> "]
[125.30213, "o", "        if (diff < tol) break;\r\n\u001b[?2004l\r"]
[125.302222, "o", "\u001b[?2004h"]
[125.30229, "o", "> "]
[125.30239, "o", "    }\r\n\u001b[?2004l\r"]
[125.30249, "o", "\u001b[?2004h"]
[125.302559, "o", "> "]
[125.302634, "o", "    \r\n\u001b[?2004l\r"]
[125.302716, "o", "\u001b[?2004h"]
[125.302796, "o", "> "]
[125.303641, "o", "    // Compute eigenvalue via Rayleigh quotient: lambda = v^T A v\r\n\u001b[?2004l\r"]
[125.303743, "o", "\u001b[?2004h"]
[125.303831, "o", "> "]
[125.304078, "o", "    // First compute Av\r\n\u001b[?2004l\r"]
[125.304162, "o", "\u001b[?2004h"]
[125.304202, "o", "> "]
[125.304674, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.304821, "o", "\u001b[?2004h"]
[125.304922, "o", "> "]
[125.305173, "o", "        w[i] = 0.0;\r\n\u001b[?2004l\r"]
[125.305261, "o", "\u001b[?2004h"]
[125.305363, "o", "> "]
[125.305786, "o", "        for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[125.305895, "o", "\u001b[?2004h"]
[125.305962, "o", "> "]
[125.306547, "o", "            w[i] += A[i * n + j] * v[j];\r\n\u001b[?2004l\r"]
[125.306692, "o", "\u001b[?2004h"]
[125.306788, "o", "> "]
[125.306945, "o", "        }\r\n\u001b[?2004l\r"]
[125.307046, "o", "\u001b[?2004h"]
[125.307168, "o", "> "]
[125.30726, "o", "    }\r\n\u001b[?2004l\r"]
[125.307369, "o", "\u001b[?2004h"]
[125.307447, "o", "> "]
[125.307533, "o", "    \r\n\u001b[?2004l\r"]
[125.307647, "o", "\u001b[?2004h"]
[125.307737, "o", "> "]
[125.30807, "o", "    double lambda = 0.0;\r\n\u001b[?2004l\r"]
[125.308176, "o", "\u001b[?2004h"]
[125.308252, "o", "> "]
[125.308712, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.308819, "o", "\u001b[?2004h"]
[125.308897, "o", "> "]
[125.309232, "o", "        lambda += v[i] * w[i];\r\n\u001b[?2004l\r"]
[125.309328, "o", "\u001b[?2004h"]
[125.309404, "o", "> "]
[125.309481, "o", "    }\r\n\u001b[?2004l\r"]
[125.309552, "o", "\u001b[?2004h"]
[125.309616, "o", "> "]
[125.309678, "o", "    \r\n\u001b[?2004l\r"]
[125.309772, "o", "\u001b[?2004h"]
[125.30985, "o", "> "]
[125.310201, "o", "    *eigenvalue = lambda;\r\n\u001b[?2004l\r"]
[125.310312, "o", "\u001b[?2004h"]
[125.310411, "o", "> "]
[125.310791, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[125.310916, "o", "\u001b[?2004h"]
[125.311007, "o", "> "]
[125.311453, "o", "        eigenvector[i] = v[i];\r\n\u001b[?2004l\r"]
[125.311577, "o", "\u001b[?2004h"]
[125.311659, "o", "> "]
