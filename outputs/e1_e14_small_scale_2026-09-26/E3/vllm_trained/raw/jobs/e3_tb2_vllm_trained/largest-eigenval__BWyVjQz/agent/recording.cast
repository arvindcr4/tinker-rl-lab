[272.028267, "o", "void hessenberg_reduce(double *A, int n) {\r\n\u001b[?2004l\r"]
[272.028362, "o", "\u001b[?2004h"]
[272.028456, "o", "> "]
[272.028927, "o", "    for (int k = 0; k < n - 2; k++) {\r\n\u001b[?2004l\r"]
[272.029022, "o", "\u001b[?2004h"]
[272.029134, "o", "> "]
[272.02977, "o", "        // Compute Householder vector for column k, rows k+1..n-1\r\n\u001b[?2004l\r"]
[272.029891, "o", "\u001b[?2004h"]
[272.029978, "o", "> "]
[272.03027, "o", "        double sigma = 0.0;\r\n\u001b[?2004l\r"]
[272.030365, "o", "\u001b[?2004h"]
[272.030478, "o", "> "]
[272.031063, "o", "        for (int i = k + 1; i < n; i++) {\r\n\u001b[?2004l\r"]
[272.031161, "o", "\u001b[?2004h"]
[272.031273, "o", "> "]
[272.031895, "o", "            sigma += A[i * n + k] * A[i * n + k];\r\n\u001b[?2004l\r"]
[272.032023, "o", "\u001b[?2004h"]
