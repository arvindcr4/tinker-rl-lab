[359.576493, "i", "cat > /app/eigen.c << 'CEOF'\n#include <math.h>\n#include <stdlib.h>\n#include <string.h>\n#include <float.h>\n\n#define MAX_ITER 500\n#define TOL 1e-14\n\n// LU decomposition with partial pivoting\n// Returns 0 on success, -1 if singular\nint lu_decompose(double *A, int n, int *piv) {\n    for (int i = 0; i < n; i++) piv[i] = i;\n    \n    for (int k = 0; k < n; k++) {\n        // Find pivot\n        int max_row = k;\n        double max_val = fabs(A[k * n + k]);\n        for (int i = k + 1; i < n; i++) {\n            double val = fabs(A[i * n + k]);\n            if (val > max_val) {\n                max_val = val;\n                max_row = i;\n            }\n        }\n        if (max_row != k) {\n            for (int j = 0; j < n; j++) {\n                double tmp = A[k * n + j];\n                A[k * n + j] = A[max_row * n + j];\n                A[max_row * n + j] = tmp;\n            }\n            int tmp = piv[k]; piv[k] = piv[max_row]; piv[max_row] = tmp;\n        }\n        if (fabs(A[k * n + k]) < 1e-30) return -1;\n        \n      "]
[359.577556, "i", "  for (int i = k + 1; i < n; i++) {\n            double factor = A[i * n + k] / A[k * n + k];\n            for (int j = k + 1; j < n; j++) {\n                A[i * n + j] -= factor * A[k * n + j];\n            }\n            A[i * n + k] = factor;\n        }\n    }\n    return 0;\n}\n\n// Solve Ax = b using LU decomposition\nvoid lu_solve(double *A, int n, int *piv, const double *b, double *x) {\n    // Forward substitution\n    double y[10];\n    for (int i = 0; i < n; i++) {\n        y[i] = b[piv[i]];\n        for (int j = 0; j < i; j++) {\n            y[i] -= A[i * n + j] * y[j];\n        }\n    }\n    // Back substitution\n    for (int i = n - 1; i >= 0; i--) {\n        x[i] = y[i];\n        for (int j = i + 1; j < n; j++) {\n            x[i] -= A[i * n + j] * x[j];\n        }\n        x[i] /= A[i * n + i];\n    }\n}\n\n// Inverse iteration to find eigenvector for eigenvalue lambda\nvoid inverse_iteration(const double *A, int n, double lambda, double *evec) {\n    // Start with random-ish vector\n    for (int i = 0; i < n; i++) {\n        "]
[359.57762, "i", "evec[i] = 1.0 / sqrt((double)n);\n    }\n    \n    double B[100]; // max 10x10\n    int piv[10];\n    double x[10], y[10];\n    \n    for (int iter = 0; iter < MAX_ITER; iter++) {\n        // Build A - lambda*I\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                B[i * n + j] = A[i * n + j];\n            }\n            B[i * n + i] -= lambda;\n        }\n        \n        // LU decompose\n        if (lu_decompose(B, n, piv) != 0) {\n            // Singular - try different starting vector\n            for (int i = 0; i < n; i++) evec[i] = (double)(i + 1);\n            continue;\n        }\n        \n        // Solve (A - lambda*I) * x = evec\n        lu_solve(B, n, piv, evec, x);\n        \n        // Normalize\n        double norm = 0.0;\n        for (int i = 0; i < n; i++) norm += x[i] * x[i];\n        norm = sqrt(norm);\n        if (norm < 1e-30) {\n            for (int i = 0; i < n; i++) evec[i] = 1.0;\n            continue;\n        }\n        for (int i = 0; i < n; i++) evec[i] = x[i] / norm;"]
[359.577668, "i", "\n    }\n}\n\n// Find dominant eigenvalue and eigenvector\n// A: input matrix (n x n, row-major)\n// eval: output eigenvalue (real part)\n// evec: output eigenvector (n elements, real)\n// Returns: 0 on success\nint find_dominant_real(const double *A, int n, double *eval, double *evec) {\n    // Use power iteration to find dominant eigenvalue and eigenvector\n    double v[10], w[10];\n    \n    // Initialize\n    for (int i = 0; i < n; i++) v[i] = 1.0 / sqrt((double)n);\n    \n    for (int iter = 0; iter < MAX_ITER; iter++) {\n        // w = A * v\n        for (int i = 0; i < n; i++) {\n            w[i] = 0.0;\n            for (int j = 0; j < n; j++) {\n                w[i] += A[i * n + j] * v[j];\n            }\n        }\n        \n        // Compute norm\n        double norm = 0.0;\n        for (int i = 0; i < n; i++) norm += w[i] * w[i];\n        norm = sqrt(norm);\n        \n        if (norm < 1e-30) {\n            for (int i = 0; i < n; i++) v[i] = (double)(i + 1);\n            continue;\n        }\n        \n        // v = w / norm\n    "]
[359.577685, "i", "    for (int i = 0; i < n; i++) v[i] = w[i] / norm;\n        \n        // Check convergence\n        double diff = 0.0;\n        for (int i = 0; i < n; i++) {\n            double d = v[i] - w[i] / norm;\n            diff += d * d;\n        }\n        if (diff < TOL) break;\n    }\n    \n    // Rayleigh quotient\n    double Av[10];\n    for (int i = 0; i < n; i++) {\n        Av[i] = 0.0;\n        for (int j = 0; j < n; j++) {\n            Av[i] += A[i * n + j] * v[j];\n        }\n    }\n    *eval = 0.0;\n    for (int i = 0; i < n; i++) *eval += v[i] * Av[i];\n    \n    for (int i = 0; i < n; i++) evec[i] = v[i];\n    \n    return 0;\n}\nCEOF\n"]
[359.578102, "o", "cat > /app/eigen.c << 'CEOF'\r\n\u001b[?2004l\r"]
[359.578292, "o", "\u001b[?2004h"]
[359.578377, "o", "> "]
[359.578549, "o", "#include <math.h>\r\n"]
[359.578586, "o", "\u001b[?2004l\r"]
[359.578743, "o", "\u001b[?2004h"]
[359.578847, "o", "> "]
[359.579132, "o", "#include <stdlib.h>\r\n"]
[359.57917, "o", "\u001b[?2004l\r"]
[359.579298, "o", "\u001b[?2004h"]
[359.579381, "o", "> "]
[359.579666, "o", "#include <string.h>\r\n\u001b[?2004l\r"]
[359.57977, "o", "\u001b[?2004h"]
[359.579858, "o", "> "]
[359.580151, "o", "#include <float.h>\r\n\u001b[?2004l\r"]
[359.580264, "o", "\u001b[?2004h"]
[359.580367, "o", "> "]
[359.580402, "o", "\r\n\u001b[?2004l\r"]
[359.580525, "o", "\u001b[?2004h"]
[359.580625, "o", "> "]
[359.580804, "o", "#define MAX_ITER 500\r\n\u001b[?2004l\r"]
[359.580885, "o", "\u001b[?2004h"]
[359.580965, "o", "> "]
[359.581176, "o", "#define TOL 1e-14\r\n\u001b[?2004l\r"]
[359.581272, "o", "\u001b[?2004h"]
[359.581348, "o", "> "]
[359.58139, "o", "\r\n\u001b[?2004l\r"]
[359.581508, "o", "\u001b[?2004h"]
[359.581597, "o", "> "]
[359.581846, "o", "// LU decomposition with partial pivoting\r\n\u001b[?2004l\r"]
[359.581912, "o", "\u001b[?2004h"]
[359.581945, "o", "> "]
[359.582493, "o", "// Returns 0 on success, -1 if singular\r\n\u001b[?2004l\r"]
[359.582619, "o", "\u001b[?2004h"]
[359.582703, "o", "> "]
[359.583359, "o", "int lu_decompose(double *A, int n, int *piv) {\r\n\u001b[?2004l\r"]
[359.583459, "o", "\u001b[?2004h"]
[359.583553, "o", "> "]
[359.584142, "o", "    for (int i = 0; i < n; i++) piv[i] = i;\r\n\u001b[?2004l\r"]
[359.584247, "o", "\u001b[?2004h"]
[359.58432, "o", "> "]
[359.584405, "o", "    \r\n\u001b[?2004l\r"]
[359.58452, "o", "\u001b[?2004h"]
[359.584608, "o", "> "]
[359.585059, "o", "    for (int k = 0; k < n; k++) {\r\n\u001b[?2004l\r"]
[359.585152, "o", "\u001b[?2004h"]
[359.585228, "o", "> "]
[359.585545, "o", "        // Find pivot\r\n\u001b[?2004l\r"]
[359.585667, "o", "\u001b[?2004h"]
[359.585766, "o", "> "]
[359.586114, "o", "        int max_row = k;\r\n\u001b[?2004l\r"]
[359.586234, "o", "\u001b[?2004h"]
[359.5863, "o", "> "]
[359.586906, "o", "        double max_val = fabs(A[k * n + k]);\r\n\u001b[?2004l\r"]
[359.587026, "o", "\u001b[?2004h"]
[359.587109, "o", "> "]
[359.587668, "o", "        for (int i = k + 1; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.587779, "o", "\u001b[?2004h"]
[359.587869, "o", "> "]
[359.588493, "o", "            double val = fabs(A[i * n + k]);\r\n\u001b[?2004l\r"]
[359.588619, "o", "\u001b[?2004h"]
[359.588702, "o", "> "]
[359.58915, "o", "            if (val > max_val) {\r\n\u001b[?2004l\r"]
[359.589257, "o", "\u001b[?2004h"]
[359.589349, "o", "> "]
[359.589698, "o", "                max_val = val;\r\n\u001b[?2004l\r"]
[359.589782, "o", "\u001b[?2004h"]
[359.58987, "o", "> "]
[359.590069, "o", "                max_row = i;\r\n\u001b[?2004l\r"]
[359.59016, "o", "\u001b[?2004h"]
[359.590225, "o", "> "]
[359.590343, "o", "            }\r\n\u001b[?2004l\r"]
[359.590427, "o", "\u001b[?2004h"]
[359.590488, "o", "> "]
[359.590617, "o", "        }"]
[359.590641, "o", "\r\n\u001b[?2004l\r"]
[359.59072, "o", "\u001b[?2004h"]
[359.590786, "o", "> "]
[359.590975, "o", "        if (max_row != k) {\r\n\u001b[?2004l\r"]
[359.591027, "o", "\u001b[?2004h"]
[359.591057, "o", "> "]
[359.59166, "o", "            for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[359.591775, "o", "\u001b[?2004h"]
[359.591847, "o", "> "]
[359.592414, "o", "                double tmp = A[k * n + j];\r\n\u001b[?2004l\r"]
[359.59252, "o", "\u001b[?2004h"]
[359.592599, "o", "> "]
[359.593308, "o", "                A[k * n + j] = A[max_row * n + j];\r\n\u001b[?2004l\r"]
[359.593427, "o", "\u001b[?2004h"]
[359.593529, "o", "> "]
[359.594095, "o", "                A[max_row * n + j] = tmp;\r\n\u001b[?2004l\r"]
[359.594226, "o", "\u001b[?2004h"]
[359.594299, "o", "> "]
[359.594509, "o", "            }\r\n\u001b[?2004l\r"]
[359.594643, "o", "\u001b[?2004h"]
[359.594728, "o", "> "]
[359.595696, "o", "            int tmp = piv[k]; piv[k] = piv[max_row]; piv[max_row] = tmp;\r\n\u001b[?2004l\r"]
[359.595812, "o", "\u001b[?2004h"]
[359.595883, "o", "> "]
[359.596037, "o", "        }\r\n\u001b[?2004l\r"]
[359.596134, "o", "\u001b[?2004h"]
[359.596213, "o", "> "]
[359.596897, "o", "        if (fabs(A[k * n + k]) < 1e-30) return -1;\r\n\u001b[?2004l\r"]
[359.597003, "o", "\u001b[?2004h"]
[359.597086, "o", "> "]
[359.597219, "o", "        \r\n\u001b[?2004l\r"]
[359.597315, "o", "\u001b[?2004h"]
[359.597389, "o", "> "]
[359.597942, "o", "        for (int i = k + 1; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.598043, "o", "\u001b[?2004h"]
[359.598111, "o", "> "]
[359.598852, "o", "            double factor = A[i * n + k] / A[k * n + k];\r\n\u001b[?2004l\r"]
[359.598948, "o", "\u001b[?2004h"]
[359.599027, "o", "> "]
[359.599636, "o", "            for (int j = k + 1; j < n; j++) {\r\n\u001b[?2004l\r"]
[359.59974, "o", "\u001b[?2004h"]
[359.599815, "o", "> "]
[359.600524, "o", "                A[i * n + j] -= factor * A[k * n + j];\r\n\u001b[?2004l\r"]
[359.600626, "o", "\u001b[?2004h"]
[359.6007, "o", "> "]
[359.600895, "o", "            }\r\n\u001b[?2004l\r"]
[359.601001, "o", "\u001b[?2004h"]
[359.60107, "o", "> "]
[359.60154, "o", "            A[i * n + k] = factor;\r\n\u001b[?2004l\r"]
[359.601643, "o", "\u001b[?2004h"]
[359.601723, "o", "> "]
[359.601873, "o", "        }\r\n\u001b[?2004l\r"]
[359.601974, "o", "\u001b[?2004h"]
[359.602039, "o", "> "]
[359.602134, "o", "    }\r\n\u001b[?2004l\r"]
[359.602229, "o", "\u001b[?2004h"]
[359.602318, "o", "> "]
[359.60252, "o", "    return 0;\r\n\u001b[?2004l\r"]
[359.602624, "o", "\u001b[?2004h"]
[359.60272, "o", "> "]
[359.602817, "o", "}\r\n\u001b[?2004l\r"]
[359.60295, "o", "\u001b[?2004h"]
[359.603043, "o", "> "]
[359.60307, "o", "\r\n\u001b[?2004l\r"]
[359.603155, "o", "\u001b[?2004h"]
[359.603219, "o", "> "]
[359.603588, "o", "// Solve Ax = b using LU decomposition\r\n\u001b[?2004l\r"]
[359.603659, "o", "\u001b[?2004h"]
[359.603688, "o", "> "]
[359.604383, "o", "void lu_solve(double *A, int n, int *piv, const double *b, double *x) {\r\n\u001b[?2004l\r"]
[359.604487, "o", "\u001b[?2004h"]
[359.60456, "o", "> "]
[359.604727, "o", "    // Forward substitution\r\n\u001b[?2004l\r"]
[359.604784, "o", "\u001b[?2004h"]
[359.604821, "o", "> "]
[359.605085, "o", "    double y[10];\r\n\u001b[?2004l\r"]
[359.605182, "o", "\u001b[?2004h"]
[359.605257, "o", "> "]
[359.605716, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.605819, "o", "\u001b[?2004h"]
[359.605891, "o", "> "]
[359.606264, "o", "        y[i] = b[piv[i]];\r\n\u001b[?2004l\r"]
[359.606364, "o", "\u001b[?2004h"]
[359.606455, "o", "> "]
[359.606958, "o", "        for (int j = 0; j < i; j++) {\r\n\u001b[?2004l\r"]
[359.607072, "o", "\u001b[?2004h"]
[359.607176, "o", "> "]
[359.607744, "o", "            y[i] -= A[i * n + j] * y[j];\r\n\u001b[?2004l\r"]
[359.607848, "o", "\u001b[?2004h"]
[359.607932, "o", "> "]
[359.608104, "o", "        }\r\n\u001b[?2004l\r"]
[359.608225, "o", "\u001b[?2004h"]
[359.608311, "o", "> "]
[359.60843, "o", "    }\r\n\u001b[?2004l\r"]
[359.608545, "o", "\u001b[?2004h"]
[359.608624, "o", "> "]
[359.608972, "o", "    // Back substitution\r\n\u001b[?2004l\r"]
[359.609063, "o", "\u001b[?2004h"]
[359.60914, "o", "> "]
[359.609665, "o", "    for (int i = n - 1; i >= 0; i--) {\r\n\u001b[?2004l\r"]
[359.609769, "o", "\u001b[?2004h"]
[359.609864, "o", "> "]
[359.610184, "o", "        x[i] = y[i];\r\n\u001b[?2004l\r"]
[359.610295, "o", "\u001b[?2004h"]
[359.610387, "o", "> "]
[359.610977, "o", "        for (int j = i + 1; j < n; j++) {\r\n\u001b[?2004l\r"]
[359.61109, "o", "\u001b[?2004h"]
[359.61117, "o", "> "]
[359.611579, "o", "            x[i] -= A[i * n + j] * x[j];\r\n\u001b[?2004l\r"]
[359.611668, "o", "\u001b[?2004h"]
[359.611746, "o", "> "]
[359.61184, "o", "        }\r\n\u001b[?2004l\r"]
[359.611895, "o", "\u001b[?2004h"]
[359.611963, "o", "> "]
[359.6123, "o", "        x[i] /= A[i * n + i];\r\n\u001b[?2004l\r"]
[359.612375, "o", "\u001b[?2004h"]
[359.612442, "o", "> "]
[359.612517, "o", "    }\r\n\u001b[?2004l\r"]
[359.612607, "o", "\u001b[?2004h"]
[359.612672, "o", "> "]
[359.612713, "o", "}\r\n\u001b[?2004l\r"]
[359.612829, "o", "\u001b[?2004h"]
[359.612905, "o", "> "]
[359.612934, "o", "\r\n\u001b[?2004l\r"]
[359.613045, "o", "\u001b[?2004h"]
[359.613107, "o", "> "]
[359.613485, "o", "// Inverse iteration to find eigenvector for eigenvalue lambda\r\n\u001b[?2004l\r"]
[359.613566, "o", "\u001b[?2004h"]
[359.613656, "o", "> "]
[359.614397, "o", "void inverse_iteration(const double *A, int n, double lambda, double *evec) {\r\n\u001b[?2004l\r"]
[359.614478, "o", "\u001b[?2004h"]
[359.61456, "o", "> "]
[359.614909, "o", "    // Start with random-ish vector\r\n\u001b[?2004l\r"]
[359.615001, "o", "\u001b[?2004h"]
[359.615075, "o", "> "]
[359.615277, "o", "    for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.615375, "o", "\u001b[?2004h"]
[359.615439, "o", "> "]
[359.615857, "o", "        evec[i] = 1.0 / sqrt((double)n);\r\n\u001b[?2004l\r"]
[359.615943, "o", "\u001b[?2004h"]
[359.616005, "o", "> "]
[359.616089, "o", "    }\r\n\u001b[?2004l\r"]
[359.616174, "o", "\u001b[?2004h"]
[359.616229, "o", "> "]
[359.616304, "o", "    \r\n\u001b[?2004l\r"]
[359.616357, "o", "\u001b[?2004h"]
[359.616403, "o", "> "]
[359.616611, "o", "    double B[100]; // max 10x10\r\n\u001b[?2004l\r"]
[359.61676, "o", "\u001b[?2004h"]
[359.616826, "o", "> "]
[359.616999, "o", "    int piv[10];\r\n\u001b[?2004l\r"]
[359.617076, "o", "\u001b[?2004h"]
[359.617131, "o", "> "]
[359.61738, "o", "    double x[10], y[10];\r\n\u001b[?2004l\r"]
[359.617448, "o", "\u001b[?2004h"]
[359.617519, "o", "> "]
[359.617596, "o", "    \r\n\u001b[?2004l\r"]
[359.617676, "o", "\u001b[?2004h"]
[359.617754, "o", "> "]
[359.618075, "o", "    for (int iter = 0; iter < MAX_ITER; iter++) {\r\n\u001b[?2004l\r"]
[359.618151, "o", "\u001b[?2004h"]
[359.618193, "o", "> "]
[359.618607, "o", "        // Build A - lambda*I\r\n\u001b[?2004l\r"]
[359.618707, "o", "\u001b[?2004h"]
[359.618781, "o", "> "]
[359.619297, "o", "        for (int i = 0; i < n; i++) {\r\n\u001b[?2004l\r"]
[359.619404, "o", "\u001b[?2004h"]
[359.6195, "o", "> "]
[359.620076, "o", "            for (int j = 0; j < n; j++) {\r\n\u001b[?2004l\r"]
[359.620188, "o", "\u001b[?2004h"]
[359.620279, "o", "> "]
[359.620899, "o", "                B[i * n + j] = A[i * n + j];\r\n\u001b[?2004l\r"]
[359.621015, "o", "\u001b[?2004h"]
[359.621085, "o", "> "]
[359.621257, "o", "            }\r\n\u001b[?2004l\r"]
[359.621337, "o", "\u001b[?2004h"]
[359.621417, "o", "> "]
[359.621647, "o", "            B[i * n + i] -= lambda;\r\n\u001b[?2004l\r"]
[359.621743, "o", "\u001b[?2004h"]
[359.621808, "o", "> "]
[359.62197, "o", "        }\r\n"]
[359.62201, "o", "\u001b[?2004l\r"]
[359.62214, "o", "\u001b[?2004h"]
[359.622228, "o", "> "]
[359.622353, "o", "        \r\n\u001b[?2004l\r"]
[359.622441, "o", "\u001b[?2004h"]
[359.622517, "o", "> "]
[359.622869, "o", "        // LU decompose\r\n\u001b[?2004l\r"]
[359.622986, "o", "\u001b[?2004h"]
[359.623086, "o", "> "]
[359.623673, "o", "        if (lu_decompose(B, n, piv) != 0) {\r\n\u001b[?2004l\r"]
[359.623777, "o", "\u001b[?2004h"]
[359.623869, "o", "> "]
[359.624617, "o", "            // Singular - try different starting vector\r\n\u001b[?2004l\r"]
[359.624727, "o", "\u001b[?2004h"]
[359.624797, "o", "> "]
[359.62568, "o", "            for (int i = 0; i < n; i++) evec[i] = (double)(i + 1);\r\n\u001b[?2004l\r"]
[359.625788, "o", "\u001b[?2004h"]
[359.625875, "o", "> "]
[359.626179, "o", "            continue;\r\n\u001b[?2004l\r"]
[359.626303, "o", "\u001b[?2004h"]
[359.626392, "o", "> "]
[359.626569, "o", "        }\r\n\u001b[?2004l\r"]
[359.626683, "o", "\u001b[?2004h"]
[359.626765, "o", "> "]
[359.626902, "o", "        \r\n\u001b[?2004l\r"]
[359.627022, "o", "\u001b[?2004h"]
[359.627117, "o", "> "]
[359.627689, "o", "        // Solve (A - lambda*I) * x = evec\r\n\u001b[?2004l\r"]
[359.627787, "o", "\u001b[?2004h"]
[359.627864, "o", "> "]
[359.628366, "o", "        lu_solve(B, n, piv, evec, x);\r\n\u001b[?2004l\r"]
[359.628461, "o", "\u001b[?2004h"]
[359.628535, "o", "> "]
[359.628673, "o", "        \r\n\u001b[?2004l\r"]
[359.628778, "o", "\u001b[?2004h"]
[359.628856, "o", "> "]
[359.629142, "o", "        // Normalize\r\n\u001b[?2004l\r"]
[359.629237, "o", "\u001b[?2004h"]
[359.629308, "o", "> "]
[359.629675, "o", "        double norm = 0.0;\r\n\u001b[?2004l\r"]
[359.629769, "o", "\u001b[?2004h"]
[359.629835, "o", "> "]
[359.630162, "o", "        for (int i = 0; i < n; i++) norm += x[i] * x[i];\r\n\u001b[?2004l\r"]
[359.630256, "o", "\u001b[?2004h"]
[359.630324, "o", "> "]
[359.630515, "o", "        norm = sqrt(norm);\r\n"]
[359.630538, "o", "\u001b[?2004l\r"]
[359.630674, "o", "\u001b[?2004h"]
[359.630765, "o", "> "]
[359.63115, "o", "        if (norm < 1e-30) {\r\n\u001b[?2004l\r"]
[359.631269, "o", "\u001b[?2004h"]
[359.631343, "o", "> "]
[359.632101, "o", "            for (int i = 0; i < n; i++) evec[i] = 1.0;\r\n\u001b[?2004l\r"]
[359.632204, "o", "\u001b[?2004h"]
[359.632276, "o", "> "]
[359.632576, "o", "            continue;\r\n\u001b[?2004l\r"]
[359.632686, "o", "\u001b[?2004h"]
[359.632754, "o", "> "]
[359.632865, "o", "        }\r\n\u001b[?2004l\r"]
[359.63295, "o", "\u001b[?2004h"]
[359.633013, "o", "> "]
[359.633362, "o", "        for (int i = 0; i < n; i++) evec[i] = x[i] / norm;\r\n\u001b[?2004l\r"]
[359.633421, "o", "\u001b[?2004h"]
[359.633467, "o", "> "]
[359.633516, "o", "    }\r\n\u001b[?2004l\r"]
[359.633563, "o", "\u001b[?2004h"]
[359.633603, "o", "> "]
[359.633649, "o", "}\r\n\u001b[?2004l\r"]
