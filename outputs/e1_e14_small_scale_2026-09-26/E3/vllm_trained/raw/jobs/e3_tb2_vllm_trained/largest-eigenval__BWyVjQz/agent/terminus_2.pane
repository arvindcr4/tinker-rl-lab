[?2004l[?2004h>                 L[i*2*n+k]=f;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         if(sing) {
[?2004l[?2004h>             for(int i=0;i<n;i++){evec_re[i]=(double)(i+1);evec_im[i]=0.0;}
[?2004l[?2004h>             continue;
[?2004l[?2004h>         }
[?2004l[?2004h>         // Forward sub
[?2004l[?2004h>         for(int i=0;i<2*n;i++) y[i]=0.0;
[?2004l[?2004h>         for(int i=0;i<2*n;i++) {
