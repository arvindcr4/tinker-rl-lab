[?2004l[?2004h>         for(int i=0;i<n;i++) {
[?2004l[?2004h>             for(int j=0;j<n;j++) {
[?2004l[?2004h>                 M[i*2*n+j]=A[i*n+j]; M[i*2*n+j+n]=0.0;
[?2004l[?2004h>                 M[(i+n)*2*n+j]=0.0; M[(i+n)*2*n+j+n]=A[i*n+j];
[?2004l[?2004h>             }
[?2004l[?2004h>             M[i*2*n+i]-=max_re; M[(i+n)*2*n+i+n]-=max_re;
[?2004l[?2004h>             M[i*2*n+i+n]=-max_im; M[(i+n)*2*n+i]=max_im;
[?2004l[?2004h>         }
[?2004l[?2004h>         memcpy(L,M,4*n*n*sizeof(double));
[?2004l[?2004h>         for(int i=0;i<2*n;i++) piv[i]=i;
[?2004l[?2004h>         int sing=0;
[?2004l[?2004h>         for(int k=0;k<2*n;k++) {
[?2004l[?2004h>             int mr=k; double mv=fabs(L[k*2*n+k]);
[?2004l[?2004h>             for(int i=k+1;i<2*n;i++) {
[?2004l[?2004h>                 double v=fabs(L[i*2*n+k]);
