[?2004l[?2004h>             for(int j=0;j<i;j++) y[i]-=L[i*2*n+j]*y[j];
[?2004l[?2004h>         }
[?2004l[?2004h>         // Back sub
[?2004l[?2004h>         for(int i=2*n-1;i>=0;i--) {
[?2004l[?2004h>             x[i]=y[i];
