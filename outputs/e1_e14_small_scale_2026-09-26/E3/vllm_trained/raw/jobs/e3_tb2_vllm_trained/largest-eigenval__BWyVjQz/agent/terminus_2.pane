[?2004l[?2004h>     *eval_re=max_re; *eval_im=max_im;
[?2004l[?2004h> 
[?2004l[?2004h>     // Inverse iteration for eigenvector
[?2004l[?2004h>     // For complex eigenvalue, solve (A - lambda*I)*v = v iteratively
[?2004l[?2004h>     // Using 2n x 2n real system
[?2004l[?2004h>     double M[400], L[400];
[?2004l[?2004h>     int piv[20];
[?2004l[?2004h>     double x[20], y[20];
