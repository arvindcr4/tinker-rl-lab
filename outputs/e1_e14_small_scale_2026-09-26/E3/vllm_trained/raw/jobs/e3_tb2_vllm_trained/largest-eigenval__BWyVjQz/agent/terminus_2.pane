[?2004l[?2004h>             }
[?2004l[?2004h>             if(mr!=k) {
[?2004l[?2004h>                 for(int j=0;j<2*n;j++) { double t=L[k*2*n+j];L[k*2*n+j]=L[mr*2*n+j];L[mr*2*n+j]=t; }
[?2004l[?2004h>                 int t=piv[k];piv[k]=piv[mr];piv[mr]=t;
[?2004l[?2004h>             }
[?2004l[?2004h>             if(fabs(L[k*2*n+k])<1e-30){sing=1;break;}
[?2004l[?2004h>             for(int i=k+1;i<2*n;i++) {
