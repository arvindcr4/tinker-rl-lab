[?2004l[?2004h> #define MAX_ITER 300
[?2004l[?2004h> #define TOL 1e-14
[?2004l[?2004h> 
[?2004l[?2004h> // Hessenberg reduction (Householder)
[?2004l[?2004h> void hessenberg_reduce(double *A, int n) {
[?2004l[?2004h>     for (int k = 0; k < n - 2; k++) {
[?2004l[?2004h>         // Compute Householder vector for column k, rows k+1..n-1
[?2004l[?2004h>         double sigma = 0.0;
[?2004l[?2004h>         for (int i = k + 1; i < n; i++) {
[?2004l[?2004h>             sigma += A[i * n + k] * A[i * n + k];
[?2004l[?2004h>         }
[?2004l[?2004h>         if (sigma < 1e-30) continue;
[?2004l[?2004h>         sigma = sqrt(sigma);
[?2004l[?2004h>         
[?2004l[?2004h>         double alpha = A[(k+1) * n + k];
[?2004l[?2004h>         double sign = (alpha >= 0) ? 1.0 : -1.0;
[?2004l[?2004h>         double v_k1 = alpha + sign * sigma;
[?2004l[?2004h>         
[?2004l[?2004h>         // Normalize
[?2004l[?2004h>         double norm = sqrt(v_k1 * v_k1 + sigma);
[?2004l[?2004h>         double v0 = 1.0 / norm;
[?2004l[?2004h>         
[?2004l[?2004h>         double v[n];
[?2004l[?2004h>         v[k] = 0.0;
[?2004l[?2004h>         v[k+1] = v_k1 * v0;
[?2004l[?2004h>         for (int i = k + 2; i < n; i++) {
[?2004l[?2004h>             v[i] = A[i * n + k] * v0;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Apply P = I - 2*v*v^T from left: A = P*A
[?2004l[?2004h>         for (int j = k; j < n; j++) {
[?2004l[?2004h>             double dot = 0.0;
[?2004l[?2004h>             for (int i = k; i < n; i++) {
[?2004l[?2004h>                 dot += v[i] * A[i * n + j];
[?2004l[?2004h>             }
[?2004l[?2004h>             for (int i = k; i < n; i++) {
[?2004l[?2004h>                 A[i * n + j] -= 2.0 * dot * v[i];
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Apply P from right: A = A*P
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             double dot = 0.0;
[?2004l[?2004h>             for (int j = k; j < n; j++) {
[?2004l[?2004h>                 dot += A[i * n + j] * v[j];
[?2004l[?2004h>             }
[?2004l[?2004h>             for (int j = k; j < n; j++) {
[?2004l[?2004h>                 A[i * n + j] -= 2.0 * dot * v[j];
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // QR iteration on upper Hessenberg matrix
[?2004l[?2004h> // Returns eigenvalues in eigenvalues array
[?2004l[?2004h> int qr_eigenvalues(double *H, int n, double *eigenvalues) {
[?2004l[?2004h>     int nn = n;
[?2004l[?2004h>     int iter = 0;
[?2004l[?2004h>     
[?2004l[?2004h>     while (nn > 0) {
[?2004l[?2004h>         if (nn == 1) {
[?2004l[?2004h>             eigenvalues[0] = H[0];
[?2004l[?2004h>             return 0;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         if (nn == 2) {
[?2004l[?2004h>             // 2x2 block
[?2004l[?2004h>             double a = H[0], b = H[1], c = H[n], d = H[n+1];
[?2004l[?2004h>             double trace = a + d;
[?2004l[?2004h>             double det = a * d - b * c;
[?2004l[?2004h>             double disc = trace * trace - 4.0 * det;
[?2004l[?2004h>             
[?2004l[?2004h>             if (disc >= 0) {
[?2004l[?2004h>                 double sqrt_disc = sqrt(disc);
[?2004l[?2004h>                 eigenvalues[0] = (trace + sqrt_disc) / 2.0;
[?2004l[?2004h>                 eigenvalues[1] = (trace - sqrt_disc) / 2.0;
[?2004l[?2004h>             } else {
[?2004l[?2004h>                 // Complex eigenvalues - store real and imaginary parts
[?2004l[?2004h>                 eigenvalues[0] = trace / 2.0;
[?2004l[?2004h>                 eigenvalues[1] = sqrt(-disc) / 2.0;
[?2004l[?2004h>             }
[?2004l[?2004h>             return 0;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Check for deflation
[?2004l[?2004h>         double off_diag = fabs(H[(nn-1) * n + nn - 2]);
[?2004l[?2004h>         double scale = 0.0;
[?2004l[?2004h>         for (int i = 0; i < nn; i++) {
[?2004l[?2004h>             for (int j = 0; j < nn; j++) {
[?2004l[?2004h>                 scale = fmax(scale, fabs(H[i * n + j]));
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         if (scale < 1e-30) scale = 1.0;
[?2004l[?2004h>         
[?2004l[?2004h>         if (off_diag / scale < TOL) {
[?2004l[?2004h>             eigenvalues[nn - 1] = H[(nn-1) * n + nn - 1];
[?2004l[?2004h>             nn--;
[?2004l[?2004h>             continue;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Wilkinson shift
[?2004l[?2004h>         double a = H[(nn-2) * n + nn - 2];
[?2004l[?2004h>         double b = H[(nn-2) * n + nn - 1];
[?2004l[?2004h>         double c = H[(nn-1) * n + nn - 2];
[?2004l[?2004h>         double d = H[(nn-1) * n + nn - 1];
[?2004l[?2004h>         double trace = a + d;
[?2004l[?2004h>         double det = a * d - b * c;
[?2004l[?2004h>         double disc = trace * trace - 4.0 * det;
[?2004l[?2004h>         
[?2004l[?2004h>         double shift;
[?2004l[?2004h>         if (disc >= 0) {
[?2004l[?2004h>             double sqrt_disc = sqrt(disc);
[?2004l[?2004h>             double e1 = (trace + sqrt_disc) / 2.0;
[?2004l[?2004h>             double e2 = (trace - sqrt_disc) / 2.0;
[?2004l[?2004h>             shift = (fabs(e1 - d) > fabs(e2 - d)) ? e1 : e2;
[?2004l[?2004h>         } else {
[?2004l[?2004h>             shift = d;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Shifted QR step
[?2004l[?2004h>         for (int i = 0; i < nn; i++) {
[?2004l[?2004h>             H[i * n + i] -= shift;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // QR decomposition using Givens rotations
[?2004l[?2004h>         for (int j = 0; j < nn - 1; j++) {
[?2004l[?2004h>             double x = H[j * n + j];
[?2004l[?2004h>             double y = H[(j+1) * n + j];
[?2004l[?2004h>             double r = sqrt(x * x + y * y);
[?2004l[?2004h>             if (r < 1e-30) continue;
[?2004l[?2004h>             double cs = x / r;
[?2004l[?2004h>             double sn = y / r;
[?2004l[?2004h>             
[?2004l[?2004h>             // Apply Givens rotation to rows j and j+1
[?2004l[?2004h>             for (int k = j; k < nn; k++) {
[?2004l[?2004h>                 double t1 = H[j * n + k];
[?2004l[?2004h>                 double t2 = H[(j+1) * n + k];
[?2004l[?2004h>                 H[j * n + k] = cs * t1 + sn * t2;
[?2004l[?2004h>                 H[(j+1) * n + k] = -sn * t1 + cs * t2;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Multiply R * Q (apply rotations from right)
[?2004l[?2004h>         for (int j = 0; j < nn - 1; j++) {
[?2004l[?2004h>             double x = H[j * n + j];
[?2004l[?2004h>             double y = H[(j+1) * n + j];
[?2004l[?2004h>             double r = sqrt(x * x + y * y);
[?2004l[?2004h>             if (r < 1e-30) continue;
[?2004l[?2004h>             double cs = x / r;
[?2004l[?2004h>             double sn = y / r;
[?2004l[?2004h>             
[?2004l[?2004h>             for (int i = 0; i < nn; i++) {
[?2004l[?2004h>                 double t1 = H[i * n + j];
[?2004l[?2004h>                 double t2 = H[i * n + (j+1)];
[?2004l[?2004h>                 H[i * n + j] = cs * t1 + sn * t2;
[?2004l[?2004h>                 H[i * n + (j+1)] = -sn * t1 + cs * t2;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Restore shift
[?2004l[?2004h>         for (int i = 0; i < nn; i++) {
[?2004l[?2004h>             H[i * n + i] += shift;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         iter++;
[?2004l[?2004h>         if (iter > MAX_ITER) break;
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     return 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // Compute eigenvector for a given eigenvalue using inverse iteration
[?2004l[?2004h> void compute_eigenvector(const double *A, int n, double lambda_r, double lambda_i, double *evec_r, double *evec_i) {
[?2004l[?2004h>     // Build (A - lambda*I) and solve for null space
[?2004l[?2004h>     // Use power iteration with shift: (A - sigma*I)^{-1} v
[?2004l[?2004h>     // Start with random vector
[?2004l[?2004h>     for (int i = 0; i < n; i++) {
[?2004l[?2004h>         evec_r[i] = 1.0 / sqrt((double)n);
[?2004l[?2004h>         evec_i[i] = 0.0;
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     // Simple inverse iteration with shift
[?2004l[?2004h>     // For simplicity, use a few steps of shifted power iteration
[?2004l[?2004h>     double sigma = lambda_r;  // real shift
[?2004l[?2004h>     
[?2004l[?2004h>     for (int iter = 0; iter < 100; iter++) {
[?2004l[?2004h>         // w = (A - sigma*I)^{-1} v
[?2004l[?2004h>         // Build A - sigma*I
[?2004l[?2004h>         double B[100]; // max 10x10
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             for (int j = 0; j < n; j++) {
[?2004l[?2004h>                 B[i * n + j] = A[i * n + j];
[?2004l[?2004h>                 if (i == j) B[i * n + j] -= sigma;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Solve B * w = v using LU decomposition
[?2004l[?2004h>         // Simple Gaussian elimination with partial pivoting
[?2004l[?2004h>         double L[100], U[100], P[100]; // LU and permutation
[?2004l[?2004h>         memcpy(U, B, n * n * sizeof(double));
[?2004l[?2004h>         for (int i = 0; i < n; i++) P[i] = i;
[?2004l[?2004h>         
[?2004l[?2004h>         for (int k = 0; k < n - 1; k++) {
[?2004l[?2004h>             // Partial pivoting
[?2004l[?2004h>             int max_row = k;
[?2004l[?2004h>             double max_val = fabs(U[k * n + k]);
[?2004l[?2004h>             for (int i = k + 1; i < n; i++) {
[?2004l[?2004h>                 if (fabs(U[i * n + k]) > max_val) {
[?2004l[?2004h>                     max_val = fabs(U[i * n + k]);
[?2004l[?2004h>                     max_row = i;
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>             if (max_row != k) {
[?2004l[?2004h>                 for (int j = 0; j < n; j++) {
[?2004l[?2004h>                     double tmp = U[k * n + j];
[?2004l[?2004h>                     U[k * n + j] = U[max_row * n + j];
[?2004l[?2004h>                     U[max_row * n + j] = tmp;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 int tmp = P[k]; P[k] = P[max_row]; P[max_row] = tmp;
[?2004l[?2004h>             }
[?2004l[?2004h>             
[?2004l[?2004h>             if (fabs(U[k * n + k]) < 1e-30) continue;
[?2004l[?2004h>             
[?2004l[?2004h>             for (int i = k + 1; i < n; i++) {
[?2004l[?2004h>                 double factor = U[i * n + k] / U[k * n + k];
[?2004l[?2004h>                 for (int j = k; j < n; j++) {
[?2004l[?2004h>                     U[i * n + j] -= factor * U[k * n + j];
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Forward substitution
[?2004l[?2004h>         double w[n];
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             w[i] = evec_r[P[i]]; // permuted RHS
[?2004l[?2004h>             for (int j = 0; j < i; j++) {
[?2004l[?2004h>                 w[i] -= U[j * n + i] * w[j]; // Note: U is upper, need to use L
[?2004l[?2004h>             }
[?2004l[?2004h>             // Actually let me redo this properly
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         // Simpler approach: just do one step of shifted power iteration
[?2004l[?2004h>         // w = A * v, then normalize
[?2004l[?2004h>         double w2[n];
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             w2[i] = 0.0;
[?2004l[?2004h>             for (int j = 0; j < n; j++) {
[?2004l[?2004h>                 w2[i] += A[i * n + j] * evec_r[j];
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         double norm = 0.0;
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             norm += w2[i] * w2[i];
[?2004l[?2004h>         }
[?2004l[?2004h>         norm = sqrt(norm);
[?2004l[?2004h>         
[?2004l[?2004h>         if (norm < 1e-30) {
[?2004l[?2004h>             for (int i = 0; i < n; i++) evec_r[i] = 1.0;
[?2004l[?2004h>             continue;
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             evec_r[i] = w2[i] / norm;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // Main function: find dominant eigenvalue and eigenvector
[?2004l[?2004h> // Returns: eigenvalue real part, eigenvalue imag part, eigenvector real, eigenvector imag
[?2004l[?2004h> void find_dominant(const double *A, int n, 
[?2004l[?2004h>                    double *eval_r, double *eval_i,
[?2004l[?2004h>                    double *evec_r, double *evec_i) {
[?2004l[?2004h>     // Make a copy
[?2004l[?2004h>     double H[100];
[?2004l[?2004h>     memcpy(H, A, n * n * sizeof(double));
[?2004l[?2004h>     
[?2004l[?2004h>     // Reduce to Hessenberg form
[?2004l[?2004h>     hessenberg_reduce(H, n);
[?2004l[?2004h>     
[?2004l[?2004h>     // QR iteration to find eigenvalues
[?2004l[?2004h>     double evals[20]; // max 10 eigenvalues, stored as pairs for complex
[?2004l[?2004h>     qr_eigenvalues(H, n, evals);
[?2004l[?2004h>     
[?2004l[?2004h>     // Find dominant eigenvalue (largest magnitude)
[?2004l[?2004h>     double max_mag = -1.0;
[?2004l[?2004h>     int idx = 0;
[?2004l[?2004h>     for (int i = 0; i < n; i++) {
[?2004l[?2004h>         double mag;
[?2004l[?2004h>         if (evals[i] < 0 && i + 1 < n && evals[i+1] != 0) {
[?2004l[?2004h>             // Complex eigenvalue stored as (real, imag)
[?2004l[?2004h>             mag = sqrt(evals[i] * evals[i] + evals[i+1] * evals[i+1]);
[?2004l[?2004h>             if (mag > max_mag) {
[?2004l[?2004h>                 max_mag = mag;
[?2004l[?2004h>                 idx = i;
[?2004l[?2004h>             }
[?2004l[?2004h>         } else {
[?2004l[?2004h>             mag = fabs(evals[i]);
[?2004l[?2004h>             if (mag > max_mag) {
[?2004l[?2004h>                 max_mag = mag;
[?2004l[?2004h>                 idx = i;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     // Extract dominant eigenvalue
