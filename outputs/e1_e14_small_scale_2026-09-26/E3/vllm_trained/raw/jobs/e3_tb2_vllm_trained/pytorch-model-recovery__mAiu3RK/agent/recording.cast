[56.32315, "i", "cat > /app/solve.py << 'PYEOF'\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.nn.functional import mse_loss\n\nclass PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000):\n        super().__init__()\n        pe = torch.zeros(1, max_len, d_model)\n        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-torch.log(torch.tensor(10000.0)) / d_model))\n        pe[0, :, 0::2] = torch.sin(position * div_term)\n        pe[0, :, 1::2] = torch.cos(position * div_term)\n        self.register_buffer('pe', pe)\n\n    def forward(self, x):\n        return x + self.pe[:, :x.size(1), :]\n\nclass RecoveredModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.embedding = nn.Linear(64, 128)\n        self.pos_encoder = PositionalEncoding(128, max_len=5000)\n        \n        encoder_layer = nn.TransformerEncoderLayer(\n            d_model=128, nhead=4, dim_feedforward=256,\n        "]
[56.323232, "i", "    batch_first=True, activation='gelu'\n        )\n        self.transformer_encoder = nn.TransformerEncoder(encoder_layer, num_layers=3)\n        \n        decoder_layer = nn.TransformerDecoderLayer(\n            d_model=128, nhead=4, dim_feedforward=256,\n            batch_first=True, activation='gelu'\n        )\n        self.transformer_decoder = nn.TransformerDecoder(decoder_layer, num_layers=1)\n        \n        self.output_layer = nn.Linear(128, 64)\n    \n    def forward(self, src, tgt):\n        x = self.embedding(src)\n        x = self.pos_encoder(x)\n        encoded = self.transformer_encoder(x)\n        x = self.transformer_decoder(tgt, encoded)\n        out = self.output_layer(x)\n        return out\n\n# Load weights and dataset\nweights = torch.load('/app/weights.pt', map_location='cpu')\ndata = torch.load('/app/dataset.pt', map_location='cpu')\nsrc = data['src_sequences']\ntgt = data['tgt_sequences']\n\nprint(f\"src shape: {src.shape}\")\nprint(f\"tgt shape: {tgt.shape}\")\n\n# Create model and load weights\nmodel = RecoveredM"]
[56.323282, "i", "odel()\nmodel.load_state_dict(weights)\nmodel.eval()\n\n# Compute original MSE\nwith torch.no_grad():\n    original_output = model(src, tgt)\n    original_mse = mse_loss(original_output, tgt)\nprint(f\"Original MSE: {original_mse.item()}\")\n\n# Now tune only output_layer\nmodel.train()\nfor name, param in model.named_parameters():\n    if not name.startswith('output_layer'):\n        param.requires_grad = False\n    else:\n        param.requires_grad = True\n\noptimizer = optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=0.01)\n\nfor epoch in range(500):\n    optimizer.zero_grad()\n    output = model(src, tgt)\n    loss = mse_loss(output, tgt)\n    loss.backward()\n    optimizer.step()\n    if epoch % 50 == 0:\n        print(f\"Epoch {epoch}, Loss: {loss.item()}\")\n\n# Compute final MSE\nmodel.eval()\nwith torch.no_grad():\n    final_output = model(src, tgt)\n    final_mse = mse_loss(final_output, tgt)\nprint(f\"Final MSE: {final_mse.item()}\")\n\n# Verify only output_layer changed\nstate_dict = model.state_dict()\nfor k in weights"]
[56.323323, "i", ":\n    if k != 'output_layer.weight' and k != 'output_layer.bias':\n        assert torch.allclose(weights[k], state_dict[k]), f\"Mismatch in {k}\"\nprint(\"Verification passed: only output_layer changed\")\n\n# Save as TorchScript\ntraced = torch.jit.script(model)\ntraced.save('/app/model.pt')\nprint(\"Model saved to /app/model.pt\")\n\n# Verify loading\nloaded = torch.jit.load('/app/model.pt')\nwith torch.no_grad():\n    loaded_output = loaded(src, tgt)\n    loaded_mse = mse_loss(loaded_output, tgt)\nprint(f\"Loaded model MSE: {loaded_mse.item()}\")\nPYEOF\n"]
