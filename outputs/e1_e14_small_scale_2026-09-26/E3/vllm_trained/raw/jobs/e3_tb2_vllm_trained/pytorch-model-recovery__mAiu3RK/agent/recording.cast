[161.74472, "i", "python3 -c \"\nimport torch\nfrom torch.nn.functional import mse_loss\n\n# Verify weights.pt is unchanged\nweights = torch.load('/app/weights.pt', map_location='cpu')\nprint('weights.pt keys:', len(weights))\n\n# Load saved model\nloaded = torch.jit.load('/app/model.pt')\nstate = loaded.state_dict()\nprint('model.pt keys:', len(state))\n\n# Check only output_layer differs\nfor k in weights:\n    if k in state:\n        if not torch.allclose(weights[k], state[k]):\n            print(f'Changed: {k}')\n    else:\n        print(f'Missing in model.pt: {k}')\n\n# Verify MSE improvement\ndata = torch.load('/app/dataset.pt', map_location='cpu')\nsrc = data['src_sequences']\ntgt = data['tgt_sequences']\nwith torch.no_grad():\n    out = loaded(src, tgt)\n    mse = mse_loss(out, tgt)\nprint(f'Final MSE: {mse.item()}')\nprint('All checks passed!')\n\"\n"]
