[111.251892, "o", "\u001b[?2004h> "]
[111.251908, "o", "        encoded = self.transformer_encoder(x)\r\n\u001b[?2004l\r"]
[111.252115, "o", "\u001b[?2004h>         # Embed and encode target as well\r\n\u001b[?2004l\r"]
[111.25213, "o", "\u001b[?2004h"]
[111.252335, "o", ">         tgt_emb = self.embedding(tgt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.252492, "o", "        tgt_emb = self.pos_encoder(tgt_emb)\r\n\u001b[?2004l\r"]
[111.252506, "o", "\u001b[?2004h"]
[111.252525, "o", "> "]
[111.252859, "o", "        x = self.transformer_decoder(tgt_emb, encoded)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.253015, "o", "        out = self.output_layer(x)\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n"]
[111.25303, "o", "\u001b[?2004l\r"]
[111.253039, "o", "\u001b[?2004h"]
[111.253288, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Load weights and dataset\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.25352, "o", "weights = torch.load('/app/weights.pt', map_location='cpu')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.253764, "o", "data = torch.load('/app/dataset.pt', map_location='cpu')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.25392, "o", "src = data['src_sequences']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.254081, "o", "tgt = data['tgt_sequences']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.254383, "o", "print(f\"src shape: {src.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"tgt shape: {tgt.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.2546, "o", "# Create model and load weights\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.254834, "o", "model = RecoveredModel()\r\n\u001b[?2004l\r\u001b[?2004h> model.load_state_dict(weights)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.255096, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Compute original MSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.255257, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.255483, "o", "    original_output = model(src, tgt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.255746, "o", "    original_mse = mse_loss(original_output, tgt)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Original MSE: {original_mse.item()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.255936, "o", "> \r\n\u001b[?2004l\r"]
[111.255952, "o", "\u001b[?2004h> # Now tune only output_layer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.256229, "o", "model.train()\r\n\u001b[?2004l\r\u001b[?2004h> for name, param in model.named_parameters():\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.256245, "o", "> "]
[111.256524, "o", "    if not name.startswith('output_layer'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.256767, "o", "        param.requires_grad = False\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.256997, "o", "        param.requires_grad = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.257282, "o", "optimizer = optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=0.01)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.2573, "o", "> "]
[111.257597, "o", "for epoch in range(500):\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.257828, "o", "    output = model(src, tgt)\r\n\u001b[?2004l\r\u001b[?2004h>     loss = mse_loss(output, tgt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.257841, "o", "> "]
[111.258108, "o", "    loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.258123, "o", "    if epoch % 50 == 0:\r\n\u001b[?2004l\r"]
[111.258319, "o", "\u001b[?2004h> "]
[111.258462, "o", "        print(f\"Epoch {epoch}, Loss: {loss.item()}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.258695, "o", "# Compute final MSE\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.258709, "o", "> "]
[111.258903, "o", "    final_output = model(src, tgt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.259051, "o", "    final_mse = mse_loss(final_output, tgt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.25927, "o", "print(f\"Final MSE: {final_mse.item()}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.259422, "o", "# Verify only output_layer changed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.259568, "o", "state_dict = model.state_dict()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.259749, "o", "for k in weights:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.260009, "o", "    if k != 'output_layer.weight' and k != 'output_layer.bias':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.260253, "o", "        assert torch.allclose(weights[k], state_dict[k]), f\"Mismatch in {k}\"\r\n\u001b[?2004l\r"]
[111.260474, "o", "\u001b[?2004h> "]
[111.260488, "o", "print(\"Verification passed: only output_layer changed\")\r\n\u001b[?2004l\r"]
[111.260693, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save as TorchScript\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.260916, "o", "traced = torch.jit.script(model)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.260929, "o", "traced.save('/app/model.pt')\r\n\u001b[?2004l\r"]
[111.261197, "o", "\u001b[?2004h> print(\"Model saved to /app/model.pt\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.261419, "o", "# Verify loading\r\n\u001b[?2004l\r\u001b[?2004h> loaded = torch.jit.load('/app/model.pt')\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.261432, "o", "> "]
[111.26171, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     loaded_output = loaded(src, tgt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.261976, "o", "    loaded_mse = mse_loss(loaded_output, tgt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.262129, "o", "print(f\"Loaded model MSE: {loaded_mse.item()}\")\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[111.264665, "o", "\u001b[?2004h"]
[111.264681, "o", "root@modal:/app# "]
[112.378134, "i", "python3 /app/solve.py\n"]
[112.378537, "o", "python3 /app/solve.py\r\n\u001b[?2004l\r"]
