[18.217963, "o", "%u broadcast \u001b[01;31m\u001b[Kresponse\u001b[m\u001b[K\r\nPXE BIS not sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked\r\nDHCPLEASE\u001b[01;31m\u001b[KQUERY\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_IAID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_SERVER_DUID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_MAC\r\n"]
[18.218157, "o", "\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_CLIENT_ID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_INTERFACE\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_LEASE_EXPIRES\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_DOMAIN\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_DATA_MISSING\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_VENDOR_CLASS\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_SUPPLIED_\u001b[01;31m\u001b[KHOST\u001b[m\u001b[KNAME\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_CPEWAN_OUI\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_CPEWAN_SERIAL\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_CPEWAN_CLASS\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_CIRCUIT_ID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_SUBSCRIBER_ID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_REMOTE_ID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_REQUESTED_OPTIONS\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_MUD_URL\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_TAGS\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_VENDOR_CLASS_ID\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_VENDOR_CLASS%i\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_RELAY_ADDRESS\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_USER_CLASS%i\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_TIME_REMAINING\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_OLD_\u001b[01;31m\u001b[KHOST\u001b[m\u001b[KNAME\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KMASQ_LOG_DHCP\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked request from %s\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq%s: \r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq%s[%d]: \r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\n"]
[18.218283, "o", "\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-server\r\ncaptive-\u001b[01;31m\u001b[Kport\u001b[m\u001b[Kal\r\n\u001b[01;31m\u001b[Khost\u001b[m\u001b[Kname\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_cache_inserted\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_cache_live_freed\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_queries_forwarded\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_auth_answered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_local_answered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_stale_answered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_unanswered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec_max_crypto_use\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec_max_sig_fail\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec_max_work\r\n"]
[18.218353, "o", "dhcp_lease\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked NSEC3 iterations value\r\n\u001b[01;31m\u001b[KHost\u001b[m\u001b[K                           Address                                  Flags      Expires                  Source\r\nduplicate dhcp-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K IP address %s\r\n\u001b[01;31m\u001b[KDns\u001b[m\u001b[Kmasq is free software, and you are welcome to redistribute it\r\nsrv-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K name %s too long after domain appended\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nReturn ipaddr for all \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks in specified domains.\r\n"]
[18.218786, "o", "Return self-pointing MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nExpand simple names in /etc/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with domain-suffix.\r\nDon't forward spurious \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests from Windows \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nDon't include IPv4 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include IPv6 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include resource records of the given type in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nSet address or \u001b[01;31m\u001b[Khost\u001b[m\u001b[Kname for a specified machine.\r\nRead DHCP \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from file.\r\nRead DHCP \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from a directory.\r\nSpecify a \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks file to be read in addition to %s.\r\nRead \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks files from a directory.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nDon't do DHCP for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nForce broadcast replies for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nReturn MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for E\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.0 (defaults to %s).\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for upstream \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nSet maximum number of random originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K.\r\nSpecify time-to-live in seconds for replies from /etc/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nRetry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries after this many milliseconds.\r\nDisplay \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq version and copyright information.\r\nAnswer \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries based on the interface a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K was sent to.\r\nGive \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name to IPv4 address of interface.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\nRead DHCP static \u001b[01;31m\u001b[Khost\u001b[m\u001b[K information from %s.\r\nDo not provide DHCP on this interface, only provide \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.\r\nEnable RFC 4388 lease\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K functions for DHCPv4\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries. (defaults to %s)\r\nClear \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K cache when reloading %s.\r\nIgnore \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames provided by DHCP clients.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by TFTP only from the specified subtree.\r\nAllow access only to files owned by the user running \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq.\r\nEphemeral \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range for use by TFTP transfers.\r\n"]
[18.218927, "o", "Use only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP server.\r\nStop \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nAlways perform \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to all servers.\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for DHCP.\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nSpecify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nGenerate \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames based on MAC address for nameless clients.\r\n"]
[18.218978, "o", "Specify alias name for LOCAL \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name.\r\nAdd requestor's MAC address to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd specified IP subnet to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd client identification to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nProxy \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation results from upstream nameservers.\r\nAllow DHCP clients to do their own D\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K updates.\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K (A/AAAA and PTR) records\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K record in interface subnet\r\nSpecify arbitrary \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nDomain to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nEnable filtering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries with connection-track marks.\r\nSet allowed \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K patterns for a connection-track mark.\r\nDisable upstream checking for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC debugging.\r\n"]
[18.219012, "o", "Ensure answers without \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC are in unsigned zones.\r\nDon't check \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature timestamps until first cache-reload\r\nTimestamp file to verify system clock for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC\r\nSet resource limits for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\n\u001b[01;31m\u001b[KAccept\u001b[m\u001b[K queries only from directly-connected networks.\r\n"]
[18.219276, "o", "Detect and remove \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K forwarding loops.\r\nIgnore \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kresponse\u001b[m\u001b[Ks containing ipaddr.\r\nSet TTL in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kresponse\u001b[m\u001b[Ks with DHCP-derived addresses.\r\nSuppress round-robin ordering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K records.\r\nSuppress \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nCache this \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record type.\r\nCase mismatch in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply - check bit 0x20 encoding.\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\ndiscarding \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply: subnet option mismatch\r\nnameserver %s refused to do a recursive \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K\r\npossible \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries reached (max: %d)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to %s reached (max: %d)\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s (logged only once)\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may \u001b[01;31m\u001b[Kaccept\u001b[m\u001b[K requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K amplification attacks via these interface(s)\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nNOT using nameserver %s#%d - \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K loop detected\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN DHCP DHCPv6 no-Lua TFTP no-conntrack ipset no-nftset auth no-\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC loop-detect inotify dumpfile\r\n"]
[18.219454, "o", "\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC not available: set HAVE_\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC in src/config.h\r\nconntrack sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNTRACK in src/config.h\r\nmax_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nstarted, version %s \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K disabled\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local subnets\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nIgnoring domain %s for DHCP \u001b[01;31m\u001b[Khost\u001b[m\u001b[K name %s\r\nlease\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from %s not permitted\r\ncannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nunable to get free \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked write request from %s\r\ncannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[18.219649, "o", "%s has more than one address in \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ksfile, using %s for DHCP\r\ncannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset control \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPfor IPv6 option\r\nDHCP \u001b[01;31m\u001b[Khost\u001b[m\u001b[K has mu multiple names\r\nbad DHCP \u001b[01;31m\u001b[Khost\u001b[m\u001b[K nainvalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K numbad dhcp-proxy amissing address ddress in alias\r\ninvalid alias rain dynamic \u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nbad NAPTR recordinvalid priorityBad \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-record\r\nBad name in \u001b[01;31m\u001b[Khost\u001b[m\u001b[Kunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked option (check that \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq was compiled with DHCP/TFTP/\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC/DBus s\r\n"]
