[115.808833, "i", "cat > /app/analyze.py << 'PYEOF'\nimport sys\nimport os\n\n# Start Ghidra headless analyzer\nos.environ['GHIDRA_INSTALL_DIR'] = '/opt/ghidra'\n\nfrom pyghidra import GhidraAPI\n\n# Create a headless Ghidra project\napi = GhidraAPI()\napi.open_project('/app/ghidra_project', create=True)\n\n# Load the binary\napi.load_binary('/app/target_binary')\n\n# Get the function at 0x39790\nfunc = api.get_function_by_address(0x39790)\nif func:\n    print(f\"Function found: {func.name} at {hex(func.address)}\")\n    print(f\"Function size: {func.size}\")\n    print(\"\\n--- Decompiled code ---\")\n    print(func.decompile())\nelse:\n    print(\"Function not found at 0x39790\")\n    # List all functions\n    for f in api.get_functions():\n        print(f\"  {hex(f.address)}: {f.name}\")\n\napi.close()\nPYEOF\n"]
