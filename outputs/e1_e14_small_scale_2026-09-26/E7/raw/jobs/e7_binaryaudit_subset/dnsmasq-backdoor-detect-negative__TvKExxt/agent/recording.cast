[17.351792, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nEnable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nAccept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s port %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King socket for %s: %s\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via interfaces other than %s\r\nignoring nameserver %s - cannot make\u001b[01;31m\u001b[K/bin\u001b[m\u001b[Kd socket: %s\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\n"]
