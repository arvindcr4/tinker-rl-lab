[370.678281, "i", "cat > /app/analyze.py << 'PYEOF'\nfrom pyghidra import open_program\n\nwith open_program('/app/target_binary', project_location='/app/ghidra_project', project_name='target', analyze=True) as prog:\n    print(\"Program loaded\")\n    print(f\"Base address: {hex(prog.getBaseAddress().getOffset())}\")\n    \n    # List all functions\n    funcs = list(prog.getFunctions(prog.toAddr(0), True))\n    print(f\"\\nTotal functions: {len(funcs)}\")\n    \n    # Look for functions with suspicious names or at suspicious addresses\n    for f in funcs:\n        name = f.getName()\n        addr = f.getEntryPoint().getOffset()\n        if 'execl' in name.lower() or 'shell' in name.lower() or 'backdoor' in name.lower() or 'system' in name.lower() or 'exec' in name.lower():\n            print(f\"  SUSPICIOUS: {hex(addr)}: {name}\")\n    \n    # Also list functions in the range we saw in radare2\n    print(\"\\n--- Functions in 0x39000-0x3a000 range ---\")\n    for f in funcs:\n        addr = f.getEntryPoint().getOffset()\n        if 0x39000 <= addr <= 0x3a000:\n            print(f\"  {hex(addr)}: {f.getName()}\")\n    \n    # List all functions\n    print(\"\\n--- All functions ---\")\n    for f in funcs:\n        addr = f.getEntryPoint().getOffset()\n        print(f\"  {hex(addr)}: {f.getName()}\")\nPYEOF\n"]
