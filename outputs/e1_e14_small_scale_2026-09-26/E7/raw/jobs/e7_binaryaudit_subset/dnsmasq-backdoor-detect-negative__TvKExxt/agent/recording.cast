[169.294294, "i", "cat > /app/analyze.py << 'PYEOF'\nfrom pyghidra import open_program\n\nwith open_program('/app/target_binary', project_location='/app/ghidra_project', project_name='target', analyze=True) as prog:\n    print(f\"Program loaded: {prog.name}\")\n    print(f\"Language: {prog.language}\")\n    \n    # Get function at 0x39790\n    addr = prog.to_addr(0x39790)\n    func = prog.get_function_at(addr)\n    if func:\n        print(f\"\\nFunction: {func.name} at {hex(func.address)}\")\n        print(f\"Size: {func.length}\")\n        print(\"\\n--- Decompiled code ---\")\n        print(func.decompile(0).getDecompiledXML())\n    else:\n        print(\"Function not found at 0x39790\")\n        # List nearby functions\n        for f in prog.get_functions(addr, True):\n            print(f\"  {hex(f.address)}: {f.name}\")\nPYEOF\n"]
