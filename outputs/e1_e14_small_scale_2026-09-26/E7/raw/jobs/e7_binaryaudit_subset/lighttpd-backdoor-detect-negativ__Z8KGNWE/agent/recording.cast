[18.582006, "o", "li_angel_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_free\r\nli_vrequest_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_upgrade\r\nli_vrequest_indirect_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\n"]
[18.584537, "o", "include_\u001b[01;31m\u001b[Kshell\u001b[m\u001b[K not allowed\r\ninclude_\u001b[01;31m\u001b[Kshell\u001b[m\u001b[K '%s' failed: %s\r\n\u001b[01;31m\u001b[Kshell\u001b[m\u001b[K: \r\n"]
[18.58468, "o", "include_\u001b[01;31m\u001b[Kshell\u001b[m\u001b[K directive takes a string as parameter\r\ninclude_\u001b[01;31m\u001b[Kshell\u001b[m\u001b[K '%s' returned non-zero status: %i\r\n(error) %s:%d: li_fatal: angel \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion close: %s\r\nAssertion `con->ndx >= 0 && (guint)con->ndx < wpool->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions->len' failed.\r\nAssertion `g_ptr_array_index(wpool->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions, con->ndx) == con' failed.\r\nAssertion `last_idle_ndx == (gint) wpool->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions->len - 1' failed.\r\n"]
[18.584747, "o", "Assertion `NULL != base->\u001b[01;31m\u001b[Kcallback\u001b[m\u001b[K' failed.\r\n(error) %s:%d: Couldn't \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K to '%s': %s\r\n(error) %s:%d: Couldn't \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K to '%s': timeout\r\nbackend \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K queue\r\nbackend \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion\r\nphysical.doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K\r\n"]
[18.584937, "o", "\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion upgrade: write response headers\r\n../src/main/\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion.c\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion keep-alive timeout\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion closed\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion closed (error)\r\n"]
[18.585001, "o", "li_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_free\r\nmainvr_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_upgrade\r\nli_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_start\r\nDOCUMENT_\u001b[01;31m\u001b[KROOT\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KCONNECT\u001b[m\u001b[K\r\nThere are too many \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions from your internet address\r\nli_network_read: fd should be disabled as chunkqueue is already full, aborting \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion.\r\n"]
[18.585283, "o", "<p>There are too many \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions from your internet address.</p>\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: Upgrade\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: close\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: keep-alive\r\nToo many open files. Either raise your fd limit or use a lower \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion limit.\r\ndis\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked_dest\r\ndis\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked_source\r\n_dis\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\nli_stream_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion\r\n(debug) %s:%d: \u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion token '%s'\r\nHTTP/1.1 response: no clean message length indicator, fall back to waiting for \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion close\r\nBackend: need chunked transfer-encoding or content-length for keepalive \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nUpgrade without \u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: Upgrade Transfer\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion upgrade\r\nli_vrequest_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_upgrade\r\nli_vrequest_indirect_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\nworker \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion keep-alive\r\nworker new \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion\r\n(debug) %s:%d: \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion io-timeout from %s after %.2f seconds\r\n(error) %s:%d: Server shutdown with unclosed \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions: %u\r\nAssertion `con->idx < wrk->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions_active' failed.\r\n(debug) %s:%d: doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K: \"%s\"\r\nno doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K specified yet but index action called\r\n(debug) %s:%d: doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K: waiting for async: \"%s\"\r\n(debug) %s:%d: doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K: not found: \"%s\", trying next\r\n"]
[18.585344, "o", "doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K action expects a string or list of strings as parameter\r\ndoc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K: failed to parse pattern\r\n"]
[18.585879, "o", "doc_\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K\r\n"]
