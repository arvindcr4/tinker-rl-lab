<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<title>Welcome page</title>
		<style type="text/css" media="screen">
			body { margin: 0; padding: 0; font-family: Verdana, sans-serif; font-size: 11pt; }
			#header { padding: 10px; background-color: #6D84B4; font-size: 18px; color: white; border-bottom: 1px solid #3B5998; font-weight: bold; text-align: center; }
			#content { width: 800px; margin: auto; }
			h1 { color: #2e3436; }
			a { color: rgb(59, 89, 152); }
		</style>
		<!-- hide inline image from IE because it can't handle data urls > 32kb and also has problems with png in it -->
		<!--[if IE]>
		<style type="text/css" media="screen">
			#logo { display: none; }
		</style>
		<![endif]-->
	</head>
	<body>
		<div id="header">
			Lighttpd Placeholder Page
		</div>
		<div id="content">
