[16.395358, "o", "%s is a CNAME, not giving it to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s\r\nnot giving name %s to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s because the name exists in %s with address %s\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K size %d, %d/%d \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K insertions re-used unexpired \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K entries.\r\n"]
