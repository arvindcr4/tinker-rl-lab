[96.313213, "o", "cannot use IPv4 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K address with IPv6 source address\r\ncannot use IPv6 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K address with IPv4 source address\r\njunk found in \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K line\r\n"]
[96.313368, "o", "bad \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K line options: %s\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nPXE\u001b[01;31m\u001b[KClient\u001b[m\u001b[K\r\n"]
[96.313668, "o", "\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks-file\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\nrev-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nno-0x20-\u001b[01;31m\u001b[Kencode\u001b[m\u001b[K\r\ndo-0x20-\u001b[01;31m\u001b[Kencode\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\nenable-t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-secure\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-no-fail\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-unique-root\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-root\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-max\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-mtu\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-lowercase\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-single-port\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-no-blocksize\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-port-range\r\nstop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\nall-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\ndhcp-\u001b[01;31m\u001b[Kclient\u001b[m\u001b[K-update\r\nauth-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nauth-sec-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks\r\nquiet-t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n"]
[96.313724, "o", "Specify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\n"]
[96.314015, "o", "Specify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nAssume we are the only DHCP \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K on the local network.\r\nSpecify BOOTP options to DHCP \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\nUse name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks strictly in the order given in %s.\r\nSpecify options to be sent to DHCP \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nDHCP option sent even if the \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K does not request it.\r\nDHCP option sent only to PXE \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nSpecify port to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for DNS requests on (defaults to 53).\r\nSpecify path to file with \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K= options\r\nSpecify address(es) of upstream \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks with optional domains.\r\nSpecify address of upstream \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\nSpecify time-to-live in seconds for maximum TTL to send to \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nTranslate IPv4 addresses from upstream \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\nEnable the DBus interface for setting upstream \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks, etc.\r\nDisable ICMP echo address checking in the DHCP \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\n\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n"]
[96.3141, "o", "Ignore hostnames provided by DHCP \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nDo NOT reuse filename and \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K fields for extra DHCP options.\r\nEnable integrated read-only T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\nExport files by T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K only from the specified subtree.\r\n"]
[96.314132, "o", "Add \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K IP or hardware address to t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-root.\r\nDo not terminate the service if T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K directories are inaccessible.\r\nMaximum number of concurrent T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers (defaults to %s).\r\nMaximum MTU to use for T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers.\r\nDisable the T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K blocksize extension.\r\n"]
[96.31416, "o", "Convert T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K filenames to lowercase\r\nEphemeral port range for use by T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers.\r\nUse only one port for T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\n"]
[96.314199, "o", "Stop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\nInhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\n"]
[96.314245, "o", "Always perform DNS queries to all \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\nSet tag if \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K includes matching option in request.\r\nSet tag if \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K provides given name.\r\n"]
[96.314484, "o", "Use only fully qualified domain names for DHCP \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nGenerate hostnames based on MAC address for nameless \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\n<local-addr>,<\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K>[,<iface>]\r\nRelay DHCP requests to a remote \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nPrompt to send to PXE \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\n[=\u001b[01;31m\u001b[Kbase64\u001b[m\u001b[K|text]\r\nAdd \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K identification to forwarded DNS queries.\r\nProxy DNSSEC validation results from upstream name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\nAttempt to allocate sequential IP addresses to DHCP \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nIgnore \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K identifier option sent by DHCP \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nAllow DHCP \u001b[01;31m\u001b[Kclient\u001b[m\u001b[Ks to do their own DDNS updates.\r\nSpecify DUID_EN-type DHCPv6 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K DUID\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nSecondary authoritative name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks for forward domains\r\n"]
[96.314545, "o", "Enable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\n"]
[96.314806, "o", "Accept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nDo not log routine T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[Kbase64\u001b[m\u001b[K\r\nIntel_Lean_\u001b[01;31m\u001b[KClient\u001b[m\u001b[K\r\n"]
[96.314866, "o", "unsupported option (check that dnsmasq was compiled with DHCP/T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K/DNSSEC/DBus support)\r\npossible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket to %s: %s\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s port %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket for %s: %s\r\nignoring name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s - local interface\r\nignoring name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K socket: %s\r\n"]
[96.315121, "o", "more \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks are defined but not logged\r\nusing name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d for %s %s%s %s\r\nNOT using name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d - query loop detected\r\nusing name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d(via %s)\r\nusing name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d\r\nusing standard name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks for %s\r\nusing %d more name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks\r\nname\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s port %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King socket for %s: %s\r\n--auth-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K required when an auth zone is defined.\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP socket: %s\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\nwarning: no upstream \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks configured\r\nT\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K %s%s %s %s\r\nwarning: T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K directory %s inaccessible\r\nrestricting maximum simultaneous T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers to %d\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP socket to device %s\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN DHCP DHCPv6 no-Lua T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K no-conntrack ipset no-nftset auth no-DNSSEC loop-detect inotify dumpfile\r\nT\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K directory %s inaccessible: %s\r\nno \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks found in %s, will retry\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket: %s\r\n%u \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K provides name: %s\r\n"]
[96.315198, "o", "not using configured address %s because it is in use by the \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K or relay\r\nwrong \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K-ID\r\n%u \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K name: %s\r\n%u next \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K: %s\r\nDNSMASQ_\u001b[01;31m\u001b[KSERVER\u001b[m\u001b[K_DUID\r\n"]
[96.315407, "o", "DNSMASQ_\u001b[01;31m\u001b[KCLIENT\u001b[m\u001b[K_ID\r\nunable to get free port for T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket: %s\r\nCannot create DHCPv6 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K DUID: %s\r\n%u \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K MAC address: %s\r\n%u cannot determine \u001b[01;31m\u001b[Kclient\u001b[m\u001b[K MAC address\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\ndns-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nlog-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nlpr-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nswap-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nnis-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K-identifier\r\n\u001b[01;31m\u001b[Kclient\u001b[m\u001b[K-id\r\nnis+-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nsmtp-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\npop3-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nnntp-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nirc-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kagent\u001b[m\u001b[K-id\r\n\u001b[01;31m\u001b[Kclient\u001b[m\u001b[K-arch\r\n\u001b[01;31m\u001b[Kclient\u001b[m\u001b[K-interface-id\r\n\u001b[01;31m\u001b[Kclient\u001b[m\u001b[K-machine-id\r\nsip-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K-address\r\n\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K-ip-address\r\n\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K-id\r\nsip-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K-domain\r\nsntp-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\n"]
[96.31563, "o", "failed to create IPset \u001b[01;31m\u001b[Kcontrol\u001b[m\u001b[K socket: %s\r\ntcp_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n"]
