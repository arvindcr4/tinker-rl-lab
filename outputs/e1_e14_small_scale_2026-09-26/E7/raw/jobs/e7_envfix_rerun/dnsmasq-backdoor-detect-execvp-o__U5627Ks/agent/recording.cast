[16.396056, "o", "cannot create \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: %s\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nCannot \u001b[01;31m\u001b[Kresolve\u001b[m\u001b[K server name\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s\r\ncannot \u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s: %s\r\n/var/run/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.pid\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K version %s  %s\r\n/etc/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.conf\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K-2.92test7-1-gd100821\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[Ksize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nservers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Khost\u001b[m\u001b[Kmaster.\r\ncannot get \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-name: %s\r\nmust have exactly one resolv.conf to \u001b[01;31m\u001b[Kread\u001b[m\u001b[K domain from.\r\nfailed to \u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s: %s\r\nthere must be a default domain when --\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn is set\r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K: %s.\r\ncannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\nno-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\nmx-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-size\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\