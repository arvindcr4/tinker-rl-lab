[16.396436, "o", "\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\nexpand-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\nno-neg\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-rr\r\naddn-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-interface\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv4-interface\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv6-interface\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K-ethers\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-vendorclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-userclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore\r\ne\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-packet-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-authoritative\r\nsrv-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-rr\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-mac\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile-ro\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-\u001b[01;31m\u001b[Kforward\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-names\r\ntftp-single-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option-force\r\nlog-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-circuitid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-remoteid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-subscrid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-pxe-vendor\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ksfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ksdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-no-override\r\ntftp-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-range\r\nstop-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-name-match\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-broadcast\r\nmin-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-ttl\r\nmax-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-alternate-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-scriptuser\r\nmin-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmax-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy\r\n"]
[16.396629, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-generate-names\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-local\u001b[01;31m\u001b[Khost\u001b[m\u001b[K-ok\r\nproxy-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-sequential-ip\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-client-update\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-luascript\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-duid\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-debug\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-check-unsigned\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-no-timecheck\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-timestamp\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-limits\r\n"]
[16.396884, "o", "quiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\nquiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-loop-detect\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kreply\u001b[m\u001b[K-delay\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-rapid-commit\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-clid\r\ndynamic-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-limit\r\nfast-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-retry\r\nuse-stale-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nReturn ipaddr for all \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks in specified domains.\r\nSpecify the size of the \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K in entries (defaults to %s).\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background: run in debug mode.\r\nDo NOT \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K queries with no domain part.\r\nReturn self-pointing MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nExpand simple names in /etc/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with domain-suffix.\r\nDon't \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K spurious \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests from Windows \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nDon't include IPv4 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include IPv6 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include resource records of the given type in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nEnable \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K in the range given with \u001b[01;31m\u001b[Klease\u001b[m\u001b[K duration.\r\n<\u001b[01;31m\u001b[Khost\u001b[m\u001b[Kspec>\r\nSet address or \u001b[01;31m\u001b[Khost\u001b[m\u001b[Kname for a specified machine.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from file.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option specs from file.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from a directory.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options from a directory.\r\nSpecify a \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks file to be \u001b[01;31m\u001b[Kread\u001b[m\u001b[K in addition to %s.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks files from a directory.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K user class to tag.\r\nDon't do \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\n"]
[16.397116, "o", "Force broadcast replies for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background, do NOT run in debug mode.\r\nAssume we are the only \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server on the local network.\r\nSpecify where to store \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\n/var/lib/misc/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks\r\nReturn MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\n<\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_name>,<target>,<pref>\r\nSpecify BOOTP options to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\nDo NOT \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K failed search results.\r\nUse expired \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K data for faster \u001b[01;31m\u001b[Kreply\u001b[m\u001b[K.\r\nSpecify options to be sent to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option sent even if the client does not request it.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option sent only to PXE clients.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for E\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.0 (defaults to %s).\r\nLog \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for upstream \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\n#\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks\r\nSet maximum number of random originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K.\r\nDo NOT \u001b[01;31m\u001b[Kread\u001b[m\u001b[K resolv.conf.\r\nNever \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K queries to specified domains.\r\nSpecify the domain to be assigned in \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks.\r\n<\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_name>\r\nSpecify time-to-live in seconds for replies from /etc/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nSpecify time-to-live in seconds for maximum TTL to \u001b[01;31m\u001b[Ksend\u001b[m\u001b[K to clients.\r\nSpecify time-to-live ceiling for \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.\r\nSpecify time-to-live floor for \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.\r\nRetry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries after this many milliseconds.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K vendor class to tag.\r\nDisplay \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K version and copyright information.\r\nDisplay this message. Use --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K or --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6 for known \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options.\r\nSpecify maximum number of \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\n"]
[16.397259, "o", "Answer \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries based on the interface a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K was sent to.\r\nSpecify TXT \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nSpecify PTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nGive \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name to IPv4 address of interface.\r\n"]
[16.39731, "o", "\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static \u001b[01;31m\u001b[Khost\u001b[m\u001b[K information from %s.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K on this interface, only provide \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 on this interface.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 on this interface.\r\nTreat \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests on aliases as arriving from interface.\r\nSpecify extra networks sharing a broadcast domain for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\nDisable ICMP echo address checking in the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\nShell script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nLua script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\n"]
[16.397369, "o", "Run \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change scripts as this user.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script with changes to local ARP table.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K configuration from all the files in this directory.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and \u001b[01;31m\u001b[Kread\u001b[m\u001b[K configuration from stdin.\r\nDo not use \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile.\r\n"]
[16.397573, "o", "Maximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries. (defaults to %s)\r\nClear \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K when reloading %s.\r\nIgnore \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames provided by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nDo NOT reuse filename and server fields for extra \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options.\r\nEnable integrated \u001b[01;31m\u001b[Kread\u001b[m\u001b[K-only TFTP server.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by TFTP only from the specified subtree.\r\nAllow access only to files owned by the user running \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\r\n"]
[16.397628, "o", "Ephemeral \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range for use by TFTP transfers.\r\nUse only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP server.\r\nExtra logging for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nStop \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nAlways perform \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to all servers.\r\n[=<\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks>]\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nSpecify NAPTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\n<\u001b[01;31m\u001b[Kport\u001b[m\u001b[K>\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nSpecify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nUse only fully qualified domain names for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nGenerate \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames based on MAC address for nameless clients.\r\nUse these \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relays as full proxies.\r\nRelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests to a remote server\r\nSpecify alias name for LOCAL \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name.\r\nPrompt to \u001b[01;31m\u001b[Ksend\u001b[m\u001b[K to PXE clients.\r\nAdd requestor's MAC address to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd specified IP subnet to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd client identification to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nProxy \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation results from upstream nameservers.\r\n"]
[16.397693, "o", "Attempt to allocate sequential IP addresses to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nIgnore client identifier option sent by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nAllow \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients to do their own D\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K updates.\r\n"]
[16.397745, "o", "\u001b[01;31m\u001b[KSend\u001b[m\u001b[K router-advertisements for interfaces doing \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6\r\nSpecify DUID_EN-type \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 server DUID\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K (A/AAAA and PTR) records\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K record in interface subnet\r\nSpecify arbitrary \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record\r\n"]
[16.397924, "o", "\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nDomain to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nSecondary authoritative nameservers for \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K domains\r\nEnable filtering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nActivate \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\nDisable upstream checking for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC debugging.\r\nEnsure answers without \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC are in unsigned zones.\r\nDon't check \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature timestamps until first \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-reload\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC\r\nSet resource limits for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\n"]
[16.397966, "o", "Set MTU, priority, re\u001b[01;31m\u001b[Ksend\u001b[m\u001b[K-interval and router-lifetime\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6.\r\n\u001b[01;31m\u001b[KAccept\u001b[m\u001b[K queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nDetect and remove \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kforward\u001b[m\u001b[King loops.\r\nIgnore \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses containing ipaddr.\r\nSet TTL in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K-derived addresses.\r\n"]
[16.398058, "o", "Delay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K replies for at least number of seconds.\r\nEnables \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 Rapid Commit option.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script when \u001b[01;31m\u001b[Klease\u001b[m\u001b[K expiry changes.\r\n\u001b[01;31m\u001b[KSend\u001b[m\u001b[K Cisco Umbrella identifiers including remote IP.\r\n"]
[16.398091, "o", "Suppress round-robin ordering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K records.\r\nSuppress \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nEnable \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\n\u001b[01;31m\u001b[KCache\u001b[m\u001b[K this \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record type.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nuk.org.thekelleys.\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-range\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K range\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 range\r\nduplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K IP address %s\r\n"]
[16.398119, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K has multiple names\r\nbad \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K name\r\ninvalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K number\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy address\r\n"]
[16.398463, "o", "Bad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-relay\r\nmissing address in dynamic \u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nbad dynamic \u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nBad \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-record\r\nBad name in \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-record\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked option (check that \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K was compiled with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/TFTP/\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC/DBus sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K)\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPv6 option\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option\r\nbad domain in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option too long\r\nNo vendor-encap options allowed in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option-pxe\r\nillegal \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-match\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K is free software, and you are welcome to redistribute it\r\nUsage: \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K [options]\r\nfailed to \u001b[01;31m\u001b[Ksend\u001b[m\u001b[K packet: %s\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s (logged only once)\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries reached (max: %d)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to %s reached (max: %d)\r\ndiscarding \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kreply\u001b[m\u001b[K: subnet option mismatch\r\npossible \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\nCase mismatch in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kreply\u001b[m\u001b[K - check bit 0x20 encoding.\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may \u001b[01;31m\u001b[Kaccept\u001b[m\u001b[K requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K amplification attacks via these interface(s)\r\ninterface %s failed to join \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 multicast group: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nNOT using nameserver %s#%d - \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K loop detected\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC not available: set HAVE_\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC in src/config.h\r\nconntrack sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNTRACK in src/config.h\r\nmax_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[16.398517, "o", "NET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\n"]
[16.398663, "o", "started, version %s \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K disabled\r\nstarted, version %s \u001b[01;31m\u001b[Kcache\u001b[m\u001b[Ksize %d\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K size greater than 10000 may cause performance issues, and is unlikely to be useful.\r\nstarted, version %s \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K disabled\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local subnets\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nchown of PID file %s failed: p\u001b[01;31m\u001b[Klease\u001b[m\u001b[K add capability CAP_CHOWN\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nsingle \u001b[01;31m\u001b[Kport\u001b[m\u001b[K mode\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 no-Lua TFTP no-conntrack ipset no-nftset auth no-\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC loop-detect inotify dumpfile\r\ncannot \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into background: %s\r\n"]
[16.398701, "o", "failed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[King %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet received on %s which has no address\r\nARP-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K injection failed: %s\r\nError \u001b[01;31m\u001b[Ksend\u001b[m\u001b[King \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet to %s: %s\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s - %d addresses\r\ncannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
