[11.733209, "o", "cannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\nno-0x20-\u001b[01;31m\u001b[Kencode\u001b[m\u001b[K\r\ndo-0x20-\u001b[01;31m\u001b[Kencode\u001b[m\u001b[K\r\n"]
[11.733587, "o", "dhcp-\u001b[01;31m\u001b[Kremote\u001b[m\u001b[Kid\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\n\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\nset:<tag>,<\u001b[01;31m\u001b[Kremote\u001b[m\u001b[K>\r\nMap RFC3046 \u001b[01;31m\u001b[Kremote\u001b[m\u001b[K-id to tag.\r\nSpecify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\n"]
[11.733713, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\n"]
[11.733793, "o", "Relay DHCP requests to a \u001b[01;31m\u001b[Kremote\u001b[m\u001b[K server\r\n"]
[11.733824, "o", "[=\u001b[01;31m\u001b[Kbase64\u001b[m\u001b[K|text]\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n"]
[11.733995, "o", "Enable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nAccept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\n"]
[11.734086, "o", "Send Cisco Umbrella identifiers including \u001b[01;31m\u001b[Kremote\u001b[m\u001b[K IP.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[Kbase64\u001b[m\u001b[K\r\n"]
[11.734124, "o", "TCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\n"]
[11.734208, "o", "cannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\n"]
