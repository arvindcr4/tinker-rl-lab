[15.717687, "o", "IPSEC\u001b[01;31m\u001b[KKEY\u001b[m\u001b[K\r\nR\u001b[01;31m\u001b[KKEY\u001b[m\u001b[K\r\nCDNS\u001b[01;31m\u001b[KKEY\u001b[m\u001b[K\r\nOPENPGP\u001b[01;31m\u001b[KKEY\u001b[m\u001b[K\r\n"]
