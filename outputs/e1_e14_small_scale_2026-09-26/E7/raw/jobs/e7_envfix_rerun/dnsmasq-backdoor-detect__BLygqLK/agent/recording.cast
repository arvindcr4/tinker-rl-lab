[16.794817, "o", "cannot create \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: %s\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n"]
[16.794999, "o", "hits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nservers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\n"]
[16.795044, "o", "\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\n"]
[16.795074, "o", "stop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n"]
[16.795099, "o", "Specify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background: run in debug mode.\r\n"]
[16.795333, "o", "Specify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background, do NOT run in debug mode.\r\nSpecify port to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for DNS requests on (defaults to 53).\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nStop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEnable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\n\u001b[01;31m\u001b[KAccept\u001b[m\u001b[K queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n"]
[16.795367, "o", "\u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate dhcp-host IP address %s\r\n\u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate CNAME\r\n\u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate\r\npossible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\n"]
[16.795439, "o", "failed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s port %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may \u001b[01;31m\u001b[Kaccept\u001b[m\u001b[K requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\n"]
[16.795471, "o", "failed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s port %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[16.795781, "o", "NET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\n"]
[16.795824, "o", "cannot \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into background: %s\r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nignoring %s line %d, \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate name or IP address\r\ncannot create DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\nIgnoring \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate dhcp-option %d\r\n\u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate IP address %s (%s) in dhcp-config directive\r\nN@cannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset control \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot open \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K %s: %s\r\ntcp_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n"]
