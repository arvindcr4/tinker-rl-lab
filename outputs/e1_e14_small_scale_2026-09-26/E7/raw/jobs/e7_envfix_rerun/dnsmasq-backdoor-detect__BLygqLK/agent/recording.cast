[15.718115, "o", "version.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nservers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\nstop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\n"]
[15.718297, "o", "Fake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\n\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\n"]
[15.718378, "o", "Specify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\n"]
[15.718592, "o", "Stop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\n"]
[15.718651, "o", "\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nillegal repeated \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword\r\npossible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server socket to %s: %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server socket for %s: %s\r\n"]
[15.718836, "o", "ignoring nameserver %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K socket: %s\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP socket: %s\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP socket to device %s\r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server socket: %s\r\n\u001b[01;31m\u001b[K/bin/sh\u001b[m\u001b[K\r\n"]
[15.718964, "o", "failed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server socket: %s\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\n"]
