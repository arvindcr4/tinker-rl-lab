[16.791597, "o", "\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kfork\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K\r\n"]
[16.791647, "o", "\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdup2\u001b[m\u001b[K\r\n"]
