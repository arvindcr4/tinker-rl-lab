[13.655539, "o", "Fake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\n\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\n"]
[13.655625, "o", "Specify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\n\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n"]
[13.655717, "o", "\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\n"]
