[14.583633, "o", "\u001b[01;31m\u001b[KHTTP\u001b[m\u001b[KS\r\ntru\u001b[01;31m\u001b[Kncat\u001b[m\u001b[Ked\r\nenable-t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-secure\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-no-fail\r\n"]
[14.583866, "o", "t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-unique-root\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-root\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-max\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-mtu\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-lowercase\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-single-port\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-no-blocksize\r\nt\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-port-range\r\nquiet-t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K\r\n"]
[14.584043, "o", "Enable integrated read-only T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K server.\r\nExport files by T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K only from the specified subtree.\r\nAdd client IP or hardware address to t\u001b[01;31m\u001b[Kftp\u001b[m\u001b[K-root.\r\nDo not terminate the service if T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K directories are inaccessible.\r\nMaximum number of concurrent T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers (defaults to %s).\r\nMaximum MTU to use for T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers.\r\nDisable the T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K blocksize extension.\r\nConvert T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K filenames to lowercase\r\nEphemeral port range for use by T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers.\r\nUse only one port for T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K server.\r\nDo not log routine T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K.\r\nunsupported option (check that dnsmasq was compiled with DHCP/T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K/DNSSEC/DBus support)\r\nT\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K %s%s %s %s\r\nwarning: T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K directory %s inaccessible\r\n"]
[14.584148, "o", "restricting maximum simultaneous T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K transfers to %d\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN DHCP DHCPv6 no-Lua T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K no-conntrack ipset no-nftset auth no-DNSSEC loop-detect inotify dumpfile\r\nT\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K directory %s inaccessible: %s\r\n\u001b[01;31m\u001b[K/bin/sh\u001b[m\u001b[K\r\nunable to get free port for T\u001b[01;31m\u001b[KFTP\u001b[m\u001b[K\r\n"]
