[19.890375, "o", "NSEC3PA\u001b[01;31m\u001b[KRA\u001b[m\u001b[KM\r\nC\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY\r\nInternal error in \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY algorithm\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked DS digest\r\n"]
[19.890613, "o", "\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC indeterminate\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC bogus\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature expired\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC sig not yet valid\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY missing\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[Kd error\r\nnot \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative\r\nno reachable \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Kority\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked NSEC3 ite\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktions value\r\n/dev/u\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kndom\r\nfailed to seed the \u001b[01;31m\u001b[Kra\u001b[m\u001b[Kndom number gene\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktor: %s\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[Kpriv\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n"]
[19.890832, "o", "Cannot \u001b[01;31m\u001b[Kresolve\u001b[m\u001b[K server name\r\n\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K can only be specified once\r\nbad \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K name\r\n/var/run/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.pid\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K version %s  %s\r\nCompile time \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\nbad command line \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\n/etc/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.conf\r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K-2.92test7-1-gd100821\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[Kors.bind\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[Ksize.bind\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K.bind\r\nthere must be a default domain when --\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn is set\r\n"]
[19.890978, "o", "\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K: %s.\r\nbad \u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\next\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kneous pa\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kmeter\r\nmissing pa\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kmeter\r\nillegal \u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-size\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-host\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-boot\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\n"]
[19.89111, "o", "no-neg\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-rr\r\n\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nexcept-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv4-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\nno-\u001b[01;31m\u001b[Kdhcpv6\u001b[m\u001b[K-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-max\r\nbind-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-vendorclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-userclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore\r\ne\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-packet-max\r\n"]
[19.891275, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-rr\r\n\u001b[01;31m\u001b[Kbootp\u001b[m\u001b[K-dynamic\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-mac\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile-ro\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-\u001b[01;31m\u001b[Kforward\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-names\r\nenable-\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K\r\n"]
[19.891442, "o", "\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-secure\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-no-fail\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-unique-root\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-root\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-mtu\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-lowercase\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-single-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K-force\r\n\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-no-blocksize\r\n"]
[19.891636, "o", "log-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-circuitid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-remoteid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-subscrid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-pxe-vendor\r\n\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K-name\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-hostsfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-hostsdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-no-override\r\n"]
[19.89173, "o", "\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\nstop-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-\u001b[01;31m\u001b[Krebind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Krebind\u001b[m\u001b[K-domain-ok\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-name-match\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-broadcast\r\nmin-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-ttl\r\nmax-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-alternate-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-scriptuser\r\nmin-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmax-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n"]
[19.891891, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-gene\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kte-names\r\n\u001b[01;31m\u001b[Krebind\u001b[m\u001b[K-localhost-ok\r\nproxy-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-sequential-ip\r\nconnt\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kck\r\n"]
[19.892095, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-client-update\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-luascript\r\nenable-\u001b[01;31m\u001b[Kra\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-duid\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-server\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-soa\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-sec-servers\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-peer\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-debug\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-check-unsigned\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-no-timecheck\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-timestamp\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-limits\r\n\u001b[01;31m\u001b[Kra\u001b[m\u001b[K-pa\u001b[01;31m\u001b[Kra\u001b[m\u001b[Km\r\nquiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\nquiet-\u001b[01;31m\u001b[Kdhcp6\u001b[m\u001b[K\r\nquiet-\u001b[01;31m\u001b[Kra\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-loop-detect\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ttl\r\n"]
[19.892283, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-reply-delay\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kpid-commit\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-clid\r\nquiet-\u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-limit\r\nfast-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-retry\r\nuse-stale-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nFake reverse lookups for RFC1918 private address \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knges.\r\n"]
[19.892531, "o", "Specify the size of the \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K in entries (defaults to %s).\r\nSpecify \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Ku\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktion file (defaults to %s).\r\nDo NOT \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K queries with no domain part.\r\nDon't \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K spurious \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests from Windows hosts.\r\nDon't include IPv4 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include IPv6 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include resource records of the given type in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nEnable \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K in the \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge given with \u001b[01;31m\u001b[Klease\u001b[m\u001b[K du\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktion.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host specs from file.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K specs from file.\r\n"]
[19.89278, "o", "Read \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host specs from a directory.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks from a directory.\r\nSpecify \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K user class to tag.\r\nDon't do \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K for hosts with tag set.\r\nAssume we are the only \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server on the local network.\r\nSpecify where to store \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\n/var/lib/misc/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks\r\n<\u001b[01;31m\u001b[Kbootp\u001b[m\u001b[K opts>\r\n"]
[19.892963, "o", "Specify \u001b[01;31m\u001b[KBOOTP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\nDo NOT \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K failed search results.\r\nUse expired \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K data for faster reply.\r\nSpecify \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks to be sent to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K sent even if the client does not request it.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K sent only to PXE clients.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for E\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.0 (defaults to %s).\r\nLog \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for upstream \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\n#\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks\r\n"]
[19.893126, "o", "Set maximum number of \u001b[01;31m\u001b[Kra\u001b[m\u001b[Kndom originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K.\r\nSpecify path to file with server= \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks\r\nSpecify address(es) of upstream servers with \u001b[01;31m\u001b[Koption\u001b[m\u001b[Kal domains.\r\nNever \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K queries to specified domains.\r\n<domain>[,<\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge>]\r\nSpecify the domain to be assigned in \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks.\r\nSpecify time-to-live ceiling for \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.\r\nSpecify time-to-live floor for \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.\r\nRetry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries after this many milliseconds.\r\n"]
[19.893367, "o", "Map \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K vendor class to tag.\r\nDisplay \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K version and copyright information.\r\nT\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knslate IPv4 addresses from upstream servers.\r\nDisplay this message. Use --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K or --help \u001b[01;31m\u001b[Kdhcp6\u001b[m\u001b[K for known \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks.\r\nSpecify maximum number of \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\nAnswer \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries based on the \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K was sent to.\r\nSpecify TXT \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nSpecify PTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\n<name>,<\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K>\r\nGive \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name to IPv4 address of \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\n"]
[19.89359, "o", "Bind only to \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks in use.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static host information from %s.\r\nEnable the DBus \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K for setting upstream servers, etc.\r\nEnable the UBus \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K on this \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K, only provide \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K on this \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 on this \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\nEnable dynamic address allocation for \u001b[01;31m\u001b[Kbootp\u001b[m\u001b[K.\r\nMap MAC address (with wildcards) to \u001b[01;31m\u001b[Koption\u001b[m\u001b[K set.\r\nTreat \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests on aliases as arriving from \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\nSpecify ext\u001b[01;31m\u001b[Kra\u001b[m\u001b[K networks sharing a broadcast domain for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\nDisable ICMP echo address checking in the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\nShell script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\n"]
[19.893794, "o", "Lua script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nRun \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change scripts as this user.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script with changes to local ARP table.\r\nRead \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Ku\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktion from all the files in this directory.\r\nExecute file and read \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Ku\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktion from stdin.\r\nDo not use \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile.\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries. (defaults to %s)\r\n"]
[19.894027, "o", "Clear \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K when reloading %s.\r\nIgnore hostnames provided by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nDo NOT reuse filename and server fields for ext\u001b[01;31m\u001b[Kra\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks.\r\nEnable integ\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kted read-only \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K server.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K only from the specified subtree.\r\nAdd client IP or hardware address to \u001b[01;31m\u001b[Ktftp\u001b[m\u001b[K-root.\r\nAllow access only to files owned by the user running \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\r\nDo not terminate the service if \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K directories are inaccessible.\r\nMaximum number of concurrent \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsfers (defaults to %s).\r\nMaximum MTU to use for \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsfers.\r\nDisable the \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K blocksize extension.\r\nConvert \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K filenames to lowercase\r\nEpheme\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kl \u001b[01;31m\u001b[Kport\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge for use by \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsfers.\r\nUse only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K server.\r\n"]
[19.894276, "o", "Ext\u001b[01;31m\u001b[Kra\u001b[m\u001b[K logging for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nEnable async. logging; \u001b[01;31m\u001b[Koption\u001b[m\u001b[Kally set queue length.\r\nStop \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Krebind\u001b[m\u001b[King. Filter private IP \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knges when resolving.\r\nAllow \u001b[01;31m\u001b[Krebind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-\u001b[01;31m\u001b[Krebind\u001b[m\u001b[K protection on this domain.\r\nAlways perform \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to all servers.\r\nSet tag if client includes matching \u001b[01;31m\u001b[Koption\u001b[m\u001b[K in request.\r\n[=<\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks>]\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nSpecify NAPTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\n<\u001b[01;31m\u001b[Kport\u001b[m\u001b[K>\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsmission.\r\n"]
[19.894472, "o", "Specify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsmission.\r\nUse only fully qualified domain names for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nGene\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kte hostnames based on MAC address for nameless clients.\r\nUse these \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relays as full proxies.\r\nRelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests to a remote server\r\nSpecify alias name for LOCAL \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name.\r\nCheck \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Ku\u001b[01;31m\u001b[Kra\u001b[m\u001b[Ktion syntax.\r\nAdd requestor's MAC address to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd specified IP subnet to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\n"]
[19.894615, "o", "Add client identification to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nProxy \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation results from upstream nameservers.\r\nAttempt to allocate sequential IP addresses to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nIgnore client identifier \u001b[01;31m\u001b[Koption\u001b[m\u001b[K sent by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nCopy connection-t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kck mark from queries to upstream connections.\r\nAllow \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients to do their own D\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K updates.\r\nSend router-advertisements for \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks doing \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K\r\nSpecify DUID_EN-type \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K server DUID\r\n<name>,[<IPv4>][,<IPv6>],<\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K-name>\r\nSpecify host record in \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K subnet\r\nSpecify certification \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Kority \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Korization record\r\n"]
[19.894721, "o", "Specify arbit\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record\r\nBind to \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks in use - check for new \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks\r\n<NS>,<\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K>\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nDomain to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nSet TTL for \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative replies\r\nSet \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative zone information\r\n"]
[19.894914, "o", "Secondary \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative nameservers for \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K domains\r\nPeers which are allowed to do zone t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsfer\r\nEnable filtering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries with connection-t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kck marks.\r\nSet allowed \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K patterns for a connection-t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kck mark.\r\n<domain>,<\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge>,[<prefix>]\r\nSpecify a domain and address \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge for synthesised names\r\nActivate \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\nDisable upstream checking for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC debugging.\r\nEnsure answers without \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC are in unsigned zones.\r\nDon't check \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature timestamps until first \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-reload\r\nTimestamp file to verify system clock for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC\r\nSet resource limits for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\n"]
[19.895068, "o", "<iface>,[mtu:<value>|<\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K>|off,][<prio>,]<intval>[,<lifetime>]\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nDo not log routine \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K.\r\nDo not log \u001b[01;31m\u001b[KRA\u001b[m\u001b[K.\r\nDetect and remove \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kforward\u001b[m\u001b[King loops.\r\nIgnore \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses containing ipaddr.\r\nSet TTL in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K-derived addresses.\r\nDelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K replies for at least number of seconds.\r\nEnables \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 \u001b[01;31m\u001b[KRa\u001b[m\u001b[Kpid Commit \u001b[01;31m\u001b[Koption\u001b[m\u001b[K.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script when \u001b[01;31m\u001b[Klease\u001b[m\u001b[K expiry changes.\r\nDo not log routine \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K.\r\nSuppress round-robin ordering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K records.\r\nSuppress \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\n"]
[19.895175, "o", "Enable \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\n\u001b[01;31m\u001b[KCache\u001b[m\u001b[K this \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record type.\r\nuk.org.thekelleys.\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K\r\ninvalid \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-zone\r\nrecompile with HAVE_CONNT\u001b[01;31m\u001b[KRA\u001b[m\u001b[KCK defined to enable connmark-allowlist directives\r\next\u001b[01;31m\u001b[Kra\u001b[m\u001b[K\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\nbad bridge-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\n"]
[19.895356, "o", "\u001b[01;31m\u001b[Kra\u001b[m\u001b[K-only\r\n\u001b[01;31m\u001b[Kra\u001b[m\u001b[K-names\r\n\u001b[01;31m\u001b[Kra\u001b[m\u001b[K-advrouter\r\n\u001b[01;31m\u001b[Kra\u001b[m\u001b[K-stateless\r\nprefix length must be exactly 64 for \u001b[01;31m\u001b[KRA\u001b[m\u001b[K subnets\r\ninconsistent \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\nduplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-host IP address %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host has multiple names\r\nbad \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host name\r\n"]
[19.89554, "o", "invalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K number\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy address\r\nBad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-relay\r\nbad \u001b[01;31m\u001b[KRA\u001b[m\u001b[K-pa\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kms\r\ninvalid alias \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked \u001b[01;31m\u001b[Koption\u001b[m\u001b[K (check that \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K was compiled with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/\u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K/\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC/DBus sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K)\r\n\u001b[01;31m\u001b[Koption\u001b[m\u001b[K:\r\n\u001b[01;31m\u001b[Koption\u001b[m\u001b[K6:\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPv6 \u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\nbad domain in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K too long\r\nNo vendor-encap \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks allowed in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K-pxe\r\n"]
[19.895631, "o", "illegal \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-match\r\nThis software comes with ABSOLUTELY NO WAR\u001b[01;31m\u001b[KRA\u001b[m\u001b[KNTY.\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K is free software, and you are welcome to redistribute it\r\nunder the terms of the GNU Gene\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kl Public License, version 2 or 3.\r\nUsage: \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K [\u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks]\r\nValid \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks are:\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s (logged only once)\r\n"]
[19.895761, "o", "ignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries reached (max: %d)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to %s reached (max: %d)\r\ndiscarding \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply: subnet \u001b[01;31m\u001b[Koption\u001b[m\u001b[K mismatch\r\npossible \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-\u001b[01;31m\u001b[Krebind\u001b[m\u001b[K attack detected: %s\r\nCase mismatch in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply - check bit 0x20 encoding.\r\n"]
[19.895955, "o", "\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks other than %s\r\nLOUD WARNING: use --bind-dynamic \u001b[01;31m\u001b[Kra\u001b[m\u001b[Kther than --bind-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks to avoid \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K amplification attacks via these \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K(s)\r\nwarning: using \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s instead\r\nwarning: no addresses found for \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\n\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s failed to join \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K multicast group: %s\r\nignoring nameserver %s - local \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\nNOT using nameserver %s#%d - \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K loop detected\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King socket for %s: %s\r\n"]
[19.896043, "o", "\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC not available: set HAVE_\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nconnt\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kck sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNT\u001b[01;31m\u001b[KRA\u001b[m\u001b[KCK in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nUbus not available: set HAVE_UBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nmax_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge\r\n--\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-server required when an \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K zone is defined.\r\ncannot set --bind-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks and --bind-dynamic\r\n"]
[19.896167, "o", "failed to find list of \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks: %s\r\nunknown \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\nfailed to set SO_BINDTODEVICE on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nDBus not available: set HAVE_DBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nUBus not available: set HAVE_UBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nNET_\u001b[01;31m\u001b[KRA\u001b[m\u001b[KW\r\n"]
[19.896303, "o", "started, version %s \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K disabled\r\nstarted, version %s \u001b[01;31m\u001b[Kcache\u001b[m\u001b[Ksize %d\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K size greater than 10000 may cause performance issues, and is unlikely to be useful.\r\nstarted, version %s \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K disabled\r\n"]
[19.896425, "o", "\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local subnets\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to localhost\r\ncompile time \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\nchown of PID file %s failed: p\u001b[01;31m\u001b[Klease\u001b[m\u001b[K add capability CAP_CHOWN\r\nwarning: \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s does not currently exist\r\nwarning: no upstream servers \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K, sockets bound exclusively to \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\n\u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K %s%s %s %s\r\n"]
[19.89653, "o", "single \u001b[01;31m\u001b[Kport\u001b[m\u001b[K mode\r\nwarning: \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K directory %s inaccessible\r\nrestricting maximum simultaneous \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K t\u001b[01;31m\u001b[Kra\u001b[m\u001b[Knsfers to %d\r\nerror binding \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket to device %s\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K no-Lua \u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K no-connt\u001b[01;31m\u001b[Kra\u001b[m\u001b[Kck ipset no-nftset \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K no-\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC loop-detect inotify dumpfile\r\n\u001b[01;31m\u001b[KTFTP\u001b[m\u001b[K directory %s inaccessible: %s\r\n>@unknown \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s in bridge-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\n"]
[19.896619, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet received on %s which has no address\r\nARP-\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K injection failed: %s\r\nError sending \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet to %s: %s\r\ncannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to set \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to bind \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server socket: %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge %s -- %s is not consistent with netmask %s\r\n"]
[19.896694, "o", "Cannot broadcast \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay at %s -> %s\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change script name is too long\r\ncannot open or create \u001b[01;31m\u001b[Klease\u001b[m\u001b[K file %s: %s\r\nfailed to parse \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database cleanly\r\nfailed to read \u001b[01;31m\u001b[Klease\u001b[m\u001b[K file %s: %s\r\ncannot run \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-init script %s: %s\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-init script returned exit code %s\r\nIgnoring domain %s for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host name %s\r\n"]
[19.8968, "o", "ignoring invalid line in \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database: %s %s %s %s ...\r\nignoring invalid line in \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database, bad address: %s\r\ntoo many stored \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks\r\nno address \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge available for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K request %s %s\r\n%u available \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K subnet: %s/%s\r\n%u available \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge: %s -- %s\r\n"]
[19.896875, "o", "\u001b[01;31m\u001b[Kbootp\u001b[m\u001b[K\r\nno address \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured\r\nno \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks left\r\n\u001b[01;31m\u001b[KBOOTP\u001b[m\u001b[K\r\n"]
[19.896993, "o", "PXE BIS not sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked\r\n\u001b[01;31m\u001b[KDHCPD\u001b[m\u001b[KECLINE\r\ndisabling \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static address %s for %s\r\nunknown \u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KRE\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[K\r\nnot using \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured address %s because it is \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kd to %s\r\nnot using \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured address %s because it is in use by the server or relay\r\nnot using \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured address %s because it was previously declined\r\n"]
[19.897071, "o", "\u001b[01;31m\u001b[KDHCPD\u001b[m\u001b[KISCOVER\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KOFFER\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K not found\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KREQUEST\r\nstatic \u001b[01;31m\u001b[Klease\u001b[m\u001b[K available\r\nabandoning \u001b[01;31m\u001b[Klease\u001b[m\u001b[K to %s of %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KNAK\r\n"]
[19.897163, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KACK\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KINFORM\r\n%u sent size:%3d \u001b[01;31m\u001b[Koption\u001b[m\u001b[K:%3d %s  %s\r\ncannot send \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/\u001b[01;31m\u001b[KBOOTP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K %d: no space left in packet\r\n%u requested \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\ncannot send RFC3925 \u001b[01;31m\u001b[Koption\u001b[m\u001b[K: too many \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks for enterprise number %d\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_IAID\r\n"]
[19.897249, "o", "\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_SERVER_DUID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_MAC\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CLIENT_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_\u001b[01;31m\u001b[KINTERFACE\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[K_EXPIRES\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_DOMAIN\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_DATA_MISSING\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_VENDOR_CLASS\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_VENDOR_CLASS_ID\r\n"]
[19.897348, "o", "\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_VENDOR_CLASS%i\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_SUPPLIED_HOSTNAME\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CPEWAN_OUI\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CPEWAN_SERIAL\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CPEWAN_CLASS\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CIRCUIT_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_SUBSCRIBER_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_REMOTE_ID\r\n"]
