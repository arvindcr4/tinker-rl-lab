[19.898361, "o", "\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K%s[%d]: \r\ncannot create \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K socket: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K socket: %s\r\nfailed to bind \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K server socket: %s\r\nCannot create \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K server DUID: %s\r\nCannot multicast \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\nno address \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge available for \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K request from relay at %s\r\nno address \u001b[01;31m\u001b[Kra\u001b[m\u001b[Knge available for \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K request via %s\r\n\u001b[01;31m\u001b[Kdhcpv6\u001b[m\u001b[K\r\n%u available \u001b[01;31m\u001b[KDHCPv6\u001b[m\u001b[K subnet: %s/%d\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KSOLICIT\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KREPLY\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KADVERTISE\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KRENEW\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KREBIND\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KCONFIRM\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KINFORMATION-REQUEST\r\nre\u001b[01;31m\u001b[Klease\u001b[m\u001b[K received\r\n%u %s size:%3d \u001b[01;31m\u001b[Koption\u001b[m\u001b[K:%3d %s  %s\r\nIgnoring duplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K %d\r\n"]
