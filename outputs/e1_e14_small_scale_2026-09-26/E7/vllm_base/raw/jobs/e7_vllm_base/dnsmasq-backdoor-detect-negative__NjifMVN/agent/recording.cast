[18.468771, "o", "\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: %s inaccessible\r\ncannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nagent-\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[K %s \r\nagent-\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[K\r\ntoo many stored \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[KUNKNOWN\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[KACTIVE\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[KUNASSIGNED\r\nunknown \u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K not found\r\nno \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks left\r\nno address \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured\r\nstatic \u001b[01;31m\u001b[Klease\u001b[m\u001b[K available\r\nPXE BIS not sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[KQUERY\r\n"]
[18.468962, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KDECLINE\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KRE\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KDISCOVER\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KOFFER\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KREQUEST\r\nabandoning \u001b[01;31m\u001b[Klease\u001b[m\u001b[K to %s of %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KNAK\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KACK\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KINFO\u001b[m\u001b[KRM\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay at %s -> %s\r\nnetlink returns \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_IAID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_SERVER_DUID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_MAC\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CLIENT_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_\u001b[01;31m\u001b[KINTERFACE\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_\u001b[01;31m\u001b[KLEASE\u001b[m\u001b[K_EXPIRES\r\n"]
[18.469085, "o", "\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_\u001b[01;31m\u001b[KDOMAIN\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_DATA_MISSING\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_VENDOR_CLASS\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_SUPPLIED_\u001b[01;31m\u001b[KHOST\u001b[m\u001b[KNAME\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CPEWAN_OUI\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CPEWAN_SERIAL\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CPEWAN_CLASS\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_CIRCUIT_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_SUBSCRIBER_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_REMOTE_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_REQUESTED_OPTIONS\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_MUD_URL\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_TAGS\r\n"]
[18.46922, "o", "\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_VENDOR_CLASS_ID\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_VENDOR_CLASS%i\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_RELAY_ADDRESS\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_USER_CLASS%i\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_TIME_REMAINING\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_OLD_\u001b[01;31m\u001b[KHOST\u001b[m\u001b[KNAME\r\n\u001b[01;31m\u001b[KDNSMASQ\u001b[m\u001b[K_\u001b[01;31m\u001b[KLOG\u001b[m\u001b[K_\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K %d %s received from %s\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked request from %s\r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K%s: \r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K%s[%d]: \r\noverflow: %d \u001b[01;31m\u001b[Klog\u001b[m\u001b[K entries lost\r\n/dev/\u001b[01;31m\u001b[Klog\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Klog\u001b[m\u001b[K failed: %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KREPLY\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KADVERTISE\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KRENEW\r\n"]
[18.46941, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KREBIND\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv6\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KCONFIRM\r\nre\u001b[01;31m\u001b[Klease\u001b[m\u001b[K received\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[KSOLICIT\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\u001b[01;31m\u001b[KINFO\u001b[m\u001b[KRMATION-REQUEST\r\nKnown \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options:\r\nKnown \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 options:\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay from %s via %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay from %s to %s\r\nsip-server-\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-server\r\n"]
[18.469561, "o", "\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-search\r\nnis-\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K\r\nnis+-\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krmation-refresh-time\r\ncaptive-\u001b[01;31m\u001b[Kport\u001b[m\u001b[Kal\r\n\u001b[01;31m\u001b[Klog\u001b[m\u001b[K-server\r\n\u001b[01;31m\u001b[Khost\u001b[m\u001b[Kname\r\n\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-name\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-time\r\nclient-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K-id\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_cache_inserted\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_cache_live_freed\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_queries_forwarded\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_auth_answered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_local_answered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_stale_answered\r\n"]
[18.469723, "o", "\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K_unanswered\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec_max_crypto_use\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec_max_sig_fail\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec_max_work\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_ack\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_decline\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_discover\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krm\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_nak\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_offer\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_re\u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_request\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks_allocated_4\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks_pruned_4\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks_allocated_6\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks_pruned_6\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kquery\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_\u001b[01;31m\u001b[Klease\u001b[m\u001b[K_unassigned\r\n"]
[18.469913, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_\u001b[01;31m\u001b[Klease\u001b[m\u001b[K_actve\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K_\u001b[01;31m\u001b[Klease\u001b[m\u001b[K_unknown\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked NSEC3 iterations value\r\n%s is a CNAME, not giving it to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s\r\nnot giving name %s to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s because the name exists in %s with address %s\r\nserver %s#%d: queries sent %u, retried %u, failed %u, nx\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K replies %u, avg. latency %ums\r\n\u001b[01;31m\u001b[KHost\u001b[m\u001b[K                           Address                                  Flags      Expires                  Source\r\n\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K can only be specified once\r\nduplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K IP address %s\r\n%s returns non-zero \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K code\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K is free software, and you are welcome to redistribute it\r\nmust have exactly one resolv.conf to read \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K from.\r\nsrv-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K name %s too long after \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K appended\r\nthere must be a default \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K when --\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn is set\r\nReturn ipaddr for all \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks in specified \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks.\r\n"]
[18.470086, "o", "Treat ipaddr as NX\u001b[01;31m\u001b[KDOMAIN\u001b[m\u001b[K (defeats Verisign wildcard).\r\nSpecify \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration file (defaults to %s).\r\nDo NOT fork into the background: run in \u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K mode.\r\nDo NOT forward queries with no \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K part.\r\nReturn self-pointing MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nExpand simple names in /etc/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-suffix.\r\nDon't forward spurious \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests from Windows \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nDon't include IPv4 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include IPv6 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include resource records of the given type in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nEnable \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K in the range given with \u001b[01;31m\u001b[Klease\u001b[m\u001b[K duration.\r\nSet address or \u001b[01;31m\u001b[Khost\u001b[m\u001b[Kname for a specified machine.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from file.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option specs from file.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from a directory.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options from a directory.\r\n"]
[18.470282, "o", "Specify a \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks file to be read in addition to %s.\r\nRead \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks files from a directory.\r\nSpecify \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K(s) to listen on.\r\nSpecify \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K(s) NOT to listen on.\r\nDon't do \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nForce broadcast replies for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nDo NOT fork into the background, do NOT run in \u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K mode.\r\nAssume we are the only \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server on the local network.\r\nSpecify where to store \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\nReturn MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nSpecify BOOTP options to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\n"]
[18.470465, "o", "Specify options to be sent to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option sent even if the client does not request it.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option sent only to PXE clients.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to listen for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for E\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.0 (defaults to %s).\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for upstream \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nSet maximum number of random originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a query.\r\nSpecify address(es) of upstream servers with optional \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks.\r\nNever forward queries to specified \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks.\r\nSpecify the \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K to be assigned in \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks.\r\n"]
[18.470571, "o", "Specify time-to-live in seconds for replies from /etc/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nRetry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries after this many milliseconds.\r\nDisplay \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K version and copyright \u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krmation.\r\nDisplay this message. Use --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K or --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6 for known \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options.\r\nSpecify path of \u001b[01;31m\u001b[KPID\u001b[m\u001b[K file (defaults to %s).\r\nSpecify maximum number of \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\nAnswer \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries based on the \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K a query was sent to.\r\nGive \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name to IPv4 address of \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\n"]
[18.4707, "o", "Bind only to \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks in use.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static \u001b[01;31m\u001b[Khost\u001b[m\u001b[K \u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krmation from %s.\r\nEnable the DBus \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K for setting upstream servers, etc.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K on this \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K, only provide \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 on this \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\n"]
[18.470793, "o", "Do not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 on this \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\nTreat \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests on aliases as arriving from \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K.\r\nSpecify extra networks sharing a broadcast \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\nEnable RFC 4388 \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kquery functions for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4\r\nDisable ICMP echo address checking in the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\nShell script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nLua script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\n"]
[18.470884, "o", "Run \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change scripts as this user.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script with changes to local ARP table.\r\nRead \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration from all the files in this directory.\r\nExecute file and read \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration from stdin.\r\n\u001b[01;31m\u001b[KLog\u001b[m\u001b[K to this sys\u001b[01;31m\u001b[Klog\u001b[m\u001b[K facility or file. (defaults to DAEMON)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries. (defaults to %s)\r\nClear \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K cache when reloading %s.\r\nIgnore \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames provided by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n"]
[18.470998, "o", "Do NOT reuse filename and server fields for extra \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by TFTP only from the specified subtree.\r\nAllow access only to files owned by the user running \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\r\nEphemeral \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range for use by TFTP transfers.\r\nUse only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP server.\r\nEnable async. \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kging; optionally set queue length.\r\nStop \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K rebinding. Filter private IP ranges when resolving.\r\nInhibit \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-rebind protection on this \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K.\r\n"]
[18.471162, "o", "Always perform \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to all servers.\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K query transmission.\r\nSpecify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K query transmission.\r\nUse only fully qualified \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K names for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nGenerate \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames based on MAC address for nameless clients.\r\nUse these \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relays as full proxies.\r\nRelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests to a remote server\r\n"]
[18.471269, "o", "Specify alias name for LOCAL \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name.\r\nAdd requestor's MAC address to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nStrip MAC \u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krmation from queries.\r\nAdd specified IP subnet to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nStrip ECS \u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krmation from queries.\r\nAdd client identification to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nProxy \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation results from upstream nameservers.\r\n"]
[18.471445, "o", "Attempt to allocate sequential IP addresses to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nIgnore client identifier option sent by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nAllow \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients to do their own D\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K updates.\r\nSend router-advertisements for \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks doing \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6\r\nSpecify DUID_EN-type \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 server DUID\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K (A/AAAA and PTR) records\r\n<name>,[<IPv4>][,<IPv6>],<\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K-name>\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K record in \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K subnet\r\n"]
[18.471581, "o", "Specify arbitrary \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record\r\nBind to \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks in use - check for new \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDomain\u001b[m\u001b[K to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nSet authoritative zone \u001b[01;31m\u001b[Kinfo\u001b[m\u001b[Krmation\r\nSecondary authoritative nameservers for forward \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks\r\n/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>[/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>...]/<ipset>...\r\nSpecify ipsets to which matching \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks should be added\r\n/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>[/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>...]/<nftset>...\r\nSpecify nftables sets to which matching \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks should be added\r\nEnable filtering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries with connection-track marks.\r\nSet allowed \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K patterns for a connection-track mark.\r\nSpecify a \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K and address range for synthesised names\r\nDisable upstream checking for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC \u001b[01;31m\u001b[Kdebug\u001b[m\u001b[Kging.\r\nEnsure answers without \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC are in unsigned zones.\r\n"]
[18.471725, "o", "Don't check \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature timestamps until first cache-reload\r\nTimestamp file to verify system clock for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC\r\nSet resource limits for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\n<iface>,[mtu:<value>|<\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K>|off,][<prio>,]<intval>[,<lifetime>]\r\nDetect and remove \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K forwarding loops.\r\nIgnore \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses containing ipaddr.\r\nSet TTL in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K-derived addresses.\r\nDelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K replies for at least number of seconds.\r\nEnables \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 Ra\u001b[01;31m\u001b[Kpid\u001b[m\u001b[K Commit option.\r\nPath to \u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K packet dump file.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script when \u001b[01;31m\u001b[Klease\u001b[m\u001b[K expiry changes.\r\nSuppress round-robin ordering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K records.\r\n"]
[18.471898, "o", "Suppress \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nCache this \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record type.\r\nCase mismatch in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply - check bit 0x20 encoding.\r\ndiscarding \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply: subnet option mismatch\r\npossible \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-rebind attack detected: %s\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries reached (max: %d)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to %s reached (max: %d)\r\nignoring query from non-local network %s (\u001b[01;31m\u001b[Klog\u001b[m\u001b[Kged only once)\r\nstopped listening on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nLOUD \u001b[01;31m\u001b[KWARN\u001b[m\u001b[KING: listening on %s may accept requests via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks other than %s\r\nLOUD \u001b[01;31m\u001b[KWARN\u001b[m\u001b[KING: use --bind-dynamic rather than --bind-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks to avoid \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K amplification attacks via these \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K(s)\r\n\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: using \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s instead\r\n\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: no addresses found for \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\n\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s failed to join \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 multicast group: %s\r\n"]
[18.472077, "o", "more servers are defined but not \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kged\r\nignoring nameserver %s - local \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 no-Lua TFTP no-conntrack ipset no-nftset auth no-\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC loop-detect inotify dumpfile\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC not available: set HAVE_\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nconntrack sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNTRACK in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nUbus not available: set HAVE_UBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nmax_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\ncannot set --bind-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks and --bind-dynamic\r\nfailed to find list of \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[Ks: %s\r\nfailed to set SO_BINDTODEVICE on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nDBus not available: set HAVE_DBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nUBus not available: set HAVE_UBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nstarted, version %s \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K disabled\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local subnets\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nchown of \u001b[01;31m\u001b[KPID\u001b[m\u001b[K file %s failed: p\u001b[01;31m\u001b[Klease\u001b[m\u001b[K add capability CAP_CHOWN\r\nchown of \u001b[01;31m\u001b[KPID\u001b[m\u001b[K file %s failed: %s\r\n"]
[18.472191, "o", "\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: failed to change owner of %s: %s\r\n\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s does not currently exist\r\n\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: ignoring resolv-file flag because no-resolv is set\r\n\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: no upstream servers \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured\r\nasynchronous \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kging enabled, queue limit is %d messages\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K, sockets bound exclusively to \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\n\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King: TFTP directory %s inaccessible\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K binding \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket to device %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K range %s -- %s is not consistent with netmask %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay address %s appears on more than one \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\n"]
[18.472365, "o", "failed to set options on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to bind \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server socket: %s\r\nunknown \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s in bridge-\u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet received on %s which has no address\r\n\u001b[01;31m\u001b[KError\u001b[m\u001b[K sending \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet to %s: %s\r\nIgnoring \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K %s for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K name %s\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change script name is too long\r\ncannot open or create \u001b[01;31m\u001b[Klease\u001b[m\u001b[K file %s: %s\r\nignoring invalid line in \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database: %s %s %s %s ...\r\nignoring invalid line in \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database, bad address: %s\r\nfailed to parse \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database cleanly\r\nfailed to read \u001b[01;31m\u001b[Klease\u001b[m\u001b[K file %s: %s\r\n"]
[18.472511, "o", "cannot run \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-init script %s: %s\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-init script returned exit code %s\r\ncannot send \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/BOOTP option %d: no space left in packet\r\nno address range available for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K request %s %s\r\n%u available \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K subnet: %s/%s\r\n%u available \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K range: %s -- %s\r\ndisabling \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static address %s for %s\r\nnot using \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured address %s because it is \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kd to %s\r\nnot using \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured address %s because it was previously declined\r\nnot using \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured address %s because it is in use by the server or relay\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kquery from %s not permitted\r\nCannot send to server via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s: %s\r\nCannot broadcast \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s: %s\r\nunable to get free \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked write request from %s\r\ncannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 socket: %s\r\n"]
[18.472677, "o", "failed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 socket: %s\r\nfailed to bind \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 server socket: %s\r\nCannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 server DUID: %s\r\n%u available \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 subnet: %s/%d\r\nno address range available for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 request from relay at %s\r\nno address range available for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 request via %s\r\nCannot multicast \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay via \u001b[01;31m\u001b[Kinterface\u001b[m\u001b[K %s\r\nIgnoring duplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option %d\r\nduplicate IP address %s (%s) in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K directive\r\n%s has more than one address in \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ksfile, using %s for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\n"]
[18.472799, "o", "%s, static \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks only on %.0s%s%s%.0s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4-derived IPv6 names on %s%s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K split-relay from %s to %s via %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay from %s to %s via %s\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPfor IPv6 option\r\ninappropriate veinappropriate enbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option\r\nbad IPv6 addressbad IPv4 addressbad \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K in dh in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option too No vendor-encap options allowed in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option-pillegal \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-matillegal repeatedepeated keyword\r\nbad \u001b[01;31m\u001b[Klog\u001b[m\u001b[K facilitybad MX preferencrecompile with HAVE_LUASCRIPT defined to enable ble Lua scripts\r\n"]
[18.472966, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K has mu multiple names\r\nbad \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K nainvalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K numbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy amissing address ddress in alias\r\ninvalid alias rain dynamic \u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nbad NAPTR recordinvalid priorityBad \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-record\r\nBad name in \u001b[01;31m\u001b[Khost\u001b[m\u001b[Kunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked option (check that \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K was compiled with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/TFTP/\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC/DBus s\r\n"]
