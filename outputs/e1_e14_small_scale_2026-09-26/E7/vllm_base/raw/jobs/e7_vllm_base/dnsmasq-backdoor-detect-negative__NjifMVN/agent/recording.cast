[17.432903, "o", "cannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\n\u001b[01;31m\u001b[K/etc\u001b[m\u001b[K/resolv.conf\r\n\u001b[01;31m\u001b[K/var\u001b[m\u001b[K/run/dnsmasq.pid\r\njunk found in \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K line\r\nbad \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K line options: %s\r\n\u001b[01;31m\u001b[K/etc\u001b[m\u001b[K/dnsmasq.conf\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nservers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[K/var\u001b[m\u001b[K/lib/misc/dnsmasq.leases\r\n\u001b[01;31m\u001b[K/etc\u001b[m\u001b[K/ethers\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\n"]
[17.433037, "o", "stop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s port %d\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\n\u001b[01;31m\u001b[K/dev\u001b[m\u001b[K/null\r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\ncannot create DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[17.433181, "o", "\u001b[01;31m\u001b[K/dev\u001b[m\u001b[K/log\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\ntcp_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n"]
[17.433292, "o", "Specify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\nExpand simple names in \u001b[01;31m\u001b[K/etc\u001b[m\u001b[K/hosts with domain-suffix.\r\n\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\n"]
[17.433382, "o", "Specify port to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for DNS requests on (defaults to 53).\r\nSpecify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\nSpecify time-to-live in seconds for replies from \u001b[01;31m\u001b[K/etc\u001b[m\u001b[K/hosts.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n"]
[17.433511, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nStop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\n"]
[17.433611, "o", "Inhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEnable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\n"]
[17.433986, "o", "Timestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\n\u001b[01;31m\u001b[KAccept\u001b[m\u001b[K queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\npossible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s port %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may \u001b[01;31m\u001b[Kaccept\u001b[m\u001b[K requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\ntry increasing \u001b[01;31m\u001b[K/proc\u001b[m\u001b[K/sys/net/core/optmem_max\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make\u001b[01;31m\u001b[K/bin\u001b[m\u001b[Kd \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[K/proc\u001b[m\u001b[K/sys/net/ipv6/conf/%s/mtu\r\ncannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset control \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ndhcp-option too No vendor-encap options allowed in dhcp-option-pillegal dhcp-matillegal repeatedepeated \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword\r\n"]
