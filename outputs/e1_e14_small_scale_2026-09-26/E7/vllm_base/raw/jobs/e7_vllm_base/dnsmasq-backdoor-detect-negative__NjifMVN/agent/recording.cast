[275.43447, "i", "cat > /tmp/scripts/analyze.py << 'PYEOF'\nfrom ghidra.program.model.listing import Function\nfrom ghidra.app.decompiler import DecompInterface\nfrom ghidra.util.task import TaskMonitor\n\n# Get all functions\nlisting = currentProgram.getListing()\nfunctions = listing.getFunctions(True)\n\nprint(\"=== Function Analysis ===\")\nfor func in functions:\n    name = func.getName()\n    addr = func.getEntryPoint()\n    print(f\"Function: {name} at {addr}\")\n\n# Try to decompile and look for suspicious patterns\ndecompiler = DecompInterface()\ndecompiler.openProgram(currentProgram)\nmonitor = TaskMonitor.DUMMY\n\nfor func in functions:\n    try:\n        result = decompiler.decompileFunction(func, 30, monitor)\n        if result.decompileCompleted():\n            ccode = result.getDecompiledFunction().getC() \n            # Check for suspicious patterns\n            suspicious = ['execve', 'system(', 'popen(', 'execl', 'execle', 'execv',\n                         '/bin/sh', '/bin/bash', '/bin/dash', 'reverse', 'shell',\n                         'backdoor', 'payload', 'exploit', 'inject', 'hook',\n                         'meterpreter', 'cobalt', 'empire', 'psexec',\n                         'cmd.exe', 'command.com', 'cmd -c', 'cmd -e',\n                         'nc -', 'ncat', 'socat', 'python -c', 'perl -e',\n                         'ruby -e', 'php -r', 'wget ', 'curl ',\n                         'chmod 777', 'chmod 4755', 'chmod 4777',\n                         'setuid', 'setgid', 'capset', 'capget',\n                         'ptrace', 'process_inject', 'mem_alloc',\n                         'mmap.*PROT_EXEC', 'open.*connect',\n                         'connect.*remote', 'remote.*shell',\n                         'hidden.*port', 'hidden.*service',\n                         'secret.*key', 'master.*key',\n                         'admin.*backdoor', 'debug.*shell',\n                         'console.*shell', 'command.*shell',\n                         'interactive.*shell', 'bind.*shell',\n                         'reverse.*shell', 'exfil', 'data.?exfil',\n                         'upload', 'download', 'keylog', 'keylogger',\n                         'c2', 'callback', 'beacon', 'rootkit',\n                         'trojan', 'malware', 'exploit', 'payload',\n                         'inject', 'hook', 'rootkit']\n            for pattern in suspicious:\n                if pattern.lower() in ccode.lower():\n                    print(f\"\\n*** SUSPICIOUS: {pattern} found in function {name} at {addr} ***\")\n                    print(ccode[:500])\n    except Exception as e:\n        pass\n\ndecompiler.close()\nPYEOF\n"]
