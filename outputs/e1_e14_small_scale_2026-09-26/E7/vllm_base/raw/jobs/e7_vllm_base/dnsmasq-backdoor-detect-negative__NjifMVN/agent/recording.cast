[464.643969, "o", "\u001b[01;31m\u001b[Klog\u001b[m\u001b[K-debug\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nsys\u001b[01;31m\u001b[Klog\u001b[m\u001b[K\r\ncannot open \u001b[01;31m\u001b[Klog\u001b[m\u001b[K %s: %s\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\n\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K is \r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\n"]
[464.644175, "o", "cannot create DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nDNSMASQ_\u001b[01;31m\u001b[KLOG\u001b[m\u001b[K_DHCP\r\noverflow: %d \u001b[01;31m\u001b[Klog\u001b[m\u001b[K entries lost\r\n/dev/\u001b[01;31m\u001b[Klog\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Klog\u001b[m\u001b[K failed: %s\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\n"]
[464.644494, "o", "no \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\n\u001b[01;31m\u001b[Klog\u001b[m\u001b[K-server\r\n\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K-path\r\ntcp_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\n"]
[464.644774, "o", "Return self-pointing MX \u001b[01;31m\u001b[Krecord\u001b[m\u001b[Ks for local hosts.\r\nDon't include resource \u001b[01;31m\u001b[Krecord\u001b[m\u001b[Ks of the given type in DNS answers.\r\n\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\nReturn MX \u001b[01;31m\u001b[Krecord\u001b[m\u001b[Ks for local hosts.\r\nSpecify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\nSpecify default target in an MX \u001b[01;31m\u001b[Krecord\u001b[m\u001b[K.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n"]
[464.644881, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\n\u001b[01;31m\u001b[KLog\u001b[m\u001b[K to this sys\u001b[01;31m\u001b[Klog\u001b[m\u001b[K facility or file. (defaults to DAEMON)\r\nAdd client IP or hardware address to tftp-\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K.\r\nEnable async. \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kging; optionally set queue length.\r\nStop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\n"]
[464.645192, "o", "Inhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nSpecify host (A/AAAA and PTR) \u001b[01;31m\u001b[Krecord\u001b[m\u001b[Ks\r\nSpecify host \u001b[01;31m\u001b[Krecord\u001b[m\u001b[K in interface subnet\r\nSpecify certification authority authorization \u001b[01;31m\u001b[Krecord\u001b[m\u001b[K\r\n"]
[464.645436, "o", "Specify arbitrary DNS resource \u001b[01;31m\u001b[Krecord\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEnable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nAccept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nSuppress round-robin ordering of DNS \u001b[01;31m\u001b[Krecord\u001b[m\u001b[Ks.\r\nCache this DNS resource \u001b[01;31m\u001b[Krecord\u001b[m\u001b[K type.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\n"]
[464.645655, "o", "possible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nignoring query from non-local network %s (\u001b[01;31m\u001b[Klog\u001b[m\u001b[Kged only once)\r\nfailed to create listening \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[464.645937, "o", "more servers are defined but not \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kged\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K \u001b[01;31m\u001b[Kroot\u001b[m\u001b[K: %s\r\nasynchronous \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kging enabled, queue limit is %d messages\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[464.646207, "o", "cannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset control \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nbad \u001b[01;31m\u001b[Klog\u001b[m\u001b[K facilitybad MX preferencrecompile with HAVE_LUASCRIPT defined to enable ble Lua scripts\r\nbad NAPTR \u001b[01;31m\u001b[Krecord\u001b[m\u001b[Kinvalid priorityBad host-\u001b[01;31m\u001b[Krecord\u001b[m\u001b[K\r\n"]
