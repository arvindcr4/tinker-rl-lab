[21.362079, "o", "bad \u001b[01;31m\u001b[Kcommand\u001b[m\u001b[K line options: %s\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nservers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\n"]
[21.362253, "o", "\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\ndhcp-\u001b[01;31m\u001b[Kremote\u001b[m\u001b[Kid\r\nstop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\n"]
[21.362401, "o", "re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nset:<tag>,<\u001b[01;31m\u001b[Kremote\u001b[m\u001b[K>\r\nMap RFC3046 \u001b[01;31m\u001b[Kremote\u001b[m\u001b[K-id to tag.\r\nSpecify port to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for DNS requests on (defaults to 53).\r\n"]
[21.362623, "o", "Specify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nStop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nRelay DHCP requests to a \u001b[01;31m\u001b[Kremote\u001b[m\u001b[K server\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\n"]
[21.362836, "o", "Enable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nAccept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nSend Cisco Umbrella identifiers including \u001b[01;31m\u001b[Kremote\u001b[m\u001b[K IP.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\npossible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s port %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\n"]
[21.363034, "o", "failed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make\u001b[01;31m\u001b[K/bin\u001b[m\u001b[Kd \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s port %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nARP-cache \u001b[01;31m\u001b[Kinject\u001b[m\u001b[Kion failed: %s\r\n"]
[21.363181, "o", "cannot create DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[K/bin\u001b[m\u001b[K\u001b[01;31m\u001b[K/sh\u001b[m\u001b[K\r\ncannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nDNSMASQ_\u001b[01;31m\u001b[KREMOTE\u001b[m\u001b[K_ID\r\n"]
[21.363294, "o", "cannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|PORT} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\nN@cannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset \u001b[01;31m\u001b[Kcontrol\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
