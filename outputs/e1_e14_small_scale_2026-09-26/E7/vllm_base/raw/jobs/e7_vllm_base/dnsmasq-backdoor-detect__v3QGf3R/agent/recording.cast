[25.321688, "o", "D$ O\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\n/\u001b[01;31m\u001b[Ketc\u001b[m\u001b[K/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\n%s is a CNAME, not giving it to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s\r\nnot giving name %s to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s because the name exists in %s with address %s\r\n"]
[25.321864, "o", "queries \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked %u, queries answered locally %u\r\n"]
[25.322048, "o", "\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d: queries sent %u, retried %u, failed %u, nx\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K replies %u, avg. latency %ums\r\n\u001b[01;31m\u001b[KHost\u001b[m\u001b[K                           Address                                  Flags      Expires                  Source\r\nnon-\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K opcode\r\n\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K\r\nC\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY algorithm\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked DS digest\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC indeterminate\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC bogus\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature expired\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC sig not yet valid\r\n"]
[25.322231, "o", "\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY missing\r\nstale NX\u001b[01;31m\u001b[KDOMAIN\u001b[m\u001b[K\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked NSEC3 iterations value\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nCannot \u001b[01;31m\u001b[Kresolve\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K name\r\ncannot use IPv4 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K address with IPv6 source address\r\ncannot use IPv6 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K address with IPv4 source address\r\n/\u001b[01;31m\u001b[Ketc\u001b[m\u001b[K/\u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K.conf\r\n/var/run/\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq.pid\r\n\u001b[01;31m\u001b[KDns\u001b[m\u001b[Kmasq version %s  %s\r\n/\u001b[01;31m\u001b[Ketc\u001b[m\u001b[K/\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq.conf\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq-2.92test7-1-gd100821\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nevictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n"]
[25.322534, "o", "auth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Khost\u001b[m\u001b[Kmaster.\r\ncannot get \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-name: %s\r\nonly one \u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K.conf file allowed in no-poll mode.\r\nmust have exactly one \u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K.conf to read \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K from.\r\nthere must be a default \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K when --\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn is set\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq: %s.\r\nno-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K-file\r\n\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks-file\r\nmx-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-boot\r\n\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-suffix\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\nbogus-nx\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K\r\nrev-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nno-\u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K\r\nexpand-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\naddn-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n"]
[25.322738, "o", "no-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-interface\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv4-interface\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv6-interface\r\n\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-needed\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-vendorclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-userclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore\r\ne\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-packet-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-authoritative\r\nsrv-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-rr\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-mac\r\n"]
[25.322832, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile-ro\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-\u001b[01;31m\u001b[Kforward\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-names\r\ntftp-single-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option-force\r\nlog-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-circuitid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-remoteid\r\n"]
[25.322954, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-subscrid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-pxe-vendor\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ksfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ksdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsdir\r\n"]
[25.323149, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-no-override\r\ntftp-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-range\r\nstop-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-ok\r\nall-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-name-match\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-broadcast\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-alternate-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-scriptuser\r\nmin-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmax-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-generate-names\r\n"]
[25.323297, "o", "re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-local\u001b[01;31m\u001b[Khost\u001b[m\u001b[K-ok\r\nproxy-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-sequential-ip\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-client-update\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-luascript\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-duid\r\nauth-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nauth-sec-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks\r\nsynth-\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-debug\r\n"]
[25.323397, "o", "\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-check-unsigned\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-no-timecheck\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-timestamp\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-limits\r\n"]
[25.323502, "o", "quiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\nquiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-loop-detect\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-reply-delay\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-rapid-commit\r\n"]
[25.323573, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-clid\r\ndynamic-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-limit\r\nfast-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-retry\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\n"]
[25.323717, "o", "/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>/<ipaddr>\r\nReturn ipaddr for all \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks in specified \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks.\r\nFake reverse \u001b[01;31m\u001b[Klookup\u001b[m\u001b[Ks for RFC1918 private address ranges.\r\nTreat ipaddr as NX\u001b[01;31m\u001b[KDOMAIN\u001b[m\u001b[K (defeats Verisign wildcard).\r\n"]
[25.323808, "o", "Do NOT \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K queries with no \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K part.\r\nReturn self-pointing MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nExpand simple names in /\u001b[01;31m\u001b[Ketc\u001b[m\u001b[K/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K-suffix.\r\nDon't \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K spurious \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests from Windows \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\nDon't include IPv4 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include IPv6 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include resource records of the given type in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\n"]
[25.323945, "o", "Enable \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K in the range given with \u001b[01;31m\u001b[Klease\u001b[m\u001b[K duration.\r\n<\u001b[01;31m\u001b[Khost\u001b[m\u001b[Kspec>\r\nSet address or \u001b[01;31m\u001b[Khost\u001b[m\u001b[Kname for a specified machine.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from file.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option specs from file.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K specs from a directory.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options from a directory.\r\n"]
[25.324118, "o", "Specify a \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks file to be read in addition to %s.\r\nRead \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks files from a directory.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K user class to tag.\r\nDon't do \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nForce broadcast replies for \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks with tag set.\r\nAssume we are the only \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K on the local network.\r\n"]
[25.324246, "o", "Specify where to store \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\n/var/lib/misc/\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq.\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks\r\nReturn MX records for local \u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\n<\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_name>,<target>,<pref>\r\nSpecify BOOTP options to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\nUse name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks strictly in the order given in %s.\r\nSpecify options to be sent to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n"]
[25.324387, "o", "\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option sent even if the client does not request it.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K option sent only to PXE clients.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for E\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.0 (defaults to %s).\r\nLog \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\n#\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks\r\nSet maximum number of random originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K.\r\n"]
[25.324464, "o", "Do NOT read \u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K.conf.\r\nSpecify path to \u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K.conf (defaults to %s).\r\nSpecify path to file with \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K= options\r\n"]
[25.324613, "o", "Specify address(es) of \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks with optional \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks.\r\nSpecify address of \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks for reverse address queries\r\n/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>/\r\nNever \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K queries to specified \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks.\r\n<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>[,<range>]\r\nSpecify the \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K to be assigned in \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks.\r\n<\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_name>\r\nSpecify time-to-live in seconds for replies from /\u001b[01;31m\u001b[Ketc\u001b[m\u001b[K/\u001b[01;31m\u001b[Khost\u001b[m\u001b[Ks.\r\n"]
[25.324805, "o", "Retry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries after this many milliseconds.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K vendor class to tag.\r\nDisplay \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq version and copyright information.\r\nTranslate IPv4 addresses from \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\nDisplay this message. Use --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K or --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6 for known \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options.\r\nSpecify maximum number of \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\nAnswer \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries based on the interface a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K was sent to.\r\nSpecify TXT \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\n"]
[25.324951, "o", "Specify PTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nGive \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name to IPv4 address of interface.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\nRead \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static \u001b[01;31m\u001b[Khost\u001b[m\u001b[K information from %s.\r\n/\u001b[01;31m\u001b[Ketc\u001b[m\u001b[K/ethers\r\nEnable the DBus interface for setting \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks, \u001b[01;31m\u001b[Ketc\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K on this interface, only provide \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 on this interface.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 on this interface.\r\nTreat \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests on aliases as arriving from interface.\r\n"]
[25.325112, "o", "Specify extra networks sharing a broadcast \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\nDisable ICMP echo address checking in the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\nShell script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nLua script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nRun \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change scripts as this user.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script with changes to local ARP table.\r\nDo not use \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile.\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries. (defaults to %s)\r\nClear \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K cache when reloading %s.\r\nIgnore \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames provided by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nDo NOT reuse filename and \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K fields for extra \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K options.\r\n"]
[25.325187, "o", "Enable integrated read-only TFTP \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by TFTP only from the specified subtree.\r\nAllow access only to files owned by the user running \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq.\r\nEphemeral \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range for use by TFTP transfers.\r\nUse only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K.\r\nExtra logging for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\n"]
[25.325345, "o", "Stop \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when \u001b[01;31m\u001b[Kresolv\u001b[m\u001b[King.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\nInhibit \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K.\r\nAlways perform \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to all \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\n"]
[25.325479, "o", "[=<\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks>]\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nSpecify NAPTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\n<\u001b[01;31m\u001b[Kport\u001b[m\u001b[K>\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nSpecify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nUse only fully qualified \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K names for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n"]
[25.325576, "o", "Generate \u001b[01;31m\u001b[Khost\u001b[m\u001b[Knames based on MAC address for nameless clients.\r\nUse these \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relays as full proxies.\r\n<local-addr>,<\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K>[,<iface>]\r\nRelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K requests to a remote \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nSpecify alias name for LOCAL \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name.\r\n"]
[25.325694, "o", "Add requestor's MAC address to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd specified IP subnet to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd client identification to \u001b[01;31m\u001b[Kforward\u001b[m\u001b[Ked \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nProxy \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation results from \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks.\r\nAttempt to allocate sequential IP addresses to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n"]
[25.325782, "o", "Ignore client identifier option sent by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nCopy connection-track mark from queries to \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K connections.\r\nAllow \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients to do their own D\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K updates.\r\n"]
[25.326028, "o", "Send router-advertisements for interfaces doing \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6\r\nSpecify DUID_EN-type \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K DUID\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K (A/AAAA and PTR) records\r\nSpecify \u001b[01;31m\u001b[Khost\u001b[m\u001b[K record in interface subnet\r\nSpecify arbitrary \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\n<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>,[<subnet>...]\r\n\u001b[01;31m\u001b[KDomain\u001b[m\u001b[K to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\n"]
[25.326228, "o", "Secondary authoritative name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks for \u001b[01;31m\u001b[Kforward\u001b[m\u001b[K \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks\r\n/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>[/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>...]/<ipset>...\r\nSpecify ipsets to which matching \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks should be added\r\n/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>[/<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>...]/<nftset>...\r\nSpecify nftables sets to which matching \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[Ks should be added\r\nEnable filtering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries with connection-track marks.\r\nSet allowed \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K patterns for a connection-track mark.\r\n<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>,<range>,[<prefix>]\r\nSpecify a \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K and address range for synthesised names\r\nActivate \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\n<\u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K>,[<class>,]...\r\nDisable \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K checking for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC debugging.\r\nEnsure answers without \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC are in unsigned zones.\r\nDon't check \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature timestamps until first cache-reload\r\nTimestamp file to verify system clock for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC\r\n"]
[25.326309, "o", "Set resource limits for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6.\r\nDetect and remove \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kforward\u001b[m\u001b[King loops.\r\nIgnore \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses containing ipaddr.\r\nSet TTL in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K responses with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K-derived addresses.\r\nDelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K replies for at least number of seconds.\r\nEnables \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 Rapid Commit option.\r\n"]
[25.326388, "o", "Call \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script when \u001b[01;31m\u001b[Klease\u001b[m\u001b[K expiry changes.\r\nSuppress round-robin ordering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K records.\r\nSuppress \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nEnable \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nCache this \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record type.\r\nuk.org.thekelleys.\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\n"]
[25.326482, "o", "bad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-range\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K range\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 range\r\nduplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Khost\u001b[m\u001b[K IP address %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K has multiple names\r\nbad \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Khost\u001b[m\u001b[K name\r\n"]
[25.32664, "o", "invalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K number\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy address\r\nBad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-relay\r\nmissing address in dynamic \u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nbad dynamic \u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nBad \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-record\r\nBad name in \u001b[01;31m\u001b[Khost\u001b[m\u001b[K-record\r\n"]
[25.326741, "o", "unsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked option (check that \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq was compiled with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/TFTP/\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC/DBus sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K)\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPv6 option\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option\r\nbad \u001b[01;31m\u001b[Kdomain\u001b[m\u001b[K in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option too long\r\nNo vendor-encap options allowed in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-option-pxe\r\n"]
[25.326922, "o", "illegal \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-match\r\n\u001b[01;31m\u001b[KDns\u001b[m\u001b[Kmasq is free software, and you are welcome to redistribute it\r\nUsage: \u001b[01;31m\u001b[Kdns\u001b[m\u001b[Kmasq [options]\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s (logged only once)\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s\r\n"]
[25.327097, "o", "Maximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries reached (max: %d)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to %s reached (max: %d)\r\ndiscarding \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply: subnet option mismatch\r\npossible \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket to %s: %s\r\nCase mismatch in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K reply - check bit 0x20 encoding.\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via interfaces other than %s\r\n"]
[25.327211, "o", "LOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K amplification attacks via these interface(s)\r\ninterface %s failed to join \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 multicast group: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket for %s: %s\r\nignoring name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s - local interface\r\nignoring name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K socket: %s\r\nmore \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks are defined but not logged\r\nusing name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d for %s %s%s %s\r\n"]
[25.327349, "o", "NOT using name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d - \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K loop detected\r\nusing name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d(via %s)\r\nusing name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K %s#%d\r\nusing standard name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks for %s\r\nusing %d more name\u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks\r\nname\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\n"]
[25.327536, "o", "failed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King socket for %s: %s\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC not available: set HAVE_\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC in src/config.h\r\nconntrack sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNTRACK in src/config.h\r\nmax_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\n--auth-\u001b[01;31m\u001b[Kserver\u001b[m\u001b[K required when an auth zone is defined.\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\n"]
[25.327747, "o", "failed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\nstarted, version %s \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K disabled\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local subnets\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nchown of PID file %s failed: p\u001b[01;31m\u001b[Klease\u001b[m\u001b[K add capability CAP_CHOWN\r\nwarning: ignoring \u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K-file flag because no-\u001b[01;31m\u001b[Kresolv\u001b[m\u001b[K is set\r\n"]
[25.327942, "o", "warning: no \u001b[01;31m\u001b[Kupstream\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks configured\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K, sockets bound exclusively to interface %s\r\nsingle \u001b[01;31m\u001b[Kport\u001b[m\u001b[K mode\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket to device %s\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 no-Lua TFTP no-conntrack ipset no-nftset auth no-\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC loop-detect inotify dumpfile\r\nno \u001b[01;31m\u001b[Kserver\u001b[m\u001b[Ks found in %s, will retry\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet received on %s which has no address\r\nError sending \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K packet to %s: %s\r\ncannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to set options on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\n"]
[25.32801, "o", "failed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K socket: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kserver\u001b[m\u001b[K socket: %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K range %s -- %s is not consistent with netmask %s\r\nCannot broadcast \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay via interface %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relay at %s -> %s\r\n"]
[25.32811, "o", "\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change script name is too long\r\ncannot open or create \u001b[01;31m\u001b[Klease\u001b[m\u001b[K file %s: %s\r\nfailed to parse \u001b[01;31m\u001b[Klease\u001b[m\u001b[K database cleanly\r\nfailed to read \u001b[01;31m\u001b[Klease\u001b[m\u001b[K file %s: %s\r\ncannot run \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-init script %s: %s\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-init script returned exit code %s\r\n"]
