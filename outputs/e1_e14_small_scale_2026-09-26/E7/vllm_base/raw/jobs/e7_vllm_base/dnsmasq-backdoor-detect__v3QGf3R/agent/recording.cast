[22.458598, "o", "\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-server\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-soa\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-sec-servers\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-peer\r\nSpecify certification \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Kority \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Korization record\r\nSet TTL for \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative replies\r\nSet \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative zone information\r\nSecondary \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Koritative nameservers for forward domains\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\nillegal repeated \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword\r\ninvalid \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-zone\r\n--\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K-server required when an \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K zone is defined.\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN DHCP DHCPv6 no-Lua TFTP no-conntrack ipset no-nftset \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K no-DNSSEC loop-detect inotify dumpfile\r\n"]
