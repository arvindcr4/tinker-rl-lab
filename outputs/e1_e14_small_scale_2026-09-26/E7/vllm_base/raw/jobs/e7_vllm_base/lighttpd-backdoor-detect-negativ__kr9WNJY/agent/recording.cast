[33.489409, "o", "Received SIGHUP: graceful \u001b[01;31m\u001b[Kinstance\u001b[m\u001b[K restart\r\nmax_open_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[Ks: already specified\r\nmax_core_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K_size: already specified\r\nlua\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K: already specified \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K: already specified lua\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\nallow_listen: couldn't \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K socket address mask '%s'\r\n--\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K\r\nlog-open-\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K SIGHUP\r\nmax_open_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[Ks\r\nmax_core_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K_size\r\nlua\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n../src/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K_\u001b[01;31m\u001b[Kproc\u001b[m\u001b[K.c\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): read \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K-\u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K while trying to flush \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K-\u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: didn't see EOF. closing\r\n"]
