[111.319236, "o", "p_i\u001b[01;31m\u001b[Knc\u001b[m\u001b[Klude_lua\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K\r\n(error) %s:%d: li_fatal: angel \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion close: %s\r\n(error) %s:%d: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K failed: %s\r\n(error) %s:%d: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K('%s') failed\r\n(error) %s:%d: Invalid \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K address: '%s'\r\n(error) %s:%d: removing old \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K '%s' failed: %s\r\n(error) %s:%d: Couldn't open \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n(error) %s:%d: Couldn't \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to '%s': %s\r\n(error) %s:%d: Couldn't \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on '%s': %s\r\n(debug) %s:%d: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to unix \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: '%s'\r\n(debug) %s:%d: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to ipv6: '%s'\r\n(debug) %s:%d: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to ipv4: '%s'\r\nAssertion `con->ndx >= 0 && (guint)con->ndx < wpool->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions->len' failed.\r\nAssertion `g_ptr_array_index(wpool->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions, con->ndx) == con' failed.\r\nAssertion `last_idle_ndx == (gint) wpool->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions->len - 1' failed.\r\nAssertion `NULL != base->\u001b[01;31m\u001b[Kcallback\u001b[m\u001b[K' failed.\r\nAssertion `!ev_is_active(&asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K->libevmess.w)' failed.\r\n(error) %s:%d: Couldn't \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K to '%s': %s\r\nAssertion `ev_is_active(&asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K->libevmess.w)' failed.\r\n(error) %s:%d: Couldn't \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K to '%s': timeout\r\nAssertion `LI_EVT_ASY\u001b[01;31m\u001b[KNC\u001b[m\u001b[K == base->type' failed.\r\n../i\u001b[01;31m\u001b[Knc\u001b[m\u001b[Klude/lighttpd/events.h\r\nbackend \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K queue\r\nbackend \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion\r\nli_event_asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K_from\r\nli_event_asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K_from\r\n"]
[111.319353, "o", "physical.doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion upgrade: write response headers\r\n../src/main/\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion.c\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion keep-alive timeout\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion closed\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion closed (error)\r\nli_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_free\r\nmainvr_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_upgrade\r\nli_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_start\r\nDOCUMENT_\u001b[01;31m\u001b[KROOT\u001b[m\u001b[K\r\nIf-Modified-Si\u001b[01;31m\u001b[Knc\u001b[m\u001b[Ke\r\nFailed Depende\u001b[01;31m\u001b[Knc\u001b[m\u001b[Ky\r\nU\u001b[01;31m\u001b[KNC\u001b[m\u001b[KHECKOUT\r\n\u001b[01;31m\u001b[KCONNECT\u001b[m\u001b[K\r\nThere are too many \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions from your internet address\r\nli_event_asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K_from\r\nli_network_read: fd should be disabled as chunkqueue is already full, aborting \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion.\r\ne\u001b[01;31m\u001b[Knc\u001b[m\u001b[K:\r\n(error) %s:%d: Plugin '%s' needs an init fu\u001b[01;31m\u001b[Knc\u001b[m\u001b[Ktion\r\ntransfer-e\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koding\r\n<p>The requested resource is no longer available on this server and there is no forwarding address.<br>Please remove all refere\u001b[01;31m\u001b[Knc\u001b[m\u001b[Kes to this resource.</p>\r\n<p>There are too many \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions from your internet address.</p>\r\n<p>The server e\u001b[01;31m\u001b[Knc\u001b[m\u001b[Kountered an internal error and was unable to complete your request.</p>\r\n<p>The server is temporarily unable to service your request due to maintena\u001b[01;31m\u001b[Knc\u001b[m\u001b[Ke downtime or capacity problems.<br>Please try again later.</p>\r\n"]
[111.31957, "o", "content-e\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koding\r\nTransfer-E\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koding\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: Upgrade\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: close\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: keep-alive\r\nserver \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K\r\nli_event_asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K_from\r\nli_server_\u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K_acquire\r\nli_server_\u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K_release\r\nToo many open files. Either raise your fd limit or use a lower \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion limit.\r\ndis\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked_dest\r\n"]
[111.319766, "o", "dis\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked_source\r\n_dis\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\nli_stream_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion\r\nResponse is chunked e\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koded twice\r\n(error) %s:%d: Response has unsupported Transfer-E\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koding: %s\r\n"]
[111.320004, "o", "Upgrade with Transfer-E\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koding: chunked\r\n(debug) %s:%d: \u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion token '%s'\r\nHTTP/1.1 response: no clean message length indicator, fall back to waiting for \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion close\r\nBackend: need chunked transfer-e\u001b[01;31m\u001b[Knc\u001b[m\u001b[Koding or content-length for keepalive \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nUpgrade without \u001b[01;31m\u001b[KConnect\u001b[m\u001b[Kion: Upgrade Transfer\r\n../src/main/stream_simple_\u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K.c\r\nli_stream_simple_\u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K_close\r\n\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion upgrade\r\n../i\u001b[01;31m\u001b[Knc\u001b[m\u001b[Klude/lighttpd/core_lua.h\r\n"]
[111.320102, "o", "li_vrequest_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion_upgrade\r\nli_vrequest_indirect_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[K\r\nworker \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion keep-alive\r\nworker new \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion\r\n(debug) %s:%d: \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion io-timeout from %s after %.2f seconds\r\n(error) %s:%d: Server shutdown with u\u001b[01;31m\u001b[Knc\u001b[m\u001b[Klosed \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions: %u\r\nAssertion `con->idx < wrk->\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions_active' failed.\r\n"]
[111.320301, "o", "li_event_asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K_from\r\n(debug) %s:%d: doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K: \"%s\"\r\nstat.asy\u001b[01;31m\u001b[Knc\u001b[m\u001b[K\r\nno doc\u001b[01;31m\u001b[Kroot\u001b[m\u001b[K specified yet but index action called\r\n"]
