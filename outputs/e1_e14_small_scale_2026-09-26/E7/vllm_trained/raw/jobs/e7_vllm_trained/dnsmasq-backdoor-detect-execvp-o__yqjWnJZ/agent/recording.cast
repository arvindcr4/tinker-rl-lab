[14.303896, "o", "%s is a CNAME, not giving it to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s\r\nnot giving name %s to the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K of %s because the name exists in %s with address %s\r\n"]
[14.304079, "o", "child processes for TCP \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks: in use %zu, highest since last SIGUSR1 %zu, max allowed %zu.\r\n\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kreply\u001b[m\u001b[K\r\nnon-\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K opcode\r\n\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K\r\n"]
[14.304383, "o", "C\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY\r\nunsupported \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY algorithm\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC indeterminate\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC bogus\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature expired\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC sig not yet valid\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KKEY missing\r\nnot \u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky\r\nuanble to \u001b[01;31m\u001b[Kconf\u001b[m\u001b[Korm to policy\r\ncannot create \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s\r\ncannot \u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s: %s\r\n/etc/resolv.\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K\r\n/var/run/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.pid\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K version %s  %s\r\nCompile time \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\nbad command line \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\n/etc/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K-2.92test7-1-gd100821\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n"]
[14.304433, "o", "copyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n"]
[14.30485, "o", "evictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nservers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nonly one resolv.\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K file allowed in no-poll mode.\r\nmust have exactly one resolv.\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K to \u001b[01;31m\u001b[Kread\u001b[m\u001b[K domain from.\r\nfailed to \u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s: %s\r\nthere must be a default domain when --\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn is set\r\n\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K: %s.\r\ncannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\nbad \u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\nillegal \u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-host\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-boot\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\n\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K-file\r\n\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K-script\r\n\u001b[01;31m\u001b[Kquery\u001b[m\u001b[K-port\r\n"]
[14.30494, "o", "no-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-interface\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv4-interface\r\nno-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[Kv6-interface\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Klease\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K-ethers\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-vendorclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-userclass\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore\r\ne\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-\u001b[01;31m\u001b[Kpacket\u001b[m\u001b[K-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-authoritative\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-rr\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-mac\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script\r\n\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K-dir\r\n\u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile-ro\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-forward-max\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-names\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K-force\r\nlog-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-circuitid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-remoteid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-subscrid\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-pxe-vendor\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-hostsfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsfile\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-hostsdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-optsdir\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-no-override\r\n"]
[14.305115, "o", "stop-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-name-match\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-broadcast\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-alternate-port\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-scriptuser\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-fqdn\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-generate-names\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\nproxy-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-sequential-ip\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-client-update\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-luascript\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-duid\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-debug\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-check-unsigned\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-no-timecheck\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-timestamp\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[Ksec-limits\r\nquiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K\r\nquiet-\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6\r\n\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-loop-detect\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ttl\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Kreply\u001b[m\u001b[K-delay\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-rapid-commit\r\n"]
[14.305364, "o", "\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-ignore-clid\r\nfast-\u001b[01;31m\u001b[Kdns\u001b[m\u001b[K-retry\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration file (defaults to %s).\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background: run in debug mode.\r\nDon't forward spurious \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks from Windows hosts.\r\nDon't include IPv4 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include IPv6 addresses in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nDon't include resource records of the given type in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K answers.\r\nEnable \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K in the range given with \u001b[01;31m\u001b[Klease\u001b[m\u001b[K duration.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host specs from file.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K specs from file.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host specs from a directory.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks from a directory.\r\n"]
[14.305555, "o", "\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\nSpecify a hosts file to be \u001b[01;31m\u001b[Kread\u001b[m\u001b[K in addition to %s.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K hosts files from a directory.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K user class to tag.\r\nSpecify vendor class to match for PXE \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks.\r\nDon't do \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K for hosts with tag set.\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background, do NOT run in debug mode.\r\nAssume we are the only \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server on the local network.\r\n"]
[14.305781, "o", "Specify where to store \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\n/var/lib/misc/\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks\r\nSpecify BOOTP \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\nUse expired cache data for faster \u001b[01;31m\u001b[Kreply\u001b[m\u001b[K.\r\nSpecify \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks to be sent to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K sent even if the client does not \u001b[01;31m\u001b[Krequest\u001b[m\u001b[K it.\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[K sent only to PXE clients.\r\nSpecify port to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks on (defaults to 53).\r\nMaximum supported UDP \u001b[01;31m\u001b[Kpacket\u001b[m\u001b[K size for E\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.0 (defaults to %s).\r\nLog \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nForce the originating port for upstream \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nSet maximum number of random originating ports for a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K.\r\nDo NOT \u001b[01;31m\u001b[Kread\u001b[m\u001b[K resolv.\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K.\r\nSpecify path to resolv.\u001b[01;31m\u001b[Kconf\u001b[m\u001b[K (defaults to %s).\r\nSpecify path to file with server= \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks\r\nSpecify address(es) of upstream servers with \u001b[01;31m\u001b[Koption\u001b[m\u001b[Kal domains.\r\nSpecify the domain to be assigned in \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks.\r\nSpecify time-to-live in seconds for maximum TTL to \u001b[01;31m\u001b[Ksend\u001b[m\u001b[K to clients.\r\nRetry \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries after this many milliseconds.\r\nMap \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K vendor class to tag.\r\nDisplay \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K version and copyright information.\r\nDisplay this message. Use --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K or --help \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K6 for known \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks.\r\nSpecify maximum number of \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[Ks (defaults to %s).\r\nAnswer \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries based on the interface a \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K was sent to.\r\nSpecify TXT \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nSpecify PTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nGive \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name to IPv4 address of interface.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K static host information from %s.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K on this interface, only provide \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 on this interface.\r\nDo not provide \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 on this interface.\r\n"]
[14.305901, "o", "Map MAC address (with wildcards) to \u001b[01;31m\u001b[Koption\u001b[m\u001b[K set.\r\nTreat \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks on aliases as arriving from interface.\r\nSpecify extra networks sharing a broadcast domain for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K\r\nDisable ICMP echo address checking in the \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K server.\r\n"]
[14.306081, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nLua script to run on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Klease\u001b[m\u001b[K creation and destruction.\r\nRun \u001b[01;31m\u001b[Klease\u001b[m\u001b[K-change scripts as this user.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script with changes to local ARP table.\r\n\u001b[01;31m\u001b[KRead\u001b[m\u001b[K \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration from all the files in this directory.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and \u001b[01;31m\u001b[Kread\u001b[m\u001b[K \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration from stdin.\r\nDo not use \u001b[01;31m\u001b[Klease\u001b[m\u001b[Kfile.\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries. (defaults to %s)\r\nClear \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K cache when reloading %s.\r\nIgnore hostnames provided by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nDo NOT reuse filename and server fields for extra \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks.\r\nEnable integrated \u001b[01;31m\u001b[Kread\u001b[m\u001b[K-only TFTP server.\r\nAllow access only to files owned by the user running \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K.\r\n"]
[14.30615, "o", "Extra logging for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nEnable async. logging; \u001b[01;31m\u001b[Koption\u001b[m\u001b[Kally set queue length.\r\nStop \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nAlways perform \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to all servers.\r\nSet tag if client includes matching \u001b[01;31m\u001b[Koption\u001b[m\u001b[K in \u001b[01;31m\u001b[Krequest\u001b[m\u001b[K.\r\nUse alternative ports for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nSpecify NAPTR \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K record.\r\nSpecify lowest port available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\n"]
[14.306205, "o", "Specify highest port available for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K transmission.\r\nUse only fully qualified domain names for \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nUse these \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K relays as full proxies.\r\nRelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks to a remote server\r\nSpecify alias name for LOCAL \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K name.\r\nPrompt to \u001b[01;31m\u001b[Ksend\u001b[m\u001b[K to PXE clients.\r\n"]
[14.306479, "o", "Check \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kuration syntax.\r\nAdd \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Kor's MAC address to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd specified IP subnet to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nAdd client identification to forwarded \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries.\r\nProxy \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation results from upstream nameservers.\r\nAttempt to allocate sequential IP addresses to \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nIgnore client identifier \u001b[01;31m\u001b[Koption\u001b[m\u001b[K sent by \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nAllow \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K clients to do their own D\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K updates.\r\n\u001b[01;31m\u001b[KSend\u001b[m\u001b[K router-advertisements for interfaces doing \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6\r\nSpecify DUID_EN-type \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 server DUID\r\nSpecify arbitrary \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nExport local names to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nDomain to export to global \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K\r\nEnable filtering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nActivate \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\nDisable upstream checking for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC debugging.\r\nEnsure answers without \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC are in unsigned zones.\r\nDon't check \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC signature timestamps until first cache-reload\r\nTimestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC\r\nSet resource limits for \u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC validation\r\nSet MTU, priority, re\u001b[01;31m\u001b[Ksend\u001b[m\u001b[K-interval and router-lifetime\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K.\r\nDo not log routine \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6.\r\n\u001b[01;31m\u001b[KAccept\u001b[m\u001b[K queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nDetect and remove \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K forwarding loops.\r\nIgnore \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kresponse\u001b[m\u001b[Ks containing ipaddr.\r\n"]
[14.306621, "o", "Set TTL in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kresponse\u001b[m\u001b[Ks with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K-derived addresses.\r\nDelay \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K replies for at least number of seconds.\r\nEnables \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv4 Rapid Commit \u001b[01;31m\u001b[Koption\u001b[m\u001b[K.\r\nPath to debug \u001b[01;31m\u001b[Kpacket\u001b[m\u001b[K dump file.\r\nMask which \u001b[01;31m\u001b[Kpacket\u001b[m\u001b[Ks to dump.\r\nCall \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-script when \u001b[01;31m\u001b[Klease\u001b[m\u001b[K expiry changes.\r\n\u001b[01;31m\u001b[KSend\u001b[m\u001b[K Cisco Umbrella identifiers including remote IP.\r\nSuppress round-robin ordering of \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K records.\r\n"]
[14.30667, "o", "Suppress \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nEnable \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K bit 0x20 encoding.\r\nCache this \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K resource record type.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nuk.org.thekelleys.\u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-range\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K range\r\ninconsistent \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 range\r\nduplicate \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-host IP address %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host has multiple names\r\nbad \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K host name\r\n"]
[14.306839, "o", "bad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-proxy address\r\nBad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-relay\r\nunsupported \u001b[01;31m\u001b[Koption\u001b[m\u001b[K (check that \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K was compiled with \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K/TFTP/\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC/DBus support)\r\n\u001b[01;31m\u001b[Koption\u001b[m\u001b[K:\r\n\u001b[01;31m\u001b[Koption\u001b[m\u001b[K6:\r\n"]
[14.306905, "o", "unsupported encapsulation for IPv6 \u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\nbad \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\nbad domain in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K too long\r\nNo vendor-encap \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks allowed in \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-\u001b[01;31m\u001b[Koption\u001b[m\u001b[K-pxe\r\nillegal \u001b[01;31m\u001b[Kdhcp\u001b[m\u001b[K-match\r\n\u001b[01;31m\u001b[KDnsmasq\u001b[m\u001b[K is free software, and you are welcome to redistribute it\r\nUsage: \u001b[01;31m\u001b[Kdnsmasq\u001b[m\u001b[K [\u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks]\r\nValid \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks are:\r\nfailed to \u001b[01;31m\u001b[Ksend\u001b[m\u001b[K \u001b[01;31m\u001b[Kpacket\u001b[m\u001b[K: %s\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s (logged only once)\r\nignoring \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K from non-local network %s\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries reached (max: %d)\r\nMaximum number of concurrent \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K queries to %s reached (max: %d)\r\ndiscarding \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kreply\u001b[m\u001b[K: subnet \u001b[01;31m\u001b[Koption\u001b[m\u001b[K mismatch\r\npossible \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\n"]
[14.307036, "o", "Case mismatch in \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K \u001b[01;31m\u001b[Kreply\u001b[m\u001b[K - check bit 0x20 encoding.\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s port %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may \u001b[01;31m\u001b[Kaccept\u001b[m\u001b[K \u001b[01;31m\u001b[Krequest\u001b[m\u001b[Ks via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K amplification attacks via these interface(s)\r\n"]
[14.307249, "o", "interface %s failed to join \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 multicast group: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make/\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nNOT using nameserver %s#%d - \u001b[01;31m\u001b[Kquery\u001b[m\u001b[K loop detected\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s port %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC not available: set HAVE_\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nconntrack support not available: set HAVE_CONNTRACK in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nUbus not available: set HAVE_UBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nDBus not available: set HAVE_DBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nUBus not available: set HAVE_UBUS in src/\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K.h\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\nstarted, version %s \u001b[01;31m\u001b[KDNS\u001b[m\u001b[K disabled\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to local subnets\r\n\u001b[01;31m\u001b[KDNS\u001b[m\u001b[K service limited to localhost\r\ncompile time \u001b[01;31m\u001b[Koption\u001b[m\u001b[Ks: %s\r\nchown of PID file %s failed: p\u001b[01;31m\u001b[Klease\u001b[m\u001b[K add capability CAP_CHOWN\r\n"]
[14.307299, "o", "warning: no upstream servers \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[Kured\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nIPv6 GNU-getopt no-DBus no-UBus no-i18n no-IDN \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[Kv6 no-Lua TFTP no-conntrack ipset no-nftset auth no-\u001b[01;31m\u001b[KDNS\u001b[m\u001b[KSEC loop-detect inotify dumpfile\r\ncannot \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into background: %s\r\n"]
[14.30736, "o", "failed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[King %s\r\n\u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kpacket\u001b[m\u001b[K received on %s which has no address\r\nError \u001b[01;31m\u001b[Ksend\u001b[m\u001b[King \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Kpacket\u001b[m\u001b[K to %s: %s\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K %s - %d addresses\r\ncannot create \u001b[01;31m\u001b[KDHCP\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
