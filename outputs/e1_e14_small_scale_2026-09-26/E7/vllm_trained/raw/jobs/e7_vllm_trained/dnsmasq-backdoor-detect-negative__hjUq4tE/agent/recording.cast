[195.524782, "o", "query-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\ntftp-single-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\ntftp-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-range\r\nstop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\ndhcp-alternate-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmin-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmax-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-limit\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\nsingle \u001b[01;31m\u001b[Kport\u001b[m\u001b[K mode\r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\ncannot create DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nPXE BIS not sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked\r\n"]
[195.524827, "o", "unsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked request from %s\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\n"]
[195.525111, "o", "captive-\u001b[01;31m\u001b[Kport\u001b[m\u001b[Kal\r\ncannot open \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K %s: %s\r\ntcp_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked NSEC3 iterations value\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background: run in debug mode.\r\n\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\n"]
[195.525376, "o", "Do NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background, do NOT run in debug mode.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for DNS requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for EDNS.0 (defaults to %s).\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for upstream DNS queries.\r\nSet maximum number of random originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a query.\r\nSpecify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n"]
[195.525637, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by TFTP only from the specified subtree.\r\nEphemeral \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range for use by TFTP transfers.\r\nUse only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP server.\r\nStop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\nInhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for DHCP.\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for DNS query transmission.\r\nSpecify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for DNS query transmission.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global DNS\r\nDomain to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global DNS\r\nEnable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\n"]
[195.525763, "o", "Set allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\n"]
[195.525838, "o", "Timestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nAccept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\nMaximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\n"]
[195.526072, "o", "possible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nfailed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make\u001b[01;31m\u001b[K/bin\u001b[m\u001b[Kd \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into background: %s\r\nconntrack sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNTRACK in src/config.h\r\n"]
[195.526163, "o", "max_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\n"]
[195.526455, "o", "failed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nunable to get free \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked write request from %s\r\ncannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset control \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPfor IPv6 option\r\ndhcp-option too No vendor-encap options allowed in dhcp-option-pillegal dhcp-matillegal repeatedepeated \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword\r\nbad DHCP host nainvalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K numbad dhcp-proxy amissing address ddress in alias\r\nBad name in hostunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked option (check that dnsmasq was compiled with DHCP/TFTP/DNSSEC/DBus s\r\n"]
