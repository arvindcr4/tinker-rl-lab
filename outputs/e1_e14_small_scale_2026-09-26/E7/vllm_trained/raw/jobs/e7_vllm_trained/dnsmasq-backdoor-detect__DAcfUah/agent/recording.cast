[195.784102, "o", "unsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked DS digest\r\nDNS\u001b[01;31m\u001b[KKEY\u001b[m\u001b[K missing\r\nno zone \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K bit set\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked NSEC3 iterations value\r\ntru\u001b[01;31m\u001b[Kncat\u001b[m\u001b[Ked\r\ncannot create \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: %s\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nversion.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauthors.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncopyright.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncachesize.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ninsertions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n"]
[195.784143, "o", "evictions.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nmisses.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nhits.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nauth.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\n"]
[195.784218, "o", "servers.\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\ncannot \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\nerror \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting %s: %s\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K-address\r\n"]
[195.784444, "o", "query-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces\r\ntftp-single-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\ntftp-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-range\r\nstop-dns-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-domain-ok\r\ndhcp-alternate-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmin-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nmax-\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\nre\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-localhost-ok\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K-limit\r\nmax-tcp-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\nSpecify local address(es) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nFake \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K lookups for RFC1918 private address ranges.\r\n"]
[195.784482, "o", "Do NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background: run in debug mode.\r\n"]
[195.784881, "o", "\u001b[01;31m\u001b[KEval\u001b[m\u001b[Kuate conditional tag expression.\r\nSpecify interface(s) to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nSpecify interface(s) NOT to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on.\r\nDo NOT \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into the background, do NOT run in debug mode.\r\nSpecify \u001b[01;31m\u001b[Kport\u001b[m\u001b[K to \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K for DNS requests on (defaults to 53).\r\nMaximum sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked UDP packet size for EDNS.0 (defaults to %s).\r\nForce the originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for upstream DNS queries.\r\n#\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks\r\nSet maximum number of random originating \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for a query.\r\nSpecify address of upstream servers for \u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K address queries\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K only to interfaces in use.\r\n"]
[195.785007, "o", "\u001b[01;31m\u001b[KShell\u001b[m\u001b[K script to run on DHCP lease creation and destruction.\r\n\u001b[01;31m\u001b[KExec\u001b[m\u001b[Kute file and read configuration from stdin.\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K files by TFTP only from the specified subtree.\r\nEphemeral \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range for use by TFTP transfers.\r\nUse only one \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP server.\r\nStop DNS re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King. Filter private IP ranges when resolving.\r\nAllow re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[King of 127.0.0.0/8, for RBL servers.\r\n"]
[195.785109, "o", "Inhibit DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K protection on this domain.\r\n[=<\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks>]\r\nUse alternative \u001b[01;31m\u001b[Kport\u001b[m\u001b[Ks for DHCP.\r\n<\u001b[01;31m\u001b[Kport\u001b[m\u001b[K>\r\nSpecify lowest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for DNS query transmission.\r\nSpecify highest \u001b[01;31m\u001b[Kport\u001b[m\u001b[K available for DNS query transmission.\r\nCopy \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark from queries to upstream \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\n\u001b[01;31m\u001b[KBind\u001b[m\u001b[K to interfaces in use - check for new interfaces\r\nEx\u001b[01;31m\u001b[Kport\u001b[m\u001b[K local names to global DNS\r\nDomain to ex\u001b[01;31m\u001b[Kport\u001b[m\u001b[K to global DNS\r\n"]
[195.785148, "o", "Enable filtering of DNS queries with \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track marks.\r\nSet allowed DNS patterns for a \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion-track mark.\r\nSpecify trust anchor \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K digest.\r\n"]
[195.785226, "o", "Timestamp file to verify \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K clock for DNSSEC\r\nAccept queries only from directly-\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Ked networks.\r\n"]
[195.785429, "o", "Maximum number of concurrent tcp \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions.\r\nillegal repeated \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword\r\nbad \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\ninvalid \u001b[01;31m\u001b[Kport\u001b[m\u001b[K number\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked option (check that dnsmasq was compiled with DHCP/TFTP/DNSSEC/DBus sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K)\r\n"]
[195.78562, "o", "unsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked encapsulation for IPv6 option\r\npossible DNS-re\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K attack detected: %s\r\nTCP \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion failed to %s#%d\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to %s: %s\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\nLOUD WARNING: \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s may accept requests via interfaces other than %s\r\nLOUD WARNING: use --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic rather than --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces to avoid DNS amplification attacks via these interface(s)\r\n"]
[195.785832, "o", "failed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nignoring nameserver %s - cannot make\u001b[01;31m\u001b[K/bin\u001b[m\u001b[Kd \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nstopped \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King on %s(#%d): %s \u001b[01;31m\u001b[Kport\u001b[m\u001b[K %d\r\n"]
[195.785938, "o", "failed to create \u001b[01;31m\u001b[Klisten\u001b[m\u001b[King \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K for %s: %s\r\nconntrack sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[K not available: set HAVE_CONNTRACK in src/config.h\r\nmax_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K cannot be smaller than min_\u001b[01;31m\u001b[Kport\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kport\u001b[m\u001b[K_limit must not be larger than available \u001b[01;31m\u001b[Kport\u001b[m\u001b[K range\r\ncannot set --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-interfaces and --\u001b[01;31m\u001b[Kbind\u001b[m\u001b[K-dynamic\r\nfailed to set SO_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[KTODEVICE on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nNET_\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K_SERVICE\r\ncannot chdir to file\u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K root: %s\r\nDHCP, \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Ks bound exclusively to interface %s\r\nsingle \u001b[01;31m\u001b[Kport\u001b[m\u001b[K mode\r\nerror \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to device %s\r\ncannot \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K into background: %s\r\nfailed to \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kute %s: %s\r\ncannot create DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set options on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on DHCP \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCP server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[K/bin\u001b[m\u001b[K\u001b[01;31m\u001b[K/sh\u001b[m\u001b[K\r\n"]
[195.786088, "o", "PXE BIS not sup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked\r\ncannot create netlink \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nunable to get free \u001b[01;31m\u001b[Kport\u001b[m\u001b[K for TFTP\r\nunsup\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked %srequest from %s\r\ncannot create DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n"]
[195.786157, "o", "failed to set SO_REUSE{ADDR|\u001b[01;31m\u001b[KPORT\u001b[m\u001b[K} on DHCPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K DHCPv6 server \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nDHCPRE\u001b[01;31m\u001b[KBIND\u001b[m\u001b[K\r\nno \u001b[01;31m\u001b[Kbind\u001b[m\u001b[King found\r\nN@cannot create ICMPv6 \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\nfailed to create IPset control \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\ncannot open \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K %s: %s\r\ntcp_\u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kions\r\n"]
