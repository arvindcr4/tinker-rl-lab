[282.789178, "o", "\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K expects a hash/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K needs a \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K doesn't take default \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K expects a string as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K ca-\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K expects a string as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K unexpected \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate parameter %s\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K c\u001b[01;31m\u001b[Kip\u001b[m\u001b[Khers expects a string as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K dh-params expects a string as parameter\r\n"]
[282.789674, "o", "\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K ecdh-curve expects a string as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K options expects a list of strings as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K option unknown: %s\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K expects a boolean as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K-any expects a boolean as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K-depth expects a number as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K \u001b[01;31m\u001b[Kverify\u001b[m\u001b[K-require expects a boolean as parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K client-ca-\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K expects a string as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: invalid parameter for \u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K: %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_\u001b[01;31m\u001b[Knew\u001b[m\u001b[K: %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_set_options(%lx): %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_set_c\u001b[01;31m\u001b[Kip\u001b[m\u001b[Kher_list('%s'): %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KError\u001b[m\u001b[K \u001b[01;31m\u001b[Kopen\u001b[m\u001b[King DH parameters from '%s': %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KError\u001b[m\u001b[K while loading DH parameters from '%s': %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: No DH parameters found in '%s'\r\n(\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King) %s:%d: \u001b[01;31m\u001b[KError\u001b[m\u001b[K while trying to find DH parameters from '%s': %s\r\n(\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King) %s:%d: Failed to set DH parameters from '%s': %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K: Unknown curve name '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_set1_\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[Ks failed to set curve '%s': %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_load_\u001b[01;31m\u001b[Kverify\u001b[m\u001b[K_locations('%s'): %s\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K expects a hash/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list or a string as pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K doesn't take default \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Ks\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K.\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K expects a string as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K unexpected \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate parameter pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K %s\r\n"]
[282.790051, "o", "\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K.\u001b[01;31m\u001b[Kcert\u001b[m\u001b[K expects a string as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: invalid parameter for \u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K: pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K %s\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K expects a hash/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list (with at least \"\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K\" and \"\u001b[01;31m\u001b[Kcert\u001b[m\u001b[K\" entries) or a string as pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K parameter\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K: missing \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K or \u001b[01;31m\u001b[Kcert\u001b[m\u001b[K in pem\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_use_\u001b[01;31m\u001b[Kcert\u001b[m\u001b[Kificate_chain_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K('%s'): %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_use_\u001b[01;31m\u001b[KPriv\u001b[m\u001b[Kate\u001b[01;31m\u001b[KKey\u001b[m\u001b[K_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K('%s'): %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K: \u001b[01;31m\u001b[KPriv\u001b[m\u001b[Kate \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K '%s' does not match the \u001b[01;31m\u001b[Kcert\u001b[m\u001b[Kificate public \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K '%s', reason: %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_CTX_set_session_id_context(): %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_load_client_CA_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K('%s'): %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Version mismatch for modules \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K: is %u, expected %u\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Compile flags mismatch: sizeof(off_t) is %u, expected %u\r\nnot enough entropy in the \u001b[01;31m\u001b[Kpool\u001b[m\u001b[K\r\nNETS\u001b[01;31m\u001b[KCAP\u001b[m\u001b[KE_REUSE_C\u001b[01;31m\u001b[KIP\u001b[m\u001b[KHER_CHANGE_BUG\r\n"]
[282.790533, "o", "SESSION_RE\u001b[01;31m\u001b[KSU\u001b[m\u001b[KMPTION_ON_RENEGOTIATION\r\nNETS\u001b[01;31m\u001b[KCAP\u001b[m\u001b[KE_DEMO_C\u001b[01;31m\u001b[KIP\u001b[m\u001b[KHER_CHANGE_BUG\r\nmod_\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K_context_release\r\nmod_\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K_context_acquire\r\n\u001b[01;31m\u001b[Ktcp\u001b[m\u001b[K_io_cb\r\n\u001b[01;31m\u001b[Kclose\u001b[m\u001b[K_cb\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K_\u001b[01;31m\u001b[Ktcp\u001b[m\u001b[K_finished\r\n\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K.setenv expects a string or a list of strings consisting of: client, client-\u001b[01;31m\u001b[Kcert\u001b[m\u001b[K, server, server-\u001b[01;31m\u001b[Kcert\u001b[m\u001b[K\r\n../src/modules/\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K_filter.c\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[Ked %i: %s\r\nAssertion `\u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K_max >= 0' failed.\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Couldn't \u001b[01;31m\u001b[Kread\u001b[m\u001b[K data from chunk\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[KSSL\u001b[m\u001b[K: client \u001b[01;31m\u001b[Kinit\u001b[m\u001b[Kiated renegotiation, closing connection\r\nAssertion `NULL != f->\u001b[01;31m\u001b[Kcallback\u001b[m\u001b[Ks' failed.\r\n"]
[282.790888, "o", "(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s: %s\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: %s: %s\r\n\u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_do_handshake\r\n\u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_\u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_shutdown\r\n\u001b[01;31m\u001b[KSSL\u001b[m\u001b[K_\u001b[01;31m\u001b[Kread\u001b[m\u001b[K\r\nlig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd stream glue\r\nli_\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K_filter_free\r\nf_\u001b[01;31m\u001b[Kclose\u001b[m\u001b[K_\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K\r\ndo_\u001b[01;31m\u001b[Kssl\u001b[m\u001b[K_\u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K_array\r\n"]
