[282.585259, "o", " if(el.getAttribute(\"val\")) \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K el.getAttribute(\"val\");\r\n  \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K el;\r\n  \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K el.innerText;\r\n  \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K str = \"\";\r\n  \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K cs = el.\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes;\r\n  \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K l = cs.length;\r\n  for (\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K i=0;i<l;i++) {\r\n   else if (cs[i].nodeType==3) str += cs[i].nod\u001b[01;31m\u001b[KeVal\u001b[m\u001b[Kue;\r\n \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K str;\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K ag = \u001b[01;31m\u001b[Kparse\u001b[m\u001b[KInt(a.getAttribute('\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[K'));\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K bg = \u001b[01;31m\u001b[Kparse\u001b[m\u001b[KInt(b.getAttribute('\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[K'));\r\n if (ag != bg) \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K (ag - bg);\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K at = get_inner_text(a.cells[sort_column]);\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K bt = get_inner_text(b.cells[sort_column]);\r\n  \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K sort_\u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K*(\u001b[01;31m\u001b[Kparse\u001b[m\u001b[KInt(at)-\u001b[01;31m\u001b[Kparse\u001b[m\u001b[KInt(bt));\r\n"]
[282.585736, "o", "  \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K aa = at.toLowerCase();\r\n  \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K bb = bt.toLowerCase();\r\n  if (aa==bb) \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K 0;\r\n  else if (aa<bb) \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K -1*sort_\u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K;\r\n  else \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K sort_\u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K;\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K span = lnk.\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes[1];\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K table = lnk.parentNode.parentNode.parentNode.parentNode;\r\n \u001b[01;31m\u001b[Kvar\u001b[m\u001b[K rows = \u001b[01;31m\u001b[Knew\u001b[m\u001b[K Array();\r\n for (\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K j=1;j<table.rows.length;j++)\r\n sort_\u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K = (span.getAttribute('sort\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K')=='down') ? -1 : 1;\r\n if (span.getAttribute('sort\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K')=='down') {\r\n  span.setAttribute('sort\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K','up');\r\n"]
