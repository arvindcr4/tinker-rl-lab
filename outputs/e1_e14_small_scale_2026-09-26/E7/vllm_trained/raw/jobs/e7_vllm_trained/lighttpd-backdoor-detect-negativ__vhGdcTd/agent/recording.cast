[282.738393, "o", "lua.handler doesn't take default \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Ks\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: lua.handler option '%s' expects positive integer as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: unknown option for lua.handler '%s'\r\nlua.plugin expects at least a \u001b[01;31m\u001b[Kfile\u001b[m\u001b[Kname, or a \u001b[01;31m\u001b[Kfile\u001b[m\u001b[Kname and some options\r\nlua.plugin expects options in a hash/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list\r\nlua.plugin doesn't take null \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Ks\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: unknown option for lua.plugin '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Loading lua plugin '%s' failed: %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Unexpected \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K type in table 'actions': %s (%i) - sk\u001b[01;31m\u001b[Kip\u001b[m\u001b[Kping entry\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Unexpected \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K type in table 'setups': %s (%i) - sk\u001b[01;31m\u001b[Kip\u001b[m\u001b[Kping entry\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: failed to register lua plugin '%s'\r\n"]
