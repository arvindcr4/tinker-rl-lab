[282.517651, "o", "../src/modules/mod_\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K_disk_etag.c\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Couldn't \u001b[01;31m\u001b[Kread\u001b[m\u001b[K data from chunk\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[K: %s\r\nCouldn't \u001b[01;31m\u001b[Kread\u001b[m\u001b[K data from chunk\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[K\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Couldn't \u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K to temporary \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K \u001b[01;31m\u001b[Kfile\u001b[m\u001b[K '%s': %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Couldn't move temporary \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K \u001b[01;31m\u001b[Kfile\u001b[m\u001b[K '%s': '%s'\r\nCannot wait for response headers as no \u001b[01;31m\u001b[Kback\u001b[m\u001b[Kend handler found - fix your \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n"]
[282.517974, "o", "\u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate etag header in response, will not \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K it\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Unexpected \u001b[01;31m\u001b[Kfile\u001b[m\u001b[K type for \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K \u001b[01;31m\u001b[Kfile\u001b[m\u001b[K '%s' (mode %o)\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K hit for '%s'\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K miss for '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: creating \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K-\u001b[01;31m\u001b[Kdir\u001b[m\u001b[Kectory '%s' failed: %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: unexpected trailing slash for \u001b[01;31m\u001b[Kfile\u001b[m\u001b[Kname '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Couldn't \u001b[01;31m\u001b[Kcreate\u001b[m\u001b[K \u001b[01;31m\u001b[Kcache\u001b[m\u001b[K temp\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K '%s': %s\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.disk.etag expects a string as parameter\r\n"]
[282.51837, "o", "(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Version mismatch for modules \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K: is %u, expected %u\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Compile flags mismatch: sizeof(off_t) is %u, expected %u\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s\r\nmod_\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K_disk_etag\r\n\u001b[01;31m\u001b[Kcache\u001b[m\u001b[K.disk.etag\r\n"]
