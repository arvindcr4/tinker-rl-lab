[282.540804, "o", "\tts_\u001b[01;31m\u001b[Kstart\u001b[m\u001b[Ked = %f,\r\n../include/lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd/events.h\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s\r\nmod_\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K \u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K\r\nmod_\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K \u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K_timeout\r\n"]
[282.541203, "o", "\u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K,\r\n\u001b[01;31m\u001b[Kread\u001b[m\u001b[K,\r\nmod_\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K.show_connections\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K.show_events\r\n<title>Lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd mod_\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K</title>\r\n<p>now: %f<br>io timeout \u001b[01;31m\u001b[Kwatch\u001b[m\u001b[Ker active/repeat: %s/%f<br></p>\r\n<tr><td>%s</td><td style=\"text-align:right;\">%s</td><td style=\"padding-left:10px;\"><a href=\"?%u_%u_%d_%s\">\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K</a></td></tr>\r\n\t\t\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[Kd = %s,\r\n\t\t\t\u001b[01;31m\u001b[Khost\u001b[m\u001b[K = \"%s\"\r\n"]
[282.541515, "o", "\t\t\t\u001b[01;31m\u001b[Kpath\u001b[m\u001b[K = \"%s\"\r\nAssertion `NULL != base->\u001b[01;31m\u001b[Kcallback\u001b[m\u001b[K' failed.\r\nAssertion `!ev_is_active(&\u001b[01;31m\u001b[Kchild\u001b[m\u001b[K->libevmess.w)' failed.\r\nAssertion `!ev_is_active(&\u001b[01;31m\u001b[Kcheck\u001b[m\u001b[K->libevmess.w)' failed.\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K.show_connections doesn't expect any parameters\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K.show_events doesn't expect any parameters\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K.show_events_after_shutdown expects one or two numbers, got %s\r\nEvent \u001b[01;31m\u001b[Klisten\u001b[m\u001b[Ker for \u001b[01;31m\u001b[Kworker\u001b[m\u001b[K %i: '%s' (%s %s)%s\r\nAssertion `ev_is_active(&\u001b[01;31m\u001b[Kchild\u001b[m\u001b[K->libevmess.w)' failed.\r\nAssertion `ev_is_active(&\u001b[01;31m\u001b[Kcheck\u001b[m\u001b[K->libevmess.w)' failed.\r\n"]
[282.54193, "o", "(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Couldn't \u001b[01;31m\u001b[Ksu\u001b[m\u001b[Kspend yet, \u001b[01;31m\u001b[Kcheck\u001b[m\u001b[King events for \u001b[01;31m\u001b[Kworker\u001b[m\u001b[K %i:\r\nAssertion `LI_EVT_ASY\u001b[01;31m\u001b[KNC \u001b[m\u001b[K== base->type' failed.\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Version mismatch for modules \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K: is %u, expected %u\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Compile flags mismatch: sizeof(off_t) is %u, expected %u\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K.show_events_after_shutdown\r\nli_event_\u001b[01;31m\u001b[Kstart\u001b[m\u001b[K_\r\nli_event_\u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\r\n"]
