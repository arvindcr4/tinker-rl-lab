[219.396316, "o", "\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[KAddr\u001b[m\u001b[Kess family %i not \u001b[01;31m\u001b[Ksu\u001b[m\u001b[Kp\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked\r\n\u001b[01;31m\u001b[KSocket\u001b[m\u001b[K \u001b[01;31m\u001b[Kaddr\u001b[m\u001b[Kess not allowed: '%s'\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Couldn't \u001b[01;31m\u001b[Kopen\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Couldn't \u001b[01;31m\u001b[Ksetsockopt\u001b[m\u001b[K(SO_REUSE\u001b[01;31m\u001b[KADDR\u001b[m\u001b[K): %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Couldn't \u001b[01;31m\u001b[Kbind\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K to '%s': %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Couldn't \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K on '%s': %s\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to \u001b[01;31m\u001b[Kip\u001b[m\u001b[Kv4: '%s' (\u001b[01;31m\u001b[Kport\u001b[m\u001b[K: %d)\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Couldn't \u001b[01;31m\u001b[Ksetsockopt\u001b[m\u001b[K(\u001b[01;31m\u001b[KIP\u001b[m\u001b[KV6_V6ONLY): %s\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to \u001b[01;31m\u001b[Kip\u001b[m\u001b[Kv6: '%s' (\u001b[01;31m\u001b[Kport\u001b[m\u001b[K: %d)\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): removing old \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K '%s' failed: %s\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to unix \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K: '%s'\r\nReceived SIGHUP: graceful instance \u001b[01;31m\u001b[Krestart\u001b[m\u001b[K\r\nAssertion `ev_is_active(&\u001b[01;31m\u001b[Kchild\u001b[m\u001b[K->libevmess.w)' failed.\r\nAssertion `ev_is_active(&\u001b[01;31m\u001b[K