[356.600145, "o", "\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kback\u001b[m\u001b[Kend\r\nAssertion `g_atomic_int_get(&\u001b[01;31m\u001b[Klog\u001b[m\u001b[K_map->refcount) > 0' failed.\r\n\u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kging not \u001b[01;31m\u001b[Ksu\u001b[m\u001b[Kp\u001b[01;31m\u001b[Kport\u001b[m\u001b[Ked yet\r\ncould not \u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K to \u001b[01;31m\u001b[Klog\u001b[m\u001b[K '%s': %s\r\nAssertion `NULL == srv->\u001b[01;31m\u001b[Klog\u001b[m\u001b[Ks.\u001b[01;31m\u001b[Kthread\u001b[m\u001b[K' failed.\r\ncould not \u001b[01;31m\u001b[Kcreate\u001b[m\u001b[K \u001b[01;31m\u001b[Klog\u001b[m\u001b[Kging \u001b[01;31m\u001b[Kthread\u001b[m\u001b[K: %s\r\nli_\u001b[01;31m\u001b[Klog\u001b[m\u001b[K_\u001b[01;31m\u001b[Kthread\u001b[m\u001b[K_\u001b[01;31m\u001b[Kstart\u001b[m\u001b[K\r\nli_\u001b[01;31m\u001b[Klog\u001b[m\u001b[K_map_release\r\nli_\u001b[01;31m\u001b[Klog\u001b[m\u001b[K_map_acquire\r\nli_event_\u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\r\n"]
[356.600494, "o", "\u001b[01;31m\u001b[Klog\u001b[m\u001b[K_\u001b[01;31m\u001b[Kwatch\u001b[m\u001b[Ker_cb\r\ng-\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K-\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K-quark\r\n../src/main/\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K.c\r\nli_\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kread\u001b[m\u001b[K: fd should be disabled as chunk\u001b[01;31m\u001b[Kqueue\u001b[m\u001b[K is al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky full, aborting connection.\r\nAssertion `*\u001b[01;31m\u001b[Kbuffer\u001b[m\u001b[K == buf' failed.\r\nli_\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kread\u001b[m\u001b[K: oops, \u001b[01;31m\u001b[Kread\u001b[m\u001b[K from fd=%d failed: %s\r\nli_\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kread\u001b[m\u001b[K\r\nli_\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kback\u001b[m\u001b[Kend_\u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K: oops, \u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K to fd=%d failed: %s\r\nli_\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kback\u001b[m\u001b[Kend_\u001b[01;31m\u001b[Kwrite\u001b[m\u001b[Kv: oops, \u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K to fd=%d failed: %s\r\n"]
[356.600922, "o", "lighty_\u001b[01;31m\u001b[Ksend\u001b[m\u001b[K\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K(linux): oops, \u001b[01;31m\u001b[Kwrite\u001b[m\u001b[K to fd=%d failed: %s\r\n\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kback\u001b[m\u001b[Kend_\u001b[01;31m\u001b[Ksend\u001b[m\u001b[K\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K: Couldn't fstat \u001b[01;31m\u001b[Kfile\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[Knetwork\u001b[m\u001b[K_\u001b[01;31m\u001b[Kback\u001b[m\u001b[Kend_\u001b[01;31m\u001b[Ksend\u001b[m\u001b[K\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K: \u001b[01;31m\u001b[KFile\u001b[m\u001b[K shrank, aborting\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern, empty range %%[-]: \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern, empty range %%[]: \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern, range overflow: \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern, invalid range: \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern: \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern (invalid \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K): \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern (missing '}'): \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern (unknown condition lvalue): \"%s\"\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: could not \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K pattern (unexpected character after '%%'): \"%s\"\r\n(\u001b[01;31m\u001b[Kerror