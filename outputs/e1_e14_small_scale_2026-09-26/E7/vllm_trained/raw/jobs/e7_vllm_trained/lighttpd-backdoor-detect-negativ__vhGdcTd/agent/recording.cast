[282.475968, "o", "(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s doesn't take default \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Ks\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K option '%s' expects string as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K option '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K option '%s' expects non-negative number as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: unknown \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K option '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s: unknown method: %s\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s: digest \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Kentication not implemented yet\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Version mismatch for modules \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K: is %u, expected %u\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Compile flags mismatch: sizeof(off_t) is %u, expected %u\r\n\u001b[01;31m\u001b[Kauth\u001b[m\u001b[K_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K_data_release\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K_array\r\n"]
