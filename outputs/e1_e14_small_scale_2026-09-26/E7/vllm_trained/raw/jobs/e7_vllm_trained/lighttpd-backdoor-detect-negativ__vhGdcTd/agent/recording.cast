[282.972021, "o", "../src/modules/mod_v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.c\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: %s\r\n(\u001b[01;31m\u001b[Kwarn\u001b[m\u001b[King) %s:%d: %s\r\nmod_v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map_regex\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map_regex: \u001b[01;31m\u001b[Khost\u001b[m\u001b[K %s matches pattern \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map_regex: \u001b[01;31m\u001b[Khost\u001b[m\u001b[K %s didn't match, \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting default action\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map_regex: neither did %s match nor default action specified, doing nothing\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map: \u001b[01;31m\u001b[Khost\u001b[m\u001b[K %s found in hashtable\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map: \u001b[01;31m\u001b[Khost\u001b[m\u001b[K %s not found in hashtable, \u001b[01;31m\u001b[Kexec\u001b[m\u001b[Kuting default action\r\n"]
[282.972416, "o", "(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map: neither \u001b[01;31m\u001b[Khost\u001b[m\u001b[K %s found in hashtable nor default action specified, doing nothing\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map_regex expects a hashtable/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map_regex expects a hashtable/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list with action values as parameter, %s value given\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map_regex: found entry with string \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K \"default\". please convert the parameter to a \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list and use the \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword default instead.\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map_regex: al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky have a default action\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map_regex: \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K compiling regex \"%s\": %s\r\n"]
[282.973134, "o", "v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map expects a hashtable/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list as parameter\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map expects a hashtable/\u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list with action values as parameter, %s value given\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map: found entry with string \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K \"default\". please convert the parameter to a \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value list and use the \u001b[01;31m\u001b[Kkey\u001b[m\u001b[Kword default instead.\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map: al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky have a default action\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: v\u001b[01;31m\u001b[Khost\u001b[m\u001b[K.map: \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate entry for '%s'\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Version mismatch for modules \u001b[01;31m\u001b[Ksystem\u001b[m\u001b[K: is %u, expected %u\r\n(\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K) %s:%d: Compile flags mismatch: sizeof(off_t) is %u, expected %u\r\nv\u001b[01;31m\u001b[Khost\u001b[m\u001b[K_map_regex_\u001b[01;31m\u001b[Kcreate\u001b[m\u001b[K\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K\r\n"]
