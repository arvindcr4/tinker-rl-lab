[282.911994, "o", "\t\t<scr\u001b[01;31m\u001b[Kip\u001b[m\u001b[Kt type=\"text/javascr\u001b[01;31m\u001b[Kip\u001b[m\u001b[Kt\">\r\n\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K sort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K = 'asc';\r\n\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K prev_arrow = null;\r\n\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K prev_elem = null;\r\n\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K table = elem.parentNode.parentNode.parentNode.parentNode;\r\n\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K arrow = elem.parentNode.\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes[elem.parentNode.\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes.length - 1];\r\n\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K column = elem.parentNode.cellIndex;\r\n\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K rows = \u001b[01;31m\u001b[Knew\u001b[m\u001b[K Array();\r\n"]
[282.912309, "o", "\t\t\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K text_a = a.cells[column].\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes[index].innerHTML.toLowerCase();\r\n\t\t\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K text_b = b.cells[column].\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes[index].innerHTML.toLowerCase();\r\n\t\t\t\t\t\tif (text_a == text_b) \u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K 0;\r\n\t\t\t\t\t\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K (text_a < text_b) ? -1 : 1;\r\n\t\t\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K int_a = \u001b[01;31m\u001b[Kparse\u001b[m\u001b[KInt(a.cells[column].\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes[index].getAttribute('value'));\r\n\t\t\t\t\t\t\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K int_b = \u001b[01;31m\u001b[Kparse\u001b[m\u001b[KInt(b.cells[column].\u001b[01;31m\u001b[Kchild\u001b[m\u001b[KNodes[index].getAttribute('value'));\r\n\t\t\t\t\t\t\u001b[01;31m\u001b[Kreturn\u001b[m\u001b[K int_a - int_b;\r\n"]
[282.912688, "o", "\t\t\t\t\tsort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K = (sort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K == 'asc') ? 'desc' : 'asc';\r\n\t\t\t\t\tarrow.innerHTML = (sort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K == 'asc') ? '&darr;' : '&uarr;';\r\n\t\t\t\t\t\tsort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K = 'asc';\r\n\t\t\t\t\t\tsort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K = 'desc';\r\n\t\t\t\tif (sort_\u001b[01;31m\u001b[Kdir\u001b[m\u001b[K == 'desc')\r\n\t\t\t\t\trows.\u001b[01;31m\u001b[Kreverse\u001b[m\u001b[K();\r\n"]
