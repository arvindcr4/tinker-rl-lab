[219.396617, "o", "max_core_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K_size: al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky specified\r\n%s: al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky specified, can only be used once\r\nlua\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K: al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky specified \u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K: al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky specified lua\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[K: couldn't find \u001b[01;31m\u001b[Kgroup\u001b[m\u001b[K '%s' \r\n\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[K: will not changed to \u001b[01;31m\u001b[Kgid\u001b[m\u001b[K 0\r\n\u001b[01;31m\u001b[Kuser\u001b[m\u001b[K: couldn't find \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K '%s' \r\n\u001b[01;31m\u001b[Kuser\u001b[m\u001b[K: will not changed to \u001b[01;31m\u001b[Kuid\u001b[m\u001b[K 0\r\n\u001b[01;31m\u001b[Kuser\u001b[m\u001b[K: will not changed to \u001b[01;31m\u001b[Kgid\u001b[m\u001b[K 0\r\nallow_\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K: expecting string list as parameter\r\nallow_\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K: couldn't \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K \u001b[01;31m\u001b[Kaddr\u001b[m\u001b[Kess mask '%s'\r\n"]
[219.397017, "o", "env: expecting \u001b[01;31m\u001b[Kkey\u001b[m\u001b[K-value/string list as parameter\r\n/\u001b[01;31m\u001b[Kvar\u001b[m\u001b[K/\u001b[01;31m\u001b[Klog\u001b[m\u001b[K/lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd2/\r\n\u001b[01;31m\u001b[Ksu\u001b[m\u001b[Kspended\r\n\u001b[01;31m\u001b[Krun\u001b[m\u001b[Kning\r\n\u001b[01;31m\u001b[Ksu\u001b[m\u001b[Kspending\r\n--\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K\r\n/etc/lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd2/lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd.conf\r\n\u001b[01;31m\u001b[Klog\u001b[m\u001b[K-\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K-\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K SIGHUP\r\nInvalid \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[K \u001b[01;31m\u001b[Kaddr\u001b[m\u001b[Kess: '%s'\r\nCouldn't \u001b[01;31m\u001b[Klisten\u001b[m\u001b[K to '%s'\r\nCouldn't \u001b[01;31m\u001b[Kdup\u001b[m\u001b[Klicate fd\r\n../include/lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd/events.h\r\n\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[K (%s:%d): %s\r\nmax_\u001b[01;31m\u001b[Kopen\u001b[m\u001b[K_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[Ks\r\nmax_core_\u001b[01;31m\u001b[Kfile\u001b[m\u001b[K_size\r\nmodules_\u001b[01;31m\u001b[Kpath\u001b[m\u001b[K\r\nlua\u001b[01;31m\u001b[Kconfig\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[K\r\n"]
[219.397425, "o", "\u001b[01;31m\u001b[Kuser\u001b[m\u001b[K\r\nallow_\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K\r\nli_event_\u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\r\n\u001b[01;31m\u001b[Klisten\u001b[m\u001b[K_ref_release\r\n../src/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K_proc.c\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Kread\u001b[m\u001b[K \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K-\u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kexec\u001b[m\u001b[K('%s') failed: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K while trying to flush \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K-\u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: didn't see EOF. closing\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Couldn't \u001b[01;31m\u001b[Kcreate\u001b[m\u001b[K \u001b[01;31m\u001b[Kpipe\u001b[m\u001b[K: %s\r\nAssertion `!ev_is_active(&\u001b[01;31m\u001b[Kchild\u001b[m\u001b[K->libevmess.w)' failed.\r\nAssertion `!ev_is_active(&\u001b[01;31m\u001b[Kcheck\u001b[m\u001b[K->libevmess.w)' failed.\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): couldn't set 'max core \u001b[01;31m\u001b[Kfile\u001b[m\u001b[K size': %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): couldn't set 'max \u001b[01;31m\u001b[Kfile\u001b[m\u001b[Kdescr\u001b[01;31m\u001b[Kip\u001b[m\u001b[Ktors': %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Ksetgid\u001b[m\u001b[K(%i) failed: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): set\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[Ks failed: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Kinit\u001b[m\u001b[K\u001b[01;31m\u001b[Kgroup\u001b[m\u001b[Ks('%s', %i) failed: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Ksetuid\u001b[m\u001b[K(%i) failed: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Kfork\u001b[m\u001b[K failed: %s\r\nli_event_\u001b[01;31m\u001b[Kstart\u001b[m\u001b[K_\r\nli_event_\u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\r\n?../src/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K_server.c\r\n\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K SIGINT\r\n"]
[219.397823, "o", "\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K SIGTERM\r\n\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K SIG\u001b[01;31m\u001b[KPIPE\u001b[m\u001b[K\r\nlig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd2-\u001b[01;31m\u001b[Kworker\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Knew\u001b[m\u001b[Ki == oldi->replace_by\r\noldi == \u001b[01;31m\u001b[Knew\u001b[m\u001b[Ki->replace\r\n\u001b[01;31m\u001b[Ksu\u001b[m\u001b[Kspend\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Kangel\u001b[m\u001b[K \u001b[01;31m\u001b[Kconnect\u001b[m\u001b[Kion \u001b[01;31m\u001b[Kclose\u001b[m\u001b[Kd: %s\r\nPlugin '%s' not available in lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd-\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K (action '%s')\r\nAction '%s' not available in plugin '%s' of lig\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Kd-\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Can't handle notification from \u001b[01;31m\u001b[Kworker\u001b[m\u001b[K: %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): \u001b[01;31m\u001b[Ksocket\u001b[m\u001b[Kpair \u001b[01;31m\u001b[Kerror\u001b[m\u001b[K, cannot \u001b[01;31m\u001b[Kspawn\u001b[m\u001b[K instance: %s\r\n\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[K (%s:%d): instance[%i] \u001b[01;31m\u001b[Kspawn\u001b[m\u001b[Ked: %s\r\n\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K (%s:%d): instance[%i] released\r\n"]
[219.39834, "o", "\u001b[01;31m\u001b[Kinfo\u001b[m\u001b[K (%s:%d): instance[%i] replaced by instance[%i]\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): reaching state %i failed, killing instance:\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): Invalid destination state %i\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): set state %i failed, killing instance:\r\nAssertion `LI_EVT_\u001b[01;31m\u001b[KCHILD\u001b[m\u001b[K == base->type' failed.\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): instance[%i] died with exit \u001b[01;31m\u001b[Kstatus\u001b[m\u001b[K %i\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): instance[%i] died: killed by '%s' (%i)\r\n"]
[219.399335, "o", "\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): instance[%i] died with unexpected stat_val %i\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): instance[%i] died: killed by %s\r\n\u001b[01;31m\u001b[Kerror\u001b[m\u001b[K (%s:%d): instance[%i] \u001b[01;31m\u001b[Kspawn\u001b[m\u001b[King failed, not \u001b[01;31m\u001b[Krestart\u001b[m\u001b[King\r\nli_event_\u001b[01;31m\u001b[Kchild\u001b[m\u001b[K_from\r\nli_event_\u001b[01;31m\u001b[Kstop\u001b[m\u001b[K_\r\n../src/\u001b[01;31m\u001b[Kangel\u001b[m\u001b[K/../common/value_impl.c\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K\r\n.\u001b[01;31m\u001b[Kinit\u001b[m\u001b[K_array\r\n"]
