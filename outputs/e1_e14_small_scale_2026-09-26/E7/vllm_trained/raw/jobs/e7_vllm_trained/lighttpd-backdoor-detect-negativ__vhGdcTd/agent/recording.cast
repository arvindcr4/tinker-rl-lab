[282.475513, "o", "(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: Realm for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\" doesn't match\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KPassword\u001b[m\u001b[K digest \"%s\" doesn't match \"%s\" for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KPassword\u001b[m\u001b[K \"%s\" doesn't match \"%s\" for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KPassword\u001b[m\u001b[K apr-md5 crypt \"%s\" doesn't match \"%s\" for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KPassword\u001b[m\u001b[K apr-sha1 crypt \"%s\" doesn't match \"%s\" for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: Invalid \u001b[01;31m\u001b[Kpassword\u001b[m\u001b[K salt/hash \"%s\" for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: \u001b[01;31m\u001b[KPassword\u001b[m\u001b[K crypt \"%s\" doesn't match \"%s\" for \u001b[01;31m\u001b[Kuser\u001b[m\u001b[K \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: sk\u001b[01;31m\u001b[Kip\u001b[m\u001b[Kping \u001b[01;31m\u001b[Kauth\u001b[m\u001b[K.basic as request is al\u001b[01;31m\u001b[Kread\u001b[m\u001b[Ky handled with current \u001b[01;31m\u001b[Kstatus\u001b[m\u001b[K %i\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: requesting \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Korization from client for realm \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: couldn't \u001b[01;31m\u001b[Kparse\u001b[m\u001b[K \u001b[01;31m\u001b[Kauth\u001b[m\u001b[Korization \u001b[01;31m\u001b[Kinfo\u001b[m\u001b[K from client for realm \"%s\"\r\n(\u001b[01;31m\u001b[Kdebug\u001b[m\u001b[K) %s:%d: wrong \u001b[01;31m