# WARNING: benchmark hidden tests / answer keys and vendored repo source must stay out of git.
# Native datasets carry test_patch + FAIL_TO_PASS/PASS_TO_PASS (hidden tests)
*_native_dataset.jsonl
# Receipt tarballs duplicate the native logs below
*_native_receipts.tgz
# Native harness logs: eval.sh embeds the hidden test patch; test_output.txt echoes hidden tests
**/logs/run_evaluation/**/eval.sh
**/logs/run_evaluation/**/test_output.txt
# Vendored benchmark repo source (base-commit slices) and prompts that embed it
**/source_context.json
**/generation_request.json
# Local wandb run cache, venvs, bytecode
wandb/
.venv/
venv/
__pycache__/
*.pyc
# Secrets
.env
.env.*
*.key
