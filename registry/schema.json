{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tinker-rl-lab/grpo-registry/schema.json",
  "title": "GRPO-Registry record",
  "description": "A machine-readable catalog record for a group-relative RL (GRPO-family) training stack, or for a variant-delta (the set of changes a named GRPO variant makes to the base algorithm). Field convention: JSON null means UNREPORTED; explicit false / 0.0 / 'none' means reported-as-absent. The MIN-REPORT auditor scores reporting coverage, not configuration virtue.",
  "oneOf": [
    {
      "$ref": "#/$defs/stack_record"
    },
    {
      "$ref": "#/$defs/variant_delta_record"
    }
  ],
  "$defs": {
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullable_boolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullable_integer": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stack_record": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "label_claimed",
        "framework",
        "provenance",
        "min_report"
      ],
      "properties": {
        "record_type": {
          "const": "stack"
        },
        "schema_version": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "label_claimed": {
          "type": "string",
          "description": "The algorithm label the stack advertises (grpo, dapo, drgrpo, gspo, ...). The registry exists because this label underdetermines the update rule."
        },
        "framework": {
          "type": "object",
          "required": [
            "name",
            "openness"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/nullable_string"
            },
            "openness": {
              "enum": [
                "open",
                "managed",
                "closed"
              ]
            }
          }
        },
        "model": {
          "$ref": "#/$defs/nullable_string"
        },
        "task": {
          "$ref": "#/$defs/nullable_string"
        },
        "seeds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_artifacts"
          ],
          "properties": {
            "source_artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "wandb": {
              "$ref": "#/$defs/nullable_string"
            },
            "date_recorded": {
              "$ref": "#/$defs/nullable_string"
            }
          }
        },
        "variant_deltas_applied": {
          "type": "array",
          "description": "Per-delta implementation status against the named variant-delta records. This is where label flips become machine-readable.",
          "items": {
            "type": "object",
            "required": [
              "delta_id",
              "component",
              "status"
            ],
            "properties": {
              "delta_id": {
                "type": "string",
                "enum": [
                  "delta_adaptiveg",
                  "delta_aero",
                  "delta_areal",
                  "delta_cppo",
                  "delta_dapo",
                  "delta_drgrpo",
                  "delta_es",
                  "delta_gift",
                  "delta_gspo",
                  "delta_liteppo",
                  "delta_mcgrpo",
                  "delta_ngrpo",
                  "delta_reinforce",
                  "delta_scafgrpo"
                ],
                "description": "Must point to a registry/entries/delta_*.json record. Enum is regenerated by scripts/p5p8/regenerate_schema_delta_enum.py whenever a delta is added."
              },
              "component": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "implemented",
                  "surrogate",
                  "absent",
                  "unknown"
                ]
              },
              "note": {
                "$ref": "#/$defs/nullable_string"
              }
            }
          }
        },
        "min_report": {
          "$ref": "#/$defs/min_report"
        },
        "outcomes": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional telemetry summary (informational; not part of the badge).",
          "properties": {
            "mean_last10_train_reward": {
              "$ref": "#/$defs/nullable_number"
            },
            "mean_zvf": {
              "$ref": "#/$defs/nullable_number"
            },
            "heldout_delta": {
              "$ref": "#/$defs/nullable_number"
            },
            "rollouts": {
              "$ref": "#/$defs/nullable_integer"
            },
            "ci_method": {
              "$ref": "#/$defs/ci_method"
            },
            "coverage": {
              "type": [
                "object",
                "null"
              ],
              "description": "Iter-62: self-reported coverage of the entry's reporting blocks. All fields nullable; null = not yet audited. min_report_coverage is the fraction of7 MIN-REPORT items with at least one sub-field populated. declared_deltas_coverage is the fraction of variant_deltas_applied entries with status in {implemented, surrogate}. measured_coverage is variant: measured_rows / delta_components, or stack: outcomes_fields_populated / 5. ci_method_present mirrors outcomes.ci_method being non-null. audit_source is the script path that produced the block.",
              "properties": {
                "min_report_coverage": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "declared_deltas_coverage": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "measured_coverage": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ci_method_present": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "audit_source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "audit_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "zvf_antiherding": {
              "type": [
                "object",
                "null"
              ],
              "description": "Iter-66: Contrastive Yield (Y = 1 - ZVF) + anti-herding residual delta_div = ZVF_iid - ZVF_obs (frontier synthesis: Gemini Deep Think Round 2), measured on the N2 same-stack reward tensor corpus. All fields nullable. Y is the fraction of groups GRPO can still assign within-group credit to; delta_div >= 0 if sampling anti-herds. ci_method.source is the audit script that produced the block.",
              "properties": {
                "delta_div_mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "delta_div_lo": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "delta_div_hi": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "y_obs_mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "y_iid_mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "zvf_obs_mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "zvf_iid_mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "G": {
                  "$ref": "#/$defs/nullable_integer"
                },
                "panel": {
                  "$ref": "#/$defs/nullable_string"
                },
                "n_steps": {
                  "$ref": "#/$defs/nullable_integer"
                },
                "ci_method": {
                  "$ref": "#/$defs/ci_method"
                },
                "audit_source": {
                  "$ref": "#/$defs/nullable_string"
                },
                "audit_date": {
                  "$ref": "#/$defs/nullable_string"
                }
              },
              "additionalProperties": false
            },
            "controller_predicted_savings_per_rollout": {
              "type": [
                "object",
                "null"
              ],
              "description": "Iter-70: per-(method \u00d7 trigger \u00d7 threshold) controller savings predictions for the iter-51 adaptive-G controller on this stack. All fields nullable; null = not yet audited. Sourced from iter-67 p7_antiherding_controller_cf_summary.tsv.",
              "properties": {
                "panel": {
                  "$ref": "#/$defs/nullable_string"
                },
                "G": {
                  "$ref": "#/$defs/nullable_integer"
                },
                "n_steps": {
                  "$ref": "#/$defs/nullable_integer"
                },
                "audit_source": {
                  "$ref": "#/$defs/nullable_string"
                },
                "audit_date": {
                  "$ref": "#/$defs/nullable_string"
                },
                "predictions": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "description": "Per-(trigger, threshold) controller prediction. Each element: trigger (str), threshold (num), fires/saved/missed (int), saved_per_fire (num), savings_per_rollout_pt/lo/hi (num, bootstrap percentile), cost_ratio_pt (num). Source: iter-67 p7_antiherding_controller_cf_summary.tsv.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "trigger": {
                        "type": "string"
                      },
                      "threshold": {
                        "type": "number"
                      },
                      "fires": {
                        "type": "integer"
                      },
                      "saved": {
                        "type": "integer"
                      },
                      "missed": {
                        "type": "integer"
                      },
                      "saved_per_fire": {
                        "type": "number"
                      },
                      "savings_per_rollout_pt": {
                        "type": "number"
                      },
                      "savings_per_rollout_lo": {
                        "type": "number"
                      },
                      "savings_per_rollout_hi": {
                        "type": "number"
                      },
                      "cost_ratio_pt": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      },
      "additionalProperties": false
    },
    "min_report": {
      "type": "object",
      "description": "The seven-item minimum reportable stack (MIN-REPORT-RL).",
      "required": [
        "loss_form",
        "reference_kl",
        "sampler_backend",
        "telemetry",
        "group_size_schedule",
        "heldout_split",
        "decontamination"
      ],
      "properties": {
        "loss_form": {
          "type": "object",
          "description": "Item 1: ratio/clip/token mask/advantage normalization.",
          "properties": {
            "importance_ratio_level": {
              "enum": [
                "token",
                "sequence",
                null
              ]
            },
            "clip_eps_low": {
              "$ref": "#/$defs/nullable_number"
            },
            "clip_eps_high": {
              "$ref": "#/$defs/nullable_number"
            },
            "length_normalization": {
              "$ref": "#/$defs/nullable_boolean"
            },
            "advantage_normalization": {
              "enum": [
                "std",
                "none",
                null
              ]
            },
            "token_mask": {
              "$ref": "#/$defs/nullable_string"
            },
            "token_aggregation": {
              "$ref": "#/$defs/nullable_string",
              "description": "Iter-32 extension: aggregation level for the token-level loss; \"token\" for DAPO, \"sequence\" for GSPO."
            },
            "reward_shaping_type": {
              "$ref": "#/$defs/nullable_string",
              "description": "Iter-32 extension: type of reward shaping (e.g. overlong_penalty for DAPO, gamma_baseline for GIFT)."
            },
            "sampling_dynamic_filter": {
              "$ref": "#/$defs/nullable_boolean",
              "description": "Iter-32 extension: whether the sampler applies dynamic filtering (e.g. DAPO dynamic_sampling)."
            }
          },
          "required": [
            "importance_ratio_level",
            "clip_eps_low",
            "clip_eps_high",
            "length_normalization",
            "advantage_normalization",
            "token_mask"
          ]
        },
        "reference_kl": {
          "type": "object",
          "description": "Item 2: reference policy + KL handling.",
          "properties": {
            "reference_policy": {
              "$ref": "#/$defs/nullable_boolean"
            },
            "kl_beta": {
              "$ref": "#/$defs/nullable_number"
            },
            "kl_estimator": {
              "$ref": "#/$defs/nullable_string"
            }
          },
          "required": [
            "reference_policy",
            "kl_beta",
            "kl_estimator"
          ]
        },
        "sampler_backend": {
          "type": "object",
          "description": "Item 3: sampler / backend / precision.",
          "properties": {
            "backend": {
              "$ref": "#/$defs/nullable_string"
            },
            "precision": {
              "$ref": "#/$defs/nullable_string"
            },
            "temperature": {
              "$ref": "#/$defs/nullable_number"
            },
            "top_p": {
              "$ref": "#/$defs/nullable_number"
            }
          },
          "required": [
            "backend",
            "precision",
            "temperature",
            "top_p"
          ]
        },
        "telemetry": {
          "type": "object",
          "description": "Item 4: per-step ZVF / gradient-utilization trajectory.",
          "properties": {
            "per_step_zvf": {
              "$ref": "#/$defs/nullable_boolean"
            },
            "per_step_gu": {
              "$ref": "#/$defs/nullable_boolean"
            },
            "source": {
              "$ref": "#/$defs/nullable_string"
            }
          },
          "required": [
            "per_step_zvf",
            "per_step_gu",
            "source"
          ]
        },
        "group_size_schedule": {
          "type": "object",
          "description": "Item 5: group-size schedule.",
          "properties": {
            "initial_g": {
              "$ref": "#/$defs/nullable_integer"
            },
            "schedule": {
              "enum": [
                "fixed",
                "adaptive",
                null
              ]
            },
            "adaptation_rule": {
              "$ref": "#/$defs/nullable_string"
            }
          },
          "required": [
            "initial_g",
            "schedule",
            "adaptation_rule"
          ]
        },
        "heldout_split": {
          "type": "object",
          "description": "Item 6: held-out split disjoint from the reward environment.",
          "properties": {
            "disjoint_from_reward_env": {
              "$ref": "#/$defs/nullable_boolean"
            },
            "description": {
              "$ref": "#/$defs/nullable_string"
            }
          },
          "required": [
            "disjoint_from_reward_env",
            "description"
          ]
        },
        "decontamination": {
          "type": "object",
          "description": "Item 7: decontamination + parser-robustness probe.",
          "properties": {
            "performed": {
              "$ref": "#/$defs/nullable_boolean"
            },
            "parser_robustness_probe": {
              "$ref": "#/$defs/nullable_boolean"
            }
          },
          "required": [
            "performed",
            "parser_robustness_probe"
          ]
        }
      },
      "additionalProperties": false
    },
    "variant_delta_record": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "name",
        "base",
        "deltas",
        "citation"
      ],
      "properties": {
        "record_type": {
          "const": "variant_delta"
        },
        "schema_version": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Same pattern as the stack_record; the schema was missing this check on the variant-delta side (iter 26 stress test)."
        },
        "name": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "citation": {
          "type": "object",
          "properties": {
            "bibkey": {
              "type": "string"
            },
            "arxiv": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "deltas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "component",
              "field",
              "change"
            ],
            "properties": {
              "component": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "change": {
                "type": "string"
              }
            }
          }
        },
        "measured": {
          "type": [
            "array",
            "null"
          ],
          "description": "Iter-34 extension (additive, optional): measured effect of this variant vs its base on a named, provenanced panel. Each element is a single (metric x panel) delta with a bootstrap/normal-approx CI. null / absent = unmeasured. This is the first block that grounds a variant_delta record in what the technique measurably does, not just what it claims to change.",
          "items": {
            "$ref": "#/$defs/measured_delta"
          }
        },
        "expected_effects": {
          "type": [
            "array",
            "null"
          ],
          "description": "Iter-46 extension (additive, optional): a forward-referenced per-(metric, panel) tuple of {predicted_sign, rationale} that the human-readable change text implies. Entries without this block are still audited -- the audit verdict is UNCLAIMED for the (metric, panel) pairs that lack a declared prediction. This block is the human-supplied input; the audit's claim_validation block (below) is the matching machine-generated output.",
          "items": {
            "$ref": "#/$defs/expected_effect"
          }
        },
        "claim_validation": {
          "type": [
            "array",
            "null"
          ],
          "description": "Iter-46 extension (additive, optional): machine-generated audit of the (measured, expected) pair per (metric, panel). Each element is a single (metric x panel) verdict: SUPPORTS / NEUTRAL / CONTRADICTS / UNCLAIMED, with the matching CI and a one-line rationale. This is the machine output that grounds a registry entry in 'what the change text claims' AND 'what was measured'.",
          "items": {
            "$ref": "#/$defs/claim_validation_row"
          }
        },
        "measured_yield_residual": {
          "type": [
            "object",
            "null"
          ],
          "description": "Iter-66: Contrastive-Yield residual (frontier synthesis: Gemini Deep Think Round 2) for this variant vs its declared base. delta_div_delta = (delta_div in variant) - (delta_div in base); negative means the variant reduces the structural diversity bonus, i.e. its sampling policy herds more than GRPO's. y_obs_delta is the same comparison on the Contrastive Yield axis (positive = more within-group credit available). All fields nullable; null = not yet audited.",
          "properties": {
            "delta_div_delta": {
              "type": [
                "number",
                "null"
              ]
            },
            "delta_div_lo": {
              "type": [
                "number",
                "null"
              ]
            },
            "delta_div_hi": {
              "type": [
                "number",
                "null"
              ]
            },
            "y_obs_delta": {
              "type": [
                "number",
                "null"
              ]
            },
            "y_obs_variant": {
              "type": [
                "number",
                "null"
              ]
            },
            "y_obs_base": {
              "type": [
                "number",
                "null"
              ]
            },
            "G": {
              "$ref": "#/$defs/nullable_integer"
            },
            "panel": {
              "$ref": "#/$defs/nullable_string"
            },
            "n_steps": {
              "$ref": "#/$defs/nullable_integer"
            },
            "significant": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "p_two_sided": {
              "type": [
                "number",
                "null"
              ]
            },
            "ci_method": {
              "$ref": "#/$defs/ci_method"
            },
            "audit_source": {
              "$ref": "#/$defs/nullable_string"
            },
            "audit_date": {
              "$ref": "#/$defs/nullable_string"
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        },
        "controller_predicted_savings_per_rollout": {
          "type": [
            "object",
            "null"
          ],
          "description": "Iter-70: per-(trigger \u00d7 threshold) controller savings predictions for the variant on the N2 same-stack corpus. Inherits from the variant's measured method; predictions carry the iter-67 saved_per_fire and savings_per_rollout paired-bootstrap estimates.",
          "properties": {
            "panel": {
              "$ref": "#/$defs/nullable_string"
            },
            "G": {
              "$ref": "#/$defs/nullable_integer"
            },
            "n_steps": {
              "$ref": "#/$defs/nullable_integer"
            },
            "audit_source": {
              "$ref": "#/$defs/nullable_string"
            },
            "audit_date": {
              "$ref": "#/$defs/nullable_string"
            },
            "predictions": {
              "type": [
                "array",
                "null"
              ],
              "description": "Per-(trigger, threshold) controller prediction. Each element: trigger (str), threshold (num), fires/saved/missed (int), saved_per_fire (num), savings_per_rollout_pt/lo/hi (num, bootstrap percentile), cost_ratio_pt (num). Source: iter-67 p7_antiherding_controller_cf_summary.tsv.",
              "items": {
                "type": "object",
                "properties": {
                  "trigger": {
                    "type": "string"
                  },
                  "threshold": {
                    "type": "number"
                  },
                  "fires": {
                    "type": "integer"
                  },
                  "saved": {
                    "type": "integer"
                  },
                  "missed": {
                    "type": "integer"
                  },
                  "saved_per_fire": {
                    "type": "number"
                  },
                  "savings_per_rollout_pt": {
                    "type": "number"
                  },
                  "savings_per_rollout_lo": {
                    "type": "number"
                  },
                  "savings_per_rollout_hi": {
                    "type": "number"
                  },
                  "cost_ratio_pt": {
                    "type": "number"
                  },
                  "net_saves": {
                    "$ref": "#/$defs/nullable_integer"
                  },
                  "n_contrast_prompts": {
                    "$ref": "#/$defs/nullable_integer"
                  },
                  "n_fired_steps": {
                    "$ref": "#/$defs/nullable_integer"
                  },
                  "n_zvf_saved": {
                    "$ref": "#/$defs/nullable_integer"
                  },
                  "n_rollout_saves": {
                    "$ref": "#/$defs/nullable_integer"
                  },
                  "g_total": {
                    "$ref": "#/$defs/nullable_integer"
                  },
                  "source_iter": {
                    "$ref": "#/$defs/nullable_string"
                  }
                },
                "additionalProperties": false
              }
            },
            "joint_controller": {
              "type": [
                "object",
                "null"
              ],
              "description": "Iter-76 (P5P8 SYNTH / JOB B): cost-adjusted joint-controller predictions per method x tau (extension of iter-70 row 82 block; pairs with iter-72 row 85 joint_controller.py outputs).",
              "properties": {
                "panel": {
                  "$ref": "#/$defs/nullable_string"
                },
                "predictions": {
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "audit_source": {
                  "$ref": "#/$defs/nullable_string"
                },
                "audit_date": {
                  "$ref": "#/$defs/nullable_string"
                },
                "ci_method": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "measured_delta": {
      "type": "object",
      "required": [
        "metric",
        "panel",
        "base",
        "delta",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "description": "Measured quantity, e.g. zvf, reward_mean, zvf_risk_mean, mean_zvf."
        },
        "panel": {
          "type": "string",
          "description": "The measurement panel, e.g. n2_same_stack_last10 or zvf130_5seed."
        },
        "base": {
          "type": "string",
          "description": "Base stack the delta is computed against (must match the record's `base`)."
        },
        "delta": {
          "$ref": "#/$defs/nullable_number",
          "description": "variant minus base (signed). Null = unmeasured (backfilled point, see synth_from_agg)."
        },
        "ci_low": {
          "$ref": "#/$defs/nullable_number"
        },
        "ci_high": {
          "$ref": "#/$defs/nullable_number"
        },
        "n": {
          "$ref": "#/$defs/nullable_integer"
        },
        "significant": {
          "$ref": "#/$defs/nullable_boolean",
          "description": "True iff the CI excludes 0; null = CI is degenerate (point estimate, see synth_from_agg)."
        },
        "ci_method": {
          "$ref": "#/$defs/ci_method"
        },
        "source": {
          "type": "string",
          "description": "Relative path to the artifact the delta was computed from."
        },
        "note": {
          "$ref": "#/$defs/nullable_string"
        },
        "window_sensitivity": {
          "type": "string",
          "enum": [
            "STABLE",
            "STABLE-DIRECTION-MAG-SHIFT",
            "FRAGILE-SIGN-FLIP"
          ],
          "description": "iter-84: window-sensitivity verdict of this (metric, panel) row under remeasurement on full40 / last10 / last5 (paired bootstrap B=2000, seed 20260705); see docs/p5p8_improvements/97_p6_n2_window_sensitivity.md."
        },
        "robust_panel": {
          "type": "string",
          "enum": [
            "full40",
            "last20",
            "last10",
            "last5",
            "none"
          ],
          "description": "iter-84: largest-window panel at which the same-sign significance holds; 'none' if no panel is significant."
        },
        "welch_ci_low": {
          "$ref": "#/$defs/nullable_number"
        },
        "welch_ci_high": {
          "$ref": "#/$defs/nullable_number"
        },
        "welch_sig": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "sig_robust_bootstrap_and_welch": {
          "$ref": "#/$defs/nullable_boolean",
          "description": "iter102: significance survives BOTH the paired Gaussian-residual bootstrap AND a conservative Welch two-sample t-test on the 5-seed risk index. Guards against optimistic single-method significance."
        },
        "sig_robust_note": {
          "$ref": "#/$defs/nullable_string"
        },
        "synth_from_agg": {
          "$ref": "#/$defs/nullable_boolean",
          "description": "iter-122: True if this row was synthesized from an aggregate (point) statistic rather than per-seed data; CI is then not meaningful. Set by scripts/p5p8/p6_iter118_zvf130_deltas_backfill.py when backfilling from mag_mean / mean_zvf aggregates whose per-seed sd was not stored."
        }
      }
    },
    "expected_effect": {
      "type": "object",
      "description": "Iter-46: human-supplied forward reference -- the predicted sign the change text implies for one (metric, panel) pair. The audit's claim_validation row for the same (metric, panel) either supports, is neutral, or contradicts this prediction.",
      "required": [
        "metric",
        "panel",
        "predicted_sign",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "panel": {
          "type": "string"
        },
        "predicted_sign": {
          "enum": [
            ">0",
            "<0",
            ">=0",
            "<=0",
            "=0"
          ],
          "description": "Operator string: '>0' = measured delta should be positive, '<0' = negative, '>=0' / '<=0' allow the boundary, '=0' = exact zero expected."
        },
        "rationale": {
          "type": "string",
          "description": "One-sentence justification of the predicted sign, citing the change text's clause."
        }
      }
    },
    "claim_validation_row": {
      "type": "object",
      "description": "Iter-46: machine-generated audit row matching one (metric, panel) measured entry against the declared expected_effect (if any).",
      "required": [
        "metric",
        "panel",
        "observed_delta",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "panel": {
          "type": "string"
        },
        "predicted_sign": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_delta": {
          "$ref": "#/$defs/nullable_number"
        },
        "ci_low": {
          "$ref": "#/$defs/nullable_number"
        },
        "ci_high": {
          "$ref": "#/$defs/nullable_number"
        },
        "significant": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "verdict": {
          "enum": [
            "SUPPORTS",
            "NEUTRAL",
            "CONTRADICTS",
            "UNCLAIMED"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "audit_source": {
          "$ref": "#/$defs/nullable_string",
          "description": "iter-122: audit-script path that produced this row, e.g. 'scripts/p5p8/p6_iter118_zvf130_deltas_backfill.py'. Optional; absent for human-written entries."
        },
        "audit_date": {
          "$ref": "#/$defs/nullable_string",
          "description": "iter-122: ISO date the audit script produced this row, e.g. '2026-07-05'. Optional."
        },
        "synth_from_agg": {
          "$ref": "#/$defs/nullable_boolean",
          "description": "iter-122: True if this row was synthesized from an aggregate (point) statistic rather than per-seed data. CI is then not meaningful. Set true by scripts/p5p8/p6_iter118_zvf130_deltas_backfill.py when it backfills a measured row from mag_mean / mean_zvf aggregates whose per-seed sd was not stored."
        }
      }
    },
    "ci_method": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional self-reported provenance of the confidence interval on this entry's outcomes/deltas (added iter 28, backward-compatible optional field). null = unreported.",
      "properties": {
        "method": {
          "$ref": "#/$defs/nullable_string"
        },
        "n_boot": {
          "$ref": "#/$defs/nullable_integer"
        },
        "seed": {
          "$ref": "#/$defs/nullable_integer"
        },
        "ci_level": {
          "$ref": "#/$defs/nullable_number"
        },
        "source": {
          "$ref": "#/$defs/nullable_string"
        }
      },
      "additionalProperties": false
    }
  }
