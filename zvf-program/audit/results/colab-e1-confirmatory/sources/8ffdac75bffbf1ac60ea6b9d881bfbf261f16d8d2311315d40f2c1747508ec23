#!/usr/bin/env python3
"""Run one resumable Qwen3-8B/GSM8K E1 GRPO arm/seed unit on Colab.

The launcher supplies credentials out of band.  This script logs every
optimizer step to W&B, synchronously uploads every Trainer
checkpoint to a private Hugging Face repository, restores the greatest valid
remote checkpoint on retry, performs the locked held-out evaluation, and emits
one machine-readable ``E1_RESULT`` line.
"""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
from importlib import metadata
import json
import math
import os
from pathlib import Path
import re
import statistics
import tempfile
import time
from typing import Any


MODEL_ID = "Qwen/Qwen3-8B"
MODEL_REVISION = "b968826d9c46dd6066d109eabc6255188de91218"
DATASET_ID = "openai/gsm8k"
DATASET_REVISION = "740312add88f781978c0658806c59bc2815b9866"
TREATMENT_CHANGES = {"grpo": []}


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--arm", choices=tuple(TREATMENT_CHANGES), default="grpo")
    parser.add_argument("--seed", type=int, required=True)
    parser.add_argument("--mode", choices=("preflight", "confirmatory"), required=True)
    parser.add_argument("--max-steps", type=int, required=True)
    parser.add_argument("--heldout-n", type=int, required=True)
    parser.add_argument("--max-completion-length", type=int, default=1024)
    parser.add_argument("--save-steps", type=int, default=5)
    parser.add_argument("--unit-fingerprint", required=True)
    parser.add_argument("--stack-fingerprint", required=True)
    parser.add_argument("--hf-repo", required=True)
    parser.add_argument("--wandb-project", required=True)
    parser.add_argument("--wandb-entity")
    parser.add_argument("--wandb-group", required=True)
    parser.add_argument("--wandb-run-name", required=True)
    parser.add_argument("--eval-batch-size", type=int, default=8)
    return parser.parse_args(argv)


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def canonical_hash(payload: dict[str, Any]) -> str:
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def parse_marked_integer(text: str) -> int | None:
    """Return the first integer after the final GSM8K ``####`` marker."""
    if "####" not in text:
        return None
    tail = text.rsplit("####", 1)[1]
    match = re.search(r"-?\d[\d,]*", tail)
    if not match:
        return None
    try:
        return int(match.group(0).replace(",", ""))
    except ValueError:
        return None


def completion_text(completion: Any) -> str:
    if isinstance(completion, str):
        return completion
    if isinstance(completion, list) and completion:
        last = completion[-1]
        if isinstance(last, dict):
            return str(last.get("content", ""))
    if isinstance(completion, dict):
        return str(completion.get("content", ""))
    return str(completion)


def gsm8k_exact_reward(completions: list[Any], answer: list[str], **_: Any) -> list[float]:
    rewards: list[float] = []
    for completion, gold in zip(completions, answer, strict=True):
        prediction = parse_marked_integer(completion_text(completion))
        target = parse_marked_integer(gold)
        rewards.append(float(prediction is not None and prediction == target))
    return rewards


def require_environment() -> None:
    missing = [key for key in ("HF_TOKEN", "WANDB_API_KEY") if not os.environ.get(key)]
    if missing:
        raise SystemExit("missing required secret environment: " + ", ".join(missing))


def configure_tracking(args: argparse.Namespace) -> None:
    os.environ.update(
        {
            "WANDB_PROJECT": args.wandb_project,
            "WANDB_GROUP": args.wandb_group,
            "WANDB_NAME": args.wandb_run_name,
            "WANDB_RUN_ID": args.unit_fingerprint[:8],
            "WANDB_RESUME": "allow",
            "WANDB_JOB_TYPE": args.arm,
            "WANDB_TAGS": f"colab,e1,{args.mode},{args.arm},qwen3-8b,gsm8k",
            "WANDB_MODE": "online",
            "WANDB_SILENT": "true",
            "HF_HUB_ENABLE_HF_TRANSFER": "0",
            "TOKENIZERS_PARALLELISM": "false",
        }
    )
    if args.wandb_entity:
        os.environ["WANDB_ENTITY"] = args.wandb_entity


def prompt_for(question: str) -> list[dict[str, str]]:
    return [
        {
            "role": "user",
            "content": (
                "Solve this math problem. Show your reasoning, then end your response "
                "with exactly `#### <integer>`.\n\n" + question
            ),
        }
    ]


def package_versions(torch_module: Any) -> dict[str, Any]:
    names = ("trl", "transformers", "datasets", "peft", "torchao", "wandb", "huggingface_hub")
    versions = {}
    for name in names:
        try:
            versions[name] = metadata.version(name)
        except metadata.PackageNotFoundError:
            versions[name] = "missing"
    versions.update(
        {
            "torch": torch_module.__version__,
            "cuda": torch_module.version.cuda,
            "gpu": torch_module.cuda.get_device_name(0) if torch_module.cuda.is_available() else "none",
        }
    )
    return versions


def metric_series(history: list[dict[str, Any]], *names: str) -> list[float]:
    values: list[float] = []
    for record in history:
        value = next((record[name] for name in names if name in record), None)
        if isinstance(value, (int, float)) and math.isfinite(value):
            values.append(float(value))
    return values


def greatest_remote_checkpoint(api: Any, repo_id: str) -> tuple[int, str] | None:
    try:
        files = api.list_repo_files(repo_id=repo_id, repo_type="model")
    except Exception as exc:  # The repo normally does not exist on the first attempt.
        if type(exc).__name__ in {"RepositoryNotFoundError", "HfHubHTTPError"}:
            return None
        raise
    checkpoints: dict[int, str] = {}
    pattern = re.compile(r"^checkpoints/(checkpoint-(\d+))/trainer_state\.json$")
    for filename in files:
        match = pattern.match(filename)
        if match:
            checkpoints[int(match.group(2))] = match.group(1)
    if not checkpoints:
        return None
    step = max(checkpoints)
    return step, f"checkpoints/{checkpoints[step]}"


def download_resume_checkpoint(api: Any, repo_id: str, root: Path) -> tuple[int, Path] | None:
    remote = greatest_remote_checkpoint(api, repo_id)
    if remote is None:
        return None
    from huggingface_hub import snapshot_download

    step, prefix = remote
    snapshot_download(
        repo_id=repo_id,
        repo_type="model",
        local_dir=root,
        allow_patterns=[f"{prefix}/*", f"{prefix}/**"],
        token=os.environ["HF_TOKEN"],
    )
    checkpoint = root / prefix
    if not (checkpoint / "trainer_state.json").is_file():
        raise RuntimeError(f"downloaded checkpoint is incomplete: {checkpoint}")
    return step, checkpoint


def remote_checkpoint_steps(api: Any, repo_id: str) -> list[int]:
    try:
        files = api.list_repo_files(repo_id=repo_id, repo_type="model")
    except Exception:
        return []
    pattern = re.compile(r"^checkpoints/checkpoint-(\d+)/trainer_state\.json$")
    return sorted({int(match.group(1)) for name in files if (match := pattern.match(name))})


def heldout_accuracy(
    model: Any,
    tokenizer: Any,
    rows: Any,
    *,
    batch_size: int,
    max_new_tokens: int,
    torch_module: Any,
) -> tuple[float, list[dict[str, Any]]]:
    model.eval()
    correct = 0
    trace: list[dict[str, Any]] = []
    for start in range(0, len(rows), batch_size):
        batch = rows.select(range(start, min(start + batch_size, len(rows))))
        prompts = [
            tokenizer.apply_chat_template(
                prompt_for(question),
                tokenize=False,
                add_generation_prompt=True,
                enable_thinking=True,
            )
            for question in batch["question"]
        ]
        encoded = tokenizer(prompts, return_tensors="pt", padding=True).to(model.device)
        with torch_module.inference_mode():
            generated = model.generate(
                **encoded,
                do_sample=False,
                max_new_tokens=max_new_tokens,
                pad_token_id=tokenizer.pad_token_id,
                use_cache=True,
                cache_implementation="dynamic",
            )
        completion_ids = generated[:, encoded.input_ids.shape[1] :]
        completions = tokenizer.batch_decode(completion_ids, skip_special_tokens=True)
        for offset, (text, gold) in enumerate(zip(completions, batch["answer"], strict=True)):
            prediction = parse_marked_integer(text)
            target = parse_marked_integer(gold)
            is_correct = prediction is not None and prediction == target
            correct += int(is_correct)
            trace.append(
                {
                    "index": start + offset,
                    "prediction": prediction,
                    "target": target,
                    "correct": is_correct,
                    "completion_sha256": hashlib.sha256(text.encode()).hexdigest(),
                }
            )
        print(f"[eval] {min(start + batch_size, len(rows))}/{len(rows)}", flush=True)
    return correct / len(rows), trace


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    require_environment()
    configure_tracking(args)
    if args.mode == "confirmatory" and (args.max_steps != 30 or args.heldout_n != 500):
        raise SystemExit("confirmatory mode requires max_steps=30 and heldout_n=500")
    if args.max_steps <= 0 or args.heldout_n <= 0 or args.save_steps <= 0:
        raise SystemExit("steps, heldout size, and save cadence must be positive")

    import torch
    from datasets import load_dataset
    from huggingface_hub import HfApi
    from peft import LoraConfig
    from transformers import AutoTokenizer, TrainerCallback
    from trl import GRPOConfig, GRPOTrainer
    import wandb

    if not torch.cuda.is_available() or not torch.cuda.is_bf16_supported():
        raise RuntimeError("E1 requires a CUDA accelerator with bfloat16 support")

    api = HfApi(token=os.environ["HF_TOKEN"])
    api.create_repo(repo_id=args.hf_repo, repo_type="model", private=True, exist_ok=True)
    runtime_versions = package_versions(torch)
    started_at = utc_now()
    wall_start = time.monotonic()

    dataset = load_dataset(
        DATASET_ID,
        "main",
        revision=DATASET_REVISION,
        trust_remote_code=False,
    )
    train_dataset = dataset["train"].map(lambda row: {"prompt": prompt_for(row["question"])})
    heldout = dataset["test"].select(range(args.heldout_n))

    tokenizer = AutoTokenizer.from_pretrained(MODEL_ID, revision=MODEL_REVISION)
    tokenizer.padding_side = "left"
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    output_dir = Path("/content/e1-output")
    resume_root = Path("/content/e1-resume")
    resume = download_resume_checkpoint(api, args.hf_repo, resume_root)
    resume_step = resume[0] if resume else 0
    resume_path = str(resume[1]) if resume else None
    if resume:
        print(f"[resume] remote checkpoint step={resume_step} path={resume_path}", flush=True)

    class HubCheckpointCallback(TrainerCallback):
        def on_save(self, training_args: Any, state: Any, control: Any, **_: Any) -> Any:
            checkpoint = Path(training_args.output_dir) / f"checkpoint-{state.global_step}"
            required = checkpoint / "trainer_state.json"
            if not required.is_file():
                raise RuntimeError(f"Trainer checkpoint is incomplete at on_save: {checkpoint}")
            commit = api.upload_folder(
                repo_id=args.hf_repo,
                repo_type="model",
                folder_path=checkpoint,
                path_in_repo=f"checkpoints/{checkpoint.name}",
                commit_message=f"E1 {args.mode} {args.arm} seed {args.seed} step {state.global_step}",
            )
            print(f"[hf-checkpoint] step={state.global_step} commit={commit.oid}", flush=True)
            return control

    save_steps = 1 if args.mode == "preflight" else args.save_steps
    training_args = GRPOConfig(
        output_dir=str(output_dir),
        run_name=args.wandb_run_name,
        report_to=["wandb"],
        model_init_kwargs={
            "revision": MODEL_REVISION,
            "dtype": "bfloat16",
            "attn_implementation": "sdpa",
        },
        per_device_train_batch_size=4,
        gradient_accumulation_steps=4,
        generation_batch_size=16,
        num_generations=4,
        max_steps=args.max_steps,
        max_completion_length=args.max_completion_length,
        learning_rate=1e-6,
        lr_scheduler_type="linear",
        warmup_steps=0,
        optim="adamw_torch_fused",
        weight_decay=0.0,
        max_grad_norm=1.0,
        bf16=True,
        tf32=True,
        gradient_checkpointing=True,
        gradient_checkpointing_kwargs={"use_reentrant": False},
        use_cache=False,
        temperature=1.0,
        top_p=1.0,
        top_k=0,
        chat_template_kwargs={"enable_thinking": True},
        beta=0.0,
        num_iterations=1,
        epsilon=0.2,
        epsilon_high=0.2,
        importance_sampling_level="token",
        scale_rewards="group",
        loss_type="grpo",
        mask_truncated_completions=False,
        logging_strategy="steps",
        logging_steps=1,
        logging_first_step=True,
        save_strategy="steps",
        save_steps=save_steps,
        save_total_limit=None,
        push_to_hub=False,
        seed=args.seed,
        data_seed=args.seed,
        shuffle_dataset=True,
        remove_unused_columns=False,
        disable_tqdm=False,
    )
    peft_config = LoraConfig(
        r=16,
        lora_alpha=32,
        lora_dropout=0.0,
        target_modules="all-linear",
        task_type="CAUSAL_LM",
        bias="none",
    )
    trainer = GRPOTrainer(
        model=MODEL_ID,
        args=training_args,
        train_dataset=train_dataset,
        reward_funcs=gsm8k_exact_reward,
        processing_class=tokenizer,
        peft_config=peft_config,
        callbacks=[HubCheckpointCallback()],
    )

    try:
        trainer.train(resume_from_checkpoint=resume_path)
        history = trainer.state.log_history
        rewards = metric_series(history, "reward", "train/reward")
        zvf = metric_series(history, "frac_reward_zero_std", "train/frac_reward_zero_std")
        if not rewards or not zvf:
            raise RuntimeError(
                "required GRPO telemetry missing from Trainer history: "
                f"reward={len(rewards)} zvf={len(zvf)} keys={sorted({key for row in history for key in row})}"
            )

        # GRPO training disables the KV cache for gradient checkpointing.  A
        # generation kwarg alone does not reliably override that model-level
        # state, and can make the long held-out pass pathologically slow.
        trainer.model.gradient_checkpointing_disable()
        trainer.model.config.use_cache = True
        trainer.model.generation_config.use_cache = True
        torch.cuda.empty_cache()
        heldout_score, heldout_trace = heldout_accuracy(
            trainer.model,
            tokenizer,
            heldout,
            batch_size=args.eval_batch_size,
            max_new_tokens=args.max_completion_length,
            torch_module=torch,
        )
        first_five_reward = statistics.fmean(rewards[:5])
        first_five_zvf = statistics.fmean(zvf[:5])
        mean_zvf = statistics.fmean(zvf)
        wall_clock_seconds = time.monotonic() - wall_start
        wandb_run = wandb.run
        if wandb_run is None:
            raise RuntimeError("W&B integration did not create a run")

        audit_record = {
            "arm": args.arm,
            "seed": args.seed,
            "heldout_n": args.heldout_n,
            "heldout_score": heldout_score,
            "last10_reward": statistics.fmean(rewards[-10:]),
            "mean_zvf": mean_zvf,
            "mean_gu": 1.0 - mean_zvf,
            "collapse": first_five_zvf >= 0.80 and first_five_reward <= 0.05,
            "rollouts": int(trainer.state.global_step * 16),
            "wall_clock_seconds": wall_clock_seconds,
            "stack_fingerprint": args.stack_fingerprint,
            "treatment_changes": TREATMENT_CHANGES[args.arm],
            "manifest_path": "run_manifest.json",
        }
        telemetry = {
            "reward": rewards,
            "zvf": zvf,
            "gu": [1.0 - value for value in zvf],
            "first_five_reward": first_five_reward,
            "first_five_zvf": first_five_zvf,
            "trainer_log_history": history,
        }
        run_config = {
            "mode": args.mode,
            "model": MODEL_ID,
            "model_revision": MODEL_REVISION,
            "dataset": DATASET_ID,
            "dataset_revision": DATASET_REVISION,
            "max_steps": args.max_steps,
            "heldout_n": args.heldout_n,
            "max_completion_length": args.max_completion_length,
            "save_steps": save_steps,
            "unit_fingerprint": args.unit_fingerprint,
            "stack_fingerprint": args.stack_fingerprint,
        }
        manifest = {
            "schema_version": "e1-colab-confirmatory-run-v1",
            "evidence_class": "confirmatory" if args.mode == "confirmatory" else "preflight-not-evidence",
            "started_at": started_at,
            "completed_at": utc_now(),
            "audit_record": audit_record,
            "run_config": run_config,
            "runtime_versions": runtime_versions,
            "resume": {"resumed_from_step": resume_step, "resumed_from_path": resume_path},
            "remote_checkpoint_steps": remote_checkpoint_steps(api, args.hf_repo),
            "telemetry": telemetry,
            "heldout_trace": heldout_trace,
            "wandb": {"run_id": wandb_run.id, "run_url": wandb_run.url},
        }

        with tempfile.TemporaryDirectory(prefix="e1-final-") as tmp:
            staging = Path(tmp)
            final_dir = staging / "final"
            trainer.save_model(str(final_dir))
            tokenizer.save_pretrained(final_dir)
            (staging / "run_manifest.json").write_text(
                json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8"
            )
            commit = api.upload_folder(
                repo_id=args.hf_repo,
                repo_type="model",
                folder_path=staging,
                path_in_repo=".",
                commit_message=f"Complete E1 {args.mode} {args.arm} seed {args.seed}",
            )

        remote = {
            "hf_repo": args.hf_repo,
            "hf_commit": commit.oid,
            "hf_checkpoint_url": f"https://huggingface.co/{args.hf_repo}/tree/{commit.oid}",
            "hf_manifest_path": "run_manifest.json",
            "hf_final_adapter_path": "final/adapter_model.safetensors",
            "hf_checkpoint_steps": remote_checkpoint_steps(api, args.hf_repo),
            "wandb_run_id": wandb_run.id,
            "wandb_run_url": wandb_run.url,
        }
        wandb_run.summary.update({**audit_record, **remote})
        wandb.finish(exit_code=0)
        result = {
            "schema_version": "e1-colab-result-v1",
            "status": "completed",
            "evidence_class": manifest["evidence_class"],
            "audit_record": audit_record,
            "remote": remote,
            "run_config": run_config,
            "runtime_versions": runtime_versions,
            "resume": manifest["resume"],
        }
        print("E1_RESULT " + json.dumps(result, sort_keys=True), flush=True)
        return 0
    except BaseException:
        if wandb.run is not None:
            wandb.finish(exit_code=1)
        raise


if __name__ == "__main__":
    raise SystemExit(main())
