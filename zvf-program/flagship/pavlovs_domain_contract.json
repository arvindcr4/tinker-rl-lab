  "sampling_contract": {
    "unit": "environment episode, not isolated prompt",
    "minimum_primary_domains_per_training_batch": 6,
    "maximum_math_fraction": 0.05,
    "minimum_stateful_fraction": 0.6,
    "minimum_artifact_or_side_effect_fraction": 0.5,
    "domain_reweighting": "inverse-frequency at the domain family level; no company count may make code dominate the mixture",
    "curriculum": "single-step tool calls -> multi-step state changes -> long-horizon artifact and live-system tasks"
  },
  "reward_contract": {
    "components": [
      "environment_task_success",
      "artifact_or_state_integrity",
      "rubric_partial_credit",
      "safety_and_policy_constraints",
      "cost_and_latency"
    ],
    "normalization": "normalize within environment family before cross-domain aggregation",
    "verifier_rule": "primary reward must inspect environment state or native artifacts whenever task correctness depends on them",
    "anti_reward_hacking": "keep hidden behavioral tests and verifier state outside the policy-visible workspace"
  },
  "evaluation_contract": {
    "primary_unit": "seed within model x environment-family x stack",
    "metrics": [
      "task_success",
      "rubric_score",
      "state_integrity",
      "safety_violation_rate",
      "tokens_per_success",
      "tool_calls_per_success",
      "wall_time_per_success"
    ],
    "required_slices": [
      "domain",
      "horizon",
      "reward_type",
      "verifier_type",
      "artifact_vs_stateful",
      "seen_vs_unseen_environment_family"
    ],
    "company_usefulness_rule": "every company inherits at least one primary evaluation suite from each listed domain; aggregate success may not hide a domain regression"
  },
  "contamination_contract": {
    "rule": "primary evaluation tasks, repositories, environment seeds, and hidden tests must be disjoint from training",
    "same_family_exception": "allowed only when the provider publishes immutable disjoint splits and the held-out task identifiers are unavailable to the training job",
    "required_receipts": [
      "dataset_revision",
      "license",
      "task_id_hashes",
      "split_manifest_hash",
      "container_digest",
      "model_revision",
      "adapter_revision"
    ]
  },
  "budget_gate": {
    "status": "AUTHORIZED_TINKER_ONLY",
    "provider": "Tinker",
    "paid_jobs_may_launch": true,
    "maximum_usd": 18.0,
    "operational_cap_usd": 16.5,
    "safety_reserve_usd": 1.5,
    "authorized_at": "2026-08-09"
  },
  "non_claims": [
    "GSM8K or MATH performance alone establishes company usefulness",
    "domain coverage establishes production readiness",
    "a public benchmark score substitutes for a company-specific acceptance test",
    "one aggregate score can compensate for failure in a listed domain",
    "planned paid runs are evidence before immutable result receipts exist"
  ]
}
