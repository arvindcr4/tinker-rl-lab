#!/usr/bin/env python3
"""Execute the uploaded preflight without exposing credentials in argv/logs."""

import json
import os
from pathlib import Path
import subprocess
import sys


SECRET_PATH = Path("/content/.next-preflight-secrets.json")
REQUEST_PATH = Path("/content/next-preflight-request.json")
SCRIPT_PATH = Path("/content/remote_preflight.py")


def read_and_remove(path: Path):
    with path.open(encoding="utf-8") as handle:
        payload = json.load(handle)
    path.unlink()
    return payload


def main(
    *,
    secret_path: Path = SECRET_PATH,
    request_path: Path = REQUEST_PATH,
    script_path: Path = SCRIPT_PATH,
) -> int:
    secrets = read_and_remove(secret_path)
    request = read_and_remove(request_path)
    required_secrets = {"HF_TOKEN", "WANDB_API_KEY"}
    if set(secrets) != required_secrets:
        raise SystemExit("secret payload keys do not match the required allowlist")
    if set(request) != {"expected_gpu", "script_args"}:
        raise SystemExit("invocation payload keys do not match the required allowlist")
    script_args = request["script_args"]
    if not isinstance(script_args, list) or not all(
        isinstance(value, str) for value in script_args
    ):
        raise SystemExit("script_args must be a list of strings")

    child_env = os.environ.copy()
    for key in sorted(required_secrets):
        value = secrets[key]
        if not isinstance(value, str) or not value:
            raise SystemExit(f"missing required secret: {key}")
        child_env[key] = value
    child_env.update(
        {
            "WANDB_MODE": "online",
            "WANDB_SILENT": "true",
            "WANDB_NOTEBOOK_NAME": script_path.name,
        }
    )
    completed = subprocess.run(
        [sys.executable, str(script_path), *script_args],
        cwd=script_path.parent,
        env=child_env,
        check=False,
    )
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
